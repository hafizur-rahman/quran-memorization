[{"row_id": 1, "segments": [{"text": "﴿نُسَارِعُ﴾", "color": "green"}, {"text": ": فِعْلٌ مُضَارِعٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ \"", "color": "black"}, {"text": "نَحْنُ", "color": "blue"}, {"text": "\"، وَالْجُمْلَةُ فِي مَحَلِّ رَفْعٍ خَبَرِ", "color": "black"}, {"text": "( أَنَّ )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿لَهُمْ﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "اللَّامُ", "color": "blue"}, {"text": "\" حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ\"", "color": "black"}, {"text": "هَاءُ الْغَائِبِ", "color": "blue"}, {"text": "\" ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى السُّكُونِ فِي مَحَلِّ جَرٍّ بِالْحَرْفِ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿فِي﴾", "color": "green"}, {"text": ": حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْخَيْرَاتِ﴾", "color": "green"}, {"text": ": اسْمٌ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْكَسْرَةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَلْ﴾", "color": "green"}, {"text": ": حَرْفُ إِضْرَابٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾", "color": "green"}, {"text": ": حَرْفُ نَفْيٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَشْعُرُونَ﴾", "color": "green"}, {"text": ": فِعْلٌ مُضَارِعٌ مَعْطُوفٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ ثُبُوتُ النُّونِ لِأَنَّهُ مِنَ الْأَفْعَالِ الْخَمْسَةِ، وَ\"", "color": "black"}, {"text": "وَاوُ الْجَمَاعَةِ", "color": "blue"}, {"text": "\" ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى السُّكُونِ فِي مَحَلِّ رَفْعٍ فَاعِلٌ.", "color": "black"}]}]