[{"row_id": 1, "segments": [{"text": "﴿هَيْهَاتَ﴾", "color": "green"}, {"text": ": اسْمُ فِعْلٍ مَاضٍ بِمَعْنَى", "color": "black"}, {"text": "( بَعُدَ )", "color": "green"}, {"text": "مَبْنِيٌّ عَلَى الْفَتْحِ لَا مَحَلَّ لَهُ مِنَ الْإِعْرَابِ، وَالْفَاعِلُ مَحْذُوفٌ تَقْدِيرُهُ \"", "color": "black"}, {"text": "الْوُقُوعُ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿هَيْهَاتَ﴾", "color": "green"}, {"text": ": تَوْكِيدٌ لِلْأُولَى مَبْنِيٌّ عَلَى الْفَتْحِ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِمَا﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "اللَّامُ", "color": "blue"}, {"text": "\" حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى الْكَسْرِ، وَ", "color": "black"}, {"text": "( مَا )", "color": "green"}, {"text": "حَرْفٌ مَصْدَرِيٌّ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُوعَدُونَ﴾", "color": "green"}, {"text": ": فِعْلٌ مُضَارِعٌ مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ ثُبُوتُ النُّونِ لِأَنَّهُ مِنَ الْأَفْعَالِ الْخَمْسَةِ، وَ\"", "color": "black"}, {"text": "وَاوُ الْجَمَاعَةِ", "color": "blue"}, {"text": "\" ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى السُّكُونِ فِي مَحَلِّ رَفْعٍ نَائِبُ فَاعِلٍ، وَالْمَصْدَرُ الْمُؤَوَّلُ مِنْ", "color": "black"}, {"text": "( مَا )", "color": "green"}, {"text": "وَالْفِعْلِ فِي مَحَلِّ جَرٍّ بِاللَّامِ.", "color": "black"}]}]