[{"row_id": 1, "segments": [{"text": "﴿وَمَا﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "الْوَاوُ", "color": "blue"}, {"text": "\" حَرْفُ اعْتِرَاضٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( مَا )", "color": "green"}, {"text": "حَرْفُ نَفْيٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿أَضَلَّنَا﴾", "color": "green"}, {"text": ": فِعْلٌ مَاضٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( نَا )", "color": "green"}, {"text": "ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى السُّكُونِ فِي مَحَلِّ نَصْبٍ مَفْعُولٌ بِهِ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِلَّا﴾", "color": "green"}, {"text": ": حَرْفُ اسْتِثْنَاءٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمُجْرِمُونَ﴾", "color": "green"}, {"text": ": فَاعِلٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الْوَاوُ لِأَنَّهُ جَمْعُ مُذَكَّرٍ سَالِمٌ.", "color": "black"}]}]