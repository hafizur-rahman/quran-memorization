[{"row_id": 1, "segments": [{"text": "﴿لَقَدْ﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "اللَّامُ", "color": "blue"}, {"text": "\" حَرْفُ جَوَابٍ لِلْقَسَمِ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( قَدْ )", "color": "green"}, {"text": "حَرْفُ تَحْقِيقٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿جِئْتُمْ﴾", "color": "green"}, {"text": ": فِعْلٌ مَاضٍ مَبْنِيٌّ عَلَى السُّكُونِ لِاتِّصَالِهِ بِتَاءِ الْفَاعِلِ، وَ\"", "color": "black"}, {"text": "تَاءُ الْفَاعِلِ", "color": "blue"}, {"text": "\" ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى الضَّمِّ فِي مَحَلِّ رَفْعٍ فَاعِلٌ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿شَيْئًا﴾", "color": "green"}, {"text": ": مَفْعُولٌ بِهِ مَنْصُوبٌ وَعَلَامَةُ نَصْبِهِ الْفَتْحَةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِدًّا﴾", "color": "green"}, {"text": ": نَعْتٌ لِـ", "color": "black"}, {"text": "( شَيْئًا )", "color": "green"}, {"text": "مَنْصُوبٌ وَعَلَامَةُ نَصْبِهِ الْفَتْحَةُ الظَّاهِرَةُ.", "color": "black"}]}]