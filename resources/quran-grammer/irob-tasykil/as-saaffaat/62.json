[{"row_id": 1, "segments": [{"text": "﴿أَذَلِكَ﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "الْهَمْزَةُ", "color": "blue"}, {"text": "\" حَرْفُ اسْتِفْهَامٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( ذَلِكَ )", "color": "green"}, {"text": "اسْمُ إِشَارَةٍ مَبْنِيٌّ عَلَى الْفَتْحِ فِي مَحَلِّ رَفْعٍ مُبْتَدَأٌ.", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿خَيْرٌ﴾", "color": "green"}, {"text": ": خَبَرٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نُزُلًا﴾", "color": "green"}, {"text": ": تَمْيِيزٌ مَنْصُوبٌ وَعَلَامَةُ نَصْبِهِ الْفَتْحَةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَمْ﴾", "color": "green"}, {"text": ": حَرْفُ عَطْفٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿شَجَرَةُ﴾", "color": "green"}, {"text": ": مَعْطُوفٌ عَلَى", "color": "black"}, {"text": "( ذَلِكَ )", "color": "green"}, {"text": "مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الزَّقُّومِ﴾", "color": "green"}, {"text": ": مُضَافٌ إِلَيْهِ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْكَسْرَةُ الظَّاهِرَةُ.", "color": "black"}]}]