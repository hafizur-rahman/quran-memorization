[{"row_id": 1, "segments": [{"text": "﴿تَنْزِيلٌ﴾", "color": "green"}, {"text": ": خَبَرٌ لِمُبْتَدَإٍ مَحْذُوفٍ تَقْدِيرُهُ \"", "color": "black"}, {"text": "هُوَ", "color": "blue"}, {"text": "\" مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ.", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿مِنْ﴾", "color": "green"}, {"text": ": حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾", "color": "green"}, {"text": ": اسْمٌ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْكَسْرَةُ الظَّاهِرَةُ، وَشِبْهُ الْجُمْلَةِ فِي مَحَلِّ رَفْعٍ نَعْتٌ لِـ", "color": "black"}, {"text": "( تَنْزِيلٌ )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْعَالَمِينَ﴾", "color": "green"}, {"text": ": مُضَافٌ إِلَيْهِ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْيَاءُ لِأَنَّهُ جَمْعُ مُذَكَّرٍ سَالِمٌ.", "color": "black"}]}]