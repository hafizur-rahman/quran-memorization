[{"row_id": 1, "segments": [{"text": "﴿فَلَا﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "الْفَاءُ", "color": "blue"}, {"text": "\" حَرْفُ عَطْفٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( لَا )", "color": "green"}, {"text": "حَرْفُ نَفْيٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿اقْتَحَمَ﴾", "color": "green"}, {"text": ": فِعْلٌ مَاضٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ \"", "color": "black"}, {"text": "هُوَ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْعَقَبَةَ﴾", "color": "green"}, {"text": ": مَفْعُولٌ بِهِ مَنْصُوبٌ وَعَلَامَةُ نَصْبِهِ الْفَتْحَةُ الظَّاهِرَةُ.", "color": "black"}]}]