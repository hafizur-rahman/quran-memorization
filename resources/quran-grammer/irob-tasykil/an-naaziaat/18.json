[{"row_id": 1, "segments": [{"text": "﴿فَقُلْ﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "الْفَاءُ", "color": "blue"}, {"text": "\" حَرْفُ عَطْفٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ", "color": "black"}, {"text": "( قُلْ )", "color": "green"}, {"text": "فِعْلُ أَمْرٍ مَبْنِيٌّ عَلَى السُّكُونِ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ \"", "color": "black"}, {"text": "أَنْتَ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿هَلْ﴾", "color": "green"}, {"text": ": حَرْفُ اسْتِفْهَامٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَكَ﴾", "color": "green"}, {"text": ": \"", "color": "black"}, {"text": "اللَّامُ", "color": "blue"}, {"text": "\" حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ\"", "color": "black"}, {"text": "كَافُ الْمُخَاطَبِ", "color": "blue"}, {"text": "\" ضَمِيرٌ مُتَّصِلٌ مَبْنِيٌّ عَلَى الْفَتْحِ فِي مَحَلِّ جَرٍّ بِالْحَرْفِ، وَشِبْهُ الْجُمْلَةِ فِي مَحَلِّ رَفْعٍ خَبَرٌ مُقَدَّمٌ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى﴾", "color": "green"}, {"text": ": حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْ﴾", "color": "green"}, {"text": ": حَرْفُ نَصْبٍ وَمَصْدَرِيَّةٍ مَبْنِيٌّ عَلَى السُّكُونِ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَزَكَّى﴾", "color": "green"}, {"text": ": فِعْلٌ مُضَارِعٌ مَنْصُوبٌ وَعَلَامَةُ نَصْبِهِ الْفَتْحَةُ الْمُقَدَّرَةُ لِلتَّعَذُّرِ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ \"", "color": "black"}, {"text": "أَنْتَ", "color": "blue"}, {"text": "\"، وَالْمَصْدَرُ الْمُؤَوَّلُ", "color": "black"}, {"text": "( أَنْ تَزَكَّى )", "color": "green"}, {"text": "فِي مَحَلِّ رَفْعٍ مُبْتَدَأٌ مُؤَخَّرٌ.", "color": "black"}]}]