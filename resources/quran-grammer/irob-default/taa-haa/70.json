[{"row_id": 1, "segments": [{"text": "{ فَأُلْقِيَ السَّحَرَةُ سُجَّدًا قَالُوا آمَنَّا بِرَبِّ هَارُونَ وَمُوسَى", "color": "brown"}, {"text": "(  طه: 70  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأُلْقِيَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ألقي: فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿السَّحَرَةُ﴾:", "color": "green"}, {"text": "نائب الفاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سُجَّدًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "صنعوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "في الآية السابقة وهو: « صَنَعُوا: فعل ماضٍ مبنيّ على الضم، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\": فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آمَنَّا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": فاعل».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِرَبِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "آمنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿هَارُونَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمُوسَى﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "هارون", "color": "blue"}, {"text": "\" معطوف عليه، مجرور بالفتحة المقدّرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ألقي السحرة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأن