[{"row_id": 1, "segments": [{"text": "{ قَالَ مَوْعِدُكُمْ يَوْمُ الزِّينَةِ وَأَنْ يُحْشَرَ النَّاسُ ضُحًى", "color": "brown"}, {"text": "(  طه: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "تقدّم إعرابه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "في الآية 49 وهو: «", "color": "black"}, {"text": "قَالَ: فعل ماض مبنيّ على الفتح، والفاعل: هو", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَوْعِدُكُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَوْمُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الزِّينَةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَأَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "أن: حرف نصب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يُحْشَرَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿النَّاسُ﴾:", "color": "green"}, {"text": "نائب الفاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ضُحًى﴾:", "color": "green"}, {"text": "ظرف زمان منصوب متعلّق بـ \"", "color": "black"}, {"text": "يحشر", "color": "blue"}, {"text": "\"، وعلامة النصب الفتحة المقدرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يحشر", "color": "blue"}, {"text": "\" في محلّ رفع، لأنه