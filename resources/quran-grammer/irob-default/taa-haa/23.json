[{"row_id": 1, "segments": [{"text": "{ لِنُرِيَكَ مِنْ آيَاتِنَا الْكُبْرَى", "color": "brown"}, {"text": "(  طه: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِنُرِيَكَ﴾:", "color": "green"}, {"text": "اللام: للتعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "نريك: فعل مضارع منصوب بأن المضمرة، وعلامة النصب الفتحة، والفاعل: نحن، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ آيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف مفعول به ثان، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكُبْرَى﴾:", "color": "green"}, {"text": "نعت مجرور بالكسرة المقدّرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن نريك", "color": "blue"}, {"text": "\" في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجار والمجرور متعلّقان بفعل محذوف تقديره: آتيناك ذلك لنريك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نريك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}]