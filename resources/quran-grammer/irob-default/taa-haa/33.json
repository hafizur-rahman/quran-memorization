[{"row_id": 1, "segments": [{"text": "{ كَيْ نُسَبِّحَكَ كَثِيرًا", "color": "brown"}, {"text": "(  طه: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَيْ﴾:", "color": "green"}, {"text": "حرف مصدري ونصب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نُسَبِّحَكَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة، والفاعل: نحن، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَثِيرًا﴾:", "color": "green"}, {"text": "مفعول مطلق نائب عن المصدر فهو نعت له منصوب بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "كي نسبحك", "color": "blue"}, {"text": "\" في محلّ جرّ باللام مقدرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "اجعل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نسبحك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "كي", "color": "blue"}, {"text": "\".", "color": "black"}]}]