[{"row_id": 1, "segments": [{"text": "{ قَالَ فَمَا بَالُ الْقُرُونِ الْأُولَى", "color": "brown"}, {"text": "(  طه: 51  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "تقدّم إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "في الآية 49 وهو: «", "color": "black"}, {"text": "قَالَ: فعل ماض مبنيّ على الفتح، والفاعل: هو", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: اسم استفهام مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَالُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْقُرُونِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْأُولَى﴾:", "color": "green"}, {"text": "نعت مجرور بالكسرة المقدّرة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال ...", "color": "blue"}]}, {"row_id": 10, "segments": [{"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما بال", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن كان ربك قد أعطى وهدى فما بال.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة الشرط المقدرة في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]