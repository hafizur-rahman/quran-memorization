[{"row_id": 1, "segments": [{"text": "{ فَلَنَأْتِيَنَّكَ بِسِحْرٍ مِثْلِهِ فَاجْعَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِدًا لَا نُخْلِفُهُ نَحْنُ وَلَا أَنْتَ مَكَانًا سُوًى", "color": "brown"}, {"text": "(  طه: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَنَأْتِيَنَّكَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: لام القسم لقسم مقدر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "تأتينك: فعل مبنيّ على الفتح في محلّ رفع، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون التوكيد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": مفعول به، والفاعل: ضمير مستتر فيه وجوبًا تقديره: نحن للتعظيم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِسِحْرٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تأتينك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِثْلِهِ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "سحر", "color": "blue"}, {"text": "\" مجرور بالكسرة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَاجْعَلْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "اجعل: فعل أمر مبنيّ على السكون، والفاعل: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بَيْنَنَا﴾:", "color": "green"}, {"text": "ظرف منصوب بالفتحة متعلّق بمحذوف مفعول به ثان.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَبَيْنَكَ﴾:", "color": "green"}, {"text": "معطوف على الظرف الأول بالواو، ويعرب مثله.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَوْعِدًا﴾:", "color": "green"}, {"text": "مفعول به أول منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿نُخْلِفُهُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل: نحن، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مفعول به.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع توكيد لضمير الفاعل المستتر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع معطوف على الضمير نحن.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿مَكَانًا﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "موعدًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿سُوًى﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "مكانًا", "color": "blue"}, {"text": "\" منصوب، وعلامة النصب الفتحة المقدرة على الألف.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نأتينك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم المقدر، وجملة القسم المقدرة في محلّ نصب لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اجعل ...", "color": "blue"}]}, {"row_id": 22, "segments": [{"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن قبلت اللّقاء \"", "color": "black"}, {"text": "فاجعل ...", "color": "blue"}]}, {"row_id": 23, "segments": [{"text": "\" وجملة \"", "color": "black"}, {"text": "لا نخلفه", "color": "blue"}, {"text": "\" في