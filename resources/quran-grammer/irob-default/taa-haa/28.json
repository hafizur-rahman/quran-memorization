[{"row_id": 1, "segments": [{"text": "{ يَفْقَهُوا قَوْلِي", "color": "brown"}, {"text": "(  طه: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَفْقَهُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم جواب الطلب، وعلامة الجزم حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَوْلِي﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "صدري", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "في الآية 25 وهو: «", "color": "black"}, {"text": "صَدْرِي: مفعول به منصوب بالفتحة المقدّرة على ما قبل الياء، و\"", "color": "blue"}, {"text": "الياء", "color": "blue"}, {"text": "\": مضاف إليه", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يفقهوا ...", "color": "blue"}]}, {"row_id": 6, "segments": [{"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط مقدر غير مقترنة بالفاء، أي: إن تحلل عقدة لساني يفقهوا قولي.", "color": "black"}]}]