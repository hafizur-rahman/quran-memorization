[{"row_id": 1, "segments": [{"text": "{ فَلَا يَصُدَّنَّكَ عَنْهَا مَنْ لَا يُؤْمِنُ بِهَا وَاتَّبَعَ هَوَاهُ فَتَرْدَى", "color": "brown"}, {"text": "(  طه: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَصُدَّنَّكَ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح في محلّ جزم، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون التوكيد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَنْهَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يصدّنك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُؤْمِنُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِهَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يؤمن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَاتَّبَعَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "اتبع: فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿هَوَاهُ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "