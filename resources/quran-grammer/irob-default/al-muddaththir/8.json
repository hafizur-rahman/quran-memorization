[{"row_id": 1, "segments": [{"text": "{ فَإِذَا نُقِرَ فِي النَّاقُورِ", "color": "brown"}, {"text": "(  المدثر: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن مبنيّ على السكون متضمن معنى الشرط متعلق بجوابه وجوابه هنا دل عليه الجزاء على معنى عسر الأمر على الكافرين، مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نُقِر﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي النَّاقُورِ﴾:", "color": "green"}, {"text": "جارّ ومجرور في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نقر في الناقور", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}]