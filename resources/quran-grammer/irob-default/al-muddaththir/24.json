[{"row_id": 1, "segments": [{"text": "{ فَقَالَ إِنْ هَذَا إِلَّا سِحْرٌ يُؤْثَرُ", "color": "brown"}, {"text": "(  المدثر: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَقَالَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "حرف تنبيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿سِحْرٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع بالضمّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يُؤْثَرُ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بالضمّة، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "قدّر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن هذا إلا سحر", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يؤثر", "color": "blue"}, {"text": "\" في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "سحر", "color": "blue"}, {"text": "\"", "color": "black"}]}]