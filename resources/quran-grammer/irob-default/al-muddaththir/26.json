[{"row_id": 1, "segments": [{"text": "{ سَأُصْلِيهِ سَقَرَ", "color": "brown"}, {"text": "(  المدثر: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية السابعة عشرة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « سَأُرْهِقُهُ﴾: السين: حرف استقبال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أرهقه: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، والفاعل ضمير مستتر في وجوبًا تقديره: أنا، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَعُودًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سأصليه سقر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة.", "color": "black"}]}]