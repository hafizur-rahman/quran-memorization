[{"row_id": 1, "segments": [{"text": "{ إِنَّهَا لَإِحْدَى الْكُبَرِ", "color": "brown"}, {"text": "(  المدثر: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّهَا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَإِحْدَى﴾:", "color": "green"}, {"text": "الّلام: حرف للتوكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إحدى: خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع بالضمّة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكُبَرِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنها لإحدى", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب القسم.", "color": "black"}]}]