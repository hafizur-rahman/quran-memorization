[{"row_id": 1, "segments": [{"text": "{ وَالرُّجْزَ فَاهْجُرْ", "color": "brown"}, {"text": "(  المدثر: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية الكريمة الثالثة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « وَرَبَّكَ﴾: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ربك: مفعول به مقدم منصوب الفتحة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَكَبِّرْ﴾:", "color": "green"}, {"text": "الفاء: حرف زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "كبر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوباً تقديره: أنت».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اهجر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة جواب النداء.", "color": "black"}]}]