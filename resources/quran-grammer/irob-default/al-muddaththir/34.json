[{"row_id": 1, "segments": [{"text": "{ وَالصُّبْحِ إِذَا أَسْفَرَ", "color": "brown"}, {"text": "(  المدثر: 34  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالصُّبْحِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية السابقة، \"", "color": "black"}, {"text": "وَاللَّيْلِ إِذْ أَدْبَرَ", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «  الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللَّيْلِ: مقسم به مجرور بالكسرة، والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف للزمن الماضي مبنيّ على السّكون في محلّ نصب مفعول به متعلّق بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَدْبَرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "إذا", "color": "blue"}, {"text": "\" ظرف للزمن المستقبل متضمن معنى الشرط، خافض لشرطه منصوب بجوابه، مبنيّ على السّكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أسفر", "color": "blue"}, {"text": "\" في محلّ جرّ بإضافة \"", "color": "black"}, {"text": "إذا", "color": "blue"}, {"text": "\" إليها.", "color": "black"}]}]