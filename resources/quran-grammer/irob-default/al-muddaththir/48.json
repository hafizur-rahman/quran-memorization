[{"row_id": 1, "segments": [{"text": "{ فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ", "color": "brown"}, {"text": "(  المدثر: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَنْفَعُهُمْ﴾:", "color": "green"}, {"text": "تنفع: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿شَفَاعَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الشَّافِعِينَ﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور بالياء؛ لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما تنفهم شفاعة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب شرط مقدر أي إذا كان هذا أمرهم فما تنفعهم شفاعة.", "color": "black"}]}]