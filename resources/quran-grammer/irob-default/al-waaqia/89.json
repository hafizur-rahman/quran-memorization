[{"row_id": 1, "segments": [{"text": "{ فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ", "color": "brown"}, {"text": "(  الواقعة: 89  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَرَوْحٌ﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب الشرط \"", "color": "black"}, {"text": "أما", "color": "blue"}, {"text": "\" وجواب \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" محذوف لأن من بعده يدل عليه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "روح: مبتدأ مرفوع بالضمة وخبره محذوف، أي: فله روح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَرَيْحَانٌ وَجَنَّتُ﴾:", "color": "green"}, {"text": "معطوفتان بواوي على \"", "color": "black"}, {"text": "روح", "color": "blue"}, {"text": "\" مرفوعان بالضمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَعِيمٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "له روح", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب الشرط أما وجواب إن محذوف دل المذكور عليه.", "color": "black"}]}]