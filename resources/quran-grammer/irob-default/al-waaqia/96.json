[{"row_id": 1, "segments": [{"text": "{ فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ", "color": "brown"}, {"text": "(  الواقعة: 96  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الرابعة والسبعين من هذه السورة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « فَسَبِّحْ﴾: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "سبح: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِاسْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "سبح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْعَظِيمِ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "اسم", "color": "blue"}, {"text": "\" أو ربك مجرور بالكسرة».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سبح", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدرة، أي: إن كان أمر الله في الثواب والعقاب كما ذكر، فسبح باسم ربك العظيم.", "color": "black"}]}]