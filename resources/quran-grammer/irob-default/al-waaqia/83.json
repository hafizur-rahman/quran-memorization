[{"row_id": 1, "segments": [{"text": "{ فَلَوْلَا إِذَا بَلَغَتِ الْحُلْقُومَ", "color": "brown"}, {"text": "(  الواقعة: 83  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَوْلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لولا: حرف توبيخ وتنديم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول به، خافض لشرطه متعلّق بجوابه متضمن معنى الشرط.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجوابه محذوف دل عليه جواب \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" في الآية السادسة والثمانين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَلَغَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث الساكنة مبنيّ على السكون وحركت بالكسر منعًا من التقاء الساكنين، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْحُلْقُومَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "بغلت الحلقوم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}]