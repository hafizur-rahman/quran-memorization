[{"row_id": 1, "segments": [{"text": "{ فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ", "color": "brown"}, {"text": "(  الواقعة: 74  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَسَبِّحْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "سبح: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِاسْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "سبح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْعَظِيمِ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "اسم", "color": "blue"}, {"text": "\" أو ربك مجرور بالكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سبح", "color": "blue"}, {"text": "\" جواب شرط مقدرة، أي: إن كانت قدرة الله في الخلق والإنشاء والتنظيم كما ذكر فسبح باسم.", "color": "black"}]}]