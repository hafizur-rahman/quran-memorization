[{"row_id": 1, "segments": [{"text": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ إِذَا وَقَعَتِ الْوَاقِعَةُ", "color": "brown"}, {"text": "(  الواقعة: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه متضمن معنى الشرط.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَقَعَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف التأنيث.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "حُرِّك بالكسرة منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْوَاقِعَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وقعت الواقعة", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه وجواب الشرط محذوف تقديره: خفضت أقوامًا ورفعت أقوامًا.", "color": "black"}]}]