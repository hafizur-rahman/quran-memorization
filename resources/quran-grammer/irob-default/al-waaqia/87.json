[{"row_id": 1, "segments": [{"text": "{ تَرْجِعُونَهَا إِنْ كُنْتُمْ صَادِقِينَ", "color": "brown"}, {"text": "(  الواقعة: 87  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تَرْجِعُونَهَا﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل يعود على النفس مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنْ كُنْتُمْ﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو «  إِنْ: حرف شرط غير جازم\n.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "كُنْتُمْ: فعل ماض ناقص مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿صَادِقِينَ﴾:", "color": "green"}, {"text": "خبر\"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ترجعونها", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها تفسيرية لجواب الشرط المقدرة الأول، أي: إن كنتم غير مدينين فأرجعوا الروح المحتضرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كنتم صادقين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية، وجواب الشرط محذوف دل عليه ما قبله، أي إن كنتم صادقين في ما تزعمون من عدم البعث فردوا روح المحتضر إلى جسده لينتفي عنه الموت.", "color": "black"}]}]