[{"row_id": 1, "segments": [{"text": "{ *فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ", "color": "brown"}, {"text": "(  الواقعة: 75  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف زائد للتوكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أُقْسِمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِمَوَاقِعِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أقسم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿النُّجُومِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]