[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ عَلِمْتُمُ النَّشْأَةَ الْأُولَى فَلَوْلَا تَذَكَّرُونَ", "color": "brown"}, {"text": "(  الواقعة: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف واقع في جواب قسم مقدّر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف توكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلِمْتُمُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿النَّشْأَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْأُولَى﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "النشأة", "color": "blue"}, {"text": "\" منصوبة بالفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَلَوْلَا تَذَكَّرُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية السابعة والخمسين.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وهو « فَلَوْلَا: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لولا: حرف تحضيض لا عمل له.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تُصَدِّقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "علمتم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب القسم المقدرة وجملة القسم المقدرة لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تذكرون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على استئنافية مقدرة مسببة عما سبق أي تنبهوا فتذكروا.", "color": "black"}]}]