[{"row_id": 1, "segments": [{"text": "{ {لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا", "color": "brown"}, {"text": "(  الواقعة: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لا يسمعون فيها﴾:", "color": "green"}, {"text": "تعرب إعراب الآية التاسعة عشرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « لَا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُصَدَّعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النون، \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَنْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يصدعون", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَغْوًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَأْثِيمًا﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "لغوًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يسمعون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}]