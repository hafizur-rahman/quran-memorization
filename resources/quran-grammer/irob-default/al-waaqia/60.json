[{"row_id": 1, "segments": [{"text": "{ نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ", "color": "brown"}, {"text": "(  الواقعة: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿نَحْنُ قَدَّرْنَا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "نحن خلقنا", "color": "blue"}, {"text": "\" الواردة في الآية السابعة والخمسين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « نَحْنُ: ضمير رفع منفصل مبني على الضم في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَلَقْنَاكُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "خَلَقْنَا", "color": "blue"}, {"text": "\": خلق: فعل ماض مبنيّ على السكون، لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل رفع فاعل».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَيْنَكُمُ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلق بـ \"", "color": "black"}, {"text": "قدرنا", "color": "blue"}, {"text": "\"، وهو مضاف، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمَوْتَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "ما: حرف نفي لا عمل له في لغة بني تميم، وعامل عمل \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة الحجازيين.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الضم في محلّ رفع مبتدأ على اللغة الأولى، وفي محل رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الثانية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِمَسْبُوقِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جر زائد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "مسبوقين: اسم مجرور لفظًا وعلامة جره الياء؛ لأنَّه جمع مذكر سالم مرفوع محلًا على اللغة الأولى على أنه خبر \"", "color": "black"}, {"text": "نحن", "color": "blue"}, {"text": "\"، ومنصوب محلًا على اللغة الثانية على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نحن قدرنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قدرنا", "color": "blue"}, {"text": "\" في محل رفع خبر المبتدأ \"", "color": "black"}, {"text": "نحن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما نحن بمسبوقين", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنّها معطوفة على الاستئنافية.", "color": "black"}]}]