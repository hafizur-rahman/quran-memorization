[{"row_id": 1, "segments": [{"text": "{ فَأَمَّا إِنْ كَانَ مِنَ الْمُقَرَّبِينَ", "color": "brown"}, {"text": "(  الواقعة: 88  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَمَّا﴾:", "color": "green"}, {"text": "الفاء حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أما: حرف شرط وتفصيل لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الفتح واسمها محذوف؛ لأنَّه معلوم من السياق.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "بمعنى إن كان المتوفيّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ الْمُقَرَّبِينَ﴾:", "color": "green"}, {"text": "جارّ مجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان من المقربين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}]