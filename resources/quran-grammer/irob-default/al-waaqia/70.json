[{"row_id": 1, "segments": [{"text": "{ لَوْ نَشَاءُ جَعَلْنَاهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ", "color": "brown"}, {"text": "(  الواقعة: 70  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية الخامسة والستين.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « لَوْ﴾: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَشَاءُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَجَعَلْنَاهُ﴾:", "color": "green"}, {"text": ",,, جعل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حُطَامًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَلَوْلَا تَشْكُرُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية السابعة والخمسين.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وهو « فَلَوْلَا: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لولا: حرف تحضيض لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُصَدِّقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل».", "color": "black"}]}]