[{"row_id": 1, "segments": [{"text": "{ فَوَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ", "color": "brown"}, {"text": "(  الطور: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَوَيْلٌ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أو واقعة في جواب شرط مقدر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ويل: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "ويل", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إذ: ظرف زمان مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والتنوين في \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" تنوين عوض ناب عن جملة محذوفة تقديرها: يوم إذ يحدث ذلك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِلْمُكَذِّبِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالخبر المحذوف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "المكذبين: اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "ويل يومئذ للمكذبين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط مقدرة، أي إذا كان أمر العذاب كذلك فويل للمكذبين.", "color": "black"}]}]