[{"row_id": 1, "segments": [{"text": "{ فَذَكِّرْ فَمَا أَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ", "color": "brown"}, {"text": "(  الطور: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَذَكِّرْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذكر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: حرف نفي من أخوات \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة الحجاز ولا عمل لها بلغة بني تميم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" أو مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِنِعْمَتِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة تقديره: حامدًا ربك، وهو مضاف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِكَاهِنٍ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "كاهن: اسم مجرور لفظًا منصوب محلًا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى ومرفوع محلًا على أنه خبر \"", "color": "black"}, {"text": "أنت", "color": "blue"}, {"text": "\" على اللغة الثانية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا: زائدة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مَجْنُونٍ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "كاهن", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدرة، أي إن وصفك الكافرون بالكهانة والجنون فذكرهم بالله أي استمر على تذكيرهم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما أنت بنعمة ربك بكاهن", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}]