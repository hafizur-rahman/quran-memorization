[{"row_id": 1, "segments": [{"text": "{ فَاكِهِينَ بِمَا آتَاهُمْ رَبُّهُمْ وَوَقَاهُمْ رَبُّهُمْ عَذَابَ الْجَحِيمِ", "color": "brown"}, {"text": "(  الطور: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَاكِهِينَ﴾:", "color": "green"}, {"text": "حال منصوبة بالياء، لأنها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ما: اسم موصول مبنيّ على السكون في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "فاكهين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آتَاهُمْ﴾:", "color": "green"}, {"text": "آتى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَبُّهُمْ﴾:", "color": "green"}, {"text": "رب: فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَوَقَاهُمْ رَبُّهُمْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "آتاهم ربهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "أو تكون \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" مصدرية وما بعدها: بتأويل مصدر في محلّ جرّ ب