[{"row_id": 1, "segments": [{"text": "{ ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ", "color": "brown"}, {"text": "(  التكاثر: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَتُسْأَلُنَّ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مبنيّ لاتصاله بنون التوكيد التي حُذفت لتوالي النونات.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وواو الجماعة المحذوفة في محلّ رفع نائب فاعل، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف توكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "سبق إعرابها في الآية الحادية عشرة من سورة \"", "color": "black"}, {"text": "العاديات", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "يَوْمَئِذٍ: ظرف زمان منصوب بالفتحة وهو مضاف.", "color": "blue"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" اسم مبنيّ على السكون وقد حرِّك بالكسر تخلصًا من التقاء الساكنين", "color": "black"}, {"text": "( سكونه سكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَنِ النَّعِيمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تسألن", "color": "blue"}, {"text": "\" معطوفة على \"", "color": "black"}, {"text": "ترون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]