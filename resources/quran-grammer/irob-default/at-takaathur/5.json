[{"row_id": 1, "segments": [{"text": "{ كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ", "color": "brown"}, {"text": "(  التكاثر: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَلَّا﴾:", "color": "green"}, {"text": "حرف ردع وزجر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف شرط غير جازم، وجواب الشرط محذوف، والتقدير: لفعلتم ما لا يوصف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وقيل \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\" حرف تمنّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عِلْمَ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْيَقِينِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة الاستئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]