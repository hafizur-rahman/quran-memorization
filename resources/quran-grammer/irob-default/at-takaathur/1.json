[{"row_id": 1, "segments": [{"text": "سورة التكاثر\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ أَلْهَاكُمُ التَّكَاثُرُ", "color": "brown"}, {"text": "(  التكاثر: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلْهَاكُمُ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح المقدر على الألف للتعذّر، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿التَّكَاثُرُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}]