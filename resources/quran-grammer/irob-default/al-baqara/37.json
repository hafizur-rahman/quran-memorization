[{"row_id": 1, "segments": [{"text": "{ فَتَلَقَّى آدَمُ مِنْ رَبِّهِ كَلِمَاتٍ فَتَابَ عَلَيْهِ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ", "color": "brown"}, {"text": "(  البقرة: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَتَلَقَّى﴾:", "color": "green"}, {"text": "الفاء استئنافية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تلقي: فعل ماض مبنيّ على الفتحة المقدرة على الألف منع من ظهورها التعذر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آدَمُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، وهو ممنوع من الصرف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ رَبِّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "تلقى", "color": "blue"}, {"text": "\"، والهاء ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَلِمَاتٍ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلًا من الفتحة؛ لأنَّه ملحق بجمع المؤنث السالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿    وجملة \"", "color": "green"}, {"text": "تلقي", "color": "green"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "﴿فَتَابَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "تاب: فعل ماض مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بتاب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿   وجملة \"", "color": "green"}, {"text": "تاب", "color": "green"}, {"text": "\" معطوفة على جملة محذوفة، والتقدير: فقالها فتاب.", "color": "green"}]}, {"row_id": 12, "segments": [{"text": "﴿إِنَّهُ﴾:", "color": "green"}, {"text": "حرف مشبّه بالفعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": 