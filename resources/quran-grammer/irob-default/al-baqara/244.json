[{"row_id": 1, "segments": [{"text": "{ وَقَاتِلُوا فِي سَبِيلِ اللَّهِ وَاعْلَمُوا أَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ", "color": "brown"}, {"text": "(  البقرة: 244  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَاتِلُوا﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح، و \"", "color": "black"}, {"text": "قاتلوا", "color": "blue"}, {"text": "\" فعل أمر مبني على حذف النون لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿سَبِيلِ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "قاتلوا", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مخفوض بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قاتلوا في سبيل الله", "color": "blue"}, {"text": "\" معطوفة على استئناف مقدّر، أي: لا تفرّوا من الموت كما هرب بعضهم فلم ينفعهم ذلك، بل اثبتوا وقاتلوا ,,,\nوَاعْلَمُوا: الواو حرف عطف مبنيّ على الفتح، و \"", "color": "black"}, {"text": "اعلموا", "color": "blue"}, {"text": "\" فعل أمر مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعلموا", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "قاتلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments"