[{"row_id": 1, "segments": [{"text": "{ فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ", "color": "brown"}, {"text": "(  البقرة: 192  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنِ﴾:", "color": "green"}, {"text": "الفاء حرف استئناف مبني على الفتح لا محل له من الإعراب، إن: حرف شرط جازم مبنيّ على السكون لا محل له من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿انْتَهَوْا﴾:", "color": "green"}, {"text": "فعل ماض مبني على فتح مقدر على الألف المحذوفة لالتقائها ساكنة مع واو الجماعة، وهو في محل جزم فعل الشرط.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل، والألف للتفريق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "انتهوا", "color": "blue"}, {"text": "\" لا محل لها من الإعراب لأنها استئنافية.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء حرف ربط واقع في جواب الشرط مبني على الفتح لا محل له من الإعراب، إن: حرف توكيد ونصب مشبه بالفعل مبني على الفتح الظاهر على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب، وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿غَفُورٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَحِيمٌ﴾:", "color": "green"}, {"text": "خبر ثان مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿والجملة الاسمية \"", "color": "green"}, {"text": "إن الله غفور رحيم", "color": "green"}, {"text": "\" في محل جزم جواب الشرط.", "color": "green"}]}, {"row_id": 11, "segments": []}]