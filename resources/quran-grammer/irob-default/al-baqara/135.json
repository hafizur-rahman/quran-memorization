[{"row_id": 1, "segments": [{"text": "{ وَقَالُوا كُونُوا هُودًا أَوْ نَصَارَى تَهْتَدُوا قُلْ بَلْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ", "color": "brown"}, {"text": "(  البقرة: 135  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالُوا﴾:", "color": "green"}, {"text": "الواو حرف استئناف مبني على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قالوا: فعل ماض مبنيّ على الضمّ لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبني على السكون في محلّ رفع فاعل والألف للتفريق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كُونُوا﴾:", "color": "green"}, {"text": "فعل أمر ناقص مبنيّ على حذف النون لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبني على السكون في محلّ رفع اسم كان، والألف للتفريق.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هُودًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَوْ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَصَارَى﴾:", "color": "green"}, {"text": "معطوف على \"", "color": "black"}, {"text": "هودًا", "color": "blue"}, {"text": "\" منصوب مثله، وعلامة نصبه الفتحة المقدرة على الألف للتعذر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كونوا هودًا أو نصارى", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"r