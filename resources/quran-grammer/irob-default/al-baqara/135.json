t": "الواو واو الحال، أو استئنافية حرف مبني على الفتح لا محلّ له من الإعراب، ما: حرف نفي مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الفتح الظاهر على آخره، واسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" ضمير مستتر فيه جوازًا تقديره: هو يعود إلى إبراهيم.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿الْمُشْرِكِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بمن، وعلامة جره الياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وما كان من المشركين", "color": "blue"}, {"text": "\" في محلّ نصب حال، وهي حال مؤكدة لما قبلها، أو استئنافية لا محلّ لها من الإعراب", "color": "black"}, {"text": "( بحسب الواو )", "color": "green"}, {"text": ".", "color": "black"}]}]