[{"row_id": 1, "segments": [{"text": "{ وَإِنْ كَانَ ذُو عُسْرَةٍ فَنَظِرَةٌ إِلَى مَيْسَرَةٍ وَأَنْ تَصَدَّقُوا خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ", "color": "brown"}, {"text": "(  البقرة: 280  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "إنْ", "color": "blue"}, {"text": "\" حرف شرط جازم مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ تامّ مبنيّ على الفتح في محلّ جزم فعل الشّرط.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ذُو﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو لأنّه من الأسماء الستّة، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عُسْرَة﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن كان ذو عسرةٍ", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "إن لم تفعلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَنَظِرَةٌ﴾:", "color": "green"}, {"text": "الفاء رابطة لجواب الشّرط حرف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "نظرة", "color": "blue"}, {"text": "\" خبر لمبتدأ محذوف تقديره: الواجب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَيْسَرَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "نظرة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الواجب نظرة إلى ميسرة", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشّرط الجازم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَأَنْ﴾:", "color": "green"}, {"text": "الواو حرف استئناف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\": حرف مصدريّ ونصب مبنيّ على السكون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَصَدَّقُوا﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بحذف النون لأنّه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، والمصدر المؤوّل من \"", "color": "black"}, {"text": "أن تصدقوا", "color": "blue"}, {"text": "\" في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "أي: تصدّقكم خير لكم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ المنسبك من المصدر المؤوّل مرفوع بالضمّة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "اللّام حرف جرّ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "خير", "color": "blue"}, {"text": "\"، وجملة \"", "color": "black"}, {"text": "أن تصدّقوا خير لكم", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم مبنيّ على السكون.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على السكون لاتّصاله بضمير رفع متحرّك في محلّ جزم فعل الشّرط، و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿تَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، لأنّه من الأفعال الخمسة، و\"", "co