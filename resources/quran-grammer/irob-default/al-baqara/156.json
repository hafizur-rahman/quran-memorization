[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ قَالُوا إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ", "color": "brown"}, {"text": "(  البقرة: 156  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبني على الفتح في محلّ نصب صفة لـ\"", "color": "black"}, {"text": "الصابرين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه متضمّن معني الشرط مبني على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَصَابَتْهُمْ﴾:", "color": "green"}, {"text": "أصاب: فعل ماضٍ مبني على الفتح، والتاء حرف للتأنيث حرف مبنيّ على السكون لا محلّ له من الإعراب، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبني على الضمّ في محلّ نصب مفعول به، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجمع.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُصِيبَةٌ﴾:", "color": "green"}, {"text": "فاعل \"", "color": "black"}, {"text": "أصابتهم", "color": "blue"}, {"text": "\" مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الفعلية أصابتهم مصيبة\"", "color": "black"}, {"text": "في محلّ جرّ بإضافة", "color": "blue"}, {"text": "\"إذا\" إليها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الضم لاتصاله بواو الجماعة، وواو الجماعة ضمير متّصل مبني على السكون في محلّ رفع فاعل، والألف للتفريق.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب شرط غير جازم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": 