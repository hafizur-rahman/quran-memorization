[{"row_id": 1, "segments": [{"text": "{ هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَى إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ", "color": "brown"}, {"text": "(  البقرة: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع خبر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "&    وجملة المبتدأ والخبر ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿خَلَقَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "خلق", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور، بمعنى \"", "color": "black"}, {"text": "لأجلكم", "color": "blue"}, {"text": "\"، \n   وجملة \"", "color": "black"}, {"text": "خلق لكم", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول بمعنى \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بصلة الموصول المحذوفة، والتقدير: ما هو كائن في الأرض.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿جَمِيعًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "bl