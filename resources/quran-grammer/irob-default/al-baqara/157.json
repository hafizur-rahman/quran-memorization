[{"row_id": 1, "segments": [{"text": "{ أُولَئِكَ عَلَيْهِمْ صَلَوَاتٌ مِنْ رَبِّهِمْ وَرَحْمَةٌ وَأُولَئِكَ هُمُ الْمُهْتَدُونَ", "color": "brown"}, {"text": "(  البقرة: 157  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أُولَئِكَ﴾:", "color": "green"}, {"text": "أولاء: اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" حرف خطاب مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جرّ مبنيّ على السكون لا محلّ له من الإعراب، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بعلى، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف خبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَلَوَاتٌ﴾:", "color": "green"}, {"text": "مبتدأ ثان مؤخر مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "عليهم صلوات", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ الأول \"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أولئك عليهم صلوات", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "اسم مخفوض بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جره الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "bl