[{"row_id": 1, "segments": [{"text": "{ وَلَوْ أَنَّهُمْ آمَنُوا وَاتَّقَوْا لَمَثُوبَةٌ مِنْ عِنْدِ اللَّهِ خَيْرٌ لَوْ كَانُوا يَعْلَمُونَ", "color": "brown"}, {"text": "(  البقرة: 103  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو حرف استئناف مبنيّ على الفتح لا محلّ له من الإعراب، لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنَّهُمْ﴾:", "color": "green"}, {"text": "أن: حرف توكيد ونصب مشبه بالفعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضمّ في محلّ نصب اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجمع.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضمّ، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية  آمنوا\"", "color": "black"}, {"text": "في محلّ رفع خبر", "color": "blue"}, {"text": "\"إن\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 6, "segments": [{"text": "والمصدر المؤول من \"أن\" واسمها و خبرها في محلّ رفع مبتدأ والخبر محذوف تقديره: ثابت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَاتَّقَوْا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضمّ المقدر على الياء المحذوفة لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتقوا", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" في محلّ رفع.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَمَثُوبَةٌ﴾:", "color": "green"}, {"text": "اللام لام الابتداء حرف مبنيّ على الفتح لا محلّ له من الإعراب، مثوبة: مبتدأ مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "من حرف جرّ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿عِنْدِ﴾:", "color": "green"}, {"text": "اسم مجرور بمن، وهو مضاف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف نعت لـ\"", "color": "black"}, {"text": "مثوبة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مخفوض، وعلامة خفضه الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة المبتدأ والخبر واقعة في جواب قسم محذوف، لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الضمّ لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿يَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة رفعه ثبوت النون لأنَّه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "والجملة \"", "color": "black