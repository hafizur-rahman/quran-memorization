[{"row_id": 1, "segments": [{"text": "{ وَاتَّقُوا يَوْمًا تُرْجَعُونَ فِيهِ إِلَى اللَّهِ ثُمَّ تُوَفَّى كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ", "color": "brown"}, {"text": "(  البقرة: 281  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاتَّقُوا﴾:", "color": "green"}, {"text": "الواو حرف استئناف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "اتّقوا", "color": "blue"}, {"text": "\": فعل أمر مبنيّ على حذف النون لاتّصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَوْمًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتقوا يومًا", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تُرْجَعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النون، لأنّه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِيهِ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على السكون، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "ترجعون", "color": "blue"}, {"text": "\"، وجملة \"", "color": "black"}, {"text": "ترجعون فيه", "color": "blue"}, {"text": "\" في محلّ نصب نعت لـ\"", "color": "black"}, {"text": "يومًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم مخفوض بالكسرة الظاهرة، والخافض والمخفوض متعلّقان بـ\"", "color": "black"}, {"text": "ترجعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُوَفَّى﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بالضمّة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كُلُّ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع بالضمّة الظاهرة، وهو مضاف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿نَفْسٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "توفّى كلّ نفسٍ", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "ترجعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿كَسَبَتْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "كسبَ", "color": "blue"}, {"text": "\": فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هي، والتاء للتأنيث حرف مبنيّ على السكون.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كسبت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو حاليّة حرف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿لَا﴾:", "color": "green