[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ وَيُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ", "color": "brown"}, {"text": "(  البقرة: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ جرّ صفة للمتقين أو في محلّ رفع خبر لمبتدأ محذوف تقديره: هم الذين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب لأنها صلة الموصول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِالْغَيْبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَيُقِيمُونَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الصَّلَاةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمِمَّا﴾:", "color": "green"}, {"text": "الواو حرف استئناف بما: أصلها: من: حرف جرّ، و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" اسم موصول مبنيّ على السكون في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "ينفقون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَزَقْنَاهُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والهاء: ضمير متّصل مبنيّ في محلّ نصب مفعول به، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "رزقناهم", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يُنْفِقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}]