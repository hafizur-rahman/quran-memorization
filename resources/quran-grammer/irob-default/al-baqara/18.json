[{"row_id": 1, "segments": [{"text": "{ صُمٌّ بُكْمٌ عُمْيٌ فَهُمْ لَا يَرْجِعُونَ", "color": "brown"}, {"text": "(  البقرة: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿صُمٌّ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\"، مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بُكْمٌ عُمْيٌ﴾:", "color": "green"}, {"text": "خبران آخران للمبتدأ مرفوعان بالضمة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَهُمْ﴾:", "color": "green"}, {"text": "الفاء حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "هم: ضمير رفع منفصل معطوف على المبتدأ المحذوف \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَرْجِعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون؛ لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "لا يرجعون", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}]