[{"row_id": 1, "segments": [{"text": "{ وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ", "color": "brown"}, {"text": "(  البقرة: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم لاتصاله بواو الجماعة الواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿  وجملة \"", "color": "green"}, {"text": "كفروا", "color": "green"}, {"text": "\" صلة الموصول الاسمي \"", "color": "green"}, {"text": "الذين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "green"}]}, {"row_id": 6, "segments": [{"text": "﴿وَكَذَّبُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "كذبوا: معطوفة على \"", "color": "black"}, {"text": "كفروا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِآيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ \"", "color": "black"}, {"text": "كذبوا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أُولَئِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ ثان.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَصْحَابُ﴾:", "color": "green"}, {"text": "خبر المبتدأ الثاني مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿النَّارِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير متّصل مبنيّ في محلّ رفع مبتدأ، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\" للخطاب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿   والجملة الاسمية \"", "color": "green"}, {"text": "أولئك أصحاب النار", "color": "green"}, {"text": "\" في محلّ رفع خبر المبتدأ الأول الذين\".", "color": "green"}]}, {"row_id": 14, "segments": [{"text": "﴿فِيهَا خَالِدُونَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بخبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "خالدون: خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "هم فيها خالدون", "color": "blue"}, {"text": "\" في محلّ نصب حال، \n   أو في محلّ رفع خبر ثانٍ لِـ\"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": []}]