[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا النَّاسُ اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ وَالَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ", "color": "brown"}, {"text": "(  البقرة: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أيّها: أيّ: منادي مبنيّ على الضمّ في محلّ نصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وها: حرف للتنبيه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّاسُ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "أيّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "&   وجملة النداء ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اعْبُدُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون؛ لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، والألف فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿رَبَّكُمُ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والميم: علامة جمع الذكور.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿   وجملة \"", "color": "green"}, {"text": "اعبدوا ربكم", "color": "green"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنها جواب النداء.", "color": "green"}]}, {"row_id": 12, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب صفة لربكم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿خَلَقَكُمْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح.", "color": "blac