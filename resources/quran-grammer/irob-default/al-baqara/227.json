[{"row_id": 1, "segments": [{"text": "{ وَإِنْ عَزَمُوا الطَّلَاقَ فَإِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ", "color": "brown"}, {"text": "(  البقرة: 227  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح، و \"", "color": "black"}, {"text": "إنْ", "color": "blue"}, {"text": "\" حرف شرط جازم مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَزَمُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتّصاله بواو الجماعة في محلّ جزم فعل الشرط، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الطَّلَاقَ﴾:", "color": "green"}, {"text": "مفعول به منصول بالفتح الظاهر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "عزموا الطلاق", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "فاؤوا", "color": "blue"}, {"text": "\" التي في الآية السابقة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط حرف مبنيّ على الفتح، و \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" حرف توكيد مشبّه بالفعل مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتح الظاهر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿سَمِيعٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلِيمٌ﴾:", "color": "green"}, {"text": "خبر ثانٍ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "