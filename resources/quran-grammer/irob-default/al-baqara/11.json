[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُوا فِي الْأَرْضِ قَالُوا إِنَّمَا نَحْنُ مُصْلِحُونَ", "color": "brown"}, {"text": "(  البقرة: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان خافض لشرطه متعلِّق بجوابه متضمِّن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قِيلَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ للمجهول على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بقيل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تُفْسِدُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بلا وعلامة جزمه حذف النون لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، والألف فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بتفسدوا.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تفسدوا في الأرض", "color": "blue"}, {"text": "\": في محلّ رفع نائب فاعل للفعل \"", "color": "black"}, {"text": "قيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضمّ لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، والألف فارقة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنَّ