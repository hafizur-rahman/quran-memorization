[{"row_id": 1, "segments": [{"text": "{ يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ وَاللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ", "color": "brown"}, {"text": "(  البقرة: 276  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَمْحَقُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الرِّبَا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يمحق الله الرّبا", "color": "blue"}, {"text": "\" اسئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَيُرْبِي﴾:", "color": "green"}, {"text": "الواو حرف عطف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "يُربي", "color": "blue"}, {"text": "\" فعل مضارع مرفوع بالضمة المقدّرة على الياء للثّقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الصَّدَقَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة عوضًا من الفتحة، لأنّه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يربي الصدقات", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "يمحق الله الرّبا", "color": "blue"}, {"text": "\" الاستئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\" لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبني