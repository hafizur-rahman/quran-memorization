[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَ لَهُ رَبُّهُ أَسْلِمْ قَالَ أَسْلَمْتُ لِرَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  البقرة: 131  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف لما مضى من الزمان مبنيّ على السكون في محلّ نصب مفعول به لفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الفتح لا محلّ له من الإعراب، والهاء: ضمير متّصل مبني على الضمّ في محلّ جرّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبُّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة رفعه الضمة الظاهرة، وهو مضاف، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبني على محلّ جرّ مضاف إليه، وجملة \"", "color": "black"}, {"text": "قال له ربه", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه بإضافة \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" إليها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَسْلِمْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أسلمْ", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، الفاعل ضمير مستتر فيه جوازًا، تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَسْلَمْتُ﴾:", "color": "green"}, {"text": "فعل ماض مبني على السكون لاتصاله بضمير رفع متحرك، والتاء ضمير متّصل مبني على الضمّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أسلمت", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لِرَبِّ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الفتح لا محلّ له من الإعراب، رب: اسم مخفوض باللام، وعلامة جره الكسرة الظاهرة، والخافض والمخفوض متعلّقان بالفعل \"", "color": "black"}, {"text": "أسلمت", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "ربّ", "color": "blue"}, {"text": "\" مضاف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة جره الياء؛ لأنَّه جمع مذكر.", "color": "black"}]}]