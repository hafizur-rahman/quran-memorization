[{"row_id": 1, "segments": [{"text": "{ وَعَلَّمَ آدَمَ الْأَسْمَاءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى الْمَلَائِكَةِ فَقَالَ أَنْبِئُونِي بِأَسْمَاءِ هَؤُلَاءِ إِنْ كُنْتُمْ صَادِقِينَ", "color": "brown"}, {"text": "(  البقرة: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَعَلَّمَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "علّم", "color": "blue"}, {"text": "\": فعل ماض مبنيّ على الفتح، وفاعله ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آدَمَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، ولم ينون لأنَّه ممنوع من الصرف للعلميّة ووزن أفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْأَسْمَاءَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كُلَّهَا﴾:", "color": "green"}, {"text": "تو كيد منصوب بالفتحة، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ جرّ بالإضافة .", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿   وجملة \"", "color": "green"}, {"text": "علّم", "color": "green"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَرَضَهُمْ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "علم", "color": "blue"}, {"text": "\"، وتعرب إعرابها، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَلَى الْمَلَائِكَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "عرض", "color": "blue"}, {"text": "\".", "color": "black"}]}, 