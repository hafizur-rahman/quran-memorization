[{"row_id": 1, "segments": [{"text": "{ وَقَاتِلُوهُمْ حَتَّى لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ لِلَّهِ فَإِنِ انْتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ", "color": "brown"}, {"text": "(  البقرة: 193  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَاتِلُوهُمْ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح لا محل له من الإعراب، قاتلوهم: فعل أمر مبني على حذف النون؛ لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل نصب مفعول به، و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجمع.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "قاتلوهم", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "قاتلوا في سبيل الله", "color": "blue"}, {"text": "\" لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وجر مبني على السكون لا محل له من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبني على السكون لا محل له من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَكُونَ﴾:", "color": "green"}, {"text": "فعل مضارع تام منصوب بأن مضمرة بعد حتى، وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِتْنَةٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة والفعل المضارع في تأويل مصدر في محل جر بحتى.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "قاتل