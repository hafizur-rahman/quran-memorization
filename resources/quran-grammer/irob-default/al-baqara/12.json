[{"row_id": 1, "segments": [{"text": "{ أَلَا إِنَّهُمْ هُمُ الْمُفْسِدُونَ وَلَكِنْ لَا يَشْعُرُونَ", "color": "brown"}, {"text": "(  البقرة: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَا﴾:", "color": "green"}, {"text": "حرف استفتاح وتنبيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنَّهُمْ﴾:", "color": "green"}, {"text": "إنّ: حرف مشبّه بالفعل، والهاء: ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، والميم: علامة جمع الذكور.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُمُ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُفْسِدُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" أو خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" إذا اعتبرت \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير فصل، مرفوع بالواو لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿والجملة الاسمية \"", "color": "green"}, {"text": "هم المفسدون", "color": "green"}, {"text": "\" في محلّ رفع خبر \"", "color": "green"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "green"}]}, {"row_id": 7, "segments": [{"text": "﴿ويجوز أن يكون \"", "color": "green"}, {"text": "هم", "color": "green"}, {"text": "\" في محلّ نصب توكيد \"", "color": "green"}, {"text": "هم", "color": "blue"}, {"text": "\" في إنهم و\"", "color": "green"}, {"text": "المفسدون", "color": "blue"}, {"text": "\": خبر \"", "color": "green"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَكِنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لكن: حرف استدراك أو عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text