[{"row_id": 1, "segments": [{"text": "{ وَالَّذِينَ يُؤْمِنُونَ بِمَا أُنْزِلَ إِلَيْكَ وَمَا أُنْزِلَ مِنْ قَبْلِكَ وَبِالْآخِرَةِ هُمْ يُوقِنُونَ", "color": "brown"}, {"text": "(  البقرة: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالَّذِينَ يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الذين يؤمنون: معطوفة على \"", "color": "black"}, {"text": "الذين يؤمنون", "color": "blue"}, {"text": "\" في الآية السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "واعراب الاية السابقة هو :\n«الَّذِينَ: اسم موصول مبنيّ على الفتح في محلّ جرّ صفة للمتقين أو في محلّ رفع خبر لمبتدأ محذوف تقديره: هم الذين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب لأنها صلة الموصول».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جرّ و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول بمعنى \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجارّ والمجرور متعلِّقان بـ\"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أُنْزِلَ﴾:", "color": "green"}, {"text": "فعل ماض للمجهول مبنيّ على الفتح ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنزل", "color": "blue"}, {"text": "\