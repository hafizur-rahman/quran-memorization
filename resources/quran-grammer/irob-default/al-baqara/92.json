[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ جَاءَكُمْ مُوسَى بِالْبَيِّنَاتِ ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِنْ بَعْدِهِ وَأَنْتُمْ ظَالِمُونَ", "color": "brown"}, {"text": "(  البقرة: 92  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو حرف قسم مبنيّ على الفتح، والمقسم به محذوف، والتقدير: والله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف واقع في جواب القسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَاءَكُمْ﴾:", "color": "green"}, {"text": "جاء: فعل ماض مبنيّ على الفتح، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضمّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة رفعه الضمة المقدرة على الألف للتعذر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاءكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب لأنها جواب القسم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِالْبَيِّنَاتِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "البينات: اسم مجرور بالباء، وعلامة جره الكسرة الظاهرة، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "جاءكم", "color": "blue"}, {"text": "\"، أو بمحذوف حال من \"", "color": "black"}, {"text": "موسى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اتَّخَذْتُمُ﴾:", "color": "green"}, {"text": "اتخذ: فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، والتاء ضمير متّصل مبنيّ على الضمّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتخذتم", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "جاءكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْعِجْلَ﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿بَعْدِهِ﴾:", "color": "green"}, {"text": "بعد: اسم مجرور بمن، وعلامة جره الكسرة الظاهرة وهو مضاف، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف حال.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَأَنْتُمْ﴾:", "color": "green"}, {"text": "الواو واو الحال حرف مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "أَنتُمْ: ضمير متّصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿ظَالِمُونَ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع، وعلامة رفعه الواو لأنَّه جمع مذكر سالم والجملة الاسمية و\"", "color": "black"}, {"text": "أنتم ظالمون", "color": "blue"}, {"text": "\" في محلّ نصب حال من\"", "color": "black"}, {"text": "تاء", "color": "blue"}, {"text": "\" الفاعل.", "color": "black"}]}]