[{"row_id": 1, "segments": [{"text": "{ وَلَا تَقُولُوا لِمَنْ يُقْتَلُ فِي سَبِيلِ اللَّهِ أَمْوَاتٌ بَلْ أَحْيَاءٌ وَلَكِنْ لَا تَشْعُرُونَ", "color": "brown"}, {"text": "(  البقرة: 154  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبني على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم مبني على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَقُولُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\" وعلامة جزمه حذف النون لأنَّه من الأفعال الخمسة و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبني على السكون في محلّ رفع فاعل والألف للتفريق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِمَنْ﴾:", "color": "green"}, {"text": "اللام حرف جرّ مبنيّ على الكسر لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ جرّ باللام، والجار والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "تقولوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُقْتَلُ﴾:", "color": "green"}, {"text": "فعل مضارع مبني للمجهول مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ونائب الفاعل ضمير مستتر فيه تقديره: هو، يعود إلى \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "يقتل", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبني على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿سَبِيلِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\"، وعلامة جره الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجار والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "يقتل", "color": "blue"}, {"text": "\" وسبيل: مضاف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مخفوض، وعلامة خفضه الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَمْوَاتٌ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: هم، مرفوع، وعلامة رفعه الضمة الظاهرة، والتقدير: لا تقولوا هم أموات، والجملة \"", "color": "black"}, {"text": "هم أموات", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿بَلْ﴾:", "color": "green"}, {"text": "حرف إضراب وعطف مبني على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿أَحْيَاءٌ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف، والتقدير: بل هم أحياء، مرفوع وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "هم أحياء", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "هم أموات", "color": "blue"}, {"text": "\" في محلّ نصب.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَلَكِن﴾:", "color": "green"}, {"text": "الواو حالية حرف عطف مبني على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "لكن: حرف استدراك مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبني على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿تَشْعُرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة رفعه ثبوت النون لأنَّه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبني على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تشعرون", "color": "blue"}, {"text": "\" في محلّ نصب حال من فاعل \"", "color": "black"}, {"text": "تقولوا", "color": "blue"}, {"text": "\".", "color": "black"}]}]