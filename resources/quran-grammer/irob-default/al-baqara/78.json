[{"row_id": 1, "segments": [{"text": "{ وَمِنْهُمْ أُمِّيُّونَ لَا يَعْلَمُونَ الْكِتَابَ إِلَّا أَمَانِيَّ وَإِنْ هُمْ إِلَّا يَظُنُّونَ", "color": "brown"}, {"text": "(  البقرة: 78  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمِنْهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "منهم: جارّ ومجرور متعلِّقان بخبر مقدم محذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أُمِّيُّونَ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالواو؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": في \"", "color": "black"}, {"text": "منهم", "color": "blue"}, {"text": "\" علامة جمع الذكور.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية لا عمل لها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون؛ لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يعلمون", "color": "blue"}, {"text": "\" في محل رفع صفة للموصوف \"", "color": "black"}, {"text": "أميون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَمَانِيَّ﴾:", "color": "green"}, {"text": "مستثنى منقطع بمعنى: إلّا ما هم عليه من أماني.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿