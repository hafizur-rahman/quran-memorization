[{"row_id": 1, "segments": [{"text": "{ أَوَلَا يَعْلَمُونَ أَنَّ اللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ", "color": "brown"}, {"text": "(  البقرة: 77  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَوَلَا﴾:", "color": "green"}, {"text": "الهمزة حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنَّه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف مشبّه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\" في محل رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أن الله يعلم", "color": "blue"}, {"text": "\" وما بعدها سدَّت مَسَدّ مفعولي \"", "color": "black"}, {"text": "يعلمون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول بمعنى \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب مفعول به للفعل \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يُسِرُّونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يعلمون", "color": "blue"}, {"text": "\" وجملة \"", "color": "black"}, {"text": "يسرون", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والعائد إلى الموصول ضمير محذوف اختصارًا منصوب المحلّ لأنَّه مفعول به، والتقدير: ما يسرونه.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿وَمَا يُعْلِنُونَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما يسرون", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}]