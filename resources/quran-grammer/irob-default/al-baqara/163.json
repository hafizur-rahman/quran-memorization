[{"row_id": 1, "segments": [{"text": "{ وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ", "color": "brown"}, {"text": "(  البقرة: 163  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِلَهُكُمْ﴾:", "color": "green"}, {"text": "الواو حرف استئناف مبنيّ على الفتح لا محلّ له من الإعراب، إلهكم: إله: مبتدأ مرفوع، وعلامة رفعه الضمة الظاهرة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ جرّ مضاف إليه، و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة جمع الذكور.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِلَهٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَاحِدٌ﴾:", "color": "green"}, {"text": "نعت \"", "color": "black"}, {"text": "إله", "color": "blue"}, {"text": "\" مرفوع، وعلامة رفعه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إلهكم إله واحد", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس تعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، حرف مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" النافية للجنس مبنيّ على الفتح في محلّ نصب، والخبر محذوف تقديره: موجود.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ نصب بدل من الضمير المستكن في الخبر المحذوف، أو بدل من محلّ \"", "co