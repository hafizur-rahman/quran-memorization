[{"row_id": 1, "segments": [{"text": "{ وَإِذْ أَخَذْنَا مِيثَاقَ بَنِي إِسْرَائِيلَ لَا تَعْبُدُونَ إِلَّا اللَّهَ وَبِالْوَالِدَيْنِ إِحْسَانًا وَذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَقُولُوا لِلنَّاسِ حُسْنًا وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ ثُمَّ تَوَلَّيْتُمْ إِلَّا قَلِيلًا مِنْكُمْ وَأَنْتُمْ مُعْرِضُونَ", "color": "brown"}, {"text": "(  البقرة: 83  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح، \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" ظرف لما مضى من الزمان متضمّن معنى الشرط، خافض لشرطه متعلِّق", "color": "black"}, {"text": "( أو منصوب )", "color": "green"}, {"text": "بجوابه، وهو في محل نصب مفعول به لفعل محذوف تقديره: اذكروا.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَخَذْنَا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل رفع فاعل، وجملة \"", "color": "black"}, {"text": "أخذنا", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِيثَاقَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة الظاهرة، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَنِي﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء لأنَّه ملحق بجمع المذكر السالم، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِسْرَائِيلَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة عوضًا عن الكسرة لأنَّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبني على السكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَعْبُدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون؛ لأنَّه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تعبدون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنها جواب قسم محذوف دلّ عليه المعنى، وهو قوله: \"", "color": "black"}, {"text": "أخذنا ميثاق", "color": "blue"}, {"text": "\"؛ لأنَّ معناه: أحلفناهم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر مبني على السكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَبِالْوَالِدَيْنِ﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح، \"", "color": "black"}, {"text": "الوالدين", "color": "blue"}, {"text": "\": اسم مجرور بالياء لأنَّه مثنّى، والجارّ والمجرور متعلّقان بفعل محذوف تقديره: أحسنوا، أو استوصوا، أو وَوَصَّيناهم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِحْسَانًا﴾:", "color": "green"}, {"text": "مفعول مطلق إذا قدَّرنا الفعل المحذوف \"", "color": "black"}, {"text": "أحسنوا", "color": "blue"}, {"text": "\"، ومفعول به إذا قدرنا الفعل المحذوف \"", "color": "black"}, {"text": "استوصوا", "color": "blue"}, {"text": "\"، ومفعول لأجله إذا قدرنا الفعل المحذوف \"", "color": "black"}, {"text": "وَوَصَّيناهم", "color": "blue"}, {"text": "\"، وهو في جميع أوجهه منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَذِي﴾:", "color": "green"}, {"text": "الواو حرف عطف مبني على الفتح، \"", "color": "black"}, {"text": "ذي", "color": "blue"}, {"text": "\": اسم معطوف على \"", "color": "black"}, {"text": "الوالدين", "color": "blue"}, {"text": "\" مجرور بالياء لأنَّه من الأسماء الستَّة، وهو مضاف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْقُرْبَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدَّرة عل