[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ بِأَنَّ اللَّهَ نَزَّلَ الْكِتَابَ بِالْحَقِّ وَإِنَّ الَّذِينَ اخْتَلَفُوا فِي الْكِتَابِ لَفِي شِقَاقٍ بَعِيدٍ", "color": "brown"}, {"text": "(  البقرة: 176  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" حرف خطاب مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِأَنَّ﴾:", "color": "green"}, {"text": "الباء حرف جرّ مبنيّ على الكسر لا محلّ له من الإعراب، \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" حرف توكيد ونصب مشبه بالفعل مبنيّ على الفتح الظاهر على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" منصوب، وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَزَّلَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح الظاهر على آخره، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، يعود إلى \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نزل الكتاب", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والمصدر المؤول \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" واسمها وخبرها في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والج