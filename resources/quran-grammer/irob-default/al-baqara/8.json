[{"row_id": 1, "segments": [{"text": "{ وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ وَبِالْيَوْمِ الْآخِرِ وَمَا هُمْ بِمُؤْمِنِينَ", "color": "brown"}, {"text": "(  البقرة: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمِنَ النَّاسِ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من الناس: جارّ ومجرور متعلِّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول بمعنى \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَقُولُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، وفاعله ضمير مستتر فيه جوازًا.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقول", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آمَنَّا بِاللَّهِ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرِّك و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل وجملة \"", "color": "black"}, {"text": "آمنا", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" \nبالله: الباء: حرف جرّ ولفظ الجلالة \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\": اسم مخفوض بالباء وعلامة خفضه الكسرة الظاهرة، والخافض والمخفوض متعلّقان بآمنا.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَبِالْيَوْمِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "باليوم: جارّ ومجرور متعلِّقان بآمنا.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْآخِرِ﴾:", "color": "green"}, {"text": "نعت لليوم مجرورة، وعلامة جرّه الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حالية، و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف نفي لا عمل لها عند بني تميم، وهي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" عند الحجازيين.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ في محلّ رفع مبتدأ، أو في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بِمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "الباء حرف جرّ زائد لتأكيد معنى النفي.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "مؤمنين: اسم مجرور لفظًا، وعلامة جرّه الياء؛ لأنَّه جمع مذكر سالم، منصوب محلًّا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "ما هم بمؤمنين", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}]