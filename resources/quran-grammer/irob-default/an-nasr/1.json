[{"row_id": 1, "segments": [{"text": "سورة النصر\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ", "color": "brown"}, {"text": "(  النصر: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان مبنيّ على السكون في محلّ نصب مفعول فيه متضمن معنى الشرط خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَصْرُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالْفَتْحُ﴾:", "color": "green"}, {"text": "معطوف بالواو على \"", "color": "black"}, {"text": "نصر الله", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاء", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]