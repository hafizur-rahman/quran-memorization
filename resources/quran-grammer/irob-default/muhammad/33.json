[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الَّذِينَ آمَنُوا أَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ وَلَا تُبْطِلُوا أَعْمَالَكُم", "color": "brown"}, {"text": "(  محمد: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا الَّذِينَ آمَنُوا﴾:", "color": "green"}, {"text": "سبق إعرابها في الآية السابعة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « يَاأَيُّهَا: يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أيها: منادى مبني على الضم في محل نصب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وها\": زائدة للتنبيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبني على الفتح في محلّ نصب بدل من \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" أو عطف بيان لـ \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"الألف : فارقة».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَطِيعُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ رفع فاعل و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَأَطِيعُوا الرَّسُولَ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "أطيعوا الله", "color": "blu