[{"row_id": 1, "segments": [{"text": "{ وَلَنَبْلُوَنَّكُمْ حَتَّى نَعْلَمَ الْمُجَاهِدِينَ مِنْكُمْ وَالصَّابِرِينَ وَنَبْلُوَ أَخْبَارَكُمْ", "color": "brown"}, {"text": "(  محمد: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَنَبْلُوَنَّكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: لام التوكيد أو واقعة في جواب قسم محذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نبلو﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\" للتوكيد، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَعْلَمَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة وما بعدها بتأويل مصدر في محلّ جرّ بـ\"", "color": "black"}, {"text": "حتى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلقان بـ\"", "color": "black"}, {"text": "نبلو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمُجَاهِدِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مِنْكُمْ﴾:", "c