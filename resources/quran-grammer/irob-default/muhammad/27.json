[{"row_id": 1, "segments": [{"text": "{ فَكَيْفَ إِذَا تَوَفَّتْهُمُ الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ", "color": "brown"}, {"text": "(  محمد: 27  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكَيْفَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كيف: اسم استفهام مبنيّ على الفتح في محلّ نصب حال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَوَفَّتْهُمُ﴾:", "color": "green"}, {"text": "توفى: فعل ماض مبنيّ على الفتح المقدر على الألف المحذوفة لاتصاله بـ\"", "color": "black"}, {"text": "تاء", "color": "blue"}, {"text": "\" التأنيث، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ مفعول به مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمَلَائِكَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَضْرِبُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وُجُوهَهُمْ﴾:", "color": "green"}, {"text": "وجوه: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَأَدْبَارَهُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "وجوههم", "color": "blue"}, {"tex