[{"row_id": 1, "segments": [{"text": "{ إِنَّكَ لَا تُسْمِعُ الْمَوْتَى وَلَا تُسْمِعُ الصُّمَّ الدُّعَاءَ إِذَا وَلَّوْا مُدْبِرِينَ", "color": "brown"}, {"text": "(  النمل: 80  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّكَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "إنك", "color": "blue"}, {"text": "\" في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "إِنَّكَ: إن: حرف توكيد مشبّه بالفعل.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُسْمِعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمَوْتَى﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "{ وَلَا تُسْمِعُ الصُّمَّ }", "color": "brown"}]}, {"row_id": 9, "segments": [{"text": ": معطوفة بالواو على \"", "color": "black"}, {"text": "لا تسمع الموتى", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الدُّعَاءَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَلَّوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدّر على الألف المحذوفة لاتصاله بواو الجماعة.", "color": "blac