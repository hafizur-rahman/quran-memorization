[{"row_id": 1, "segments": [{"text": "{ وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَسَاءَ مَطَرُ الْمُنْذَرِينَ", "color": "brown"}, {"text": "(  النمل: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة سبق إعرابها في سورة الشعراء في الآية الثالثة والسبعين بعد المئة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: «وَأَمْطَرْنَا: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أمطر: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أمطرنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَطَرًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَسَاءَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ساء: فعل ماضٍ مبنيّ على الفتح لإنشاء الذم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَطَرُ﴾:", "color": "green"}, {"text": "فاعل \"", "color": "black"}, {"text": "ساء", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمُنْذَرِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أمطرنا", "color": "blue"}, {"text": "\" ل