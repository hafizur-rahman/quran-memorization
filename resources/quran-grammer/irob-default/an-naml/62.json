[{"row_id": 1, "segments": [{"text": "{ أَمَّنْ يُجِيبُ الْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ السُّوءَ وَيَجْعَلُكُمْ خُلَفَاءَ الْأَرْضِ أَإِلَهٌ مَعَ اللَّهِ قَلِيلًا مَا تَذَكَّرُونَ", "color": "brown"}, {"text": "(  النمل: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمَّنْ﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و الآية 60 وهو: «  أَمَّنْ: أصلها \"", "color": "black"}, {"text": "أم", "color": "blue"}, {"text": "\": حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محلّ رفع معطوف على \"", "color": "black"}, {"text": "لفظ الجلالة", "color": "blue"}, {"text": "\" في الآية الكريمة 59 وخبره \"", "color": "black"}, {"text": "خير", "color": "blue"}, {"text": "\"\nيُجِيبُ: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُضْطَرَّ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿دَعَاهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "{ وَيَكْشِفُ السُّوءَ وَيَجْعَلُكُمْ }", "color": "brown"}]}, {"row_id": 9, "segments": [{"text": ": الجملتان معطوفتان على \"", "color": "black"}, {"text": "يجيب المضطر", "color": "blue"}, {"text": "\" وتعربان إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿خُلَفَاءَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْأَرْضِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "{ أَإِلَهٌ مَعَ اللَّهِ }", "color": "brown"}]}, {"row_id": 14, "segments": [{"text": ": سبق إعرابها في الآية الستين.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وهو: « أَإِلَهٌ: الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "إله: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿مَعَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بخبر المبتدأ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "صفة نائبة المفعول المطلق التقدير: تذكرًا قليلًا.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "زائدة مهملة.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿تَذَكَّرُونَ﴾:", "color": "green"}, {"text": "أصلها: تتذكرون.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من يجيب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 2