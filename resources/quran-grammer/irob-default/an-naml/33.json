[{"row_id": 1, "segments": [{"text": "{ قَالُوا نَحْنُ أُولُو قُوَّةٍ وَأُولُو بَأْسٍ شَدِيدٍ وَالْأَمْرُ إِلَيْكِ فَانْظُرِي مَاذَا تَأْمُرِينَ", "color": "brown"}, {"text": "(  النمل: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أُولُو﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "نحن", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قُوَّةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَأُولُو بَأْسٍ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "أولو قوة", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿شَدِيدٍ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "بأس", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَالْأَمْرُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "الأمر: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَيْكِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 12, "s