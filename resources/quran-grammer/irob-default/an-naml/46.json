[{"row_id": 1, "segments": [{"text": "{ قَالَ يَاقَوْمِ لِمَ تَسْتَعْجِلُونَ بِالسَّيِّئَةِ قَبْلَ الْحَسَنَةِ لَوْلَا تَسْتَغْفِرُونَ اللَّهَ لَعَلَّكُمْ تُرْحَمُونَ", "color": "brown"}, {"text": "(  النمل: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قوم: منادى منصوب بالفتحة المقدّرة على ما قبل الياء المحذوفة منع من ظهورها اشتغال المحل بالحركة المناسبة، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة: ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِمَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ، و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم استفهام مبنيّ على السكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "تستعجلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَسْتَعْجِلُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِالسَّيِّئَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تستعجلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَبْلَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة، وهو مضاف متعلّق بـ\"", "color": "black"}, {"text": "تستعجلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْحَسَنَةِ﴾:", "color": "green"}, {"te