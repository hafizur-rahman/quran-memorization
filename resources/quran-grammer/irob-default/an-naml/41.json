[{"row_id": 1, "segments": [{"text": "{ قَالَ نَكِّرُوا لَهَا عَرْشَهَا نَنْظُرْ أَتَهْتَدِي أَمْ تَكُونُ مِنَ الَّذِينَ لَا يَهْتَدُونَ", "color": "brown"}, {"text": "(  النمل: 41  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نَكِّرُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نكروا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَرْشَهَا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَنْظُرْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون، وهو جواب الأمر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَتَهْتَدِي﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "تهتدي: فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]},