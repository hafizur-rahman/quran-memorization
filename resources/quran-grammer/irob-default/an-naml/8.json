[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا جَاءَهَا نُودِيَ أَنْ بُورِكَ مَنْ فِي النَّارِ وَمَنْ حَوْلَهَا وَسُبْحَانَ اللَّهِ رَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  النمل: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: اسم شرط غير جازم مبني على السكون في محل نصب مفعول فيه متعلقة بالجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَهَا﴾:", "color": "green"}, {"text": "جاء: فعل ماض مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نُودِيَ﴾:", "color": "green"}, {"text": "فعل ماض مبني للمجهول على الفتح، ونائب الفاعل ضمير مستتر فيه جوازا تقديره: \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" عائدة إلى الجملة \"", "color": "black"}, {"text": "بورك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف تفسير.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بُورِكَ﴾:", "color": "green"}, {"text": "فعل ماض للمجهول مبني على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَن﴾:", "color": "green"}, {"text": "اسم موصول مبني على السكون في محل رفع نائب فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي النَّار﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بصلة الموصول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَنْ حَوْلَهَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "من: معطوفة على \"", "color": "black"}, {"text": "من في النار", "color": "blue"}, {"text": "\" وتعرب إ