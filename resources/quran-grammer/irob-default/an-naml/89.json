[{"row_id": 1, "segments": [{"text": "{ مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَهُمْ مِنْ فَزَعٍ يَوْمَئِذٍ آمِنُونَ", "color": "brown"}, {"text": "(  النمل: 89  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ فعل الشّرط، مبنيّ على الفتح في محلّ جزم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِالْحَسَنَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "جاء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَلَهُ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشّرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "له: جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "خير", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "هم: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنْ فَزَعٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "آمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 13, "