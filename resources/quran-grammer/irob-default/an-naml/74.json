[{"row_id": 1, "segments": [{"text": "{ وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ", "color": "brown"}, {"text": "(  النمل: 74  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنَّ رَبَّكَ﴾:", "color": "green"}, {"text": "معطوفة على الآية السابقة وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: « وَإِنَّ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبَّكَ﴾:", "color": "green"}, {"text": "رب: اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَيَعْلَمُ﴾:", "color": "green"}, {"text": "اللام: لام الابتداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "يعلم: فعل مضارع مرفوع بالضمة والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تُكِنُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿صُدُورُهُمْ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ما: سبق إعرابها.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يُعْلِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"tex