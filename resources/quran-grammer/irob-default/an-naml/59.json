[{"row_id": 1, "segments": [{"text": "{ قُلِ الْحَمْدُ لِلَّهِ وَسَلَامٌ عَلَى عِبَادِهِ الَّذِينَ اصْطَفَى آللَّهُ خَيْرٌ أَمَّا يُشْرِكُونَ", "color": "brown"}, {"text": "(  النمل: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون وحرك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْحَمْدُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "{ وَسَلَامٌ عَلَى عِبَادِهِ }", "color": "brown"}]}, {"row_id": 7, "segments": [{"text": ": معطوفة على \"", "color": "black"}, {"text": "الحمد لله", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ جرّ صفة لـ\"", "color": "black"}, {"text": "عباده", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اصْطَفَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿آللَّهُ﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "الله: لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلا