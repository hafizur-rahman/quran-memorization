[{"row_id": 1, "segments": [{"text": "وَتَفَقَّدَ الطَّيْرَ فَقَالَ مَا لِيَ لَا أَرَى الْهُدْهُدَ أَمْ كَانَ مِنَ الْغَائِبِينَ", "color": "black"}, {"text": "(  النمل: 20  )", "color": "green"}, {"text": "}", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿وَتَفَقَّدَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تفقد: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الطَّيْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَقَالَ﴾:", "color": "green"}, {"text": "معطوفة بالفاء على \"", "color": "black"}, {"text": "تفقد", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا لِيَ﴾:", "color": "green"}, {"text": "ما: اسم استفهام مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لي: جارّ ومجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَرَى﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْهُدْهُدَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح، واسمها ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مِنَ الْغَائِبِينَ﴾:", "color": "green"}, {"text": "جارّ ومج