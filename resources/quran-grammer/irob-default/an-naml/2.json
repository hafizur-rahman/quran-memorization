[{"row_id": 1, "segments": [{"text": "{ هُدًى وَبُشْرَى لِلْمُؤْمِنِينَ", "color": "brown"}, {"text": "(  النمل: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هُدًى﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة المقدرة على الألف للتعذر (ويجوز أن تكون خبرًا لمبتدأ محذوف تقديره: \"", "color": "black"}, {"text": "هي هدى", "color": "blue"}, {"text": "\"، أو بدلًا من آيات القرآن، أو خبرًا ثانيًا للمبتدأ \"", "color": "black"}, {"text": "تلك", "color": "blue"}, {"text": "\" في الآية الأولى.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَبُشْرَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "بشرى: معطوفة بالواو على \"", "color": "black"}, {"text": "هدي", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلْمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "هدي", "color": "blue"}, {"text": "\"و\"", "color": "black"}, {"text": "بشرى", "color": "blue"}, {"text": "\" أو بصفة محذوفة من \"", "color": "black"}, {"text": "بشري", "color": "blue"}, {"text": "\"، والمؤمنين: اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}]