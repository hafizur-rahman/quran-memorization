[{"row_id": 1, "segments": [{"text": "{ وَمَا أَنْتَ بِهَادِي الْعُمْيِ عَنْ ضَلَالَتِهِمْ إِنْ تُسْمِعُ إِلَّا مَنْ يُؤْمِنُ بِآيَاتِنَا فَهُمْ مُسْلِمُونَ", "color": "brown"}, {"text": "(  النمل: 81  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نافية بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" بلغة الحجاز ونافية لا عمل لها بلغة نجد وبني تميم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى وفي محلّ رفع مبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِهَادِي﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "هادي: اسم مجرور لفظًا منصوب محلًا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "أو مرفوع محلًا على أنه خبر المبتدأ \"", "color": "black"}, {"text": "أنت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْعُمْيِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَنْ ضَلَالَتِهِمْ﴾:", "color": "green"}, {"text": "جارّ مجرور متعلّقان باسم الفاعل \"", "color": "black"}, {"text": "هادي", "color": "blue"}, {"text": "\" أو بفعله و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تُسْمِعُ﴾:", "color": "green"}, {"text": "ف