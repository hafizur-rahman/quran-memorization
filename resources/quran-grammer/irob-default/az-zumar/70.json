ck"}]}, {"row_id": 13, "segments": [{"text": "ما: حرف مصدري.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يَفْعَلُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": وما تلاها: بتأويل مصدر في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "أعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ما عملت", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به بحذف مضاف أي جزاء عملها.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ما يفعلون", "color": "blue"}, {"text": "\" في محلّ جرّ بالباء متعلّق بأعلم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وفيت كل نفس", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "قضي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "عملت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو أعلم", "color": "blue"}, {"text": "\" لا محلّ لها استئنافيّة.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يفعلون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الثاني.", "color": "black"}]}]