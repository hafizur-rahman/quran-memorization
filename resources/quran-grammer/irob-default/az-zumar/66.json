[{"row_id": 1, "segments": [{"text": "{ بَلِ اللَّهَ فَاعْبُدْ وَكُنْ مِنَ الشَّاكِرِينَ", "color": "brown"}, {"text": "(  الزمر: 66  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَلِ﴾:", "color": "green"}, {"text": "حرف إضراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مفعول به منصوب بالفتحة بفعل محذوف تقديره: أعبد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَاعْبُدْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "اعبد: فعل أمر مبنيّ على السكون، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَكُنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "كن: فعل أمر ناقص مبنيّ على السكون واسمها ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ الشَّاكِرِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كن", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعبد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على استئنافية مقدرة، أي تنبه فاعبد الله.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كن من الشاكرين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "اعبد", "color": "blue"}, {"text": "\".", "color": "black"}]}]