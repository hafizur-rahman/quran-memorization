[{"row_id": 1, "segments": [{"text": "{ أَنْ تَقُولَ نَفْسٌ يَاحَسْرَتَا عَلَى مَا فَرَّطْتُ فِي جَنْبِ اللَّهِ وَإِنْ كُنْتُ لَمِنَ السَّاخِرِينَ", "color": "brown"}, {"text": "(  الزمر: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري ونصب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَقُولَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَفْسٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَاحَسْرَتَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "حسرتا: منادي منصوب بالفتحة، والألف المنقلبة عن ياء المتكلم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف مصدري.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَرَّطْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": وما تلاها بتأويل مصدر في محلّ جرّ بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، و \"الجارّ والمجرور متعلّقان بحسرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِي جَنْبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "فرطت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"tex