[{"row_id": 1, "segments": [{"text": "سُورةُ الزُّمَر\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْحَكِيمِ", "color": "brown"}, {"text": "(  الزمر: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تَنْزِيلُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أو هو خبر مبتدأ محذوف تقديره: هذا تنزيل الكتاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بخبر المبتدأ \"", "color": "black"}, {"text": "تنزيل", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( على إعراب الوجه الأول )", "color": "green"}, {"text": "، أو يكون الخافض والمخفوض متعلّقان بالتنزيل", "color": "black"}, {"text": "( على إعراب الوجه الثاني )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْعَزِيزِ الْحَكِيمِ﴾:", "color": "green"}, {"text": "نعتان للفظ الجلالة مجروران بالكسرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ويجوز أن يكون \"", "color": "black"}, {"text": "الحكيم", "color": "blue"}, {"text": "\" صفة للعزيز.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "تنزيل الكتاب من الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها ابتدائية.", "color": "black"}]}]