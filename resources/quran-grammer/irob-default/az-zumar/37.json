[{"row_id": 1, "segments": [{"text": "{ وَمَنْ يَهْدِ اللَّهُ فَمَا لَهُ مِنْ مُضِلٍّ أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ", "color": "brown"}, {"text": "(  الزمر: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية أعربت في الآيتين الكريمتين الثالثة والعشرين والسادسة والثلاثين.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « وَمَنْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يُضْلِلِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره وحُرِّك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿هَادٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا مبتدأ مؤخر والحركة مقدرة على الياء المحذوفة».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿« أَلَيْسَ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "ليس: فعل ماضٍ ناقص.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: اسم \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿بِكَافٍ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد للتأكيد، كافٍ: اسم مجرور لفظًا منصوب محلًا، لأنه خبر \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" والحركة مقدّرة على الياء المحذوفة».", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿ذِي﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "عزيز", "color": "blue"}, {"text": "\" مجرور بالياء، لأنه من الأسماء الخمسة، وهو مضاف.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿انْتِقَامٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من يهد الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يضلل الله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما له من مضل", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشرط مقترنة بالفاء.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أليس الله بعزيز", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]