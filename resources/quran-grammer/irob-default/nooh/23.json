[{"row_id": 1, "segments": [{"text": "{ وَقَالُوا لَا تَذَرُنَّ آلِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا", "color": "brown"}, {"text": "(  نوح: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قالوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل بني في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "&لَا حرف نهي وجزم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَذَرُنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ في محلّ جزم لاتصاله بنون التوكيد؛ لأنَّه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\" نون التوكيد الثقيلة حرف لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آلِهَتَكُمْ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا تَذَرُنَّ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "لا تذرن", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَدًّا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الف