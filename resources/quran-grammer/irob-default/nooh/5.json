[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ إِنِّي دَعَوْتُ قَوْمِي لَيْلًا وَنَهَارًا", "color": "brown"}, {"text": "(  نوح: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ رَبِّ إِنِّي﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "قال يا قوم إني", "color": "blue"}, {"text": "\" الواردة في الآية الثانية من هذه السورة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « قَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قوم: منادي منصوب بالفتحة المقدرة على آخره منع من ظهورها اشتغال المحل بالحركة المناسبة \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" التي هي ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "حرف نصب توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿و \"", "color": "green"}, {"text": "رب", "color": "green"}, {"text": "\": منادي بحرف نداء محذوف.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "﴿دَعَوْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَوْمِي﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على آخره منع من ظهورها اشتغال المحلّ بالحركة المناسبة لياء المتكلم، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَيْلًا﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ \"", "color": "black"}, {"text": "دعوت", "color": "blue"}, {"text": "\"، وعلامة نصبه بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَنَهَارًا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ليلا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة النداء لا محلّ لها من الإعراب؛ لأنّها اعتراضية.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إني دعوت", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "دعوت", "color": "blue"}, {"text": "\" في محلّ رفع خبر\"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": []}]