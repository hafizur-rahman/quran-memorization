[{"row_id": 1, "segments": [{"text": "{ وَقَالَ نُوحٌ رَبِّ لَا تَذَرْ عَلَى الْأَرْضِ مِنَ الْكَافِرِينَ دَيَّارًا", "color": "brown"}, {"text": "(  نوح: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالَ نُوحٌ رَبِّ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية الحادية والعشرين، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "قَالَ: فعل ماضٍ مبنيّ على الفتح", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نوح﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿«", "color": "green"}, {"text": "يَاقَوْمِ﴾:", "color": "blue"}, {"text": "يا: حرف نداء.", "color": "green"}]}, {"row_id": 6, "segments": [{"text": "قوم: منادي منصوب بالفتحة المقدرة على آخره منع من ظهورها اشتغال المحل بالحركة المناسبة \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" التي هي ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "رب", "color": "blue"}, {"text": "\": منادي بحرف نداء محذوف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا تَذَرْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "لا تزد", "color": "blue"}, {"text": "\" في الآية الرابعة والعشرين.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وهو « لا: حرف للدعاء بصيغة النهي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تَزِدِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون وقد حرك بالكسر الالتقاء الساكنين.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿عَلَى الْأَرْضِ﴾:", "color": "gre