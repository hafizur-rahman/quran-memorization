[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ", "color": "brown"}, {"text": "(  الملك: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف للابتداء والتوكيد أو لام القسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَذَّبَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ قَبْلِهِمْ﴾:", "color": "green"}, {"text": "من قبل: جارّ ومجرور متعلّقان بصلة الموصول المحذوفة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَكَيْفَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "كيف: اسم استفهام مبنيّ على الفتح في محلّ نصب خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿نَكِيرِ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" المؤخر مرفوع بالضمة المقدرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة لـ \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة التي هي ضمير متّصل ـ مبنيّ في محلّ