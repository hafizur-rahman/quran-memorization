[{"row_id": 1, "segments": [{"text": "{ أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ", "color": "brown"}, {"text": "(  الملك: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَأَمِنْتُمْ﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أمنتم: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": لجمع الذكور.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي السَّمَاءِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بصلة الموصول المحذوفة بمعنى: من تزعمون أنه كائن في السماء، وهو متعال عن المكان.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَخْسِفَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ نصب بدل اشتمال من الاسم الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بِكُمُ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يخسف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْأَرْضَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "إذا: حرف فجاءة لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿هِيَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿تَمُورُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أمنتم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة يخسف\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي", "color": "blue"}, {"text": "\"أن\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"هي تمور\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب؛ لأنّها معطوفة على الاستئنافية.", "color": "blue"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"تمور\"", "color": "black"}, {"text": "في محلّ رفع خبر المبتدأ", "color": "blue"}, {"text": "\"هي\".", "color": "black"}]}]