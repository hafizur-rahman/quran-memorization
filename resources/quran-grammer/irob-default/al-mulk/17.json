[{"row_id": 1, "segments": [{"text": "{  أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا:", "color": "brown"}, {"text": "(  الملك: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا﴾:", "color": "green"}, {"text": "أم: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وما بعده: معطوف على الآية السابقة، ويعرب إعرابها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو « أمنتم: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": لجمع الذكور.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي السَّمَاءِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بصلة الموصول المحذوفة بمعنى: من تزعمون أنه كائن في السماء، وهو متعال عن المكان.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَخْسِفَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ نصب بدل اشتمال من الاسم الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِكُمُ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يخسف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْأَرْضَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿فَسَتَعْلَمُونَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والسين: حرف استقبال.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "تعلمون: فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿كَيْفَ﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على الفتح في محلّ رفع خبر مقدم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿نَذِيرِ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالضمة المقدرة على ما قبل \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" منع من ظهورها اشتغال المحل بالحركة المناسبة للياء، التي هي ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أمنتم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يرسل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يرسل", "color": "blue"}, {"text": "\" في محلّ نصب بدل اشتمال من الموصول الثاني \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ستعلمون", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن جاءكم