[{"row_id": 1, "segments": [{"text": "{ خَلَقَ الْإِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِ", "color": "brown"}, {"text": "(  الرحمن: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿خَلَقَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْإِنْسَانَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ صَلْصَالٍ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال محذوفة من \"", "color": "black"}, {"text": "الإنسان", "color": "blue"}, {"text": "\"، والتقدير: خلق الإنسان حالة كونه من صلصال، أي: الذي هو صلصال.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَالْفَخَّارِ﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ للتشبيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الفخار: اسم مجرور بالكاف وعلامة جره الكسرة، والجار والمجرور متعلقان بمفعول مطلق محذوف تقديره: خلقًا كالفخار أو تكون الكاف اسمًا بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" في محلّ جرّ صفة لـ \"", "color": "black"}, {"text": "لصلصال", "color": "blue"}, {"text": "\"، هو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والفخار: مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلق الإنسان", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها استئنافية.", "color": "black"}]}]