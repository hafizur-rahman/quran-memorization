[{"row_id": 1, "segments": [{"text": "{ فَإِذَا انْشَقَّتِ السَّمَاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ", "color": "brown"}, {"text": "(  الرحمن: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن مبنيّ على السكون محلّ نصب مفعول فيه خافض لشرطه متعلّق بجوابه متضمن معنى الشرط.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿انْشَقَّتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السكون، وقد حُرّك بالكسرة لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿السَّمَاءُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَكَانَتْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "كانت: فعل ماض مبنيّ على الفتح، واسمها ضمير مستتر فيه جوازًا تقديره: هي، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَرْدَةً﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَالدِّهَانِ﴾:", "color": "green"}, {"text": "الكاف اسم بمعنى: \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبني على الفتح في محلّ نصب صفة نعت لـ\"", "color": "black"}, {"text": "وردة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "الدهان", "color": "blue"}, {"text": "\" مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، أو تكون الكاف حرف جرّ للتشبيه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجارّ والمجرور متعلّقان بصفة لـ\"", "color": "black"}, {"text": "وردة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "انشقت السماء", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كانت", "color": "blue"}, {"text": "\" في محلّ جرّ معطوفة على جملة انشقت وجواب الشرط محذوف تقديره: رأيت أمرًا هائلًا.", "color": "black"}]}]