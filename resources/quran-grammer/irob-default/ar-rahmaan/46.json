[{"row_id": 1, "segments": [{"text": "{ وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ", "color": "brown"}, {"text": "(  الرحمن: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلِمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "واللام: حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَافَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَقَامَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿رَبِّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿جَنَّتَانِ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالألف؛ لأنَّه مثنى.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لمن خاف مقام ربه جنتان", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خاف", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}]