[{"row_id": 1, "segments": [{"text": "{ فِيهِنَّ قَاصِرَاتُ الطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنْسٌ قَبْلَهُمْ وَلَا جَانٌّ", "color": "brown"}, {"text": "(  الرحمن: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فِيهِنَّ﴾:", "color": "green"}, {"text": "في: حرف جر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "هن", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَاصِرَاتُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الطَّرْفِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَطْمِثْهُنَّ﴾:", "color": "green"}, {"text": "يطمث: فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، علامة جزمه سكون آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "هن", "color": "blue"}, {"text": "\": ضمير متّصل مبني على الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": لجمع الإناث.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنْسٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿قَبْلَهُمْ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "يطمث", "color": "blue"}, {"text": "\".",