[{"row_id": 1, "segments": [{"text": "{ بَلِ الْإِنْسَانُ عَلَى نَفْسِهِ بَصِيرَةٌ", "color": "brown"}, {"text": "(  القيامة: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَلِ﴾:", "color": "green"}, {"text": "حرف إضراب مبنيّ على السّكون، وكسر آخره منعًا لالتقاء السَّاكِنَيْن.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْإِنْسَانُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَى نَفْسِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "بصيرة", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَصِيرَةٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة الإنسان على نفسه بصيرة\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة.", "color": "black"}]}]