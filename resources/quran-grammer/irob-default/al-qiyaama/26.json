[{"row_id": 1, "segments": [{"text": "{ كَلَّا إِذَا بَلَغَتِ التَّرَاقِيَ", "color": "brown"}, {"text": "(  القيامة: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَلَّا﴾:", "color": "green"}, {"text": "حرف ردع وزجر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرفٌ لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه مبنيّ على السّكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَلَغَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السّكون، وحُركت بالكسر منعًا لالتقاء السَّاكِنَيْن، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿التَّرَاقِيَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بلغت", "color": "blue"}, {"text": "\" في محلّ جرّ مضافٌ إليه.", "color": "black"}]}]