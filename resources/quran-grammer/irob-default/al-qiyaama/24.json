[{"row_id": 1, "segments": [{"text": "{ وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ", "color": "brown"}, {"text": "(  القيامة: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَوُجُوهٌ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية الثانية والعشرين، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «  وُجُوهٌ: مبتدأ مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "يقول", "color": "blue"}, {"text": "\"، هو مضافٌ، و\"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" اسم مبنيّ على السّكون، وقد حرّك بالكسر تخلصًا من التقاء السَّاكِنَيْن", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ مضافٌ إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ نَاضِرَةٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع بالضمّة».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة وجوه يومئذ باسرة\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة", "color": "black"}]}]