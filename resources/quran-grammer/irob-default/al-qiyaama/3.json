[{"row_id": 1, "segments": [{"text": "{ أَيَحْسَبُ الْإِنْسَانُ أَلَّنْ نَجْمَعَ عِظَامَهُ", "color": "brown"}, {"text": "(  القيامة: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَيَحْسَبُ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يحسب: فعل مضارع مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْإِنْسَانُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَلَّنْ﴾:", "color": "green"}, {"text": "أصلها أن أدغمت في \"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\" مخفّفة بين حرفين عاملين ألغت أحدهما، أو تكون هو \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المخففة من\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" الثقيلة حرف توكيد مشبّه بالفعل، واسمها ضمير شأن محذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" واسمها و خبرها في محلّ نصب بتأويل مصدر سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "يحسب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لن: حرف نفي واستقبال.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَجْمَعَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\" وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عِظَامَهُ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يحسب الإنس