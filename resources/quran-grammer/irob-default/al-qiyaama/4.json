[{"row_id": 1, "segments": [{"text": "{ بَلَى قَادِرِينَ عَلَى أَنْ نُسَوِّيَ بَنَانَهُ", "color": "brown"}, {"text": "(  القيامة: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَلَى﴾:", "color": "green"}, {"text": "حرف جواب لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَادِرِينَ﴾:", "color": "green"}, {"text": "حال من الضمير في \"", "color": "black"}, {"text": "نجمع", "color": "blue"}, {"text": "\" منصوب بالياء؛ لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نُسَوِّيَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\"، وعلامة نصبه بالفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قادرين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَنَانَهُ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نسوي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}]