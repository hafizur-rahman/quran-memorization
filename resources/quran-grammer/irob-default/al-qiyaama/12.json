[{"row_id": 1, "segments": [{"text": "{ إِلَى رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ", "color": "brown"}, {"text": "(  القيامة: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَى رَبِّكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "أعربت في الآية العاشرة من هذه السورة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو «", "color": "black"}, {"text": "يَوْمَئِذٍ: يوم: ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "blue"}, {"text": "يقول", "color": "blue"}, {"text": "\"، هو مضافٌ، و\"", "color": "blue"}, {"text": "إذ", "color": "blue"}, {"text": "\" اسم مبنيّ على السّكون، وقد حرّك بالكسر تخلصًا من التقاء السَّاكِنَيْن", "color": "blue"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ مضافٌ إليه", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إلى ربك المستقر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمُسْتَقَرُّ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}]