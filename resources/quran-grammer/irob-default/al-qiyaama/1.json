[{"row_id": 1, "segments": [{"text": "سُورَةُ القِيَامَة\nترتيبها 75 آياتها 40 مكية\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ", "color": "brown"}, {"text": "(  القيامة: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف زائد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أُقْسِمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِيَوْمِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "يوم: اسم مجرور بالكسرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "أقسم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْقِيَامَةِ﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور بالكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها ابتدائية.", "color": "black"}]}]