[{"row_id": 1, "segments": [{"text": "{ كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ", "color": "brown"}, {"text": "(  القيامة: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَلَّا﴾:", "color": "green"}, {"text": "حرف ردع وزجر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بَلْ﴾:", "color": "green"}, {"text": "حرف إضراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُحِبُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْعَاجِلَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تحبون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]