[{"row_id": 1, "segments": [{"text": "{ كِتَابٌ مَرْقُومٌ", "color": "brown"}, {"text": "(  المطففين: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية التاسعة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: \n« كِتَابٌ: خبر المبتدأ محذوف تقديره: هو كتاب، مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَرْقُومٌ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "كتاب", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "هو كتاب", "color": "blue"}, {"text": "\" تفسيرية لا محلّ لها من الإعراب، أو يكون التقدير: ذلك الكتاب كتاب مكتوب».", "color": "black"}]}]