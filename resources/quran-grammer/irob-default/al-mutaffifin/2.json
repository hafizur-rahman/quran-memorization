[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ إِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَ", "color": "brown"}, {"text": "(  المطففين: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ صفة لـ\"", "color": "black"}, {"text": "المطففين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه، متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اكْتَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَى النَّاسِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يستوفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَسْتَوْفُونَ﴾:", "color": "green"}, {"text": "فعل مضارع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، والجملة \"", "color": "black"}, {"text": "يستوفون", "color": "blue"}, {"text": "\" جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اكتالوا", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة الشرطية من الفعل وجوابه لا محلّ لها من الإعراب، لأنّها صلة الموصول.", "color": "black"}]}]