[{"row_id": 1, "segments": [{"text": "{ خِتَامُهُ مِسْكٌ وَفِي ذَلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُونَ", "color": "brown"}, {"text": "(  المطففين: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿خِتَامُهُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مِسْكٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة الاسمية في محلّ جرّ صفة ثانية لـ\"", "color": "black"}, {"text": "رحيق", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَفِي﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "في: حرف جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "يتنافس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَلْيَتَنَافَسِ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "واللام: لام الأمر حرف جزم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "يتنافس: فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لام", "color": "blue"}, {"text": "\" الأمر، وعلامة جزمه السكون، وقد حُرِّك بالكسر منعا لالت