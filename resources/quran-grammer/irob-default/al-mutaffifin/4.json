[{"row_id": 1, "segments": [{"text": "{ أَلَا يَظُنُّ أُولَئِكَ أَنَّهُمْ مَبْعُوثُونَ", "color": "brown"}, {"text": "(  المطففين: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\": حرف نفي لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَظُنُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أُولَئِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على الكسر في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف خطاب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنَّهُمْ﴾:", "color": "green"}, {"text": "أن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَبْعُوثُونَ﴾:", "color": "green"}, {"text": "خبرها مرفوع بالواو، لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" وما بعدها من اسمها وخبرها بتأويل مصدر سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "يظن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يظن", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]