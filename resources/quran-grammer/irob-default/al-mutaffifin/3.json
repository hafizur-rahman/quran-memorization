[{"row_id": 1, "segments": [{"text": "{ وَإِذَا كَالُوهُمْ أَوْ وَزَنُوهُمْ يُخْسِرُونَ", "color": "brown"}, {"text": "(  المطففين: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "معطوفة بحرف الواو على الآية الكريمة السابقة،   وتعرب إعرابها، وهو : \n« إِذَا: ظرف لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه، متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اكْتَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَوْ وَزَنُوهُمْ﴾:", "color": "green"}, {"text": "معطوفة بـ\"", "color": "black"}, {"text": "أو", "color": "blue"}, {"text": "\" على \"", "color": "black"}, {"text": "كالوهم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}]