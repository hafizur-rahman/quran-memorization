[{"row_id": 1, "segments": [{"text": "{ إِذَا تُتْلَى عَلَيْهِ آيَاتُنَا قَالَ أَسَاطِيرُ الْأَوَّلِينَ", "color": "brown"}, {"text": "(  المطففين: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه، متضمن معني الشرط مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تُتْلَى﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تتلي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿آيَاتُنَا﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تتلي", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَسَاطِيرُ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: تلك أساطير، أو هي أساطير، وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَوَّلِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تلك أساطير", "color": "blue"}, {"text": "\" في محلّ نصب \