[{"row_id": 1, "segments": [{"text": "{ وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ", "color": "brown"}, {"text": "(  المطففين: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيْلٌ﴾:", "color": "green"}, {"text": "تعرب إعراب الآية الأولى.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : \n«", "color": "black"}, {"text": "وَيْلٌ : مبتدأ مرفوع بالضمة", "color": "blue"}, {"text": "»", "color": "black"}, {"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون وحُرِّك بالكسر تخلص من التقاء الساكنين:", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ مضاف إليه، وهو مضاف أيضا والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلْمُكَذِّبِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "ويل", "color": "blue"}, {"text": "\" المحذوف، وعلامة جره \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ويل يومئذٍ للمكذبين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]