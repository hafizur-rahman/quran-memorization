[{"row_id": 1, "segments": [{"text": "سُورَةُ المُطَفِّفِينَ\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَيْلٌ لِلْمُطَفِّفِينَ", "color": "brown"}, {"text": "(  المطففين: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيْلٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِلْمُطَفِّفِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالخبر المحذوف، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة الاستئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]