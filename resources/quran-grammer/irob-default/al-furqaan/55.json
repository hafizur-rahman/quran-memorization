[{"row_id": 1, "segments": [{"text": "وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُهُمْ وَلَا يَضُرُّهُمْ وَكَانَ الْكَافِرُ عَلَى رَبِّهِ ظَهِيرًا}", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُهُمْ وَلَا يَضُرُّهُمْ: هذه الآية أعربت في الآية الثامنة عشرة من سورة يونس.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: \n« وَيَعْبُدُونَ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "يعبدون: فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ دُونِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بمحذوف حال من فاعل \"", "color": "black"}, {"text": "يعبدون", "color": "blue"}, {"text": "\"، أي: متجاوزين الله.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا يَضُرُّهُمْ﴾:", "color": "green"}, {"text": "لا يضرّ: مثل \"", "color": "black"}, {"text": "لا يفلح", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مفعول به، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَنْفَعُهُمْ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يضرهم", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَكَانَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "كان: فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 13, "segments": [{"text"