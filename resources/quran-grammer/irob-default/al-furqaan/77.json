[{"row_id": 1, "segments": [{"text": "{ قُلْ مَا يَعْبَأُ بِكُمْ رَبِّي لَوْلَا دُعَاؤُكُمْ فَقَدْ كَذَّبْتُمْ فَسَوْفَ يَكُونُ لِزَامًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "قُلْ: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف استفهام مبنيّ على السكون في محلّ نصب مفعول به على المصدر تقديره، أي: عبء يعبأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَعْبَأُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يعبأ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّي﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدّرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَوْلَا﴾:", "color": "green"}, {"text": "حرف امتناع.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿دُعَاؤُكُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وخبره محذوف وجوبًا تقديره: لو عبادتكم موجودة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَقَدْ﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب الشرط.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿