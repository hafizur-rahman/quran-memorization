[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا مِنَ الْمُجْرِمِينَ وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَكَذَلِكَ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الكاف: بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ رفع مبتدأ وخبره الجملة الفعلية \"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\" أو في محلّ نصب صفة لمفعول مطلق محذوف تقديره: مثل ذلك الجعل جعلنا).", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿جَعَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِكُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿نَبِيٍّ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَدُوًّا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنَ الْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة محذوفة لـ\"", "color": "black"}, {"text": "عدرا", "color": "blue"}, {"text": "\".", "col