[{"row_id": 1, "segments": [{"text": "{ قُلْ أَذَلِكَ خَيْرٌ أَمْ جَنَّةُ الْخُلْدِ الَّتِي وُعِدَ الْمُتَّقُونَ كَانَتْ لَهُمْ جَزَاءً وَمَصِيرًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "قُلْ: فعل أمر مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَذَلِكَ﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿جَنَّةُ﴾:", "color": "green"}, {"text": "معطوفة على المبتدأ مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْخُلْدِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة وحذف خبر \"", "color": "black"}, {"text": "جنة", "color": "blue"}, {"text": "\" لأن ما قبله يدل عليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الَّتِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "جنة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وُعِدَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْمُتَّقُونَ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع بالواو، لأنه ج