[{"row_id": 1, "segments": [{"text": "{ فَلَا تُطِعِ الْكَافِرِينَ وَجَاهِدْهُمْ بِهِ جِهَادًا كَبِيرًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "فَلَا: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُطِعِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم وحرك بالكسر منعًا لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكَافِرِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَجَاهِدْهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "جاهد: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "جاهدهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿جِهَادًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَبِيرًا﴾:", "color": "green"}, {"text": "صفة لجهاد منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تطع", "color": "blue"}, {"text": "\" جواب الشرط مقدر أي إن أرسلناك إلى الناس كافة فلا \"", "color": "black"}, {"text": "تطع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاهدهم", "color": "blue"}, {"text": "\" معطوفة على جملة لا \"", "color": "black"}, {"text": "تطع", "col