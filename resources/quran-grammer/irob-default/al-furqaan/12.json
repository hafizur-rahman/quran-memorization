[{"row_id": 1, "segments": [{"text": "{ إِذَا رَأَتْهُمْ مِنْ مَكَانٍ بَعِيدٍ سَمِعُوا لَهَا تَغَيُّظًا وَزَفِيرًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "إِذَا: ظرف لما يستقبل من الزمان مبنيّ على السكون في محلّ نصب مفعول به متعلّق بجوابه بعد الظرف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَأَتْهُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتحة المقدرة على الألف منع من ظهورها التعذر المحذوفة لاتصاله بـ\"", "color": "black"}, {"text": "تاء", "color": "blue"}, {"text": "\" التأنيث.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": للتأنيث.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ مَكَانٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَعِيدٍ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "مكان", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿سمعوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "سمعوا", "color": "blue"}, {"text": "\".", "color": "b