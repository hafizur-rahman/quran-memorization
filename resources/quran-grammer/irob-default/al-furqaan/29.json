[{"row_id": 1, "segments": [{"text": "{ لَقَدْ أَضَلَّنِي عَنِ الذِّكْرِ بَعْدَ إِذْ جَاءَنِي وَكَانَ الشَّيْطَانُ لِلْإِنْسَانِ خَذُولًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "لَقَدْ: اللام: واقعة في جواب قسم مقدر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَضَلَّنِي﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للوقاية.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عن الذكر﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أضلني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَعْدَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "أضلني", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "اسم مبنيّ على السكون في محلّ جرّ بالإضافة، وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿جَاءَنِي﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "أضلني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَكَانَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "كان: فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الشَّيْطَانُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخ