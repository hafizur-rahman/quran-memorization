[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ صَرَّفْنَاهُ بَيْنَهُمْ لِيَذَّكَّرُوا فَأَبَى أَكْثَرُ النَّاسِ إِلَّا كُفُورًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَلَقَدْ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: للابتداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَرَّفْنَاهُ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَيْنَهُمْ﴾:", "color": "green"}, {"text": "ظرف مكان متعلّق بـ\"", "color": "black"}, {"text": "صرفناه", "color": "blue"}, {"text": "\" منصوب بالفتحة وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لِيَذَّكَّرُوا﴾:", "color": "green"}, {"text": "اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "يذكروا: أصلها يتذكروا: فعل مضارع منصوب بحذف النون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة المصدرية وما بعدها: بتأويل مصدر في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "صرفناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿فَأَبَى﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "أبى: فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿أَكْثَرُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿النَّاسِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿كُفُورًا﴾:", "color": "green"}, {"text": "مفعول لأجله منصوب بالفتحة.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "ويجوز أن تكون \"", "color": "black"}, {"text": "كفورًا", "color": "blue"}, {"text": "\" مفعولًا به.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "صرفناه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يذكروا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أبى أكثر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة جواب القسم.", "color": "black"}]}]