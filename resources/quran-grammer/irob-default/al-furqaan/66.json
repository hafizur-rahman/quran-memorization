[{"row_id": 1, "segments": [{"text": "{ إِنَّهَا سَاءَتْ مُسْتَقَرًّا وَمُقَامًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "إِنَّهَا: إن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿سَاءَتْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": للتأنيث.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وفاعل \"", "color": "black"}, {"text": "ساءت", "color": "blue"}, {"text": "\" ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُسْتَقَرًّا﴾:", "color": "green"}, {"text": "تمييز أو حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَمُقَامًا﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "مستقرًا", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنها ساءت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تعليل آخر لصرف العذاب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ساءت", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}]