[{"row_id": 1, "segments": [{"text": "{ وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ", "color": "brown"}, {"text": "(  الحجر: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم مبنيّ على السكون في محلّ نصب مفعول به بفعل مضمر تقديره: اذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "فاعل مرفوع للتعظيم بالضمة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِلْمَلَائِكَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال ربك ,,,", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، والياء: ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿خَالِقٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بَشَرًا﴾:", "color": "green"}, {"text": "مفعول به لاسم الفاعل \"", "color": "black"}, {"text": "خالق", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّي ,,,", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ﴾:", "color": "green"}, {"text": "أعربت وشرحت في الآية الكريمة السادسة والعشرين.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وهو:\n « مِنْ صَلْصَالٍ مِنْ حَمَإٍ}", "color": "black"}]}, {"row_id": 15, "segments": [{"text": ": اسمان مجروران بحرفي جرّ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مَسْنُونٍ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "حمأ", "color": "blue"}, {"text": "\" مجرور الكسرة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجار والمجرور متعلّقان بحال محذوفة، أي خلقناه في حال كونه من طين أسود على هيئة إنسان».", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وإذ قال ربك", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]