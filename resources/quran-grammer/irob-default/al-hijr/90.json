[{"row_id": 1, "segments": [{"text": "{ كَمَا أَنْزَلْنَا عَلَى الْمُقْتَسِمِينَ", "color": "brown"}, {"text": "(  الحجر: 90  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كما﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب مفعول به بفعل مضمر يفسره المذكور بعده.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: اسم موصول مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أنزلنا﴾:", "color": "green"}, {"text": "أنزل: فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنزلنا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿على المقتسمين﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أنزلنا", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنه جمع مذكر سالم.", "color": "black"}]}]