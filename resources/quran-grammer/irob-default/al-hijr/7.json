[{"row_id": 1, "segments": [{"text": "{ لَوْمَا تَأْتِينَا بِالْمَلَائِكَةِ إِنْ كُنْتَ مِنَ الصَّادِقِينَ", "color": "brown"}, {"text": "(  الحجر: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَوْمَا﴾:", "color": "green"}, {"text": "حرف تحضيض لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَأْتِينَا﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِالْمَلَائِكَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تأتي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لو ما تأتينا ..", "color": "blue"}]}, {"row_id": 6, "segments": [{"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كُنْتَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، والتاء: ضمير متّصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنَ الصَّادِقِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "خبر", "color": "blue"}, {"text": "\"كان\"", "color": "black"}, {"text": "، وعلامة جرّ الاسم الياء، لأنه جمع مذكر سالم، و", "color": "blue"}, {"text": "\"كان\"", "color": "black"}, {"text": "فعل الشرط في محلّ جزم بـ", "color": "blue"}, {"text": "\"أن\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجواب الشرط محذوف لتقدم معناه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "بمعنى هلا تأتينا بالملائكة يشهدون بصدقك.", "color": "black"}]}]