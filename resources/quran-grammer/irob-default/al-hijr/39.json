[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ بِمَا أَغْوَيْتَنِي لأُزَيِّنَنَّ لَهُمْ فِي الْأَرْضِ وَلأُغْوِيَنَّهُمْ أَجْمَعِينَ", "color": "brown"}, {"text": "(  الحجر: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ رَبِّ﴾:", "color": "green"}, {"text": "أعربت في الآية الكريمة السادسة والثلاثين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: « قَالَ: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى منصوب للتعظيم بالفتحة المقدّرة على ما قبل ياء المتكلم المحذوفة منع من ظهورها اشتغال المحل بحركة الياء وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ما: حرف مصدري.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَغْوَيْتَنِي﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والتاء: ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والنون: للوقاية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والياء: ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها: بتأويل مصدر في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أغويتني", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "ما", "color": "blue"}, {