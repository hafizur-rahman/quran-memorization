[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ جَعَلُوا الْقُرْآنَ عِضِينَ", "color": "brown"}, {"text": "(  الحجر: 91  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الذين﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ جرّ نعت لـ \"", "color": "black"}, {"text": "المقسمين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جعلوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿القرآن﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جعلوا القرآن", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عضين﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}]