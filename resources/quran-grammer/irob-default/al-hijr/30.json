[{"row_id": 1, "segments": [{"text": "{ فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ", "color": "brown"}, {"text": "(  الحجر: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَسَجَدَ﴾:", "color": "green"}, {"text": "الفاء: سببية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "سجد: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ الْمَلَائِكَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كُلُّهُمْ﴾:", "color": "green"}, {"text": "توكيد مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَجْمَعُونَ﴾:", "color": "green"}, {"text": "توكيد ثاني مرفوع بالواو، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قسد", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]