[{"row_id": 1, "segments": [{"text": "{ وَمَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ", "color": "brown"}, {"text": "(  الحجر: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَأْتِيهِمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَسُولٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظ مرفوع محلًا لأنه فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وما يأتيهم", "color": "blue"}, {"text": "\" حكاية حال ماضية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة بعدها في محلّ نصب حال.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الضم، والواو ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كانوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يستهزئون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يَسْتَهْزِئُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والواو ضمير متّصل