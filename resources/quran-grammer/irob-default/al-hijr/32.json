[{"row_id": 1, "segments": [{"text": "{ قَالَ يَاإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ السَّاجِدِينَ", "color": "brown"}, {"text": "(  الحجر: 32  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال ,,,", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَاإِبْلِيسُ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "إبليس: منادى مبنيّ على الضم في محلّ نصب بفعل محذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَلَّا﴾:", "color": "green"}, {"text": "أي: في ألَّا بحذف حرف الجر وأن مدغمة بـ \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لَا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تَكُونَ مَعَ السَّاجِدِينَ﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وهو \n«يَكُونَ: فعل مضارع ناقص منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يكون مع خبرها", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية لا محلّ له