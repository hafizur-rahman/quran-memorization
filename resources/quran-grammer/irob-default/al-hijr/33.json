[{"row_id": 1, "segments": [{"text": "{ قَالَ لَمْ أَكُنْ لِأَسْجُدَ لِبَشَرٍ خَلَقْتَهُ مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ", "color": "brown"}, {"text": "(  الحجر: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\" وعلامة جزمه السكون وحذفت واوه لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "واسمها ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِأَسْجُدَ﴾:", "color": "green"}, {"text": "اللام: لام الجحود حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "أسجد: فعل مضارع منصوب بأن مضمرة بعد اللام وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة بعد اللام وما بعدها: بتأويل مصدر في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجار والمجرور متعلّقان بخبر \"", "color": "black"}, {"text": "أكن", "color": "blue"}, {"text": "\" المحذوف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "التقدير: لم أكن مريدًا للسجود.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أسجد", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية المضمرة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لم أكن ,,,", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿لِبَشَرٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أسجد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿خَلَقْتَهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والتاء: ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلقته", "color": "blue"}, {"text": "\" في محلّ جرّ نعت لـ \"", "color": "black"}, {"text": "بشر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ﴾:", "color": "green"}, {"text": "أعربت وشرحت في الآية الكريمة السادسة والعشرين.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وهو: \n« مِنْ صَلْصَالٍ مِنْ حَمَإٍ}", "color": "black"}]}, {"row_id": 22, "segments": [{"text": ": اسمان مجروران بحرفي جرّ.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿مَسْنُونٍ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "حمأ", "color": "blue"}, {"text": "\" مجرور الكسرة.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "والجار والمجرور متعلّقان بحال محذوفة، أي خلقناه في حال كونه من طين أسود على هيئة إنسان».", "color": "black"}]}]