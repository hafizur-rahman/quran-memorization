[{"row_id": 1, "segments": [{"text": "{ رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ", "color": "brown"}, {"text": "(  الحجر: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رُبَمَا﴾:", "color": "green"}, {"text": "ربّ: حرف جرّ بطل عمله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف زائد وكاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوَدُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كفروا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف للتمني لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مُسْلِمِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "ولو وما بعدها: بتأويل مصدر في محلّ نصب مفعول به للفعل \"", "color": "black"}, {"text": "يود", "color": "blue"}, {"text": "\"، والتقدير: يود الكافرون كونهم مسلمين.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ربّما يوَدّ", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب، وجملة \"", "color": "black"}, {"text": "كفروا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كانوا مسلمين", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\" المصدرية لا محلّ لها من الإعراب.", "color": "black"}]}]