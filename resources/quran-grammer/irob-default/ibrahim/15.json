[{"row_id": 1, "segments": [{"text": "{ وَاسْتَفْتَحُوا وَخَابَ كُلُّ جَبَّارٍ عَنِيدٍ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَاسْتَفْتَحُوا: الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "استفتحوا", "color": "blue"}, {"text": "\": فعل ماض مبنيّ على الضمّ لاتّصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة من الفعل والفاعل استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَخَابَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "خاب", "color": "blue"}, {"text": "\": فعل ماض مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كُلُّ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة من الفعل والفاعل معطوفة على الجملة \"", "color": "black"}, {"text": "استفتحوا", "color": "blue"}, {"text": "\" الاستئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿جَبَّارٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَنِيدٍ﴾:", "color": "green"}, {"text": "نعت للاسم \"", "color": "black"}, {"text": "جبّار", "color": "blue"}, {"text": "\" مجرور بالكسرة الظّاهرة.", "color": "black"}]}]