[{"row_id": 1, "segments": [{"text": "{ وَقَالَ مُوسَى إِنْ تَكْفُرُوا أَنْتُمْ وَمَنْ فِي الْأَرْضِ جَمِيعًا فَإِنَّ اللَّهَ لَغَنِيٌّ حَمِيدٌ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَقَالَ: الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\": فعل ماض مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بضمّة مقدّرة على الألف منع من ظهورها التعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَكْفُرُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنّه فعل الشرط وعلامة جزمه حذف النوّن، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على السّكون في محلّ رفع توكيد للواو في \"", "color": "black"}, {"text": "تكفروا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السّكون في محلّ رفع معطوف على الواو في \"", "color": "black"}, {"text": "تكفروا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَرْضِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\"، وعلامة جرّه الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بمحذوف صلة الموصول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿جَمِيعًا﴾:", "color": "green"}, {"text": "حال منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب الشّرط حرف مبنيّ على الفتح، \"", "color": "black"}, {"text": "إنَّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "حرف توكيد مشبّه بالفعل مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿لَغَنِيٌّ﴾:", "color": "green"}, {"text": "اللّام هي اللّام المزحلقة حرف توكيد مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "\"", "color": "black"}, {"text": "غني", "color": "blue"}, {"text": "\": خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "إنّ الله لغنيٌّ", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشّرط.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿حَمِيد﴾:", "color": "green"}, {"text": "نعت مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "والجملة من الشّرط وجوابه في محلّ نصب مفعول به، لأنّها \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]