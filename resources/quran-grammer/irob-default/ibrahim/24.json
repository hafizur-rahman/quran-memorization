[{"row_id": 1, "segments": [{"text": "{ أَلَمْ تَرَ كَيْفَ ضَرَبَ اللَّهُ مَثَلًا كَلِمَةً طَيِّبَةً كَشَجَرَةٍ طَيِّبَةٍ أَصْلُهَا ثَابِتٌ وَفَرْعُهَا فِي السَّمَاءِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "أَلَمْ: الهمزة: حرف استفهام يتضمن معنى التقرير مبنيّ على الفتح، \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\": حرف جزم ونفي وقلب مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَرَ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\" وعلامة جزمه حذف حرف العلة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَيْفَ﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على الفتح في محل نصب حال.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ضَرَبَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة في محلّ نصب سدّت مسدّ مفعولي \"", "color": "black"}, {"text": "تَر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَثَلًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كَلِمَةً﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "مثلًا", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿طَيِّبَةً﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "كلمة", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segme