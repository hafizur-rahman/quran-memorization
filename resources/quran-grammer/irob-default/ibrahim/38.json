[{"row_id": 1, "segments": [{"text": "{ رَبَّنَا إِنَّكَ تَعْلَمُ مَا نُخْفِي وَمَا نُعْلِنُ وَمَا يَخْفَى عَلَى اللَّهِ مِنْ شَيْءٍ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "رَبَّنَا: \"", "color": "black"}, {"text": "ربّ", "color": "blue"}, {"text": "\": منادى منصوب على أنه مفعول به فعل النّداء المحذوف تقديره:", "color": "black"}, {"text": "(  إبراهيم: أنادي  )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّكَ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\": حرف توكيد مشبّه بالفعل مبنيّ على الفتح، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمّة الظّاهرة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة من الفعل والفاعل في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نُخْفِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمّة الظّاهرة، وفاعله ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة من الفعل والفاعل صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، و \"", "color": "black"},