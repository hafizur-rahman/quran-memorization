[{"row_id": 1, "segments": [{"text": "سورة إبراهيم\nبسم الله الرحمن الرحيم", "color": "black"}, {"text": "{ الر كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ لِتُخْرِجَ النَّاسَ مِنَ الظُّلُمَاتِ إِلَى النُّورِ بِإِذْنِ رَبِّهِمْ إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "الر: خبر لمبتدأ محذوف في محلّ رفع والتقدير", "color": "black"}, {"text": "(  إبراهيم: هذه آلر  )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كِتَابٌ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف مرفوع بالضمّة الظّاهرة، والتقدير:", "color": "black"}, {"text": "( هذا كتاب )", "color": "green"}, {"text": "، والجملة من المبتدأ وخبره استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْزَلْنَاهُ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "أَنْزَلَ", "color": "blue"}, {"text": "\": فعل ماضٍ مبنيّ على السّكون لاتّصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مبنيّ على الضم في محلّ نصب مفعول به، والجملة \"", "color": "black"}, {"text": "أنزلناه", "color": "blue"}, {"text": "\" من الفعل والفاعل في محلّ رفع نعت لِـ \"", "color": "black"}, {"text": "كتاب", "color": "blue"}, {"text": "\"، أي:", "color": "black"}, {"text": "( هذا كتاب منزل )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "إلى: حرف جرّ مبنيّ على السّكون، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\"، والجار والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "أنزلناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِتُخْرِجَ﴾:", "color": "green"}, {"text": "اللّام: حرف جرّ وتعليل ينصب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة مبنيّ على الكسر، \"", "color": "black"}, {"text": "تُخرج", "color": "blue"}, {"text": "\": فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\": مضمرة بعد لام التّعليل وعلامة نصبه الفتحة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت، والمصدر المؤوّل من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة والفعل \"", "color": "black"}, {"text": "تخرج", "color": "blue"}, {"text": "\" في محلّ جرّ باللام، والتقدير", "color": "black"}, {"text": "( لإخراج النّاس )", "color": "green"}, {"text": "، والجار والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "أنزلناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿النَّاسَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون وحرّك بالفتح منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الظُّلُمَاتِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "تخرج", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿النُّور﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "تخرج", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بِإِذْنِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر، \"", "color": "black"}, {"text": "إِذْنِ", "color": "blue"}, {"text": "\": اسم مجرور بالباء وعلامة جرّه الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بمحذوف حال من النّاس", "color": "black"}, {"text": "( أي: مأذونًا لهم )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "رَبِّ", "color": "blue"}, {"text": "\": مضاف إليه مجرور بالكسرة الظاهرة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة\nإِلَى: حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿صِرَاطِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\" وعلامة جره الكسرة، والجارّ والمجرور بدل من قوله \"", "color": "black"}, {"text": "إلى النور", "color": "blue"}, {"text": "\" بإعادة حرف الجرّ", "color": "black"}, {"text": "( أي إلى النّور الذي هو صراط العزيز الحميد )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الْعَزِيزِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿الْحَمِيدِ﴾:", "color": "green"}, {"text": "نعت لِـ \"", "color": "black"}, {"text": "العزيز", "color": "blue"}, {"text": "\" مجرور بالكسرة الظّاهرة.", "color": "black"}]}]