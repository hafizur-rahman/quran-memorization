[{"row_id": 1, "segments": [{"text": "{ وَمَثَلُ كَلِمَةٍ خَبِيثَةٍ كَشَجَرَةٍ خَبِيثَةٍ اجْتُثَّتْ مِنْ فَوْقِ الْأَرْضِ مَا لَهَا مِنْ قَرَارٍ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَمَثَلُ: الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "مثلُ", "color": "blue"}, {"text": "\": مبتدأ مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿كَلِمَةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَبِيثَةٍ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "كلمة", "color": "blue"}, {"text": "\" مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَشَجَرَةٍ﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ مبنيّ على الفتح، \"", "color": "black"}, {"text": "شجرة", "color": "blue"}, {"text": "\": اسم مجرور بالكاف، وعلامة جرّه الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بمحذوف خبر، والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَبِيثَةٍ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "كلمة", "color": "blue"}, {"text": "\" مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اجْتُثَّتْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ للمجهول مبنيّ على الفتح، والتّاء: حرف تأنيث مبنيّ على السّكون، ونائب الفاعل في محلّ جرّ نعت ثانٍ لـ\"", "color": "black"}, {"text": "شجرة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَوْق﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "اجتثّت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_