[{"row_id": 1, "segments": [{"text": "{ وَقَدْ مَكَرُوا مَكْرَهُمْ وَعِنْدَ اللَّهِ مَكْرُهُمْ وَإِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَقَدْ: الواو: حرف استئناف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "\"", "color": "black"}, {"text": "قد", "color": "blue"}, {"text": "\": حرف تحقيق مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَكَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتّصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَكْرَهُمْ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَعِنْدَ﴾:", "color": "green"}, {"text": "الواو: حالية حرف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "\"", "color": "black"}, {"text": "عِنْدَ", "color": "blue"}, {"text": "\": ظرف مكان متعلق بمحذوف خبر مقدّم والتقدير:", "color": "black"}, {"text": "(  إبراهيم: مكرهم موجود عندَ الله  )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَكْرُهُمْ﴾:", "color": "green"}, {"text": "مبتدأ مؤخّر مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة، والجملة من المبتدأ والخبر في محلّ نصب حال.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَإِنْ﴾:", "colo