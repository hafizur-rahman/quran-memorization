[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ يَسْتَحِبُّونَ الْحَيَاةَ الدُّنْيَا عَلَى الْآخِرَةِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا أُولَئِكَ فِي ضَلَالٍ بَعِيدٍ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "الَّذِينَ: اسم موصول مبنيّ على السّكون في محلّ جرّ نعت \"", "color": "black"}, {"text": "الكافرين", "color": "blue"}, {"text": "\" في الآية السّابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَسْتَحِبُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة من الفعل والفاعل صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْحَيَاةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الدُّنْيَا﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "الحياة", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدّرة على الألف منع من ظهورها التعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْآخِرَةِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظاهرة، والجارّ والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "يستحبون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَيَصُدُّونَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "يصدون", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بثبوت النّون، لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة معطوفة على الجملة \"", "color": "black"}, {"text": "يستحبون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}