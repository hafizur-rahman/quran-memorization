[{"row_id": 1, "segments": [{"text": "{ أَلَمْ تَرَ إِلَى الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا وَأَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "أَلَمْ: الهمزة: حرف للاستفهام التعجّبيّ مبنيّ على الفتح، \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\": حرف جزم ونفي وقلب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَرَ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلّة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت، والجملة من الفعل والفاعل استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "تر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَدَّلُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضمّ لاتّصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة من الفعل والفاعل لا محلّ لها من الإعراب، لأنّها صلة الموصول.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نِعْمَتَ﴾:", "color": "green"}, {"text": "مفعول به أوّل لـ \"", "color": "black"}, {"text": "بذلوا", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كُفْرًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ لـ \"", "color": "black"}, {"text": "بدل", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَأَحَلُّوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "أحلوا", "color": "blue"}, {"text": "\": فعل ماض مبنيّ على الضمّ لاتّصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة \"", "color": "black"}, {"text": "أحلُّوا", "color": "blue"}, {"text": "\" من الفعل والفاعل معطوفة على الجملة \"", "color": "black"}, {"text": "بدّلوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿قَوْمَهُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "قَوْمَ", "color": "blue"}, {"text": "\": مفعول به أول منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿دَارَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْبَوَارِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}]