[{"row_id": 1, "segments": [{"text": "{ وَتَرَى الْمُجْرِمِينَ يَوْمَئِذٍ مُقَرَّنِينَ فِي الْأَصْفَادِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَتَرَى: الواو: حرف استئناف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "\"", "color": "black"}, {"text": "تَرَى", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بضمّة مقدّرة منع من ظهورها التعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة من الفعل والفاعل استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "يوم", "color": "blue"}, {"text": "\": ظرف زمان متعلّق بـ\"", "color": "black"}, {"text": "ترى", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُقَرَّنِينَ﴾:", "color": "green"}, {"text": "حال من \"", "color": "black"}, {"text": "المجرمين", "color": "blue"}, {"text": "\" منصوب بالياء، لأنّه جمع مذكّر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْأَصْفَادِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "مقرنين", "color": "blue"}, {"text": "\".", "color": "black"}]}]