[{"row_id": 1, "segments": [{"text": "{ هَذَا بَلَاغٌ لِلنَّاسِ وَلِيُنْذَرُوا بِهِ وَلِيَعْلَمُوا أَنَّمَا هُوَ إِلَهٌ وَاحِدٌ وَلِيَذَّكَّرَ أُولُو الْأَلْبَابِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "هَذَا: الهاء: للتنبيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَلَاغٌ﴾:", "color": "green"}, {"text": "خبر مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِلنَّاسِ﴾:", "color": "green"}, {"text": "اللّام حرف جرّ مبنيّ على الكسر، و \"", "color": "black"}, {"text": "النّاس", "color": "blue"}, {"text": "\": اسم مجرور باللّام وعلامة جرّه الكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف صفة لـ\"", "color": "black"}, {"text": "بلاغ", "color": "blue"}, {"text": "\"، أي:", "color": "black"}, {"text": "(  إبراهيم: هذا بلاغ مخصّص للنّاس  )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلِيُنْذَرُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "واللّام: حرف جرّ وتعليل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "ينذروا", "color": "blue"}, {"text": "\": فعل مضارع مبنيّ للمجهول منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة بعد لام التّعليل، وعلامة نصبه حذف النّون لأنّه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السّكون في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" والفعل في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وشبه الجملة معطوف على شبه الجملة \"", "color": "black"}, {"text": "للناس", "color": "blue"}, {"text": "\" في محلّ رفع.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والتّقدير:", "color": "black"}, {"text": "( هذا بلاغ مخصص للناس للإنذار )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والجارّ والمجرور متعلّقان \"", "color": "black"}, {"text": "ينذروا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿وَلِيَعْلَمُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "واللّام: حرف تعليل وجرّ مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "\"", "color": "black"}, {"text": "يعلموا", "color": "blue"}, {"text": "\": فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\" مضمرة بعد لام التّعليل وعلامة نصبه حذف النّون، لأنه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "والواو ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، والمصدر المؤول من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة والفعل في محلّ جرّ باللّام.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وشبه الجملة معطوفة على شبه الجملة \"", "color": "black"}, {"text": "للنّاس", "color": "blue"}, {"text": "\" في محلّ رفع.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿أَنَّمَا﴾:", "color": "green"}, {"text": "كافّة ومكفوفة", "color": "black"}, {"text": "( حرف توكيد مشبّه بالفعل كفته \"", "color": "green"}, {"text": "ما", "color": "blue"}, {"text": "\" عن طلب اسم منصوب وخبر مرفوع )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿إِلَهٌ﴾:", "color": "green"}, {"text": "خبر مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "والجملة في محلّ نصب سدّت مسدّ مفعولي \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 25, "segments": [{"text": "﴿وَاحِدٌ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "إله", "color": "blue"}, {"text": "\" مرفوع بالضّمة الظّاهرة.", "color": "black"}]}, {"row_id": 26, "segments": [{"text": "﴿وَلِيَذَّكَّرَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، واللّام حرف تعليل وجرّ مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 27, "segments": [{"text": "\"", "color": "black"}, {"text": "يذّكر", "color": "blue"}, {"text": "\": فعل مضارع منصوب بأن مضمرة بعد لام التّعليل، وعلامة نصبه بالفتحة الظّاهرة، والمصدر المؤوّل من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة والفعل في محلّ جرّ باللام وشبه الجملة معطوف على شبه الجملة \"", "color": "black"}, {"text": "للنّاس", "color": "blue"}, {"text": "\" والتقدير:", "color": "black"}, {"text": "( هذا بلاغ موجه للناس وللإنذار وللعلم وللتّذكير )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 28, "segments": [{"text": "﴿أُولُو﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو، لأنّه ملحق بجمع المذكّر السّالم.", "color": "black"}]}, {"row_id": 29, "segments": [{"text": "﴿الْأَلْبَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}]