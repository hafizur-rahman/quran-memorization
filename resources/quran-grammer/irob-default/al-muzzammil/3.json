[{"row_id": 1, "segments": [{"text": "{ نِصْفَهُ أَوِ انْقُصْ مِنْهُ قَلِيلًا", "color": "brown"}, {"text": "(  المزمل: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿نِصْفَهُ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "الليل", "color": "blue"}, {"text": "\" منصوبة بالفتحة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَوِ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿انْقُصْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، وفاعله ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أنقص", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنقص", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جواب النداء.", "color": "black"}]}]