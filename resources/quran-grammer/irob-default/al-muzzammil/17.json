[{"row_id": 1, "segments": [{"text": "{ فَكَيْفَ تَتَّقُونَ إِنْ كَفَرْتُمْ يَوْمًا يَجْعَلُ الْوِلْدَانَ شِيبًا", "color": "brown"}, {"text": "(  المزمل: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكَيْفَ﴾:", "color": "green"}, {"text": "ألفا: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كيف: اسم استفهام مبنيّ على الفتح في محلّ نصب حال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَتَّقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَفَرْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَوْمًا﴾:", "color": "green"}, {"text": "مفعول فيه منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَجْعَلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازاً تقديره: هو، يعود على \"", "color": "black"}, {"text": "يوماً", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْوِلْدَانَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿شِيبًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "