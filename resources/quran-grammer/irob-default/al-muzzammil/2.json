[{"row_id": 1, "segments": [{"text": "{ قُمِ اللَّيْلَ إِلَّا قَلِيلًا", "color": "brown"}, {"text": "(  المزمل: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُمِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، وقد حرك بالكسر منعاً لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوباً تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّيْلَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "مستثنى منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب النداء.", "color": "black"}]}]