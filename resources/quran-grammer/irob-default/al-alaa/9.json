[{"row_id": 1, "segments": [{"text": "{ فَذَكِّرْ إِنْ نَفَعَتِ الذِّكْرَى", "color": "brown"}, {"text": "(  الأعلى: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَذَكِّرْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذكر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إن﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَفَعَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح في محلّ جزم بـ\"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السكون، وقد حُرِّك بالكسر منعا لالتقاء الساكنين، وجواب الشرط محذوف لتقدم معناه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الذِّكْرَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]