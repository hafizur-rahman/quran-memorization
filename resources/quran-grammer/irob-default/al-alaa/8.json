[{"row_id": 1, "segments": [{"text": "{ وَنُيَسِّرُكَ لِلْيُسْرَى", "color": "brown"}, {"text": "(  الأعلى: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَنُيَسِّرُكَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "نقرئك", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : \n«", "color": "black"}, {"text": "نقرئك: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبا تقديره: نحن، و\"", "color": "blue"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به أول، حذف المفعول الثاني اختصارًا،", "color": "blue"}, {"text": "»", "color": "black"}, {"text": "﴿لِلْيُسْرَى﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نيسرك", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}]