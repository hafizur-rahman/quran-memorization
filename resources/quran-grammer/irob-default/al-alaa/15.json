[{"row_id": 1, "segments": [{"text": "{ وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى", "color": "brown"}, {"text": "(  الأعلى: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَذَكَرَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "تزكي", "color": "blue"}, {"text": "\"، وتعرب إعرابها،  وهو : \n«", "color": "black"}, {"text": "تَزَكَّى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وعلامة بناء الفعل الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اسْمَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَصَلَّى﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "صلي: تعرب إعراب \"", "color": "black"}, {"text": "تزكي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملتان \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\" و \"", "color": "black"}, {"text": "صلّي", "color": "blue"}, {"text": "\" معطوفتان على \"", "color": "black"}, {"text": "تزكي", "color": "blue"}, {"text": "\" لا محلّ لهما من الإعراب.", "color": "black"}]}]