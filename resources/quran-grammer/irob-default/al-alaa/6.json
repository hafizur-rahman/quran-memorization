[{"row_id": 1, "segments": [{"text": "{ سَنُقْرِئُكَ فَلَا تَنْسَى", "color": "brown"}, {"text": "(  الأعلى: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سَنُقْرِئُكَ﴾:", "color": "green"}, {"text": "السين: حرف استقبال.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "نقرئك: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبا تقديره: نحن، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به أول، حذف المفعول الثاني اختصارًا، أي: سنقرئك يا محمد القرآن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَنْسَى﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الألف للتعذّر، الفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سنقرئك", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب، وكذلك جملة \"", "color": "black"}, {"text": "لا تنسى", "color": "blue"}, {"text": "\".", "color": "black"}]}]