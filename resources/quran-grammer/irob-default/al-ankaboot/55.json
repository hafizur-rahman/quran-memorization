[{"row_id": 1, "segments": [{"text": "{ يَوْمَ يَغْشَاهُمُ الْعَذَابُ مِنْ فَوْقِهِمْ وَمِنْ تَحْتِ أَرْجُلِهِمْ وَيَقُولُ ذُوقُوا مَا كُنْتُمْ تَعْمَلُونَ", "color": "brown"}, {"text": "(  العنكبوت: 55  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "ظرف زمان متعلق بـ \"", "color": "black"}, {"text": "محيطة", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَغْشَاهُمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدرة على الألف للتعذر، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْعَذَابُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ فَوْقِهِمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "يغشاهم العذاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَمِنْ تَحْتِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "من فوقهم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَرْجُلِهِمْ﴾:", "color": "green"}, {"text": "أرجل: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَيَقُولُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "يقول: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: ويقول الله لهم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿