[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ أَنْزَلْنَا إِلَيْكَ الْكِتَابَ فَالَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يُؤْمِنُونَ بِهِ وَمِنْ هَؤُلَاءِ مَنْ يُؤْمِنُ بِهِ وَمَا يَجْحَدُ بِآيَاتِنَا إِلَّا الْكَافِرُونَ", "color": "brown"}, {"text": "(  العنكبوت: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب نعت لمصدر محذوف، أي: وأنزلنا إنزالًا مثل ذلك الإنزال، وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْزَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أنزلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَالَّذِينَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿آتَيْنَاهُمُ الْكِتَابَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "أنزلنا ا