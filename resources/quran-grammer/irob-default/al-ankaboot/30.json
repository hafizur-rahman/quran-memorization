[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ انْصُرْنِي عَلَى الْقَوْمِ الْمُفْسِدِينَ", "color": "brown"}, {"text": "(  العنكبوت: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي بحرف نداء محذوف منصوب، وعلامة نصبه الفتحة المقدرة على ما قبل الياء منع من ظهورها اشتغال المحل بالحركة المناسبة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿انْصُرْنِي﴾:", "color": "green"}, {"text": "فعل طلب مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَى الْقَوْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "انصرني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمُفْسِدِينَ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "القوم", "color": "blue"}, {"text": "\" مجرورة بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة النداء في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "انصر