[{"row_id": 1, "segments": [{"text": "{ وَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ آمَنُوا وَلَيَعْلَمَنَّ الْمُنَافِقِينَ", "color": "brown"}, {"text": "(  العنكبوت: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة أعربت في الآية الكريمة الثالثة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: « فَلَيَعْلَمَنَّ: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "يعلمن: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة، و \"", "color": "black"}, {"text": "نون", "color": "blue"}, {"text": "\" التوكيد: حرف لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿صَدَقُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "صدقوا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَيَعْلَمَنَّ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ليعلمن الله الذين صدقوا", "color": "blue"}, {"text": "\"، وفاعل \"", "color": "black"}, {"text": "يعلمن", "color": "blue"}, {"text": "\" ضمير مستتر فيه جوازًا تقديره: هو أي الله سبحانه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْكَاذِبِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\" عوض من التنوين والحركة في المفرد.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "بمعنى الكاذبين في الإيمان، أي: ليتميزن الصادق منهم الكاذب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "أو بتقدير ليعلمنهم فلنجازيهم بحسب علمه فيهم، أي: ليثيبن الذين صدقوا وليعاقبن الكاذبين.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فتنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم المقدر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة القسم المقدرة لا محلّ لها من الإعراب، لأنّها معطوفة على الجملة الابتدائية.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعلمن", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( الأولى )", "color": "green"}, {"text": "لا محلّ لها من الإعراب، لأنّها جواب القسم المقدر.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة القسم المقدّرة لا محلّ لها من الإعراب، لأنّها معطوفة على جملة القسم المقدّرة الأولى.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "صدقوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعلمن", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( الثانية )", "color": "green"}, {"text": "لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يعلمن", "color": "blue"}, {"text": "\"الأولى».", "color": "black"}]}]