[{"row_id": 1, "segments": [{"text": "{ وَلُوطًا إِذْ قَالَ لِقَوْمِهِ إِنَّكُمْ لَتَأْتُونَ الْفَاحِشَةَ مَا سَبَقَكُمْ بِهَا مِنْ أَحَدٍ مِنَ الْعَالَمِينَ", "color": "brown"}, {"text": "(  العنكبوت: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلُوطًا إِذْ قَالَ لِقَوْمِهِ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "وإبراهيم إذ قال لقومه", "color": "blue"}, {"text": "\" الواردة في الآية السادسة عشرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: « وَإِبْرَاهِيمَ: معطوفة بالواو على \"", "color": "black"}, {"text": "وأرسلنا نوحًا", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة الرابعة عشرة .", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "اسم مبنيّ على السكون في محلّ نصب بدل من \"", "color": "black"}, {"text": "إبراهيم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِقَوْمِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِنَّكُمْ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في و محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَتَأْتُونَ﴾:", "color": "green"}, {"text": "اللام: حرف للتوكيد.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "تأتون", "color": "blue"}, {"text": "\" ف