[{"row_id": 1, "segments": [{"text": "{ وَإِلَى مَدْيَنَ أَخَاهُمْ شُعَيْبًا فَقَالَ يَاقَوْمِ اعْبُدُوا اللَّهَ وَارْجُوا الْيَوْمَ الْآخِرَ وَلَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ", "color": "brown"}, {"text": "(  العنكبوت: 36  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِلَى مَدْيَنَ أَخَاهُمْ شُعَيْبًا فَقَالَ يَاقَوْمِ اعْبُدُوا اللَّهَ﴾:", "color": "green"}, {"text": "أعربت في الآية الخامسة والثمانين من سورة الأعراف، والآية الرابعة والثمانين من سورة هود.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "التي أعرب نظيرها في الآية الخمسين من سورة هود ، وهو: « وَإِلَى عَادٍ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إلى عاد: جارّ ومجرور متعلّقان بفعل بمحذوف تقديره: \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَخَاهُمْ﴾:", "color": "green"}, {"text": "مفعول به للفعل المحذوف منصوب، وعلامة النصب الألف، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هُودًا﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "أخاهم", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "قوم: منادي منصوب، وعلامة النصب الفتحة المقدرة على ما قبل الياء المحذوفة للتخفيف، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة: مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اعْبُدُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text