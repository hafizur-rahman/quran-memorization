[{"row_id": 1, "segments": [{"text": "{ اللَّهُ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَهُ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ", "color": "brown"}, {"text": "(  العنكبوت: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَبْسُطُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: الله سبحانه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الرِّزْقَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِمَنْ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَشَاءُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يبسط", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ عِبَادِهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَيَقْدِرُ لَهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "يقدر له: معطوفة على \"", "color": "black"}, {"text": "يبسط الرزق لمن يشاء", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف نصب وتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة: اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب للتعظيم بالفتحة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بِكُلِّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿عَلِيمٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله يبسط", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يبسط", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يشاء", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها صلة الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقدر له", "color": "blue"}, {"text": "\" في محلّ رفع معطوفة على جملة \"", "color": "black"}, {"text": "يبسط", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن الله بكل شيء عليم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافية.", "color": "black"}]}]