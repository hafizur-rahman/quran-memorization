[{"row_id": 1, "segments": [{"text": "{ قَالَ لَهُ مُوسَى هَلْ أَتَّبِعُكَ عَلَى أَنْ تُعَلِّمَنِ مِمَّا عُلِّمْتَ رُشْدًا", "color": "brown"}, {"text": "(  الكهف: 66  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مبني في محلّ جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجار والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدرة على الألف للتعذر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هَلْ﴾:", "color": "green"}, {"text": "حرف استفهام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَتَّبِعُكَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَن﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تُعَلِّمَنِ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة للتخفيف ضمير مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن تعلمن", "color": "blue"}, {"text": "\" في مح