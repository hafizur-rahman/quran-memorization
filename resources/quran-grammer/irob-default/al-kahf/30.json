[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ إِنَّا لَا نُضِيعُ أَجْرَ مَنْ أَحْسَنَ عَمَلًا", "color": "brown"}, {"text": "(  الكهف: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَعَمِلُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "عملوا: مثل \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الصَّالِحَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الكسرة، لأنه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مستتر في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿نُضِيعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَجْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موص