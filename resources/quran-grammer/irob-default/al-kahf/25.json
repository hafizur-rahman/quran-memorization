[{"row_id": 1, "segments": [{"text": "{ وَلَبِثُوا فِي كَهْفِهِمْ ثَلَاثَ مِائَةٍ سِنِينَ وَازْدَادُوا تِسْعًا", "color": "brown"}, {"text": "(  الكهف: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَبِثُوا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لبثوا: فعل ماض مبنيّ على الضم، والواو ضمير مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي كَهْفِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "لبثوا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ثَلَاثَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب متعلق بـ\"", "color": "black"}, {"text": "لبثوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِائَةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿سِنِينَ﴾:", "color": "green"}, {"text": "بدل من ثلاثمائة، أو عطف بيان منه منصوب، وعلامة النصب الياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَازْدَادُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ازدادوا: فعل ماضٍ مبنيّ على الضم، وفاعله ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تِسْعًا﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لبثوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ازدادوا", "color": "blue"}, {"text"