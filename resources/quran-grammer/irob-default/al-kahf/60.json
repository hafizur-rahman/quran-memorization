[{"row_id": 1, "segments": [{"text": "{ وَإِذْ قَالَ مُوسَى لِفَتَاهُ لَا أَبْرَحُ حَتَّى أَبْلُغَ مَجْمَعَ الْبَحْرَيْنِ أَوْ أَمْضِيَ حُقُبًا", "color": "brown"}, {"text": "(  الكهف: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم ظرفي في محلّ نصب مفعول به لفعل محذوف تقديره: أذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الضمة المقدرة على الألف للتعذر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِفَتَاهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\"، وعلامة الجر الكسرة المقدرة على الألف، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَبْرَحُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وجر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَبْلُغَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بأن مضمرة بعد \"", "color": "black"}, {"text": "حتى", "color": "blue"}, {"text": "\"، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَجْمَعَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ البحرين﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجر الياء، لأنه مثنى.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَو﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَمْضِيَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة، وفاعله ضمير مستتر فيه وجوبا تقديره: أنا.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿حُقُبًا﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلق به أمضي\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 16, "segments": [{"text": "والمصدر المؤول من \"أن أبلغ\"", "color": "black"}, {"text": "في محلّ جرّ بـ", "color": "blue"}, {"text": "\"حتى\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 17, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"أبرح\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"قال موسى\"", "color": "black"}, {"text": "في محلّ جر مضاف إليه.", "color": "blue"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"لا أبرح\"", "color": "black"}, {"text": "في محلّ نصب", "color": "blue"}, {"text": "\"مقول القول\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"أبلغ\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي", "color": "blue"}, {"text": "\"أن\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"أمضي\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة صلة الموصول الحرفي.", "color": "black"}]}]