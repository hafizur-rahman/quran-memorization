[{"row_id": 1, "segments": [{"text": "{ وَرَأَى الْمُجْرِمُونَ النَّارَ فَظَنُّوا أَنَّهُمْ مُوَاقِعُوهَا وَلَمْ يَجِدُوا عَنْهَا مَصْرِفًا", "color": "brown"}, {"text": "(  الكهف: 53  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَرَءَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "رأى: فعل ماضٍ مبني على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمُجْرِمُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة الرفع الواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّارَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَظَنُّوا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ظنوا: فعل ماضٍ مبنيّ على الضم، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنَّهُمْ﴾:", "color": "green"}, {"text": "أن: حرف توكيد مشبّه بالفعل و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُوَاقِعُوهَا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" مرفوع، وعلامة الرفع الواو، لأنه جمع مذكر سالم، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أنهم مواقعوها", "color": "blue"}, {"text": "\" في محلّ نصب سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "ظنوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id