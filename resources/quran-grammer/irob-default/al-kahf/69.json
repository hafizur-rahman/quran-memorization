[{"row_id": 1, "segments": [{"text": "{ قَالَ سَتَجِدُنِي إِنْ شَاءَ اللَّهُ صَابِرًا وَلَا أَعْصِي لَكَ أَمْرًا", "color": "brown"}, {"text": "(  الكهف: 69  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ، وفاعله ضمير مستتر فيه جوازا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿سَتَجِدُنِي﴾:", "color": "green"}, {"text": "السين: حرف استقبال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "تجدني: فعل مضارع مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِن﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ في محلّ جزم فعل الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿صَابِرًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب للفعل \"", "color": "black"}, {"text": "تجدني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَعْصِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة الرفع الضمة المقدرة على الياء، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لَكَ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و \"", "color": "bl