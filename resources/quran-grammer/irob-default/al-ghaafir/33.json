[{"row_id": 1, "segments": [{"text": "{ يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ", "color": "brown"}, {"text": "(  غافر: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "يوم التناد", "color": "blue"}, {"text": "\" الواردة في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تُوَلُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُدْبِرِينَ﴾:", "color": "green"}, {"text": "حال من ضمير \"", "color": "black"}, {"text": "تولون", "color": "blue"}, {"text": "\" منصوبة بالياء، لأنها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَا لَكُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ﴾:", "color": "green"}, {"text": "أعربت في الآية السابعة والعشرين من سورة \"", "color": "black"}, {"text": "يونس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وهو : « مَا: حرف نفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر، والجار والمجرور متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "العاصم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر زائد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَاصِمٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظ مرفوع محلًّا على أنه مبتدأ مؤخر».", "color": "black"}]}, {"row_id": 11, "segments":