[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ آتَيْنَا مُوسَى الْهُدَى وَأَوْرَثْنَا بَنِي إِسْرَائِيلَ الْكِتَابَ", "color": "brown"}, {"text": "(  غافر: 53  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف واقع في جواب قسم مقدّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿آتَيْنَا﴾:", "color": "green"}, {"text": "آتي: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُوسَى الْهُدَى﴾:", "color": "green"}, {"text": "مفعولا لـ \"", "color": "black"}, {"text": "آتينا", "color": "blue"}, {"text": "\" منصوبان بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَأَوْرَثْنَا بَنِي إِسْرَائِيلَ الْكِتَابَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "آتينا موسى الهدي", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وعلامة نصب المفعول الأول \"", "color": "black"}, {"text": "بني", "color": "blue"}, {"text": "\" الياء، لأنه ملحق بجمع المذكر السالم، وحذفت نونه للإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وعلامة نصب المفعول الثاني \"", "color": "black"}, {"text": "الكتاب", "color": "blue"}, {"text": "\" الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "إسرائيل", "color": "blue"}, {"text": "\": مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آتينا", "color": "blue"}, {"text": "\" لا محلّ ل