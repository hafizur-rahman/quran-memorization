[{"row_id": 1, "segments": [{"text": "{ فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا وَحَاقَ بِآلِ فِرْعَوْنَ سُوءُ الْعَذَابِ", "color": "brown"}, {"text": "(  غافر: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَوَقَهُ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وقاه: فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَيِئَاتِ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب بالكسرة بدلًا من الفتحة، لأنه ملحق بجمع المؤنث السالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف مصدري.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَكَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها: بتأويل مصدر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَحَاقَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بَآلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "حاق", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِرعَونَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه