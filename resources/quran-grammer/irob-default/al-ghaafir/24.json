[{"row_id": 1, "segments": [{"text": "{ إِلَى فِرْعَوْنَ وَهَامَانَ وَقَارُونَ فَقَالُوا سَاحِرٌ كَذَّابٌ", "color": "brown"}, {"text": "(  غافر: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَى فِرْعَوْنَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَهَامَانَ وَقَارُونَ﴾:", "color": "green"}, {"text": "معطوفان بواوي العطف على \"", "color": "black"}, {"text": "فرعون", "color": "blue"}, {"text": "\"، ويعربان إعرابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَقَالُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قالوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿سَاحِرٌ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هو ساحر أو هذا ساحر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كَذَّابٌ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "ساحر", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو ساحر", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]