[{"row_id": 1, "segments": [{"text": "{ وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ", "color": "brown"}, {"text": "(  غافر: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قال: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبُّكُمُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ادْعُونِي﴾:", "color": "green"}, {"text": "فعل أمر مجزوم وعلامة جزمه حذف النون، لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَسْتَجِبْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنه جواب الطلب، وعلامة جزمه سكون آخره، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "استجب", "color": "blue"}, {"text": "\".", "c