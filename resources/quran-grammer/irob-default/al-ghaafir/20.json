[{"row_id": 1, "segments": [{"text": "{ وَاللَّهُ يَقْضِي بِالْحَقِّ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَقْضُونَ بِشَيْءٍ إِنَّ اللَّهَ هُوَ السَّمِيعُ الْبَصِيرُ", "color": "brown"}, {"text": "(  غافر: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الله: لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَقْضِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هو\nبِالْحَقِّ: جارّ ومجرور متعلّقان بصفة لمصدر", "color": "black"}, {"text": "( مفعول مطلق )", "color": "green"}, {"text": "محذوف، أي قضاء ملتبسًا بالحق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَدْعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ دُونِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة لموصوف محذوف، بتقدير: والذين يدعونهم آلهة من دونه أو متعلّق بحال محذوفة بتقدير: حالة كونهم من دونه، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَقْضُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يدعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row