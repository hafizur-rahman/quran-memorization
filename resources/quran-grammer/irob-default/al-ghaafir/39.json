[{"row_id": 1, "segments": [{"text": "{ يَاقَوْمِ إِنَّمَا هَذِهِ الْحَيَاةُ الدُّنْيَا مَتَاعٌ وَإِنَّ الْآخِرَةَ هِيَ دَارُ الْقَرَارِ", "color": "brown"}, {"text": "(  غافر: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "أعربت في الآية التاسعة والعشرين من هذه السورة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "يَاقَوْمِ: يا: حرف نداء.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "قوم: منادى منصوب بالفتحة المقدّرة على آخره منع من ظهورها اشتغال المحلّ بالكسرة المناسبة لياء المتكلم المحذوفة، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد بطل عمله.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ما: حرف زائد وكافّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿هَذِهِ﴾:", "color": "green"}, {"text": "ها: اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْحَيَاةُ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الدُّنْيَا﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "الحياة", "color": "blue"}, {"text": "\" مرفوعة بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَتَاعٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَإِنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْآخِرَةَ﴾:", "color": "green"}, {"text": "ا