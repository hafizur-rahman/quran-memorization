[{"row_id": 1, "segments": [{"text": "{ ذَلِكُمُ اللَّهُ رَبُّكُمْ خَالِقُ كُلِّ شَيْءٍ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُؤْفَكُونَ", "color": "brown"}, {"text": "(  غافر: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكُمُ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: خبر مبتدأ محذوف تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبُّكُمْ﴾:", "color": "green"}, {"text": "خبر ثانٍ مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَالِقُ﴾:", "color": "green"}, {"text": "خبر ثالث مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كُلِّ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة و وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُؤْفَكُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية الثالثة من سورة \"", "color": "black"}, {"text": "فاطر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وهو : « لَا: نافية للجنس.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب، وخبر \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" محذوف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع بدل من موضع \"", "color": "black"}, {"text": "لا إله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿فَأَنَّى﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "أنى: اسم استفهام بمعنى \"", "color": "black"}, {"text": "من أين", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب ظرف مكان.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿تُؤْفَكُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل».", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذلكم الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا إله إلا هو", "color": "blue"}, {"text": "\" في محلّ رفع خبر رابع للمبتدأ \"", "color": "black"}, {"text": "ذلكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة تؤفكون لا محلّ لها من الإعراب، لأنّها جواب شرط مقدر أي إذا كانت هذه صفات الله \"", "color": "black"}, {"text": "فأني تؤفكون", "color": "blue"}, {"text": "\".", "color": "black"}]}]