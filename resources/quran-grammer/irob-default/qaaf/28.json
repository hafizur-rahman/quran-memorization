[{"row_id": 1, "segments": [{"text": "{ قَالَ لَا تَخْتَصِمُوا لَدَيَّ وَقَدْ قَدَّمْتُ إِلَيْكُمْ بِالْوَعِيدِ", "color": "brown"}, {"text": "(  ق: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "قال: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَخْتَصِمُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَدَيَّ﴾:", "color": "green"}, {"text": "ظرف مكان مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بـ\"", "color": "black"}, {"text": "تختصموا", "color": "blue"}, {"text": "\"، وهو مضاف، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَقَدْ﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَدَّمْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَيْكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "قدمت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِالْوَعِيدِ﴾:", "color": "green"}, {"text": "الب