[{"row_id": 1, "segments": [{"text": "{ لَا تَحْسَبَنَّ الَّذِينَ كَفَرُوا مُعْجِزِينَ فِي الْأَرْضِ وَمَأْوَاهُمُ النَّارُ وَلَبِئْسَ الْمَصِيرُ", "color": "brown"}, {"text": "(  النور: 57  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَحْسَبَنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للتوكيد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الذين﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كفروا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُعْجِزِينَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب، وعلامة النصب الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "معجزين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَأْوَاهُمُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "مأواهم: مبتدأ مرفوع بالضمة المقدّرة على الألف للتعذّر، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\