[{"row_id": 1, "segments": [{"text": "{ يَوْمَئِذٍ يُوَفِّيهِمُ اللَّهُ دِينَهُمُ الْحَقَّ وَيَعْلَمُونَ أَنَّ اللَّهَ هُوَ الْحَقُّ الْمُبِينُ", "color": "brown"}, {"text": "(  النور: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب على الظرفية متعلّق بـ\"", "color": "black"}, {"text": "تشهد", "color": "blue"}, {"text": "\" إذ: ظرف زمان مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والتنوين في \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" تنوين عوض ناب عن جملة محذوفة تقديرها \"", "color": "black"}, {"text": "يوم إذ تشهد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُوَفِّيهِمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿دِينَهُمُ﴾:", "color": "green"}, {"text": "دين: مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْحَقَّ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "الدين", "color": "blue"}, {"text": "\" منصوب، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ويعلمون﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "يعلمون: فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color":