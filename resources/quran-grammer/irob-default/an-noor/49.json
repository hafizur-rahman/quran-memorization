[{"row_id": 1, "segments": [{"text": "{ وَإِنْ يَكُنْ لَهُمُ الْحَقُّ يَأْتُوا إِلَيْهِ مُذْعِنِينَ", "color": "brown"}, {"text": "(  النور: 49  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص، فعل الشرط، مجزوم بـ\"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمُ﴾:", "color": "green"}, {"text": "اللام حرف جر، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف خبر مقدم لـ\"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\" مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَأْتُوا﴾:", "color": "green"}, {"text": "فعل مضارع جواب الشرط مجزوم بـ\"", "color": "black"}, {"text": "إنْ", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يأتوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مُذْعِنِينَ﴾:", "color": "green"}, {"text": "حال منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يكن لهم الحق", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة الشرط وفعله وجوابه.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يأتوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط جازم غير مقترنة بالفاء.", "color": "black"}]}]