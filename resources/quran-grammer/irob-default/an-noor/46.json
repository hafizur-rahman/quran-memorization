[{"row_id": 1, "segments": [{"text": "{ لَقَدْ أَنْزَلْنَا آيَاتٍ مُبَيِّنَاتٍ وَاللَّهُ يَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ", "color": "brown"}, {"text": "(  النور: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَقَدْ﴾:", "color": "green"}, {"text": "اللام للابتداء والتوكيد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنْزَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آيَاتٍ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلا من الفتحة، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مبينات﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "آيات", "color": "blue"}, {"text": "\" منصوبة بالكسرة بدلا من الفتحة لأنه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "الله: لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَهْدِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَنْ يَشَاءُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "ما يشاء", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة السابقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وهو: « مَا: اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿