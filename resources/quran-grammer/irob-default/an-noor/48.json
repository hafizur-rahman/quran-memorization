[{"row_id": 1, "segments": [{"text": "{ وَإِذَا دُعُوا إِلَى اللَّهِ وَرَسُولِهِ لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِيقٌ مِنْهُمْ مُعْرِضُونَ", "color": "brown"}, {"text": "(  النور: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿دُعُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَى اللَّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "دعوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَرَسُولِهِ﴾:", "color": "green"}, {"text": "معطوف بالواو على لفظ الجلالة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِيَحْكُمَ﴾:", "color": "green"}, {"text": "اللام: لام التعليل حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "يحكم: فعل مضارع منصوب بأن مضمرة، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بينهم ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بـ \"", "color": "black"}, {"text": "يحكم", "color": "blue"}, {"text": "\" وهو مضاف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ ف