[{"row_id": 1, "segments": [{"text": "{ وَالْخَامِسَةُ أَنَّ لَعْنَتَ اللَّهِ عَلَيْهِ إِنْ كَانَ مِنَ الْكَاذِبِينَ", "color": "brown"}, {"text": "(  النور: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالْخَامِسَةُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَعْنَتَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة، مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص في محل جزم فعل الشرط، مبني على الفتح، واسمه: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنَ الْكَاذِبِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن لعنة الله عليه", "color": "blue"}, {"text": "\" في محل رفع خبر المبتدأ \"", "color": "black"}, {"text": "الخامسة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان من الكاذبين", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها استئنافية، وجواب الشرط محذوف دل عليه ما ق