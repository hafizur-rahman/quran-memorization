[{"row_id": 1, "segments": [{"text": "{ وَمَا هُمْ عَنْهَا بِغَائِبِينَ", "color": "brown"}, {"text": "(  الانفطار: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" أي يعمل عملها في لغة الحجازيين ونافية لا عمل له في لغة بني تميم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى وفي محلّ رفع مبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَنْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "غائبين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِغَائِبِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "غائبين: اسم مجرور لفظا بحرف الجر، وعلامة جره بالياء، لأنه جمع مذكر سالم منصوب محلا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى ومرفوع محلًا على أنه خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" على اللغة الثانية.", "color": "black"}]}]