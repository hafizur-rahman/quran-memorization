[{"row_id": 1, "segments": [{"text": "{ الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ", "color": "brown"}, {"text": "(  الانفطار: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة ثانية لـ\"", "color": "black"}, {"text": "ربك", "color": "blue"}, {"text": "\" أو بدل منه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿خَلَقَكَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ علي الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلقك", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَسَوَّاكَ فَعَدَلَكَ﴾:", "color": "green"}, {"text": "معطوفتان بفاءي العطف على \"", "color": "black"}, {"text": "خلقك", "color": "blue"}, {"text": "\"، وتعربان إعرابها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وعلامة بناء \"", "color": "black"}, {"text": "سواك", "color": "blue"}, {"text": "\" الفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}]