[{"row_id": 1, "segments": [{"text": "{ يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ", "color": "brown"}, {"text": "(  الانفطار: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "مفعول به لفعل مضمر تقديره: فعل \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "اذكر يوم", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَمْلِكُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نَفْسٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تملك", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِنَفْسٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "لا تملك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شَيْئًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَالْأَمْرُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "الأمر: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و\"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون وحُرك بالكسر تخلصًا من التقاء الساكنين:", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ مضاف إليه، وهو مضاف أيضًا والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ مضاف إليه، والتقدير: ويوم لا تملك نفس لنفس شيئًا.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بخبر المبتدأ \"", "color": "black"}, {"text": "الأمر", "color": "blue"}, {"text": "\".", "color": "black"}]}]