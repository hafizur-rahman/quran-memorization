[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ", "color": "brown"}, {"text": "(  الانفطار: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أيها: أي: اسم مبنيّ على الضم في محلّ نصب منادي، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف زائد للتنبيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْإِنْسَانُ﴾:", "color": "green"}, {"text": "عطف بيان لـ \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" أو بدل منه مرفوع", "color": "black"}, {"text": "( على لفظ \"", "color": "green"}, {"text": "أي", "color": "blue"}, {"text": "\" )", "color": "green"}, {"text": "بالضمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة النداء استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿غَرَّكَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به وجملة \"", "color": "black"}, {"text": "غرك", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما غرك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِرَيِّكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "غرك", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْكَرِيمِ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "الرب", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}]