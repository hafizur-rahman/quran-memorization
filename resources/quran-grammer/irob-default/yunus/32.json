[{"row_id": 1, "segments": [{"text": "{ فَذَلِكُمُ اللَّهُ رَبُّكُمُ الْحَقُّ فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ فَأَنَّى تُصْرَفُونَ", "color": "brown"}, {"text": "(  يونس: 32  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَذَلِكُمُ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذلكم: اسم إشارة مبنيّ في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": حرف الجمع الذكور.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبُّكُمُ﴾:", "color": "green"}, {"text": "بدل من لفظ الجلالة مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْحَقِّ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "رب", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَمَاذَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ماذا: اسم استفهام مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بَعْدَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة، متعلّق بمحذوف خبر المبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "b