[{"row_id": 1, "segments": [{"text": "{ وَلِكُلِّ أُمَّةٍ رَسُولٌ فَإِذَا جَاءَ رَسُولُهُمْ قُضِيَ بَيْنَهُمْ بِالْقِسْطِ وَهُمْ لَا يُظْلَمُونَ", "color": "brown"}, {"text": "(  يونس: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلِكُلِّ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لكل: جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أُمَّةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَسُولٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "إذا: ظرف للزمن المستقبل متضمن معنى الشرط مبنيّ في محلّ نصب متعلّق بـ\"", "color": "black"}, {"text": "قضي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَسُولُهُمْ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿قُضِيَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول، ونائب الفاعل محذوف تقديره: القضاء.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بَيْنَهُمْ﴾:", "color": "green"}, {"text": "بين: ظرف مكان منصوب متعلّق بـ\"", "color": "black"}, {"text": "قضي", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِالْقِسْطِ﴾:", "color": "green"}, {"text": "