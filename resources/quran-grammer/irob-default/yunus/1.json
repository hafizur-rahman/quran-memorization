[{"row_id": 1, "segments": [{"text": "سورة يونس\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ الر تِلْكَ آيَاتُ الْكِتَابِ الْحَكِيمِ", "color": "brown"}, {"text": "(  يونس: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الر﴾:", "color": "green"}, {"text": "انظر الآية الأولى من سورة البقرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "الم: ابتدأت بعض سور القرآن الكريم ببعض الحروف المقطّعة، وقد اختلف العلماء في تفسيرها وإعرابها اختلافًا كبيرًا.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "وهي تُعرب اسمًا مبنيًّا في محلّ رفع خبر مقدّم لمبتدأ محذوف، تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ويجوز إعراب \"", "color": "black"}, {"text": "الم", "color": "blue"}, {"text": "\" هنا، اسمًا مبنيًّا في محلّ رفع مبتدأ خبره \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تِلْكَ﴾:", "color": "green"}, {"text": "تِ: اسم إشارة مبني على المقدر الظاهر على الياء المحذوفة، لالتقاء الساكنين في محل رفع مبتدأ، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آيَاتُ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْحَكِيمِ﴾:", "color": "green"}, {"text": "نعت للكتاب مجرور بالكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تلك آيات", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها ابتدائية.", "color": "black"}]}]