[{"row_id": 1, "segments": [{"text": "{ قَالَ قَدْ أُجِيبَتْ دَعْوَتُكُمَا فَاسْتَقِيمَا وَلَا تَتَّبِعَانِّ سَبِيلَ الَّذِينَ لَا يَعْلَمُونَ", "color": "brown"}, {"text": "(  يونس: 89  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي الله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أُجِيبَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف: للتأنيث.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿دَعْوَتُكُمَا﴾:", "color": "green"}, {"text": "دعوة: نائب الفاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "كما", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَاسْتَقِيمَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "استقيما: فعل أمر مبنيّ على حذف النون، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" ضمير مبنيّ متصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَتَّبِعَانِّ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، وعلامة الجزم حذف النون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" ضمير فاعل، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segmen