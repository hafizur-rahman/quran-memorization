[{"row_id": 1, "segments": [{"text": "{ وَلَوْ جَاءَتْهُمْ كُلُّ آيَةٍ حَتَّى يَرَوُا الْعَذَابَ الْأَلِيمَ", "color": "brown"}, {"text": "(  يونس: 97  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو: واو الحال.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَتْهُمْ﴾:", "color": "green"}, {"text": "جاءت: فعل ماضٍ مبنيّ، والتاء: حرف للتأنيث، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كُلُّ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آيَةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وجر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَرَوُا﴾:", "color": "green"}, {"text": "فعل مضارع منصوب، وعلامة النصب حذف النون، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْعَذَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَلِيمَ﴾:", "color": "green"}, {"text": "نعت للعذاب منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يروا", "color": "blue"}, {"text": "\" في محلّ جر بـ \"", "color": "black"}, {"text": "حتى", "color": "blue"}, {"text": "\"، والجار والمجرور متعلقان بـ \"", "color": "black"}, {"text": "لا يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ووجملة \"", "color": "black"}, {"text": "جاءتهم كل آية", "color": "blue"}, {"text": "\" في محلّ نصب حال من فاعل \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجواب \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\" محذوف دل عليه ما قبله.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يروا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}]