[{"row_id": 1, "segments": [{"text": "{ فَكَفَى بِاللَّهِ شَهِيدًا بَيْنَنَا وَبَيْنَكُمْ إِنْ كُنَّا عَنْ عِبَادَتِكُمْ لَغَافِلِينَ", "color": "brown"}, {"text": "(  يونس: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكَفَى﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كفي: فعل ماضٍ مبنيّ على الفتح المقدر على الألف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِاللَّهِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "الله: لفظ الجلالة اسم مخفوض لفظًا منصوب محلًّا على أنه فاعل \"", "color": "black"}, {"text": "كفي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿شَهِيدًا﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَيْنَنَا﴾:", "color": "green"}, {"text": "بين: ظرف مكان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "شهيد", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَبَيْنَكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "بينكم: مثل \"", "color": "black"}, {"text": "بيننا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إن﴾:", "color": "green"}, {"text": "مخففة من \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" الثقيلة، بطل عملها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كُنَّا﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id