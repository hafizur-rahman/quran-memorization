[{"row_id": 1, "segments": [{"text": "{ وَلَا تَكُونَنَّ مِنَ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ فَتَكُونَ مِنَ الْخَاسِرِينَ", "color": "brown"}, {"text": "(  يونس: 95  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا تَكُونَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا تكونن: تقدم إعرابهما في الآية السابقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو: « لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَكُونَنَّ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مبني على الفتح في محل جزم، والنون نون التوكيد واسمه ضمير مستتر فيه وجوبًا تقديره: أنت».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول في محلّ جرّ، والجار والمجرور متعلقان بخبر \"", "color": "black"}, {"text": "تكونن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَذَّبُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِآيَاتِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "كذبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَتَكُونَ﴾:", "color": "green"}, {"text": "الفاء: فاء السببية، حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "تكون: فعل مضارع ناقص منصوب بأن مضمرة بعد الفاء، واسمه ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنَ الْخَاسِرِينَ﴾:", "color": "green"}, {"text": "مثل \""