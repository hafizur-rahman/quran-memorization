[{"row_id": 1, "segments": [{"text": "{ قُلْ بِفَضْلِ اللَّهِ وَبِرَحْمَتِهِ فَبِذَلِكَ فَلْيَفْرَحُوا هُوَ خَيْرٌ مِمَّا يَجْمَعُونَ", "color": "brown"}, {"text": "(  يونس: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِفَضْلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بفعل محذوف دل عليه المذكور بعده، أي: يحسن الفرح بمجيء فضل الله.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَبِرَحْمَتِهِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "برحمة: جارّ ومجرور متعلّقان بما تعلق به، والجارّ والمجرور \"", "color": "black"}, {"text": "بفضل", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَبِذَلِكَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ذلك: اسم إشارة مبنيّ في محلّ جرّ بدل من \"", "color": "black"}, {"text": "فضل الله", "color": "blue"}, {"text": "\" بإعادة الجار، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَلْيَفْرَحُوا﴾:", "color": "green"}, {"text": "الفاء: حرف ربط.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "اللام: لام الأمر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "يفرحوا: فعل مضارع مجزوم، وعلامة ا