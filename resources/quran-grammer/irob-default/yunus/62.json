[{"row_id": 1, "segments": [{"text": "{ أَلَا إِنَّ أَوْلِيَاءَ اللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ", "color": "brown"}, {"text": "(  يونس: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَا﴾:", "color": "green"}, {"text": "حرف تنبيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَوْلِيَاءَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَوْفٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بمحذوف خبر المبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَحْزَنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن أولياء الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا خوف عليهم", "color": "blu