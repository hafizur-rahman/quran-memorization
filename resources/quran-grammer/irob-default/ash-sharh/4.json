[{"row_id": 1, "segments": [{"text": "{ وَرَفَعْنَا لَكَ ذِكْرَكَ", "color": "brown"}, {"text": "(  الشرح: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية الثانية من هذه السورة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « وَوَضَعْنَا: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وضع: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَنْكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وِزْرَكَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتحة في محلّ جرّ بالإضافة».", "color": "black"}]}]