[{"row_id": 1, "segments": [{"text": "{ فَإِذَا فَرَغْتَ فَانْصَبْ", "color": "brown"}, {"text": "(  الشرح: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن خافض لشرطه متعلّق بجوابه متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَرَغْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَانْصَبْ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "انصب: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فرغت", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "انصب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب شرط غير جازم.", "color": "black"}]}]