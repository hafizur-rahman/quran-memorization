[{"row_id": 1, "segments": [{"text": "{ وَوَضَعْنَا عَنْكَ وِزْرَكَ", "color": "brown"}, {"text": "(  الشرح: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَوَضَعْنَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وضع: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَنْكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وِزْرَكَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتحة في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وضعنا", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "نشرح", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]