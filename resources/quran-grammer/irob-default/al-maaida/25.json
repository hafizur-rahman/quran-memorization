[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ إِنِّي لَا أَمْلِكُ إِلَّا نَفْسِي وَأَخِي فَافْرُقْ بَيْنَنَا وَبَيْنَ الْقَوْمِ الْفَاسِقِينَ", "color": "brown"}, {"text": "(  المائدة: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: موسى.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى مضاف محذوف منه حرف النداء منصوب، وعلامة النصب الفتحة المقدرة على ما قبل ياء المتكلم المحذوفة للتخفيف، والياء المحذوفة ضمير مبنيّ في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" ضمير مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَمْلِكُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَفْسِي﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الفتحة المقدرة على ما قبل الياء والياء ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَأَخِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "أخي: اسم معطوف على نفسي ويعرب مثله.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَافْرُقْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "افرق: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بَيْنَنَا﴾:", "color": "green"}, {"text": "بين: ظرف مكان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "افرق", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَبَيْنَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "بين: ظرف مكان منصوب بالفتحة، متعلّق بـ\"", "color": "black"}, {"text": "فرق", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الْقَوْمِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿الْفَاسِقِينَ﴾:", "color": "green"}, {"text": "نعت للقوم مجرور، وعلامة الجرّ الياء.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافيّة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة النداء \"", "color": "black"}, {"text": "رب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها اعتراضية.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إني لا أملك", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا أملك", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أفرق بيننا", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]