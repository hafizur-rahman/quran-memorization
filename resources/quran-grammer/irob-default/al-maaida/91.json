[{"row_id": 1, "segments": [{"text": "{ إِنَّمَا يُرِيدُ الشَّيْطَانُ أَنْ يُوقِعَ بَيْنَكُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ فِي الْخَمْرِ وَالْمَيْسِرِ وَيَصُدَّكُمْ عَنْ ذِكْرِ اللَّهِ وَعَنِ الصَّلَاةِ فَهَلْ أَنْتُمْ مُنْتَهُونَ", "color": "brown"}, {"text": "(  المائدة: 91  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافة عليه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يُرِيدُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الشَّيْطَانُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ناصب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يُوقِعَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بأن وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يوقع", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به للفعل \"", "color": "black"}, {"text": "يريد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَيْنَكُمُ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "يوقع", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصلّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْعَدَاوَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَالْبَغْضَاءَ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو