[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ", "color": "brown"}, {"text": "(  المائدة: 67  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أيّ: منادى مبنيّ على الضم في محلّ نصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و", "color": "black"}, {"text": "( ها )", "color": "green"}, {"text": "للتنبيه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الرَّسُولُ﴾:", "color": "green"}, {"text": "صفة لأيّ لأنه اسم مشتق مرفوعة بالضمة تبعت", "color": "black"}, {"text": "( أيّ )", "color": "green"}, {"text": "على حركتها وليس على محلها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَلِّغْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أُنزِلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح ونائب الفاعل: ضمير مستتر جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّق بـ", "color": "black"}, {"text": "( أنزل )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجملة صلة الموصول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِن ربِّكَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال محذوفة من  \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" و  \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مت