[{"row_id": 1, "segments": [{"text": "{ وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ عَظِيمٌ", "color": "brown"}, {"text": "(  المائدة: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَعَدَ﴾:", "color": "green"}, {"text": "فعل ماض.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماض مبني على الضم، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَعَمِلُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "عملوا: مثل \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الصَّالِحَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة النصب الكسرة، والمفعول الثاني لفعل \"", "color": "black"}, {"text": "وعد", "color": "blue"}, {"text": "\" محذوف تقديره: الجنة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ وهم: ضمير في محلّ جرّ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف خبر مقدم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَغْفِرَةٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَأَجْرٌ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "أجر: اسم معطوف على \"", "c