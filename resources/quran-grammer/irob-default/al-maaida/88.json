[{"row_id": 1, "segments": [{"text": "{ وَكُلُوا مِمَّا رَزَقَكُمُ اللَّهُ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ الَّذِي أَنْتُمْ بِهِ مُؤْمِنُونَ", "color": "brown"}, {"text": "(  المائدة: 88  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكُلُوا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كلوا: فعل أمر مبنيّ على حذف النون؛ لأنّ مضارعه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والواو ضمير متّصل في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِمَّا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": حرف جرّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول في محلّ جرّ بمن، أو \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": حرف زائد لتأكيد المعنى وتقويته، و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم مجرور لفظا بمن منصوب محلًا؛ لأنه مفعول \"", "color": "black"}, {"text": "كلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَزَقَكُمُ﴾:", "color": "green"}, {"text": "جملة فعلية لا محلّ لها من الإعراب، لأنّها صلة الموصول.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "رزق: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿حَلَالًا﴾:", "color": "green"}, {"text": "حال منصوب بالفت