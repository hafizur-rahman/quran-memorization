[{"row_id": 1, "segments": [{"text": "{ وَلَوْ أَنَّ أَهْلَ الْكِتَابِ آمَنُوا وَاتَّقَوْا لَكَفَّرْنَا عَنْهُمْ سَيِّئَاتِهِمْ وَلأَدْخَلْنَاهُمْ جَنَّاتِ النَّعِيمِ", "color": "brown"}, {"text": "(  المائدة: 65  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَهْلَ﴾:", "color": "green"}, {"text": "اسم  \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والمصدر المؤول من  \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" مع اسمها وخبرها في محلّ رفع فاعل لفعل محذوف تقديره: ثبت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آمنوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متصلّ في محلّ رفع فاعل، و", "color": "black"}, {"text": "( الألف )", "color": "green"}, {"text": ": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاتَّقَوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدر على الألف المحذوفة، والواو: فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَكَفْرْنَا﴾:", "color": "green"}, {"text": "اللام: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "كفرنا: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع، و  \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصلّ مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": 