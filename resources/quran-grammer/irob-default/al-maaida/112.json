[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَ الْحَوَارِيُّونَ يَاعِيسَى ابْنَ مَرْيَمَ هَلْ يَسْتَطِيعُ رَبُّكَ أَنْ يُنَزِّلَ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ قَالَ اتَّقُوا اللَّهَ إِنْ كُنْتُمْ مُؤْمِنِينَ", "color": "brown"}, {"text": "(  المائدة: 112  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ قَالَ الْحَوَارِيُّونَ﴾:", "color": "green"}, {"text": "«إِذْ: اسم ظرف مبنيّ على السكون في محلّ نصب مفعول به لفعل محذوف تقديره: اذكرْ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْحَوَارِيُّونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو لانه جمع مذكر سالم».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَاعِيسَى ابْنَ مَرْيَمَ﴾:", "color": "green"}, {"text": "«يَاعِيسَى: يا: حرف نداء.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "عيسي: منادي على الضم في محلّ نصب مفعول به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ابْنَ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "عيسي", "color": "blue"}, {"text": "\" تبعه في المحلّ منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَرْيَمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة، لأنه ممنوع من الصّرف».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هَلْ﴾:", "color": "green"}, {"text": "حرف استفهام.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَسْتَطِيعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "رب: فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يُنَزِّلَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿عَلَيْنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "ينزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مَائِدَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مِنَ السَّمَاءِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "ينزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن ينزل", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به عامله \"", "color": "black"}, {"text": "يستطيع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض، والفاعل ضمير مستتر تقديره: هو.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿اتَّقُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" فاعل.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على السكون في محلّ جزم فعل الشرط، و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color"