[{"row_id": 1, "segments": [{"text": "{ مَا عَلَى الرَّسُولِ إِلَّا الْبَلَاغُ وَاللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ", "color": "brown"}, {"text": "(  المائدة: 99  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي\nعَلَى الرَّسُولِ: جارّ ومجرور متعلّقان بمحذوف خبر مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْبَلَاغُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الله: لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تُبْدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: اسم موصول مبنيّ في محلّ نصب اسم معطوف على \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الأولى.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَكْتُمُونَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "تبدون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"te