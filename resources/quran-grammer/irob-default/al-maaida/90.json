[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ", "color": "brown"}, {"text": "(  المائدة: 90  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أي: منادى مبنيّ على الضم في محلّ نصب مفعول به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": للتنبيه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع بدل من \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافة عليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْخَمْرُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ﴾:", "color": "green"}, {"text": "أسماء معطوفات بواوات العطف على \"", "color": "black"}, {"text": "الخمر", "color": "blue"}, {"text": "\"، مرفوعة بالضمة.", "color": "black"}]},