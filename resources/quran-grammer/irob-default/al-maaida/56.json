[{"row_id": 1, "segments": [{"text": "{ وَمَنْ يَتَوَلَّ اللَّهَ وَرَسُولَهُ وَالَّذِينَ آمَنُوا فَإِنَّ حِزْبَ اللَّهِ هُمُ الْغَالِبُونَ", "color": "brown"}, {"text": "(  المائدة: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من: اسم شرط جازم مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَتَوَلَّ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم فعل الشرط، وعلامة الجزم حذف حرف العلة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿والفاعل ضمير مستتر فيه جوازًا تقديره﴾:", "color": "green"}, {"text": "هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَرَسُولَهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "رسول: اسم معطوف منصوب وعلامة نصبه الفتحة الظاهرة على آخره، والهاء: ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "الذين: اسم موصول مبنيّ في محلّ نصب اسم \nآمَنُوا: فعل ماض مبنيّ على الضم، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "إنّ: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿حِزْبَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿هُمُ﴾:", "color": "green"}, {"text": "ضمير فصل مبنيّ لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الْغَالِبُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من يتول", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها معطوفة على الجملة الاستئنافية في الآية السابقة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يتول الله", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها صلة الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ حزب الله هم", "color": "blue"}, {"text": "\"الغالبون\" في محلّ جزم جواب الشرط.", "color": "black"}]}]