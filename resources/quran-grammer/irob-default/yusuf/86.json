[{"row_id": 1, "segments": [{"text": "{ قَالَ إِنَّمَا أَشْكُو بَثِّي وَحُزْنِي إِلَى اللَّهِ وَأَعْلَمُ مِنَ اللَّهِ مَا لَا تَعْلَمُونَ", "color": "brown"}, {"text": "(  يوسف: 86  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: هو، أي: يعقوب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل للتوكيد، بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافّة عليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَشْكُو﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة الرفع الضمة المقدّرة على الواو، والفاعل: أنا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَثِّي﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الفتحة المقدّرة على ما قبل الياء، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَحُزْنِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "حزني: مثل \"", "color": "black"}, {"text": "بثّي", "color": "blue"}, {"text": "\"، ومعطوف عليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَى الله﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أشكوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَأَعْلَمُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "أعلم: فعل مضارع بالضمّة، والفاعل: أنا.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنَ الله﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text