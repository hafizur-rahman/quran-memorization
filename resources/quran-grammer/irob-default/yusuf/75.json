[{"row_id": 1, "segments": [{"text": "{ قَالُوا جَزَاؤُهُ مَنْ وُجِدَ فِي رَحْلِهِ فَهُوَ جَزَاؤُهُ كَذَلِكَ نَجْزِي الظَّالِمِينَ", "color": "brown"}, {"text": "(  يوسف: 75  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَزَاؤُهُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع بالضمّة، و\"الهاء: مضاف إليه، والخبر محذوف تقديره: بين أو واضح أو معروف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وُجِدَ﴾:", "color": "green"}, {"text": "فعل ماض للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي رَحْلِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "وجد", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَهُوَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "{ هُوَ }", "color": "brown"}]}, {"row_id": 9, "segments": [{"text": ": ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿جَزَاؤُهُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره, و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ وتشبيه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ذَلِكَ: اسم إشارة مبنيّ في محلّ جرّ بالكاف، والجارّ والمجرور متعلّقان بمحذوف مفعول مطلق للفعل \"", "color": "black"}, {"text": "نجز