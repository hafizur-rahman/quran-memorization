[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَ يُوسُفُ لِأَبِيهِ يَاأَبَتِ إِنِّي رَأَيْتُ أَحَدَ عَشَرَ كَوْكَبًا وَالشَّمْسَ وَالْقَمَرَ رَأَيْتُهُمْ لِي سَاجِدِينَ", "color": "brown"}, {"text": "(  يوسف: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف للزمن الماضي مبنيّ في محلّ نصب مفعول فيه متعلق بالغافلين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُوسُفُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، وامتنع من التنوين للعلمية والعجمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِأَبِيهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\"، وعلامة الجرّ الياء؛ لأنه من الأسماء الخمسة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَاأَبَتِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "أبت: منادي منصوب، وعلامة النصب الفتحة المقدرة على ما قبل ياء المتكلم، ونقلت الكسرة كسرة المناسبة إلى التاء المبدلة من ياء المتكلم، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": اسمه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَأَيْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، والتاء: فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَحَدَ عَشَرَ﴾:", "color": "green"}, {"text": "عدد مركب مبنيّ الجزءين على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments