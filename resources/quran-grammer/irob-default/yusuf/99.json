[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا دَخَلُوا عَلَى يُوسُفَ آوَى إِلَيْهِ أَبَوَيْهِ وَقَالَ ادْخُلُوا مِصْرَ إِنْ شَاءَ اللَّهُ آمِنِينَ", "color": "brown"}, {"text": "(  يوسف: 99  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: ظرف زمان متضمن معنى الشرط، مبنيّ في محلّ نصب مفعول فيه متعلّق بـ \"", "color": "black"}, {"text": "آوى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿دَخَلُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو: فاعله.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَى يُوسُفَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "دخلوا", "color": "blue"}, {"text": "\"، وعلامة الجر الفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آوَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "آوى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَبَوَيْهِ﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الياء، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "قال: فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ادْخُلُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النّون، والواو: فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مِصْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظا