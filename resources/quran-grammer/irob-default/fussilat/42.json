[{"row_id": 1, "segments": [{"text": "{ لَا يَأْتِيهِ الْبَاطِلُ مِنْ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِ تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ", "color": "brown"}, {"text": "(  فصلت: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَأْتِيه﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبني في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْبَاطِلُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ بَيْنِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يأتيه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَدَيْهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه مثني، وهو مضاف، والهاء\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ خَلْفِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "لا يأتيه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تَنْزِيلٌ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هو تنزيل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنْ حَكِيمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تنزيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments