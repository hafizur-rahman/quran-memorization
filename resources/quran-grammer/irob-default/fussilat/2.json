[{"row_id": 1, "segments": [{"text": "{ تَنْزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ", "color": "brown"}, {"text": "(  فصلت: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تَنْزِيلٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "حم", "color": "blue"}, {"text": "\" مرفوع مرفوع بالضمة إن جعلت \"", "color": "black"}, {"text": "حم", "color": "blue"}, {"text": "\" في موضع رفع مبتدأ على أنها اسم للسورة، وإن جعلت \"", "color": "black"}, {"text": "حم", "color": "blue"}, {"text": "\" تعديدًا للحروف كانت \"", "color": "black"}, {"text": "تنزيل", "color": "blue"}, {"text": "\" خبر لمبتدأ محذوف تقديره: هذا تنزيل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مِنَ الرَّحْمَنِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بصفة لـ \"", "color": "black"}, {"text": "تنزيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الرَّحِيمِ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "الرحمن", "color": "blue"}, {"text": "\" مخفوض بالكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تنزيل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها ابتدائية.", "color": "black"}]}]