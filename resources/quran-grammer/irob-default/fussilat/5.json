[{"row_id": 1, "segments": [{"text": "{ وَقَالُوا قُلُوبُنَا فِي أَكِنَّةٍ مِمَّا تَدْعُونَا إِلَيْهِ وَفِي آذَانِنَا وَقْرٌ وَمِنْ بَيْنِنَا وَبَيْنِكَ حِجَابٌ فَاعْمَلْ إِنَّنَا عَامِلُونَ", "color": "brown"}, {"text": "(  فصلت: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قالوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قُلُوبُنَا﴾:", "color": "green"}, {"text": "قلوب: مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة\nفِي أَكِنَّةٍ: جارّ ومجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِمَّا﴾:", "color": "green"}, {"text": "أصلها: من: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محلّ جرّ بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "أكنة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَدْعُونَا﴾:", "color": "green"}, {"text": "تدعو: فعل مضارع مرفوع بالضمة المقدّرة على الواو للثقل، والفاعل  ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تدعونا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَفِي آذَانِنَا﴾:", "color": "green"}, {"text": "الواو: حر