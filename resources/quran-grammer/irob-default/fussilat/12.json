[{"row_id": 1, "segments": [{"text": "{ فَقَضَاهُنَّ سَبْعَ سَمَاوَاتٍ فِي يَوْمَيْنِ وَأَوْحَى فِي كُلِّ سَمَاءٍ أَمْرَهَا وَزَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَحِفْظًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ", "color": "brown"}, {"text": "(  فصلت: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَقَضَاهُنَّ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قضى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "هن: ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَبْعَ﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة، وهي مضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿سَمَاوَاتٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي يَوْمَيْنِ﴾:", "color": "green"}, {"text": "أعربت في الآية التاسعة من هذه السورة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "فِي يَوْمَيْنِ: جارّ ومجرور متعلّقان بـ \"", "color": "blue"}, {"text": "خلق", "color": "blue"}, {"text": "\"، ويجوز أن يتعلق بحال محذوفة من الأرض بتقدير: خلقها قائمة في مدة يومين، وعلامة جرّ الاسم الياء، لأنه مثنى", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَأَوْحَى﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "قضى", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي كُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أوحى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿سَمَاءٍ﴾:", "color": "green"}, {"text": "مضاف إليه