[{"row_id": 1, "segments": [{"text": "{ فَأَعْرِضْ عَنْ مَنْ تَوَلَّى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا", "color": "brown"}, {"text": "(  النجم: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَعْرِضْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اعرض: فعل أمر مبني على السكون والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبني على السكون في محلّ جرّ بـ عَنْ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجار والمجرور متعلقان بـ \"", "color": "black"}, {"text": "أعرض", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَوَلَّى﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتحة المقدرة على الألف منع من ظهورها التعذر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَنْ ذِكْرِنَا﴾:", "color": "green"}, {"text": "عن ذكر: جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تولى", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُرِدْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون والفاعل ضمير مستتر فيه جوازا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْحَيَاةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الدُّنْيَا﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "الحياة", "color": "blue"}, {"text": "\" المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أعرض", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدرة، أي إن كانوا يتبعون الظن وهو غير الحق فأعرض عنهم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تولى", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لم يرد إلا الحياة", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها معطوفة على جملة الصلة.", "color": "black"}]}]