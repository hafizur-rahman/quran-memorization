[{"row_id": 1, "segments": [{"text": "{ وَأَنْ لَيْسَ لِلْإِنْسَانِ إِلَّا مَا سَعَى", "color": "brown"}, {"text": "(  النجم: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنْ: مخففة من \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" الثقيلة واسمها ضمير الشأن المحذوف وخبرها جملة فعلية تقديرها: أنّه ليس للإنسان في الآخرة إلا سعيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَيْسَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبني على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلْإِنْسَانِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبرها المقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿سَعَى﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما تلاها بتأويل مصدر في محلّ رفع اسم \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن ليس للإنسان إلا ما سعى", "color": "blue"}, {"text": "\" في محلّ جرّ معطوف على المصدر ألا تزر وازرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ليس للإنسان", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المخففة الثانية.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وحملة \"", "color": "black"}, {"text": "سعى", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها صلة \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" المصدرية.", "color": "black"}]}]