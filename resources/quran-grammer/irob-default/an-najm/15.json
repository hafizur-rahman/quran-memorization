[{"row_id": 1, "segments": [{"text": "{ عِنْدَهَا جَنَّةُ الْمَأْوَى", "color": "brown"}, {"text": "(  النجم: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عِنْدَهَا﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بخبر مقدم، وهو مضاف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَنَّةُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالضمة وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمَأْوَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة وعلامة جره الكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "عندها جنة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]