[{"row_id": 1, "segments": [{"text": "{ أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى", "color": "brown"}, {"text": "(  النجم: 38  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَّا﴾:", "color": "green"}, {"text": "أصلها: أن: مخففة من \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" الثقيلة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "واسمها ضمير الشأن المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها في محلّ جرّ بدل من \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "صحف موسى", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة السادسة والثلاثين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "أو في محل رفع خبر مبتدأ محذوف تقديره: هو أنّه لا تزر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَزِرُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَازِرَةٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وِزْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أُخْرَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ألا تزر وازرة", "color": "blue"}, {"text": "\" في محلّ جرّ بدل من الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تزر وازرة", "color": "blue"}, {"text": "