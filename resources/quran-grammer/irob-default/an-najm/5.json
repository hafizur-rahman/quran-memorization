[{"row_id": 1, "segments": [{"text": "{ عَلَّمَهُ شَدِيدُ الْقُوَى", "color": "brown"}, {"text": "(  النجم: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عَلَّمَهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿شَدِيدُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْقُوَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "علمه شديد", "color": "blue"}, {"text": "\" في محلّ رفع نعت ثان لوحي والرابط بينهما مقدر أي علمه إياه شديد القوي.", "color": "black"}]}]