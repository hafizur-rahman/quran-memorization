[{"row_id": 1, "segments": [{"text": "{ فَالسَّابِقَاتِ سَبْقًا", "color": "brown"}, {"text": "(  النازعات: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب آية سابقة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "«", "color": "black"}, {"text": "الفاء ﴾:", "color": "blue"}, {"text": "عاطفة »", "color": "black"}, {"text": "﴿ وهو « ,,,.", "color": "green"}]}, {"row_id": 4, "segments": [{"text": "النازعات﴾: اسم مجرور بواو القسم، وعلامة جرّه الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجار والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿غَرْقًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بفعل مضمر تقديره: فتغرق غرقا، أي: إعراق في النزع، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم بالنازعات", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها ابتدائية، وجواب القسم محذوف تقديره: لتبعثن أيها الكافرون».", "color": "black"}]}]