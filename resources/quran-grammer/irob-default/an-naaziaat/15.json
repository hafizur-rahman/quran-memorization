[{"row_id": 1, "segments": [{"text": "{ هَلْ أَتَاكَ حَدِيثُ مُوسَى", "color": "brown"}, {"text": "(  النازعات: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هَلْ﴾:", "color": "green"}, {"text": "حرف استفهام لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَتَاكَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتحة المقدرة على الألف منع من ظهورها التعذر، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَدِيثُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة المقدرة على الألف للتعذّر بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أتاك حديث", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]