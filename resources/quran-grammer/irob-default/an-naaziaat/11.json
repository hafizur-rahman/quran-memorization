[{"row_id": 1, "segments": [{"text": "{ أَإِذَا كُنَّا عِظَامًا نَخِرَةً", "color": "brown"}, {"text": "(  النازعات: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَإِذَا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان متضمن معنى الشرط خافض لشرطه متعلق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كُنَّا﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع اسمها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عِظَامًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نَخِرَةً﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "عظامًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كنا عظامًا", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجواب الشرط محذوف تقديره: فهل نبعث من جديد.", "color": "black"}]}]