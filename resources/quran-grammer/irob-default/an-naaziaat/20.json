[{"row_id": 1, "segments": [{"text": "{ فَأَرَاهُ الْآيَةَ الْكُبْرَى", "color": "brown"}, {"text": "(  النازعات: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَرَاهُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أراه: فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْآيَةَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الكبرى﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "الآية", "color": "blue"}, {"text": "\" منصوبة بالفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أراه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على استئناف مقدر، أي: فذهب إلى فرعون، فأراه.", "color": "black"}]}]