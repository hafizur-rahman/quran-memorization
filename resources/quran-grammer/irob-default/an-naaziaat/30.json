[{"row_id": 1, "segments": [{"text": "{ وَالْأَرْضَ بَعْدَ ذَلِكَ دَحَاهَا", "color": "brown"}, {"text": "(  النازعات: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": ":\nوَالْأَرْضَ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الأرض: مفعول به منصوب بإضمار فعل يدل على ما بعدها، والتقدير: دحى الأرض\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَعْدَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بالفعل المضمر، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ذلك﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿دَحَاهَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "دحى الأرض", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "دحاها", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}]