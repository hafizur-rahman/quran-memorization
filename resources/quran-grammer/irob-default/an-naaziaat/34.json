[{"row_id": 1, "segments": [{"text": "{ فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَى", "color": "brown"}, {"text": "(  النازعات: 34  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن متضمن معنى الشرط خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث، وقد حركت بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الطَّامَّةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الكبرى﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "الطامة", "color": "blue"}, {"text": "\" مرفوعة بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاءت الطامة", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه والجواب مقدر، أي: يبعث الناس.", "color": "black"}]}]