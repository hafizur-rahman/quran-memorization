[{"row_id": 1, "segments": [{"text": "{ إِلَى رَبِّكَ مُنْتَهَاهَا", "color": "brown"}, {"text": "(  النازعات: 44  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَى رَبِّكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مُنْتَهَاهَا﴾:", "color": "green"}, {"text": "منتهى: مبتدأ مؤخر مرفوع بالضمة المقدّرة على الألف للتعذّر، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إلى ربك منتهاها", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}]