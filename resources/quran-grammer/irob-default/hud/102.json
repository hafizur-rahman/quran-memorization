[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ", "color": "brown"}, {"text": "(  هود: 102  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الكاف: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ذلك: اسم إشارة في محلّ جرّ بالكاف، والجارّ والمجرور متعلّقان بخبر مقدم، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَخْذُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان مجرد من الشرط مبنيّ في محلّ نصب مفعول به متعلّق بالمصدر \"", "color": "black"}, {"text": "أخذ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَخَذَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْقُرَى﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الفتحة المقدرة على الألف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَهِيَ﴾:", "color": "green"}, {"text": "الواو: واو الحال.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "هي: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ظَالِمَةٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفع