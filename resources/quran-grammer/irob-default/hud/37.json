[{"row_id": 1, "segments": [{"text": "{ وَاصْنَعِ الْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا وَلَا تُخَاطِبْنِي فِي الَّذِينَ ظَلَمُوا إِنَّهُمْ مُغْرَقُونَ", "color": "brown"}, {"text": "(  هود: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاصْنَعِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اصنع: فعل أمر مبنيّ على السكون، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْفُلْكَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِأَعْيُنِنَا﴾:", "color": "green"}, {"text": "بأعين: جار ومجرور متعلقان بمحذوف حال من فاعل \"", "color": "black"}, {"text": "اصنع", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَوَحْيِنَا﴾:", "color": "green"}, {"text": "الواو حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وحينا: اسم معطوف على \"", "color": "black"}, {"text": "أعيننا", "color": "blue"}, {"text": "\" مجرور بالكسرة، \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير ومضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُخَاطِبْنِي﴾:", "color": "green"}, {"text": "تخاطب: فعل مضارع مجزوم بالسكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ، والجار والمجرور متعلقان بـ \"", "color": "black"}, {"text": "تخاطب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿ظَلَمُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِنَّهُمْ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مُغْرَقُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اصنع", "color": "blue"}, {"text": "\" في محلّ جزم معطوفة على جملة \"", "color": "black"}, {"text": "لا تبتئس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تخاطبني", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "اصنع الفلك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ظلموا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها صلة الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنهم مغرقون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها تعليلية.", "color": "black"}]}]