[{"row_id": 1, "segments": [{"text": "{ وَإِلَى عَادٍ أَخَاهُمْ هُودًا قَالَ يَاقَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ إِنْ أَنْتُمْ إِلَّا مُفْتَرُونَ", "color": "brown"}, {"text": "(  هود: 50  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِلَى عَادٍ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إلى عاد: جارّ ومجرور متعلّقان بفعل بمحذوف تقديره: \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَخَاهُمْ﴾:", "color": "green"}, {"text": "مفعول به للفعل المحذوف منصوب، وعلامة النصب الألف، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿هُودًا﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "أخاهم", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "قوم: منادي منصوب، وعلامة النصب الفتحة المقدرة على ما قبل الياء المحذوفة للتخفيف، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة: مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اعْبُدُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\": فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِلَهٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿غَيْرُهُ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "إله", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿مُفْتَرُونَ﴾:", "color": "green"}, {"text": "خبر مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أرسلنا إلى عاد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة جواب القسم \"", "color": "black"}, {"text": "أرسلنا نوحًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئناف بياني.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يا قوم", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعبدوا", "color": "blue