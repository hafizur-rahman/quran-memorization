[{"row_id": 1, "segments": [{"text": "{ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ", "color": "brown"}, {"text": "(  الحج: 76  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَيْنَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب على الظرفية بالفتحة متعلّق بفعل محذوف وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَيْدِيهِمْ﴾:", "color": "green"}, {"text": "أيدي: مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "منع من ظهورها الثقل وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَا خَلْفَهُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما بين أيديهم", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَإِلَى اللَّهِ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "إلى الله: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ترجع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تُرْجَعُ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْأُمُورُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 1