[{"row_id": 1, "segments": [{"text": "{ لَيُدْخِلَنَّهُمْ مُدْخَلًا يَرْضَوْنَهُ وَإِنَّ اللَّهَ لَعَلِيمٌ حَلِيمٌ", "color": "brown"}, {"text": "(  الحج: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَيُدْخِلَنَّهُمْ مُدْخَلًا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "ليرزقهم رزقًا", "color": "blue"}, {"text": "\" في الآية الكريمة السابقة، وهو: « لَيَرْزُقَنَّهُمُ: اللام: واقعة في جواب قسم مقدر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وجواب الشرط محذوف دل عليه جواب القسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "يرزقن: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": لا محلّ لها من الإعراب، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع للتعظيم بالضمة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رِزْقًا﴾:", "color": "green"}, {"text": "مفعول مطلق - مصدر - منصوب بالفتحة».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "&لأنه بدل منها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَرْضَوْنَهُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَإِنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "إنّ: حرف نصب وتوكيد مشبّه بال