[{"row_id": 1, "segments": [{"text": "{ وَهُدُوا إِلَى الطَّيِّبِ مِنَ الْقَوْلِ وَهُدُوا إِلَى صِرَاطِ الْحَمِيدِ", "color": "brown"}, {"text": "(  الحج: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَهُدُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "هدوا: فعل ماضٍ مبنيّ للمجهول على الضم المقدر على الياء المحذوفة لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى الطَّيِّبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "هدوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ الْقَوْلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من الطيب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَهُدُوا إِلَى صِرَاطِ﴾:", "color": "green"}, {"text": "معطوفة على ما قبلها وتعرب إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْحَمِيدِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وهدوا", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]