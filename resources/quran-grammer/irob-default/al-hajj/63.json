[{"row_id": 1, "segments": [{"text": "{ أَلَمْ تَرَ أَنَّ اللَّهَ أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَتُصْبِحُ الْأَرْضُ مُخْضَرَّةً إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ", "color": "brown"}, {"text": "(  الحج: 63  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَرَ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف آخره حرف العلة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف نصب وتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب للتعظيم بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنْزَلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنَ السَّمَاءِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أنزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَاءً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَتُصْبِحُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والفعل المضارع بعدها معطوف على \"", "color": "black"}, {"text": "أنزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿تصبح﴾:", "colo