[{"row_id": 1, "segments": [{"text": "{ الْمُلْكُ يَوْمَئِذٍ لِلَّهِ يَحْكُمُ بَيْنَهُمْ فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي جَنَّاتِ النَّعِيمِ", "color": "brown"}, {"text": "(  الحج: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الْمُلْكُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إذ: اسم مبنيّ على السكون الذي حرك بالكسر تخلصًا من التقاء الساكنين: سكونه وسكون التنوين في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض للتعظيم متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَحْكُمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَيْنَهُمْ﴾:", "color": "green"}, {"text": "بين: ظرف مكان متعلق بـ\"", "color": "black"}, {"text": "يحكم", "color": "blue"}, {"text": "\" منصوب على الظرفية بالفتحة وهو مضاف، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَالَّذِينَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة فعل الشرط في محلّ جزم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَعَمِلُوا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الصَّالِحَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلًا من الفتحة، لأنه ملحق بجمع المؤنث السالم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿فِي جَنَّاتِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر المبتدأ محذوف تقديره: فهم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿النَّعِيمِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يحكم", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فَهُم في جنات النعيم", "color": "blue"}, {"text": "\" جواب شرط جازم مقترن بالفاء في محلّ جزم باسم الشرط \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "والجملة الشرطية من فعل الشرط وجوابه في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}]