[{"row_id": 1, "segments": [{"text": "{ وَلَنْ يُؤَخِّرَ اللَّهُ نَفْسًا إِذَا جَاءَ أَجَلُهَا وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ", "color": "brown"}, {"text": "(  المنافقون: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَنْ﴾:", "color": "green"}, {"text": "الواو حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لن: حرف نفي ونصب واستقبال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُؤَخِّرَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نَفْسًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن خافض لشرطه متعلق بجوابه متضمن معنى الشرط مبني على السكون في محل نصب مفعول فيه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَجَلُهَا﴾:", "color": "green"}, {"text": "أجل: فاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "الله: لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿خَبِيرٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بِم