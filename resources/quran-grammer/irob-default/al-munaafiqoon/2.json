[{"row_id": 1, "segments": [{"text": "{ اتَّخَذُوا أَيْمَانَهُمْ جُنَّةً فَصَدُّوا عَنْ سَبِيلِ اللَّهِ إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ", "color": "brown"}, {"text": "(  المنافقون: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "&انظر الآية السادسة عشرة من سورة المجادلة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ثم الآية الخامسة عشرة منها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو \n« اتَّخَذُوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَيْمَانَهُمْ جُنَّةً﴾:", "color": "green"}, {"text": "مفعولاً \"", "color": "black"}, {"text": "اتخذوا", "color": "blue"}, {"text": "\" منصوبان بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَصَدُّوا﴾:", "color": "green"}, {"text": "معطوفة بالفاء على \"", "color": "black"}, {"text": "اتخذوا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَنْ سَبِيلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "صدوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ إِنَّهُمْ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "colo