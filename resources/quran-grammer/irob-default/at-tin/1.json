[{"row_id": 1, "segments": [{"text": "سورة التين\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَالتِّينِ وَالزَّيْتُونِ", "color": "brown"}, {"text": "(  التين: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالتِّينِ﴾:", "color": "green"}, {"text": "الواو: حرف جر للقسم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "التين: اسم مقسم به مجرور بالكسرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالزَّيْتُونِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "التين", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة القسم الابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}]