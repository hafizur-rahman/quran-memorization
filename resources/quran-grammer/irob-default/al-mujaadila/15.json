[{"row_id": 1, "segments": [{"text": "{ أَعَدَّ اللَّهُ لَهُمْ عَذَابًا شَدِيدًا إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ", "color": "brown"}, {"text": "(  المجادلة: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَعَدَّ اللَّهُ لَهُمْ عَذَابًا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "غضب الله عليهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو \n« غَضِبَ: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "غضب", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ عذاباً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شَدِيدًا﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "عذاباً", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية التاسعة من سورة \"", "color": "black"}, {"text": "التوبة", "color": "blue"}, {"text": "\"، وفي الآية الثانية من سورة \"", "color": "black"}, {"text": "المنافقون", "color": "blue"}, {"text": "\".", "color": "b