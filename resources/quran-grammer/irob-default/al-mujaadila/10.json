[{"row_id": 1, "segments": [{"text": "{ إِنَّمَا النَّجْوَى مِنَ الشَّيْطَانِ لِيَحْزُنَ الَّذِينَ آمَنُوا وَلَيْسَ بِضَارِّهِمْ شَيْئًا إِلَّا بِإِذْنِ اللَّهِ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ", "color": "brown"}, {"text": "(  المجادلة: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد بطل عمله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف زائد وكافّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿النَّجْوَى﴾:", "color": "green"}, {"text": "مبتدأ مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ الشَّيْطَانِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِيَحْزُنَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "يحزن: فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة بعد اللام، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة وما بعدها بتأويل مصدر في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بمحذوف خبر ثانٍ لـ \"", "color": "black"}, {"text": "النجوى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَيْسَ﴾:", "color": "green"}, {"text": "الواو: واو الحال.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ليس: فعل ماضٍ ناقص مبنيّ على الفتح، واسمها ضمير مستتر فيه جوازاً تقديره: هو يعود على الشيطان أو الحزن.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بِضَارِّهِمْ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد للتوكيد.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "ضار: اسم مجرور لفظاً منصوب محلاً؛ لأنَّه خبر \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿شَيْئًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿بِإِذْنِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ضار", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿وَعَلَى اللَّهِ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "على الله: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يتوكلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿فَلْيَتَوَكَّلِ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "