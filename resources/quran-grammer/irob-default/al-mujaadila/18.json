[{"row_id": 1, "segments": [{"text": "{ يَوْمَ يَبْعَثُهُمُ اللَّهُ جَمِيعًا فَيَحْلِفُونَ لَهُ كَمَا يَحْلِفُونَ لَكُمْ وَيَحْسَبُونَ أَنَّهُمْ عَلَى شَيْءٍ أَلَا إِنَّهُمْ هُمُ الْكَاذِبُونَ", "color": "brown"}, {"text": "(  المجادلة: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "مفعول فيه منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "خالدين", "color": "blue"}, {"text": "\"، و\"يجوز أن يكون اسماً منصوباً بمضمر، أي مفعولاً به لفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَبْعَثُهُمُ﴾:", "color": "green"}, {"text": "يبعث: فعل مضارع مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿جَمِيعًا﴾:", "color": "green"}, {"text": "توكيد للضمير \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" أو حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَيَحْلِفُونَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "يحلفون: فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يحلفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كَمَا﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ للتشبيه.", "col