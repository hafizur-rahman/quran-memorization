[{"row_id": 1, "segments": [{"text": "{ إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَى", "color": "brown"}, {"text": "(  الليل: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿ابْتِغَاءَ﴾:", "color": "green"}, {"text": "مستثني منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ويجوز أن يكون مفعولًا له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والمعنى: لا يؤتي ماله إلا ابتغاء وجه ربه لا لمكافأة نعمه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَجْهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبِّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة\nالْأَعْلَى: صفة لـ\"", "color": "black"}, {"text": "الرب", "color": "blue"}, {"text": "\" مجرورة بالكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}]