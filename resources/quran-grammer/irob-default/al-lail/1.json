[{"row_id": 1, "segments": [{"text": "سورة الليل\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَاللَّيْلِ إِذَا يَغْشَى", "color": "brown"}, {"text": "(  الليل: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاللَّيْلِ إِذَا﴾:", "color": "green"}, {"text": "أعربت في الآية الثانية من سورة \"", "color": "black"}, {"text": "الشمس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : « وَالْقَمَرِ: الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿القمر﴾:", "color": "green"}, {"text": "مقسم به مجرور بالكسرة، والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ إِذَا﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب متعلّق بحال محذوفة من القمر، ».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَغْشَى﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يغشي", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]