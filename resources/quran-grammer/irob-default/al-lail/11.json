[{"row_id": 1, "segments": [{"text": "{ وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّى", "color": "brown"}, {"text": "(  الليل: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُغْنِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يغني", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَنْهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يغني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَالُهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول فيه يدل عليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تَرَدَّى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تردي", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]