[{"row_id": 1, "segments": [{"text": "{ وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَى", "color": "brown"}, {"text": "(  الليل: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لِأَحَدٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عِنْدَهُ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بنعمة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نِعْمَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظ مرفوع محلًا لأنه مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تُجْزَى﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بالضمة المقدّرة على الألف للتعذّر، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تجزي", "color": "blue"}, {"text": "\" في محلّ جرّ صفة لـ\"", "color": "black"}, {"text": "نعمة", "color": "blue"}, {"text": "\" على اللفظ وفي محلّ رفع على المحل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة المبتدأ والخبر استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]