[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ", "color": "brown"}, {"text": "(  البروج: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَتَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فتنوا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَالْمُؤْمِنَاتِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "المؤمنين", "color": "blue"}, {"text": "\" منصوبة بالكسرة بدلا من الفتحة، لأنّها جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ثُمَّ: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَتُوبُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"tex