[{"row_id": 1, "segments": [{"text": "{ سُنَّةَ مَنْ قَدْ أَرْسَلْنَا قَبْلَكَ مِنْ رُسُلِنَا وَلَا تَجِدُ لِسُنَّتِنَا تَحْوِيلًا", "color": "brown"}, {"text": "(  الإسراء: 77  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سُنَّةَ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بالفتحة لفعل محذوف، والتقدير: سننا ذلك سُنَّةَ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَرْسَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَبْلَكَ﴾:", "color": "green"}, {"text": "ظرف زمان متعلّق بـ\"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ رُسُلِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من مفعول \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\" المحذوف، أي: أرسلناه من رسلنا.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا تَجِدُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَجِدُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لِسُنَّتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف مفعول به ثان، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿تَحْوِيلًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سنتنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قد أرسلنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تجد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "سنتنا", "color": "blue"}, {"text": "\" المقدرة.", "color": "black"}]}]