[{"row_id": 1, "segments": [{"text": "{ وَأَنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا", "color": "brown"}, {"text": "(  الإسراء: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِالْآخِرَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَعْتَدْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أعتدنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَذَابًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَلِيمًا﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "عذابًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن ال