[{"row_id": 1, "segments": [{"text": "{ وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ وَلَا يَزِيدُ الظَّالِمِينَ إِلَّا خَسَارًا", "color": "brown"}, {"text": "(  الإسراء: 82  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَنُنَزِّلُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ننزل: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ الْقُرْآنِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ننزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿شِفَاءٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَرَحْمَةٌ﴾:", "color": "green"}, {"text": "معطوف على شفاء مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لِلْمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "شفاء ورحمة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وعلامة الجرّ الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يَزِيدُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والفاعل: ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الظَّالِمِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الياء.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف للحصر.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿خَسَارًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ننزل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو شفاء", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يزيد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الجملة الاستئنافيّة.", "color": "black"}]}]