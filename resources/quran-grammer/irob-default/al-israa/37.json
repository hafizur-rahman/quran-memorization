[{"row_id": 1, "segments": [{"text": "{ وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا إِنَّكَ لَنْ تَخْرِقَ الْأَرْضَ وَلَنْ تَبْلُغَ الْجِبَالَ طُولًا", "color": "brown"}, {"text": "(  الإسراء: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا تَمْشِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا تمش: مثل \"", "color": "black"}, {"text": "لا تقف", "color": "blue"}, {"text": "\" في الآية السابقة وهو: «", "color": "black"}, {"text": "وَلَا تَقْفُ: الواو: حرف عطف.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "لا تقف: مثل \"", "color": "black"}, {"text": "لا تجعل", "color": "blue"}, {"text": "\"، وعلامة الجزم حذف حرف العلة من آخر الفعل».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تمش", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَرَحًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِنَّكَ﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَنْ﴾:", "color": "green"}, {"text": "حرف نفي ونصب واستقبال.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تَخْرِقَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْأَرْضَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id":