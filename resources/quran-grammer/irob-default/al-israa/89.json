[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ صَرَّفْنَا لِلنَّاسِ فِي هَذَا الْقُرْآنِ مِنْ كُلِّ مَثَلٍ فَأَبَى أَكْثَرُ النَّاسِ إِلَّا كُفُورًا", "color": "brown"}, {"text": "(  الإسراء: 89  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: لام القسم لقسم مقدر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَرَّفْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ وفاعله مبنيّ على السكون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِلنَّاسِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "صرفنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هَذَا الْقُرْآنِ﴾:", "color": "green"}, {"text": "تقدم إعرابهما في الآية السابقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو: \n« هَذَا: ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ذا: اسم إشارة مبنيّ في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْقُرْآنِ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\" أو عطف بيان مجرور بالكسرة».", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والخافض والمخفوض متعلّقان بـ\"", "color": "black"}, {"text": "بصرفنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مِنْ كُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت لمفعول \"", "col