gments": [{"text": "ابتغوا: فعل ماض مبنيّ على الضم المقدر على الألف المحذوفة لالتقاء الساكنين، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِلَى ذِي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ابتغوا", "color": "blue"}, {"text": "\"، وعلامة الجرّ الياء، لأنه من الأسماء الخمسة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْعَرْشِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿سَبِيلًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ما يقولون", "color": "blue"}, {"text": "\" في محلّ جرّ بالكاف.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف مفعول مطلق، أي: لو كان معه آلهة كونًا كقولهم ,,,,,, إذًا لابتغوا.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لو كان معه آلهة", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقولون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ابتغوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}]