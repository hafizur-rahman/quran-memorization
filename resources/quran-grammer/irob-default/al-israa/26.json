[{"row_id": 1, "segments": [{"text": "{ وَآتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا", "color": "brown"}, {"text": "(  الإسراء: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَآتِ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "آت: فعل أمر مبنيّ على حذف حرف العلة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ذَا﴾:", "color": "green"}, {"text": "مفعول به أول منصوب، وعلامة النصب الألف، لأنه من الأسماء الخمسة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقُرْبَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الكسرة المقدرة على الألف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حَقَّهُ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالْمِسْكِينَ وَابْنَ السَّبِيلِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف في الموضعين.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "المسكين، وابن: اسمان معطوفان على \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\" منصوبان بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "السبيل: مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿تُبَذِرْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿تَبْذِيرًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تبذر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الجملة الاستئنافيّة.", "color": "black"}]}]