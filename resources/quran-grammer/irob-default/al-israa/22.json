[{"row_id": 1, "segments": [{"text": "{ لَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتَقْعُدَ مَذْمُومًا مَخْذُولًا", "color": "brown"}, {"text": "(  الإسراء: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي وجزم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَجْعَلْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَعَ﴾:", "color": "green"}, {"text": "ظرف منصوب بالفتحة متعلق بمحذوف مفعول ثان.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَهًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آخَرَ﴾:", "color": "green"}, {"text": "نعت لإله منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَتَقْعُدَ﴾:", "color": "green"}, {"text": "الفاء: فاء السببية، حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "تقعد: فعل مضارع منصوب بأن مضمرة بعد الفاء، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَذْمُومًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَخْذُولًا﴾:", "color": "green"}, {"text": "حال ثانية منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن تقعد", "color": "blue"}, {"text": "\" في محلّ رفع معطوف على مصدر متصيد من النهي السابق، أي: لا يكن منك جعل إله مع الله، فقعود.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تجعل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تقعد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}]