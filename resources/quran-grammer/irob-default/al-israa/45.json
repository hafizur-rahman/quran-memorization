[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قَرَأْتَ الْقُرْآنَ جَعَلْنَا بَيْنَكَ وَبَيْنَ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ حِجَابًا مَسْتُورًا", "color": "brown"}, {"text": "(  الإسراء: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف للزمن المستقبل متضمن معنى الشرط في محلّ نصب متعلّق بالجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَرَأْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ وفاعله مبنيّ على السكون، والتاء: ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقُرْآنَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿جَعَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَيْنَكَ﴾:", "color": "green"}, {"text": "بين: ظرف منصوب متعلّق بفعل \"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَبَيْنَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "بين: مثل \"", "color": "black"}, {"text": "بين", "color": "blue"}, {"text": "\" الأول ومعطوف عليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "bl