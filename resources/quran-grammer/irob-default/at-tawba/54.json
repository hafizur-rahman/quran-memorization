[{"row_id": 1, "segments": [{"text": "{ وَمَا مَنَعَهُمْ أَنْ تُقْبَلَ مِنْهُمْ نَفَقَاتُهُمْ إِلَّا أَنَّهُمْ كَفَرُوا بِاللَّهِ وَبِرَسُولِهِ وَلَا يَأْتُونَ الصَّلَاةَ إِلَّا وَهُمْ كُسَالَى وَلَا يُنْفِقُونَ إِلَّا وَهُمْ كَارِهُونَ", "color": "brown"}, {"text": "(  التوبة: 54  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَمَا: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنَعَهُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَن﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُقْبَلَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تقبل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَفَقَاتُهُمْ﴾:", "color": "green"}, {"text": "نفقات: نائب الفاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن تقبل", "color": "blue"}, {"text": "\" في محلّ جرّ بحرف جرّ محذوف، أي: من أن تقبل، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "منع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَّآ﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَنَّهُمْ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"tex