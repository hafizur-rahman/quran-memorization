[{"row_id": 1, "segments": [{"text": "{ يَوْمَ يُحْمَى عَلَيْهَا فِي نَارِ جَهَنَّمَ فَتُكْوَى بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ هَذَا مَا كَنَزْتُمْ لِأَنْفُسِكُمْ فَذُوقُوا مَا كُنْتُمْ تَكْنِزُونَ", "color": "brown"}, {"text": "(  التوبة: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بمحذوف يدلّ عليه \"", "color": "black"}, {"text": "عذاب", "color": "blue"}, {"text": "\" في الآية السابقة، أي: يعذبون يوم ,,,\nيُحْمَى: فعل مضارع للمجهول مرفوع، وعلامة الرفع الضمة المقدرة على الألف، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: الوقود.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَيْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يحمى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي نَارِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يحمى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَهَنَّمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَتُكْوَى﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "تكوي: مثل \"", "color": "black"}, {"text": "يحمى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تكوي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿جِبَاهُهُمْ﴾:", "color": "green"}, {"text": "جباه: نائب الفاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَ