[{"row_id": 1, "segments": [{"text": "{ أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ سِرَّهُمْ وَنَجْوَاهُمْ وَأَنَّ اللَّهَ عَلَّامُ الْغُيُوبِ", "color": "brown"}, {"text": "(  التوبة: 78  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَعْلَمُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف النّون، والفاعل: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، والفاعل: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿سِرَّهُمْ﴾:", "color": "green"}, {"text": "سر: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَنَجْوَاهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "نجواهم: اسم معطوف على \"", "color": "black"}, {"text": "سرّهم", "color": "blue"}, {"text": "\" منصوب، وعلامة النصب الفتحة المقدّرة على الألف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَأَنَّ اللَّهَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "أن الله: مثل الأول.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿عَلَّامُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"tex