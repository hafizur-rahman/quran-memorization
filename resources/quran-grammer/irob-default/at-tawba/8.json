[{"row_id": 1, "segments": [{"text": "{ كَيْفَ وَإِنْ يَظْهَرُوا عَلَيْكُمْ لَا يَرْقُبُوا فِيكُمْ إِلًّا وَلَا ذِمَّةً يُرْضُونَكُمْ بِأَفْوَاهِهِمْ وَتَأْبَى قُلُوبُهُمْ وَأَكْثَرُهُمْ فَاسِقُونَ", "color": "brown"}, {"text": "(  التوبة: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَيْفَ﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ في محلّ نصب خبر \"", "color": "black"}, {"text": "يكون", "color": "blue"}, {"text": "\" المحذوف، دلّ عليه المذكور، أي: كيف يكون لهم عهد، وهو تكرار لاستبعاد ثباتهم على العهد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَظْهَرُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم فعل الشرط، وعلامة الجزم حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَيْكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يظهروا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَرْقُبُوا﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يظهروا", "color": "blue"}, {"text": "\"، جواب الشرط.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِيكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يرقبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلًّا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا: حرف زائد لتأكيد النف