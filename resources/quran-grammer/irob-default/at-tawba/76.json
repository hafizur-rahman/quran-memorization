[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا آتَاهُمْ مِنْ فَضْلِهِ بَخِلُوا بِهِ وَتَوَلَّوْا وَهُمْ مُعْرِضُونَ", "color": "brown"}, {"text": "(  التوبة: 76  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: ظرف زمان متضمن معنى الشرط مبنيّ في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آتَاهُمْ مِنْ فَضْلِهِ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "آتانا من فضله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو «آتَانَا: آتي: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف، في محلّ جزم فعل الشرط، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به، والفاعل: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ فَضْلِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "آتي", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مضاف إليه».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَخِلُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "بخلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَتَوَلَّوْا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "تولوا: فعل ماضٍ مبنيّ على الضم المقدّر على الألف المحذوفة لالتقاء الساكنين، والواو: فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "هم: ض