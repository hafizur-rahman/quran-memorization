[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا آبَاءَكُمْ وَإِخْوَانَكُمْ أَوْلِيَاءَ إِنِ اسْتَحَبُّوا الْكُفْرَ عَلَى الْإِيمَانِ وَمَنْ يَتَوَلَّهُمْ مِنْكُمْ فَأُولَئِكَ هُمُ الظَّالِمُونَ", "color": "brown"}, {"text": "(  التوبة: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أي: منادى مبنيّ على الضم في محلّ نصب مفعول به لفعل النداء المحذوف، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف تنبيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الضم في محلّ رفع به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَتَّخِذُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، وعلامة الجزم حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آبَاءَكُمْ﴾:", "color": "green"}, {"text": "آباء: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَإِخْوانَكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "إخوانكم: اسم معطوف على \"", "color": "black"}, {"text": "آباء", "color": "blue"}, {"text": "\" ومضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَوْلِيَاءَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة، ولم ينون؛ لأنه ممنوع من الصرف، جمع على وزن أفعلاء.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِنِ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿اسْتَحَبُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، في محلّ جزم فعل الشرط، والواو: فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْكُفْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿عَلَى الْإِيمَانِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "استحبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "من: اسم شرط جازم مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿يَتَوَلَّهُم﴾:", "color": "green"}, {"text": "يتول: فعل مضارع مجزوم فعل الشرط، وعلامة الجزم حذف حرف العلة، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مفعول به، والفاعل: ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿مِنْكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف حال من فاعل \"", "color": "black"}, {"text": "يتولهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿فَأُولَئِكَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "أولئك: اسم إشارة مبنيّ في محلّ رفع مبتدأ، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف خطاب.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿هُمُ﴾:", "color": "green"}, {"text": "ضمير فصل.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿الظَّالِمُونَ﴾:", "color": "green"}, {"text": "خبر المبتدأ \"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\" مرفوع بالواو.