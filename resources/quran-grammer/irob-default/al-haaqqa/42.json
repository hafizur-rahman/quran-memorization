[{"row_id": 1, "segments": [{"text": "{ وَلَا بِقَوْلِ كَاهِنٍ قَلِيلًا مَا تَذَكَّرُونَ", "color": "brown"}, {"text": "(  الحاقة: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « ما: حرف نفي بمنزل \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة الحجازيين، ونافية لا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، ومبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِقَوْلِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "قول: اسم مجرور لفظًا منصوب محلًا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" أو مرفوع محلًا على أنه خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\"، وعلامة نصبه أو رفعه فتحة أو ضمة في آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَاعِرٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف زائد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما هو بقول", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جواب القسم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تؤمنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها اعتراضية».", "color": "black"}]}]