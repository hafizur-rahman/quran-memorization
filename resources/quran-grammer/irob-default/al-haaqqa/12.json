[{"row_id": 1, "segments": [{"text": "{ لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَا أُذُنٌ وَاعِيَةٌ", "color": "brown"}, {"text": "(  الحاقة: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِنَجْعَلَهَا﴾:", "color": "green"}, {"text": "اللام: حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "نجعل: فعل مضارع منصوب بأن مضمرة بعد اللام، وعلامة نصبه بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة وما بعدها بتأويل مصدر في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نجعل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَذْكِرَةً﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَتَعِيَهَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "نجعلها", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أُذُنٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَاعِيَةٌ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "أذن", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نجعلها", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّه