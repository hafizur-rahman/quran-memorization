[{"row_id": 1, "segments": [{"text": "{ فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَيَقُولُ هَاؤُمُ اقْرَءُوا كِتَابِيَهْ", "color": "brown"}, {"text": "(  الحاقة: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَمَّا﴾:", "color": "green"}, {"text": "حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أما: حرف شرط وتفصيل مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أُوتِيَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كِتَابَهُ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِيَمِينِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أوتي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والهاء\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَيَقُولُ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب \"", "color": "black"}, {"text": "أما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "يقول: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿هَاؤُمُ﴾:", "color": "green"}, {"text": "اسم فعل أمر بمعنى \"", "color": "black"}, {"text": "خذ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اقْرَءُوا﴾:", "color": "green"}, {"text": "فعل أمر