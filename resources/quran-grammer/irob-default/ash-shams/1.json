[{"row_id": 1, "segments": [{"text": "سورة الشمس\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَالشَّمْسِ وَضُحَاهَا", "color": "brown"}, {"text": "(  الشمس: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالشَّمْسِ﴾:", "color": "green"}, {"text": "الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الشمس: مقسم به مجرور بالكسرة، والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَضُحَاهَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "الشمس", "color": "blue"}, {"text": "\" مجرورة بالكسرة المقدّرة على الألف للتعذّر، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة القسم ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}]