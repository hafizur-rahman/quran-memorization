[{"row_id": 1, "segments": [{"text": "{ وَالنَّهَارِ إِذَا جَلَّاهَا", "color": "brown"}, {"text": "(  الشمس: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية الثانية.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: \n«", "color": "black"}, {"text": "وَالْقَمَرِ: الواو: حرف جرّ للقسم.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "القمر : مقسم به مجرور بالكسرة، والجارّ والمجرور متعلّقان بفعل القسم المحذوف».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب متعلّق بحال محذوفة من القمر، والتقدير: وأقسم بالقمر كائنًا إذا تلاها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَلَاهَا﴾:", "color": "green"}, {"text": "فعل ماضٍ نبني على الفتح المقدّر على الألف للتعذر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تلاها", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة».", "color": "black"}]}]