[{"row_id": 1, "segments": [{"text": "{ وَقَدْ خَابَ مَنْ دَسَّاهَا", "color": "brown"}, {"text": "(  الشمس: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَدْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : \n« قَدْ: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَفْلَحَ﴾:", "color": "green"}, {"text": "فعل ماضٍ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿زَكَّاهَا﴾:", "color": "green"}, {"text": "زكى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أفلح", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب».", "color": "black"}]}]