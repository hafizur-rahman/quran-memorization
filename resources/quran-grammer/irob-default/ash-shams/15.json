[{"row_id": 1, "segments": [{"text": "{ وَلَا يَخَافُ عُقْبَاهَا", "color": "brown"}, {"text": "(  الشمس: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف أو حالية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَخَافُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عُقْبَاهَا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يخاف", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب، أو في محلّ نصب حال.", "color": "black"}]}]