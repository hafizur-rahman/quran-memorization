[{"row_id": 1, "segments": [{"text": "{ لَأَنْتُمْ أَشَدُّ رَهْبَةً فِي صُدُورِهِمْ مِنَ اللَّهِ ذَلِكَ بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ", "color": "brown"}, {"text": "(  الحشر: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَأَنْتُمْ﴾:", "color": "green"}, {"text": "اللام: حرف للابتداء والتوكيد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنتم: ضمير رفع منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَشَدُّ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنتم", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَهْبَةً﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي صُدُورِهِمْ﴾:", "color": "green"}, {"text": "في صدور: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "رهبة", "color": "blue"}, {"text": "\" أو بصفة محذوفة لها، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "رهبة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 12, "segments": [{"te