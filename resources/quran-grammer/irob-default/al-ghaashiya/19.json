[{"row_id": 1, "segments": [{"text": "{ وَإِلَى الْجِبَالِ كَيْفَ نُصِبَتْ", "color": "brown"}, {"text": "(  الغاشية: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِلَى﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية السابعة عشرة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : \n« إِلَى الْإِبِلِ: جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "ينظرون", "color": "blue"}, {"text": "\"\nكَيْفَ: اسم استفهام مبنيّ على الفتح في محلّ نصب حال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خُلِقَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ينظرون", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خُلقت", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به للفعل ينظرون\"».", "color": "black"}]}]