[{"row_id": 1, "segments": [{"text": "{ فَذَكِّرْ إِنَّمَا أَنْتَ مُذَكِّرٌ", "color": "brown"}, {"text": "(  الغاشية: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَذَكِّرْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذَكِّرْ: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد بطل عمله.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: حرف زائد وكافّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مُذَكِّرٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب، وكذلك جملة \"", "color": "black"}, {"text": "إنما أنت مذكر", "color": "blue"}, {"text": "\".", "color": "black"}]}]