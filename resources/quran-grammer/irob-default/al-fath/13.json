[{"row_id": 1, "segments": [{"text": "{ وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا", "color": "brown"}, {"text": "(  الفتح: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يُؤْمِنْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\" بالسكون وهو فعل الشرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِاللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بـ\"", "color": "black"}, {"text": "يؤمن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَرَسُولِهِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "رسوله: معطوف على اسم الجلالة \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\" مجرور بالكسرة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَإِنَّا﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب الشرط \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text":