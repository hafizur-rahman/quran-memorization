[{"row_id": 1, "segments": [{"text": "{ لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَمَنْ يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا", "color": "brown"}, {"text": "(  الفتح: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَيْسَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَى الْأَعْمَى﴾:", "color": "green"}, {"text": "على: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "الأعمى: اسم مجرور بالكسرة المقدّرة على الألف للتعذّر، والجار والمجرور متعلّقان بخبر \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿حَرَجٌ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملتان بعدها معطوفتان عليها وتعربان إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ و \"", "color": "green"}, {"text": "لا", "color": "green"}, {"text": "\": زائدة وما بعدها سبق إعرابه في الآية الثالثة عشرة من سورة النساء.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "وهو « وَمَنْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "من: اسم شرط جازم مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يُطِعِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنه فعل الشرط، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَرَسُولَهُ﴾:", "color": "green"}, {"text": "الواو: حرف عط