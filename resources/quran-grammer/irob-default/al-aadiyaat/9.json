[{"row_id": 1, "segments": [{"text": "{ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ", "color": "brown"}, {"text": "(  العاديات: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَفَلَا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه، متعلّق بجوابه متضمن معنى الشرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بُعْثِرَ﴾:", "color": "green"}, {"text": "فعل ماض للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِي الْقُبُورِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصلة الموصول المحذوفة، والتقدير: ما استقر في القبور.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة استقر في القبور صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها م الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بعثر", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملة الشرطية سدت مسد مفعولي \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}]