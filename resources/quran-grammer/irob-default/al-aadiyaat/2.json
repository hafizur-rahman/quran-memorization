[{"row_id": 1, "segments": [{"text": "{ فَالْمُورِيَاتِ قَدْحًا", "color": "brown"}, {"text": "(  العاديات: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَالْمُورِيَاتِ﴾:", "color": "green"}, {"text": "معطوفة بالفاء على الآية السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : « وَالْعَادِيَاتِ: الواو: جرف جرّ للقسم العاديات: اسم مجرور بواو القسم وعلامة جره الكسرة، والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة القسم ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ضَبْحًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بفعل مضمر تقديره: \"", "color": "black"}, {"text": "يضبحن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يضبحن ضبحًا", "color": "blue"}, {"text": "\" في محلّ نصب حال».", "color": "black"}]}]