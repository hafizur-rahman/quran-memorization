[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ", "color": "brown"}, {"text": "(  التكوير: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف للابتداء وللتوكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَآهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، يعود على الرسول الكريم محمد - صلى الله عليه وسلم -.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِالْأُفُقِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُبِينِ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "الأفق", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قد رآه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "ما صاحبكم بمجنون", "color": "blue"}, {"text": "\".", "color": "black"}]}]