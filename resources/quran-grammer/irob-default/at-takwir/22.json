[{"row_id": 1, "segments": [{"text": "{ وَمَا صَاحِبُكُمْ بِمَجْنُونٍ", "color": "brown"}, {"text": "(  التكوير: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي يعمل عمل \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة الحجازيين ونافية مهملة في لغة بني تميم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿صَاحِبُكُمْ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، ومبتدأ على اللغة الثانية مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِمَجْنُونٍ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "مجنون: خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" أو خبر المبتدأ مجرور لفظا منصوب محلا على اللغة الأولى ومرفوع على اللغة الثانية.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما صاحبكم بمجنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جواب القسم.", "color": "black"}]}]