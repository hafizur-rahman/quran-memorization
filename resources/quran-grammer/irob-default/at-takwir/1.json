[{"row_id": 1, "segments": [{"text": "{ إِذَا الشَّمْسُ كُوِّرَتْ", "color": "brown"}, {"text": "(  التكوير: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن متضمن معنى الشرط خافض لشرطه منصوب بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الشَّمْسُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع بفعل مضمر يفسره \"", "color": "black"}, {"text": "كورت", "color": "blue"}, {"text": "\"، وعلامة نصبه الضمة الظاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كُوِّرَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث الساكنة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كورت الشمس", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة الشرط وفعله وجواب لا محلّ لها من الإعراب، لأنّها ابتدائية.", "color": "black"}]}]