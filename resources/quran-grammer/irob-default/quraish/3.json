[{"row_id": 1, "segments": [{"text": "{ فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ", "color": "brown"}, {"text": "(  قريش: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلْيَعْبُدُوا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب شرط مقدّر، أي: إن نعم الله عليهم لا تحصى، فإن لم يعبدوه لسائر نعمه، فليعبدوه لهذه النعمة الظاهرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿واللام﴾:", "color": "green"}, {"text": "لام الأمر حرف جزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "يعبدوا: فعل مضارع مجزوم باللام، وعلامة جزمه حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبَّ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْبَيْتِ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مجرور بالكسرة.", "color": "black"}]}]