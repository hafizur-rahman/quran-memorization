[{"row_id": 1, "segments": [{"text": "{ وَلَا تَجْعَلُوا مَعَ اللَّهِ إِلَهًا آخَرَ إِنِّي لَكُمْ مِنْهُ نَذِيرٌ مُبِينٌ", "color": "brown"}, {"text": "(  الذاريات: 51  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَجْعَلُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَعَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بحال محذوفة من \"", "color": "black"}, {"text": "إلهًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَهًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آخَرَ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "إلهًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنِّي لَكُمْ مِنْهُ نَذِيرٌ مُبِينٌ﴾:", "color": "green"}, {"text": "سبق إعرابها في الآية السابقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو « إِنِّي: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "