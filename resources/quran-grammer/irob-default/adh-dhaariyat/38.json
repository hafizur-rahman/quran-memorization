[{"row_id": 1, "segments": [{"text": "{ وَفِي مُوسَى إِذْ أَرْسَلْنَاهُ إِلَى فِرْعَوْنَ بِسُلْطَانٍ مُبِينٍ", "color": "brown"}, {"text": "(  الذاريات: 38  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَفِي مُوسَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "في: حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "موسى: اسم مجرور بالفتحة المقدّرة على الألف بدلًا من الكسرة، لانه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل محذوف تقديره: \"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\"، أو \"", "color": "black"}, {"text": "تركنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بـ\"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\" أو \"", "color": "black"}, {"text": "تركنا", "color": "blue"}, {"text": "\"\nأَرْسَلْنَاهُ: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَى فِرْعَوْنَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ارسلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وفرعون: اسم مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِسُلْطَانٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color":