[{"row_id": 1, "segments": [{"text": "{ فَإِنَّ لِلَّذِينَ ظَلَمُوا ذَنُوبًا مِثْلَ ذَنُوبِ أَصْحَابِهِمْ فَلَا يَسْتَعْجِلُونِ", "color": "brown"}, {"text": "(  الذاريات: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لِلَّذِينَ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ظَلَمُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ذَنُوبًا﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِثْلَ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "ذنوبًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ذَنُوبِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة وهو مضاف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَصْحَابِهِمْ﴾:", "color": "green"}, {"text": "أصحاب: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\"