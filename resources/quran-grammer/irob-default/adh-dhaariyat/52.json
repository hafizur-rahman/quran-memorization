[{"row_id": 1, "segments": [{"text": "{ كَذَلِكَ مَا أَتَى الَّذِينَ مِنْ قَبْلِهِمْ مِنْ رَسُولٍ إِلَّا قَالُوا سَاحِرٌ أَوْ مَجْنُونٌ", "color": "brown"}, {"text": "(  الذاريات: 52  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ رفع خبر مبتدأ محذوف تقديره: الأمر كذلك، أو تكون في محلّ رفع مبتدأ، وخبرها محذوف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَتَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ قَبْلِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بفعل مضمر بتقدير: وجد من قبلهم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَسُولٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا، لأنه فاعل \"", "color": "black"}, {"text": "أتى", "color": "b