[{"row_id": 1, "segments": [{"text": "{ وَمَا خَلَقْتُ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُونِ", "color": "brown"}, {"text": "(  الذاريات: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَلَقْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْجِنَّ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالْإِنْسَ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "الجن", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف تحقيق وحصر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِيَعْبُدُونِ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "يعبدون: فعل مضارع منصوب بحذف النون، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون الوقاية، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة وما تلاها في تأويل مصدر في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "خلقت", "color": "blu