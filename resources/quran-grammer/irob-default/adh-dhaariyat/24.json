[{"row_id": 1, "segments": [{"text": "{ هَلْ أَتَاكَ حَدِيثُ ضَيْفِ إِبْرَاهِيمَ الْمُكْرَمِينَ", "color": "brown"}, {"text": "(  الذاريات: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هَلْ﴾:", "color": "green"}, {"text": "حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَتَاكَ﴾:", "color": "green"}, {"text": "أتي: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿حَدِيثُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ضَيْفِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِبْرَاهِيمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُكْرَمِينَ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "ضيف", "color": "blue"}, {"text": "\" مجرورة بالياء، لأنها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أَتاك حديث", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]