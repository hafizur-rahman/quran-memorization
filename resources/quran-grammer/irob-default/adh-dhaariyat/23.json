[{"row_id": 1, "segments": [{"text": "{ فَوَرَبِّ السَّمَاءِ وَالْأَرْضِ إِنَّهُ لَحَقٌّ مِثْلَ مَا أَنَّكُمْ تَنْطِقُونَ", "color": "brown"}, {"text": "(  الذاريات: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَوَرَبِّ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الواو: واو القسم حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "رب: اسم مجرور بالكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿السَّمَاءِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "السماء", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنَّهُ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل واقع في جواب القسم، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَحَقٌّ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "حق: خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِثْلَ﴾:", "color": "green"}, {"text": "صفة لمصدر محذوف بتقدير لحق حقًّا مثل منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف زائد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَنَّكُمْ﴾:", "color": "green"}, {"text": "أن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿تَنْطِقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" واسمها وخبرها بتأويل مصدر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم برب السماء", "color": "blue"}, {"text": "\" لا محلّ لها معطوفة على جملة \"", "color": "black"}, {"text": "في السماء رزقكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنه لحق", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تنطقون", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}]