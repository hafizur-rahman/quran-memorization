[{"row_id": 1, "segments": [{"text": "{ فَأَوْجَسَ مِنْهُمْ خِيفَةً قَالُوا لَا تَخَفْ وَبَشَّرُوهُ بِغُلَامٍ عَلِيمٍ", "color": "brown"}, {"text": "(  الذاريات: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَوْجَسَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أوجس: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "من: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "أوجس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿خِيفَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "أو مفعول لأجله.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَخَفْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_