[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ", "color": "brown"}, {"text": "(  الانشقاق: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن خافض لشرطه متعلّق بجوابه متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قُرِئَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَيْهِمُ﴾:", "color": "green"}, {"text": "على: حرف جرّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجار والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "قريء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْقُرْآنُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَسْجُدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قرئ", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يسجدون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}]