[{"row_id": 1, "segments": [{"text": "{ وَيَنْقَلِبُ إِلَى أَهْلِهِ مَسْرُورًا", "color": "brown"}, {"text": "(  الانشقاق: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيَنْقَلِبُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ينقلب: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى أَهْلِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ينقلب", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَسْرُورًا﴾:", "color": "green"}, {"text": "حال من الضمير منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ينقلب", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "يحاسب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]