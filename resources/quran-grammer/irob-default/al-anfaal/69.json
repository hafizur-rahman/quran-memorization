[{"row_id": 1, "segments": [{"text": "{ فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ", "color": "brown"}, {"text": "(  الأنفال: 69  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكُلُوا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كلوا: فعل أمر مبنيّ على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِمَّا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "كلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: مثل السابق\nغَنِمْتُمْ: فعل ماض مبنيّ على السكون، والتاء: فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حَلَالًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿طَيِّبًا﴾:", "color": "green"}, {"text": "حال ثانية منصوبة بالفتحة، أو نعت لـ \"", "color": "black"}, {"text": "حلالًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَاتَّقُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "اتقوا: مثل \"", "color": "black"}, {"text": "كلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿غَفُورٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة