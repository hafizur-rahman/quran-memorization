[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ", "color": "brown"}, {"text": "(  الأنفال: 51  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ما: حرف مصدريّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَدَّمَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": للتأنيث.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَيْدِيكُمْ﴾:", "color": "green"}, {"text": "أيدي: فاعل مرفوع، وعلامة الرفع الضمة المقدّرة على الياء، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ما قدمت أيديكم", "color": "blue"}, {"text": "\" في محلّ جرّ بالباء، والجار والمجرور متعلّقان بمحذوف خبر المبتدأ \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَأَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "أن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَيْسَ﴾:", "color": "green"}, {"text": "فعل