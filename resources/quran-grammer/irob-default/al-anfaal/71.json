[{"row_id": 1, "segments": [{"text": "{ وَإِنْ يُرِيدُوا خِيَانَتَكَ فَقَدْ خَانُوا اللَّهَ مِنْ قَبْلُ فَأَمْكَنَ مِنْهُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ", "color": "brown"}, {"text": "(  الأنفال: 71  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُرِيدُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم فعل الشرط، وعلامة الجزم حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿خِيَانَتَكَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَقَدْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿خَانُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿قَبْلُ﴾:", "color": "green"}, {"text": "اسم مبنيّ على الضم في محلّ جرّ، والجار والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "خانوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَأَمْكَنَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "أمكن: فعل ماضٍ مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 14, "segments": [{"text