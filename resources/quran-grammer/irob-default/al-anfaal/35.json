[{"row_id": 1, "segments": [{"text": "{ وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ", "color": "brown"}, {"text": "(  الأنفال: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبني على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَلَاتُهُمْ﴾:", "color": "green"}, {"text": "صلاة: اسم كان مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلق بمحذوف حال من \"", "color": "black"}, {"text": "الصلاة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْبَيْتِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُكَاءً﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَتَصْدِيَةً﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "تصدية: اسم معطوف على \"", "color": "black"}, {"text": "مكاء", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَذُوقُوا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "ذوقوا: فعل أمر مبني على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْعَذَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "ما: حرف مصدريّ.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبني على السكون، والتاء: اسمها.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿تَكْفُرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "ما كان صلاتهم", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذوقوا العذاب", "color": "blue"}, {"text": "\" في محل جزم جواب شرط مقدر، أي: إن كانت هذه طبيعة صلاتكم فذوقوا.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كنتم تكفرون", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة (تكفرون\"", "color": "black"}, {"text": "في محل نصب خبر", "color": "blue"}, {"text": "\"كنتم\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 23, "segments": [{"text": "والمصدر المؤول من \"ما كنتم تكفرون\"", "color": "black"}, {"text": "في محل جر بالباء، والجار والمجرور متعلقان بـ", "color": "blue"}, {"text": "\"ذوقوا\".", "color": "black"}]}]