[{"row_id": 1, "segments": [{"text": "{ وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ", "color": "brown"}, {"text": "(  الأنفال: 73  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الذين: اسم موصول مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ﴾:", "color": "green"}, {"text": "مرّ إعرابها في الآية السابقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وهو :«بَعْضُهُمْ: بعض: مبتدأ ثان مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَوْلِيَاءُ﴾:", "color": "green"}, {"text": "خبر المبتدأ \"", "color": "black"}, {"text": "بعض", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَعْضٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا حرف نفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَفْعَلُوهُ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم فعل الشرط، وعلامة الجزم حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿تَكُنْ﴾:", "color": "green"}, {"text": "فع