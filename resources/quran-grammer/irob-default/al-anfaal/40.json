[{"row_id": 1, "segments": [{"text": "{ وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ", "color": "brown"}, {"text": "(  الأنفال: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَوَلَّوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدر على الألف المحذوفة في محلّ جزم فعل الشرط، والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَاعْلَمُوا﴾:", "color": "green"}, {"text": "الفاء: تعليلية.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "اعلموا: فعل أمر مبنيّ على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَوْلَاكُمْ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" مرفوع بالضمة المقدّرة على الألف، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿نِعْمَ﴾:", "color": "green"}, {"text": "فعل ماضٍ جامد لإنشاء المدح مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمَوْلَى﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الضمة المقدّرة على الألف، والمخصوص بالمدح محذوف تقديره: الله.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَنِعْمَ النَّصِيرُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "نعم النصير: مثل \"", "color": "black"}, {"text": "نعم المولى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن الله مولاكم", "color": "blue"}, {"text": "\" في محلّ نصب سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "اعلموا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ تولوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "إن انتهوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعلموا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تعليل للجواب المحذوف، أي: إنّ تولوا فلا تخشوا بأسهم، لأن الله مولاكم، أو الجملة جواب الشرط في محلّ جزم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نعم المولى", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نعم النصير", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "نعم المولى", "color": "blue"}, {"text": "\".", "color": "black"}]}]