[{"row_id": 1, "segments": [{"text": "{ لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ", "color": "brown"}, {"text": "(  الأنفال: 68  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَوْلَا﴾:", "color": "green"}, {"text": "حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿كِتَابٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، والخبر محذوف وجوبا تقديره: موجود.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت لـ \"", "color": "black"}, {"text": "كتاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَبَقَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، والفاعل: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَمَسَّكُمْ﴾:", "color": "green"}, {"text": "اللام: حرف رابط لجواب \"", "color": "black"}, {"text": "لولا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "مس: فعل ماضٍ مبنيّ على الفتح، والفاعل: هو، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِيمَا﴾:", "color": "green"}, {"text": "في: حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ما: اسم موصول مبنيّ في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "مسكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَخَذْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون، و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿عَذَابٌ﴾:", "color": "green"}, {"text": "فاعل \"", "color": "black"}, {"text": "مسكم", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره