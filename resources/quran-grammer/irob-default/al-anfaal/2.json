[{"row_id": 1, "segments": [{"text": "{ إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ", "color": "brown"}, {"text": "(  الأنفال: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مشبّه بالفعل، بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافّة عليه، و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف كافت لا محلّ له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْمُؤْمِنُونَ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف للزمن المستقبل متضمن معنى الشرط مبنيّ في محلّ نصب مفعول به متعلّق بالجواب \"", "color": "black"}, {"text": "وجلت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ذُكِرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة نائب الفاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَجِلَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والتاء: للتأنيث.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قُلُوبُهُمْ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهم: ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black