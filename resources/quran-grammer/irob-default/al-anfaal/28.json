[{"row_id": 1, "segments": [{"text": "{ وَاعْلَمُوا أَنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَأَنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ", "color": "brown"}, {"text": "(  الأنفال: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاعْلَمُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اعلموا: فعل أمر مبني على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنَّمَا﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل، بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافّة عليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَمْوَالُكُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَأَوْلَادُكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "أولاد: معطوف على \"", "color": "black"}, {"text": "أموال", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِتْنَةٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَأَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "أنّ: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id":