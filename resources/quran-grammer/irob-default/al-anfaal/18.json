[{"row_id": 1, "segments": [{"text": "{ ذَلِكُمْ وَأَنَّ اللَّهَ مُوهِنُ كَيْدِ الْكَافِرِينَ", "color": "brown"}, {"text": "(  الأنفال: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكُمْ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبني في محل رفع مبتدأ خبره محذوف تقديره: حاصل، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و \"", "color": "black"}, {"text": "الكاف حرف خطاب و", "color": "blue"}, {"text": "\"الميم\": حرف لجمع الذكور.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَأَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أن: حرف توكيد مشبّه للفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُوهِنُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كَيْدِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْكَافِرِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجر الياء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن الله موهن", "color": "blue"}, {"text": "\" في محل رفع مبتدأ خبره محذوف تقديره: حق.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذلكم", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( حق )", "color": "green"}, {"text": "لا محل لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة المصدر المؤول وخبره لا محل لها من الإعراب، لأنها معطوفة على الاستئنافية، أي: ذلك الإبلاء حق وتوهين