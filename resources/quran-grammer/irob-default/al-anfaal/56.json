[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ عَاهَدْتَ مِنْهُمْ ثُمَّ يَنْقُضُونَ عَهْدَهُمْ فِي كُلِّ مَرَّةٍ وَهُمْ لَا يَتَّقُونَ", "color": "brown"}, {"text": "(  الأنفال: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "بدل من الأول في الآية السابقة، مبنيّ في محلّ رفع.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَاهَدْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، والتاء: فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من العائد المحذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَنْقُضُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَهْدَهُمْ﴾:", "color": "green"}, {"text": "عهد: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي كُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ينقضون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَرَّةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَهُمْ لَا يَتَّقُونَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "هم لا يتقون: مثل \"", "color": "black"}, {"text": "هم لا يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وهو « هم : ضمير منفصل مبني في محل رفع مبتدأ .", "color": "black"}]}, {"row_id": 13, "segments": [{"t