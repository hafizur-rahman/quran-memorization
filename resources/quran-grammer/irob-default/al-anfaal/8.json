[{"row_id": 1, "segments": [{"text": "{ لِيُحِقَّ الْحَقَّ وَيُبْطِلَ الْبَاطِلَ وَلَوْ كَرِهَ الْمُجْرِمُونَ", "color": "brown"}, {"text": "(  الأنفال: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِيُحِقَّ﴾:", "color": "green"}, {"text": "اللام: لام التعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يحق: فعل مضارع منصوب بأن مضمرة بعد اللام، والفاعل: هو، أي: الله.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْحَقَّ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَيُبْطِلَ الْبَاطِلَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "يبطل الباطل: مثل \"", "color": "black"}, {"text": "يحق الحق", "color": "blue"}, {"text": "\" ومعطوف عليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَرِهَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْمُجْرِمُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يحق", "color": "blue"}, {"text": "\" في محل جر باللام، والجار والمجرور متعلقان بفعل محذوف تقديره: أمركم بالقتال.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يحق الحق", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يبطل", "color": "blue"}, {"text": "\" لا محل