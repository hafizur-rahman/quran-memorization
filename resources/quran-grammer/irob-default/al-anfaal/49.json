[{"row_id": 1, "segments": [{"text": "{ إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَؤُلَاءِ دِينُهُمْ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ", "color": "brown"}, {"text": "(  الأنفال: 49  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" في الآية السابقة في محلّ نصب مفعول فيه متعلّق بفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَقُولُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمُنَافِقُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الواو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الذين: اسم موصول مبنيّ في محلّ رفع، لأنّه معطوف على الفاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي قُلُوبِهِمْ﴾:", "color": "green"}, {"text": "في قلوب: جارّ ومجرور متعلّقان بمحذوف رفع خبر مقدم، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَرَضٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿غَرَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿هَؤُلَاءِ﴾:", "color": "green"}, {"text": "ها: للتنبيه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "أولاء: اسم إشارة مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿دِينُهُمْ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"tex