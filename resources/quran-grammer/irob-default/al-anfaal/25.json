[{"row_id": 1, "segments": [{"text": "{ وَاتَّقُوا فِتْنَةً لَا تُصِيبَنَّ الَّذِينَ ظَلَمُوا مِنْكُمْ خَاصَّةً وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ", "color": "brown"}, {"text": "(  الأنفال: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاتَّقُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اتقوا: فعل أمر مبني على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِتْنَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُصِيبَنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبني على الفتح في محل رفع، والنون: للتوكيد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ظَلَمُوا﴾:", "color": "green"}, {"text": "فعل ماض مبني على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْكُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بمحذوف حال من الواو في \"", "color": "black"}, {"text": "ظلموا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿خَاصَّةً﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة من فاعل \"", "color": "black"}, {"text": "تصيبن", "color": "blue"}, {"text": "\" العائد على \"", "color": "black"}, {"text": "فتنة", "color": "blue"}, {"text": "\"، أي: مختصة بهم، أو من ضمير مبني ظلموا، أي: مختصين بهذه الاصابة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَاعْلَمُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "اعلموا: فعل أمر مبني على حذف النون، والواو: فاعل.", "color": "black"}]}, {"r