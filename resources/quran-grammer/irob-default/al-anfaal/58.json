[{"row_id": 1, "segments": [{"text": "{ وَإِمَّا تَخَافَنَّ مِنْ قَوْمٍ خِيَانَةً فَانْبِذْ إِلَيْهِمْ عَلَى سَوَاءٍ إِنَّ اللَّهَ لَا يُحِبُّ الْخَائِنِينَ", "color": "brown"}, {"text": "(  الأنفال: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِمَّا تَخَافَنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إمّا تخافن: مثل \"", "color": "black"}, {"text": "إمّا تثقفن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو «إنّ: حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ما﴾:", "color": "green"}, {"text": "حرف زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَثْقَفَنَّهُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح في محلّ جزم فعل الشرط، والنون: للتوكيد، والفاعل ضمير مبنيّ مستتر فيه وجوبا تقديره: أنت».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ قَوْمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من خيانة، نعت تقدّم على المنعوت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿خِيَانَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَانْبِذْ إِلَيْهِمْ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "فشرد بهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو «فَشَرِّدْ: الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "شرد: فعل أمر مبنيّ على السكون، والفاعل: أنت.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "شرِّد", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿على سواء﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال م