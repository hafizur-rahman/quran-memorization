[{"row_id": 1, "segments": [{"text": "{ رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا", "color": "brown"}, {"text": "(  النبأ: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "ربك", "color": "blue"}, {"text": "\" في الآية السابقة، وهو مضاف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ما: اسم موصول مبنيّ على السكون في محلّ جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَيْنَهُمَا﴾:", "color": "green"}, {"text": "بين: ظرف مكان منصوب بالفتحة متعلق بصلة الموصول المحذوفة، وهو مضاف، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": للمثني.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الرَّحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا﴾:", "color": "green"}, {"text": "الرحمن: بدل من \"", "color": "black"}, {"text": "رب السماوات", "color": "blue"}, {"text": "\" مجرورة بالكسرة، والجملة الفعلية بعده تعرب إعراب \"", "color": "black"}, {"text": "لا يسمعون فيها لغوًا", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة الخامسة و الثلاثين.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو : \n« لَا: حرف نفي لا عمل له.", "color": "black"}