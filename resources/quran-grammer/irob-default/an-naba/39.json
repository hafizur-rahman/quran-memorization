[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ الْيَوْمُ الْحَقُّ فَمَنْ شَاءَ اتَّخَذَ إِلَى رَبِّهِ مَآبًا", "color": "brown"}, {"text": "(  النبأ: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْيَوْمُ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "اليوم", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَمَنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اتَّخَذَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "شاء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَى رَبِّهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "اتخذ", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَآبًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "col