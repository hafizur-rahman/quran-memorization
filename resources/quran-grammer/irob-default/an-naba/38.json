[{"row_id": 1, "segments": [{"text": "{ يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا", "color": "brown"}, {"text": "(  النبأ: 38  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلق بـ\"", "color": "black"}, {"text": "لا يملكون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَقُومُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الرُّوحُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالْمَلَائِكَةُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "الروح", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿صَفًّا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَتَكَلَّمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ مستثني بـ\"", "color": "black"}, {"text": "إلا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أذن﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَهُ﴾:", "color":