[{"row_id": 1, "segments": [{"text": "{ وَإِذَا بُشِّرَ أَحَدُهُمْ بِالْأُنْثَى ظَلَّ وَجْهُهُ مُسْوَدًّا وَهُوَ كَظِيمٌ", "color": "brown"}, {"text": "(  النحل: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه وهو حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة الفعلية بعده: في محلّ جرّ بالإضافة لوقوعها بعد الظرف \"", "color": "black"}, {"text": "إذا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بُشِّرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَحَدُهُمْ﴾:", "color": "green"}, {"text": "أحد: نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِالْأُنْثَى﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "بشر", "color": "blue"}, {"text": "\" وعلامة جرّ الاسم الكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وإذا بشر ,,,", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ظَلَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح من أخوات \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَجْهُهُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "ظلّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مُسْوَدًّا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "ظلّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حالية والجملة الاسمية بعده: في محلّ نصب حال.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "هو: ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿كَظِيمٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}]