[{"row_id": 1, "segments": [{"text": "{ إِنَّمَا قَوْلُنَا لِشَيْءٍ إِذَا أَرَدْنَاهُ أَنْ نَقُولَ لَهُ كُنْ فَيَكُونُ", "color": "brown"}, {"text": "(  النحل: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "كافة ومكفوفة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَوْلُنَا﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِشَيْءٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالقول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن خافض لشرطه منصوب بجوابه وهو حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَرَدْنَاهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أردناه", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجواب الشّرط محذوف يفسره السياق.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ناصب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿نَقُولَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أنْ", "color": "blue"