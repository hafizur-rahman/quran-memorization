[{"row_id": 1, "segments": [{"text": "{ يَوْمَ تَأْتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا وَتُوَفَّى كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ", "color": "brown"}, {"text": "(  النحل: 111  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة بفعل مضمر تقديره: اذكر وهو مضاف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَأْتِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدرة على الياء للثقل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كُلُّ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَفْسٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "تأتي كل نفس", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تُجَادِلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تجادل", "color": "blue"}, {"text": "\" في محلّ جرّ نعت لـ\"", "color": "black"}, {"text": "نفس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَنْ نَفْسِهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تجادل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير الغائبة مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَتُوَفَّى﴾:", "color": "green"}, {"text": "الواو: