ments": [{"text": ": تقدم إعرابها في الآية الحادية والستين.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وهو « هَذَا: اسم إشارة مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿صِرَاطٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مُسْتَقِيمٌ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "صراط", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن الله ربي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعبدوه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على استئناف مقدر، أي تنبهوا فاعبدوه.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هذا صراط", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]