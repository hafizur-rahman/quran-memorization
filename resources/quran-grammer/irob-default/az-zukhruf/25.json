[{"row_id": 1, "segments": [{"text": "{ فَانْتَقَمْنَا مِنْهُمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ", "color": "brown"}, {"text": "(  الزخرف: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَانْتَقَمْنَا﴾:", "color": "green"}, {"text": "الفاء: سببية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "انتقم: فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "انتقمنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "{ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ }", "color": "brown"}]}, {"row_id": 6, "segments": [{"text": ": تقدم إعرابها في الآية الثالثة والسبعين من سورة \"", "color": "black"}, {"text": "الصافات", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وهو « فَانْظُرْ: الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "انظر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَيْفَ﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ في محلّ نصب خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مقدم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿عَاقِبَةُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْمُنْذَرِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجر الياء».", "col