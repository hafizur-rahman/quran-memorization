[{"row_id": 1, "segments": [{"text": "{ وَلِبُيُوتِهِمْ أَبْوَابًا وَسُرُرًا عَلَيْهَا يَتَّكِئُونَ", "color": "brown"}, {"text": "(  الزخرف: 34  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب هذه الآية إعراب الآية السابقة، وهي معطوفة عليها بالواو.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « لِبُيُوتِهِمْ﴾: جارّ ومجرور في محلّ نصب بدلٌ من قوله \"", "color": "black"}, {"text": "لمن يكفر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿سُقُفًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ فِضَّةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت محذوف من \"", "color": "black"}, {"text": "سقفًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَمَعَارِجَ﴾:", "color": "green"}, {"text": "اسم معطوفٌ بالواو على \"", "color": "black"}, {"text": "فضة", "color": "blue"}, {"text": "\" مجرور بالفتحة بدلا من الكسرة؛ لأنَّهُ ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَلَيْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يظهرون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَظْهَرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لولا أن يكون", "color": "blue"}, {"text": "\" \"", "color": "black"}, {"text": "الاسمية", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يكون الناس أمة", "color": "blue"}, {"text": "\" لا محلّ لها من الإ