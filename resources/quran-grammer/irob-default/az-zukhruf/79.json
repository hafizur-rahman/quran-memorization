[{"row_id": 1, "segments": [{"text": "{ أَمْ أَبْرَمُوا أَمْرًا فَإِنَّا مُبْرِمُونَ", "color": "brown"}, {"text": "(  الزخرف: 79  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف إضراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَبْرَمُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَمْرًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَإِنَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إن: حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مُبْرِمُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أبرموا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنا مبرمون", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر أي إن فعلوا ذلك فإنا مبرمون.", "color": "black"}]}]