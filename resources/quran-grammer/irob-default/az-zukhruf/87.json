[{"row_id": 1, "segments": [{"text": "{ وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَهُمْ لَيَقُولُنَّ اللَّهُ فَأَنَّى يُؤْفَكُونَ", "color": "brown"}, {"text": "(  الزخرف: 87  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تقدم إعرابها في الآية الحادية والستين من سورة العنكبوت\"", "color": "green"}, {"text": ".", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وفي الآية التاسعة من سورة الزخرف\"،وهو : «  وَلَئِنْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللام: حرف موطئ للقسم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "إن: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿سَأَلْتَهُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك في محلّ جزم بـ \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿و \"", "color": "green"}, {"text": "هم", "color": "green"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿خَلَقَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿السَّمَاوَاتِ", "color": "green"}, {"text": "( ,,, )", "color": "green"}, {"text": "﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلًا من الفتحة، لأنه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَيَقُولُنَّ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب القسم المقدرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "يقولن: فعل مضارع مرفوع بثبوت النون، لأنه من ال