[{"row_id": 1, "segments": [{"text": "{ وَإِنَّهُ فِي أُمِّ الْكِتَابِ لَدَيْنَا لَعَلِيٌّ حَكِيمٌ", "color": "brown"}, {"text": "(  الزخرف: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي أُمِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور بالكسرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَدَيْنَا﴾:", "color": "green"}, {"text": "ظرفٌ مكان مبنيّ على السكون متَعَلِّقٌ بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَعَلِيٌّ﴾:", "color": "green"}, {"text": "اللَّام: لام التوكيد المزحلقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "علي: خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿حَكِيمٌ﴾:", "color": "green"}, {"text": "خبر ثانٍ أو نعت لـ\"", "color": "black"}, {"text": "علي", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنه في أم الكتاب لدينا لعلي", "color": "blue"}, {"text": "\"