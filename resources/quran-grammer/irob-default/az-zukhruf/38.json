[{"row_id": 1, "segments": [{"text": "{ حَتَّى إِذَا جَاءَنَا قَالَ يَالَيْتَ بَيْنِي وَبَيْنَكَ بُعْدَ الْمَشْرِقَيْنِ فَبِئْسَ الْقَرِينُ", "color": "brown"}, {"text": "(  الزخرف: 38  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وابتداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرفٌ لما يستقبل من الزمن مبنيّ في محلّ نصب مفعول فيه متضمن معنى الشَّرط.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَنَا﴾:", "color": "green"}, {"text": "جاء: فعل ماض مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "جاء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَالَيْتَ﴾:", "color": "green"}, {"text": "يا: حرف تنبيه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ليت: حرف تمنٍّ مشبّه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَيْنِي﴾:", "color": "green"}, {"text": "ظرفٌ مكان منصوب بالفتحة المقدرة على ما قبل الياء، متَعَلِّقٌ بخبر \"", "color": "black"}, {"text": "ليت", "color": "blue"}, {"text": "\" المقدم، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَبَيْنَكَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "بيني", "color": "blue"}, {"text": "\" معطوفٌ عليه، وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بُعْدَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "ليت", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمَشْرِقَيْنِ﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور بالياء؛ لأنَّهُ مثنى.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَبِئْسَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "بئس: فعل ماض جامد لإنشاء الذم مبني على الفتح مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْقَرِينُ﴾:", "color": "green"}, {"text": "فاعل \"", "color": "black"}, {"text": "بئس", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاءنا", "color": "blue"}, {"text": "\" في محلّ جرّ مضافٌ إليه.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ليت بيني", "color": "blue"}, {"text": "\" بعد في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بئس القرين", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر أي إن كنتُ اتخذتك قرينًا فبئس القرين أنت.", "color": "black"}]}]