[{"row_id": 1, "segments": [{"text": "{ أَوْ نُرِيَنَّكَ الَّذِي وَعَدْنَاهُمْ فَإِنَّا عَلَيْهِمْ مُقْتَدِرُونَ", "color": "brown"}, {"text": "(  الزخرف: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَوْ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نُرِيَنَّكَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "نذهبن", "color": "blue"}, {"text": "\"في الآية السابقة وهو: « نَذْهَبَنَّ: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد في محلّ جزم؛ لأنَّهُ فعل الشَّرط، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف توكيد، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": ")، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مفعول به أوّل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به ثانٍ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَعَدْنَاهُمْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "{ فَإِنَّا عَلَيْهِمْ مُقْتَدِرُونَ }", "color": "brown"}]}, {"row_id": 10, "segments": [{"text": ": مثل \"", "color": "black"}, {"text": "فإنا منهم منتقمون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وهو : «فَإِنَّا: الفاء: حرف ربط لجواب الشَّرط.", "color": "black"}]}