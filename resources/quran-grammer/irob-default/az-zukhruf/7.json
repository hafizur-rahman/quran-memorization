[{"row_id": 1, "segments": [{"text": "{ وَمَا يَأْتِيهِمْ مِنْ نَبِيٍّ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ", "color": "brown"}, {"text": "(  الزخرف: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَأْتِيهِمْ﴾:", "color": "green"}, {"text": "يأتي: فعل مضارع مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَبِيٍّ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا على أنه فاعل \"", "color": "black"}, {"text": "يأتي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَسْتَهْزِئُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ رفع فاعل.", "c