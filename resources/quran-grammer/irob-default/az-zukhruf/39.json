[{"row_id": 1, "segments": [{"text": "{ وَلَنْ يَنْفَعَكُمُ الْيَوْمَ إِذْ ظَلَمْتُمْ أَنَّكُمْ فِي الْعَذَابِ مُشْتَرِكُونَ", "color": "brown"}, {"text": "(  الزخرف: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لن: حرف نصب واستقبال.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَنْفَعَكُمُ﴾:", "color": "green"}, {"text": "ينفع: فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\"، وعلامة نصبه بالفتحة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْيَوْمَ﴾:", "color": "green"}, {"text": "مفعول فيه منصوب بالفتحة متَعَلِّقٌ بـ\"", "color": "black"}, {"text": "ينفع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "حرف للتعليل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ظَلَمْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَنَّكُمْ﴾:", "color": "green"}, {"text": "أن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ\nنصب اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فِي الْعَذَابِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والمصدر المؤول من اسمها وخبرها في محلّ رفع فاعل \"", "color": "black"}, {"text": "ينفع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والجملة من اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" وخبرها صلة الحرف المصدريّ لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مُشْتَرِكُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مرفوع بالواو؛ لأنَّهُ جمع مذكر سالم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "لن ينفعكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "ظلمتم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها اعتراضية.", "color": "black"}]}]