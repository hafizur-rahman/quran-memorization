[{"row_id": 1, "segments": [{"text": "{ لَقَدْ جِئْنَاكُمْ بِالْحَقِّ وَلَكِنَّ أَكْثَرَكُمْ لِلْحَقِّ كَارِهُونَ", "color": "brown"}, {"text": "(  الزخرف: 78  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَقَدْ﴾:", "color": "green"}, {"text": "اللام: حرف ابتداء للتوكيد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جِئْنَاكُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصب مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِالْحَقِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "جئناكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَلَكِنَّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لكن: حرف مشبه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَكْثَرَكُمْ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لكنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لِلْحَقِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "لكن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَارِهُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "لكن", "color": "blue"}, {"text": "\"