[{"row_id": 1, "segments": [{"text": "{ وَإِنَّهُ لَعِلْمٌ لِلسَّاعَةِ فَلَا تَمْتَرُنَّ بِهَا وَاتَّبِعُونِ هَذَا صِرَاطٌ مُسْتَقِيمٌ", "color": "brown"}, {"text": "(  الزخرف: 61  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أن: حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَعِلْمٌ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد المزحلقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "علم: خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِلسَّاعَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت محذوف من \"", "color": "black"}, {"text": "علم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَمْتَرُنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على حذف النون، لأنه من الأفعال الخمسة في محلّ جزم بـ \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" وسبب بنائه على حذف النون اتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "واو الجماعة المحذوفة في محلّ رفع فاعل، ونون التوكيد: حرف لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِهَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تمترن", "color": "blue"}, {"text": "\".