[{"row_id": 1, "segments": [{"text": "{ قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  الأنعام: 162  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة بعدها في محل نصب مفعول به لفعل \"", "color": "black"}, {"text": "قل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَلَاتِي﴾:", "color": "green"}, {"text": "اسمها منصوب بالفتحة المقدرة على ما قبل الياء، والياء: ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَنُسُكِي﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "صلاتي", "color": "blue"}, {"text": "\" ويعرب مثله.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَمَحْيَايَ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "صلاتي", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدّرة على الألف، والياء: ضمير متصل في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَمَاتِي﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "صلاتي", "color": "blue"}, {"text": "\" ويعرب إعرابه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "جار ومجرور للتعظيم متعلقان بخبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "نعت للفظ الجلالة أو بدل منه مجرور للتعظيم بالكسرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color