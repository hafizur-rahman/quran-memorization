[{"row_id": 1, "segments": [{"text": "{ فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ", "color": "brown"}, {"text": "(  الأنعام: 118  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكُلُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كلوا: فعل أمر مبنيّ على حذف النون؛ لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِمَّا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "مِنْ", "color": "blue"}, {"text": "\": حرف جر، و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول مبنيّ في محل جر بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" والجار والمجرور \"", "color": "black"}, {"text": "مما", "color": "blue"}, {"text": "\" متعلقان بـ \"", "color": "black"}, {"text": "كلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ذُكِرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اسْمُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور للتعظيم بالكسرة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذكر اسم الله عليه", "color": "blue"}, {"text": "\" صلة الموصول لا محل له