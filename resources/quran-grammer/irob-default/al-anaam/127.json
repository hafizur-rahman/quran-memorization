[{"row_id": 1, "segments": [{"text": "{ لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ", "color": "brown"}, {"text": "(  الأنعام: 127  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿دَارُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿السَّلَامِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب على الظرفية بالفتحة متعلق بالخبر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "ربّ: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجملة في محل نصب مفعول به لفعل محذوف تقديره: ماذا أعدّ لهم؟ أو في محل نصب حال من فاعل \"", "color": "black"}, {"text": "يذكرون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "هو: ضمير منفصل مبنيّ في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلِيُّهُمْ﴾:", "color": "green"}, {"text": "وليّ: خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِمَا