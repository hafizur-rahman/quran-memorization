[{"row_id": 1, "segments": [{"text": "{ ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ", "color": "brown"}, {"text": "(  الأنعام: 62  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رُدُّوا﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السكون في محل رفع نائب فاعل، والجملة معطوفة على جملة \"", "color": "black"}, {"text": "توفّته", "color": "blue"}, {"text": "\" في الآية السابقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم مخفوض بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظاهرة، والخافض والمخفوض متعلقان بالفعل \"", "color": "black"}, {"text": "ردّوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَوْلَاهُمُ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "مولا", "color": "blue"}, {"text": "\": نعت اسم الجلالة مجرور بالكسرة المقدّرة على الألف للتعذّر، وهو مضاف، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْحَقِّ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "مولاهم", "color": "blue"}, {"text": "\" مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَلَا﴾:", "color": "green"}, {"text": "حرف تنبيه واستفتاح مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الفتح، والهاء: ضمير متّصل مبنيّ على الضم في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بمحذوف خبر مقدم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْحُكْمُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، هو: ضمير منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَسْرَعُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وهو مضاف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْحَاسِبِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم، وجملة \"", "color": "black"}, {"text": "هو أسرع الحاسبين", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "له الحكم", "color": "blue"}, {"text": "\".", "color": "black"}]}]