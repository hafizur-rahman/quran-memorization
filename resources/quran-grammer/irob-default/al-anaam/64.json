[{"row_id": 1, "segments": [{"text": "{ قُلِ اللَّهُ يُنَجِّيكُمْ مِنْهَا وَمِنْ كُلِّ كَرْبٍ ثُمَّ أَنْتُمْ تُشْرِكُونَ", "color": "brown"}, {"text": "(  الأنعام: 64  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون وقد حرّك بالكسر منعًا من التقاء ساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُنَجِّيكُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "ينجّي", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به، وجملة \"", "color": "black"}, {"text": "ينجيكم", "color": "blue"}, {"text": "\" في محل رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْهَا﴾:", "color": "green"}, {"text": "من حرف جرّ مبنيّ على السكون، والهاء: ضمير متّصل مبنيّ على السكون في محل جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "ينجي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كُلِّ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة، والجارّ والمجرور متعلقان بـ \"", "color": "black"}, {"text": "ينجي", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments"