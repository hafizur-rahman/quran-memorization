[{"row_id": 1, "segments": [{"text": "{ اتَّبِعْ مَا أُوحِيَ إِلَيْكَ مِنْ رَبِّكَ لَا إِلَهَ إِلَّا هُوَ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ", "color": "brown"}, {"text": "(  الأنعام: 106  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اتَّبِعْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أُوحِيَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتَّبع", "color": "blue"}, {"text": "\" استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أوحي", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أوحي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ رَبِّكَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال محذوفة من الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس تعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محل نصب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محل رفع بدلًا من موضع \"", "color": "black"}, {"text": "لا إله", "color": "blue"}, {"text": "\" لأن موضع \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" وما عملت فيه رفع بالابتداء.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وخبر \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" محذوف تقديره: كائن أو موجود.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والجملة اعتراضية لا محل لها من الإعراب، ويجوز أن تكون في محل نصب حالًا مؤكدة من ربك.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَأَعْرِضْ﴾:", "color": "green"}, {"text": "جملة معطوفة بالواو على \"", "color": "black"}, {"text": "اتبع", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿عَنِ الْمُشْرِكِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أعرض", "color": "blue"}, {"text": "\"، وعلامة جر الاسم الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجملة معطوفة على الاستئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]