[{"row_id": 1, "segments": [{"text": "{ ثُمَّ لَمْ تَكُنْ فِتْنَتُهُمْ إِلَّا أَنْ قَالُوا وَاللَّهِ رَبِّنَا مَا كُنَّا مُشْرِكِينَ", "color": "brown"}, {"text": "(  الأنعام: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف جزم ونفي وقلب مبنيّ على السكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\" وعلامة جزمه السكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِتْنَتُهُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "فتنةُ", "color": "blue"}, {"text": "\": اسم \"", "color": "black"}, {"text": "تكن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وهو مضاف، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب واستقبال مبنيّ على السكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل، والمصدر المؤول من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها في محل نصب خبر \"", "color": "black"}, {"text": "تكنْ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاللَّهِ﴾:", "color": "green"}, {"text": "الواو: حرف قسم وجر مبنيّ على الفتح، \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\": لفظ الجلالة اسم مخفوض بالواو و