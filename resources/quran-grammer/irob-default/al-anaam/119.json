[{"row_id": 1, "segments": [{"text": "{ وَمَا لَكُمْ أَلَّا تَأْكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُمْ مَا حَرَّمَ عَلَيْكُمْ إِلَّا مَا اضْطُرِرْتُمْ إِلَيْهِ وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِالْمُعْتَدِينَ", "color": "brown"}, {"text": "(  الأنعام: 119  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: اسم استفهام مبنيّ في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية بعده في محل نصب حال بمعني غير آكلين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَلَّا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\": حرف نصب مصدريّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\": حرف نفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَأْكُلُوا﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\"، وعلامة نصبه حذف النون، والواو ضمير متّصل مبنيّ في محل رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\" وما تلاها في محل جرّ بحرف جرّ مقدر، ولما حذف حرف الجرّ، صارت الجملة في محل نصب حال بتقدير: غير آكلين.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تأكلوا", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" لا محل لها من ا