[{"row_id": 1, "segments": [{"text": "{ وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا لَا مُبَدِّلَ لِكَلِمَاتِهِ وَهُوَ السَّمِيعُ الْعَلِيمُ", "color": "brown"}, {"text": "(  الأنعام: 115  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَتَمَّتْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تمت: فعل ماضٍ مبنيّ على الفتح، والتاء: تاء التأنيث الساكنة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَلِمَتُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور للتعظيم بالكسرة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿صِدْقًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَعَدْلًا﴾:", "color": "green"}, {"text": "اسم معطوف على \"", "color": "black"}, {"text": "صدقًا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس تعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُبَدِّلَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محل نصب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لِكَلِمَاتِهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" المحذوف وجوبًا، والهاء: ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالإضافة