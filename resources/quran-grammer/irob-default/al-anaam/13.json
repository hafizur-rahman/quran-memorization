[{"row_id": 1, "segments": [{"text": "{ وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ وَهُوَ السَّمِيعُ الْعَلِيمُ", "color": "brown"}, {"text": "(  الأنعام: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، اللام: حرف جرّ مبنيّ على الفتح، والهاء: ضمير متّصل مبنيّ على الضمّ في محل جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بمحذوف خبر مقدّم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿سَكَنَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّيْلِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\"، وعلامة جرّه الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "سكن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالنَّهَارِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "\"", "color": "black"}, {"text": "النهار", "color": "blue"}, {"text": "\": اسم معطوف على \"", "color": "black"}, {"text": "الليل", "color": "blue"}, {"text": "\" مجرور بالكسرة الظاهرة وجملة \"", "color": "black"}, {"text": "سكن في الليل والنهار", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"tex