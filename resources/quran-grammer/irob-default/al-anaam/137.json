[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ زَيَّنَ لِكَثِيرٍ مِنَ الْمُشْرِكِينَ قَتْلَ أَوْلَادِهِمْ شُرَكَاؤُهُمْ لِيُرْدُوهُمْ وَلِيَلْبِسُوا عَلَيْهِمْ دِينَهُمْ وَلَوْ شَاءَ اللَّهُ مَا فَعَلُوهُ فَذَرْهُمْ وَمَا يَفْتَرُونَ", "color": "brown"}, {"text": "(  الأنعام: 137  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السكون في محل جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿زَيَّنَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "زين", "color": "blue"}, {"text": "\" في محل رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِكَثِيرٍ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "زين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ الْمُشْرِكِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بنعت محذوف من \"", "color": "black"}, {"text": "كثير", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء؛ لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَتْلَ﴾:", "color": "green"}, {"text": "مفعول به مقدم منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَوْلَادِهِمْ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة ج