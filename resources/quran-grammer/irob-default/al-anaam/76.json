[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا جَنَّ عَلَيْهِ اللَّيْلُ رَأَى كَوْكَبًا قَالَ هَذَا رَبِّي فَلَمَّا أَفَلَ قَالَ لَا أُحِبُّ الْآفِلِينَ", "color": "brown"}, {"text": "(  الأنعام: 76  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لما", "color": "blue"}, {"text": "\": حرف رابط لجواب الشّرط.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَنَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح الظاهر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "عليْ", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على السكون، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر، والجارّ والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "جنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّيْلُ﴾:", "color": "green"}, {"text": "فاعل \"", "color": "black"}, {"text": "جنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وجملة \"", "color": "black"}, {"text": "جنّ عليه الليل", "color": "blue"}, {"text": "\" في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَأَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتحة المقدّرة على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كَوْكَبًا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة الظاهرة، وجملة \"", "color": "black"}, {"text": "رأى كوكبًا", "color": "blue"}, {"text": "\" لا محل لها من الإعراب لأنها جواب شرط غير جازم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "الهاء للتنبيه مبنيّ على الفتح، \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السكون في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَبِّي﴾:", "color": "green"}, {"text": "خبر مرفوع بالضمة المقدّرة على ما قبل ياء المتكلم المانع من ظهورها اشتغال المحل بالحركة المناسبة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لما", "color": "blue"}, {"text": "\": حرف رابط لجواب الشّرط.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَفَلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، وجملة \"", "color": "black"}, {"text": "أفل", "color": "blue"}, {"text": "\" في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، وجملة قال في محل جزم جواب الشرط.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿أُحِبُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الْآفِلِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء لأنه جمع مذكر سالم، وجملة \"", "color": "black"}, {"text": "لا أحب الآفلين", "color": "blue"}, {"text": "\" في محل نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]