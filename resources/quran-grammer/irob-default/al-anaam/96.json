[{"row_id": 1, "segments": [{"text": "{ فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ", "color": "brown"}, {"text": "(  الأنعام: 96  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَالِقُ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: هو الله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْإِصْبَاحِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَجَعَلَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "جعل: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّيْلَ سَكَنًا﴾:", "color": "green"}, {"text": "مفعولا \"", "color": "black"}, {"text": "جعل", "color": "blue"}, {"text": "\" منصوبان بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالشَّمْسَ وَالْقَمَرَ﴾:", "color": "green"}, {"text": "اسمان معطوفان بالواو على \"", "color": "black"}, {"text": "الليل", "color": "blue"}, {"text": "\" منصوبان بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حُسْبَانًا﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "سكنًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محل رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": للخطاب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَقْدِيرُ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color"