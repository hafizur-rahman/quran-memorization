[{"row_id": 1, "segments": [{"text": "{ وَقَالُوا إِنْ هِيَ إِلَّا حَيَاتُنَا الدُّنْيَا وَمَا نَحْنُ بِمَبْعُوثِينَ", "color": "brown"}, {"text": "(  الأنعام: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالُوا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\": فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل، وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هِيَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حَيَاتُنَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "حياةُ", "color": "blue"}, {"text": "\": خبر للمبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وهو مضاف، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الدُّنْيَا﴾:", "color": "green"}, {"text": "صفة لِـ \"", "color": "black"}, {"text": "حياتنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف يعمل عمل ليس مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الضم في محل رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text