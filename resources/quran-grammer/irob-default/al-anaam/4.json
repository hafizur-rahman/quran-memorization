[{"row_id": 1, "segments": [{"text": "{ وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ", "color": "brown"}, {"text": "(  الأنعام: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تَأْتِيهِمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "تأتي", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل نصب مفعول به مقدّم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد مبنيّ على السكون،\nآيَةٍ: اسم مجرور لفظًا مرفوع محلًّا على أنه فاعل للفعل \"", "color": "black"}, {"text": "تأتي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تأتيهم من آية", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آيَاتِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظاهرة والجار والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "تأتي", "color": "blue"}, {"text": "\" وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "ربّ", "color": "blue"}, {"text": "\": مضاف إليه مجرور بالكسرة الظاهرة، وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة، وجملة \"", "color": "black"}, {"text": "من آيات ربهم", "color": "blue"}, {"text": "\" متعلقة بمحذوف صفة لـ \"", "color": "black"}, {"text": "آية", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر مبنيّ على السكون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السكون في محل رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، وجملة \"", "color": "black"}, {"text": "كانوا", "color": "blue"}, {"text": "\": في محل نصب حال.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿عَنْهَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "عن", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على السكون والهاء: ضمير متّصل مبنيّ على السكون في محلّ جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بالخبر \"", "color": "black"}, {"text": "معرضين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مُعْرِضِينَ﴾:", "color": "green"}, {"text": "خبر كان منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كانوا عنها معرضين", "color": "blue"}, {"text": "\" معطوفة على الجملة السابقة.", "color": "black"}]}]