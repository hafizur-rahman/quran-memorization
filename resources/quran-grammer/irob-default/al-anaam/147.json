[{"row_id": 1, "segments": [{"text": "{ فَإِنْ كَذَّبُوكَ فَقُلْ رَبُّكُمْ ذُو رَحْمَةٍ وَاسِعَةٍ وَلَا يُرَدُّ بَأْسُهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ", "color": "brown"}, {"text": "(  الأنعام: 147  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَذَّبُوكَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة في محل جزم بـ \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، وهو فعل الشرط، والواو ضمير متصل مبنيّ في محل رفع فاعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَقُلْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "قل: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فقل ,,,", "color": "blue"}, {"text": "\" في محل جزم جواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿رَبُّكُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع للتعظيم بالضمة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ذُو﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع بالواو؛ لأنه من الأسماء الخمسة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَحْمَةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَاسِعَةٍ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "رحمة", "color": "blue"}, {"text