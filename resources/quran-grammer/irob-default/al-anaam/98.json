[{"row_id": 1, "segments": [{"text": "{ وَهُوَ الَّذِي أَنْشَأَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ فَمُسْتَقَرٌّ وَمُسْتَوْدَعٌ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَفْقَهُونَ", "color": "brown"}, {"text": "(  الأنعام: 98  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَهُوَ الَّذِي أَنْشَأَكُمْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "وهو الذي جعل", "color": "blue"}, {"text": "\" في الآية السابقة،وهو :«وَهُوَ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "هو: ضمير منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محل رفع خبر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة معطوفة على هو \"", "color": "black"}, {"text": "فالق", "color": "blue"}, {"text": "\" لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿جَعَلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: ضمير مستتر فيه جوازًا تقديره: هو».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ نَفْسٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أنشأكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاحِدَةٍ﴾:", "color": "green"}, {"text": "نعت لنفس مجرور بالكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَمُسْتَقَرٌّ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "مستقر: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَمُسْتَوْدَعٌ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "colo