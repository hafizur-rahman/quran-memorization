[{"row_id": 1, "segments": [{"text": "{ * وَإِذْ قَالَ إِبْرَاهِيمُ لِأَبِيهِ آزَرَ أَتَتَّخِذُ أَصْنَامًا آلِهَةً إِنِّي أَرَاكَ وَقَوْمَكَ فِي ضَلَالٍ مُبِينٍ", "color": "brown"}, {"text": "(  الأنعام: 74  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": ظرف لما مضى من الزمان متضمن معنى الشرط خافض لشرطه منصوب بجوابه مبنيّ على السكون في محل نصب مفعول فيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح الظاهر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِبْرَاهِيمُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وجملة \"", "color": "black"}, {"text": "قال إبراهيم", "color": "blue"}, {"text": "\" في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِأَبِيهِ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الكسر، \"", "color": "black"}, {"text": "أبي", "color": "blue"}, {"text": "\": اسم مجرور بالكسرة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والجار والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\"، والهاء: ضمير متّصل مبنيّ على الكسر في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آزَرَ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "أبيه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَتَتَّخِذُ﴾:", "color": "green"}, {"text": "الهمزة للاستفهام الإنكاري، \"", "color": "black"}, {"text": "تتخذ", "color": "blue"}, {"text": "\": فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَصْنَامًا﴾:", "color": "green"}, {"text": "مفعول به أول منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿آلِهَةً﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\": حرف توكيد مشبّه بالفعل مبنيّ على الفتح، والياء: ضمير متّصل مبنيّ على السكون في محل نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَرَاكَ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "أرى", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بالضمة المقدّرة على الألف للتعذر والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محل نصب مفعول به، وجملة \"", "color": "black"}, {"text": "أراك", "color": "blue"}, {"text": "\" في محل رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَقَوْمَكَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "قوم", "color": "blue"}, {"text": "\": اسم معطوف على الكاف في \"", "color": "black"}, {"text": "أراك", "color": "blue"}, {"text": "\" منصوب بالفتحة الظاهرة، وهو مضاف، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿ضَلَالٍ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة، والجار والمجرور متعلقان بمحذوف حال.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مُبِينٍ﴾:", "color": "green"}, {"text": "صفة.", "color": "black"}]}]