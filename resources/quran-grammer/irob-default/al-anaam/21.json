[{"row_id": 1, "segments": [{"text": "{ وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أَوْ كَذَّبَ بِآيَاتِهِ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ", "color": "brown"}, {"text": "(  الأنعام: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": اسم استفهام مبنيّ على السكون في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَظْلَمُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والجملة من المبتدأ والخبر استئنافيّة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِمَّنِ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "مِنْ", "color": "blue"}, {"text": "\": حرف جر مبنيّ على السكون، \"", "color": "black"}, {"text": "مَنْ", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محل جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بالخبر \"", "color": "black"}, {"text": "أظلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿افْتَرَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتحة المقدرة على الألف المقصورة للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم مجرور بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظاهرة، والجارّ والمجرور متعلقان بالفعل \"", "color": "black"}, {"text": "افتري", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَذِبًا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة الظاهرة، وجملة \"", "color": "black"}, {"text": "افترى على الله كذبًا", "color": "