[{"row_id": 1, "segments": [{"text": "{ لَا تُدْرِكُهُ الْأَبْصَارُ وَهُوَ يُدْرِكُ الْأَبْصَارَ وَهُوَ اللَّطِيفُ الْخَبِيرُ", "color": "brown"}, {"text": "(  الأنعام: 103  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تُدْرِكُهُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والهاء: ضمير متّصل مبنيّ على الضم في محل نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْأَبْصَارُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية في محل رفع خبر ثانٍ \"", "color": "black"}, {"text": "للمبتدأ", "color": "blue"}, {"text": "\" هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "هو: ضمير منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُدْرِكُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يدرك", "color": "blue"}, {"text": "\" في محل رفع خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَبْصَارَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهُوَ اللَّطِيفُ الْخَبِيرُ﴾:", "color": "green"}, {"text": "وهو: مرّ إعرابها.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "اللطيف الخبير: خبران للمبتدأ \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوعان وعلامة رفعهما الضمة.", "color": "black"}]}]