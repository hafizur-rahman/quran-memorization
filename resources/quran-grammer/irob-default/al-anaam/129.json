[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ نُوَلِّي بَعْضَ الظَّالِمِينَ بَعْضًا بِمَا كَانُوا يَكْسِبُونَ", "color": "brown"}, {"text": "(  الأنعام: 129  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محل نصب مفعول مطلق، والتقدير: نولي بعض الظالمين تولية كذلك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السكون في محل جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "أو الكاف: حرف جرّ، و\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة في محل جرّ بالكاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلقان بمفعول مطلق محذوف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نُوَلِّي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدرة على الياء للثقل، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بَعْضَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الظَّالِمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بَعْضًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "نولي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ في محل رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يَكْسِبُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو ضمير متّصل مبنيّ في محل رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يكسبون", "color": "blue"}, {"text": "\" في محل نصب خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كانوا يكسبون", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}]