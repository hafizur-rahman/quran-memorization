[{"row_id": 1, "segments": [{"text": "{ وَهَذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَذَّكَّرُونَ", "color": "brown"}, {"text": "(  الأنعام: 126  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَهَذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "هذا: اسم إشارة مبنيّ على السكون في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿صِرَاطُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُسْتَقِيمًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَصَّلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بـ \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْآيَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لِقَوْمٍ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "فصلنا", "color": "blue"},