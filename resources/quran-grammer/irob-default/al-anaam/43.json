[{"row_id": 1, "segments": [{"text": "{ فَلَوْلَا إِذْ جَاءَهُمْ بَأْسُنَا تَضَرَّعُوا وَلَكِنْ قَسَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا يَعْمَلُونَ", "color": "brown"}, {"text": "(  الأنعام: 43  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَوْلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لولا", "color": "blue"}, {"text": "\": حرف تحضيض مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف لما مضى من الزمان متضمن معنى الشرط خافض لشرطه منصوب بجوابه مبنيّ على السكون في محل نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَهُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "جاءَ", "color": "blue"}, {"text": "\": فعل ماضٍ مبنيّ على الفتح، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَأْسُنَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "بأسُ", "color": "blue"}, {"text": "\": فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاءهم بأسنا", "color": "blue"}, {"text": "\" في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَضَرَّعُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَكِنْ﴾:", "color": "green"}, {"text": "الواو: حالية، \"", "color": "black"}, {"text": "لكنْ", "color": "blue"}, {"text": "\": الم