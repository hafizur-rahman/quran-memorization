[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ جَعَلْنَا فِي كُلِّ قَرْيَةٍ أَكَابِرَ مُجْرِمِيهَا لِيَمْكُرُوا فِيهَا وَمَا يَمْكُرُونَ إِلَّا بِأَنْفُسِهِمْ وَمَا يَشْعُرُونَ", "color": "brown"}, {"text": "(  الأنعام: 123  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كذلك: الكاف: اسم مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ في محل جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَعَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بـ \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\" في محل رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي كُلِّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "جعلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَرْيَةٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَكَابِرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مُجْرِمِيهَا﴾:", "color": "green"}, {"text": "م