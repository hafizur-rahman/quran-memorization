[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ", "color": "brown"}, {"text": "(  الأنعام: 131  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محل رفع خبر لمبتدأ محذوف تقديره: الأمر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة بعده للتعليل لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَن﴾:", "color": "green"}, {"text": "أنْ: حرف توكيد مشبّه بالفعل مخفف من \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" الثقيلة، واسمه ضمير الشأن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَكُنَ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لم يكن ربك مهلك القرى", "color": "blue"}, {"text": "\" في محل رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المخففة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُهْلِكَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْقُرَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 11,