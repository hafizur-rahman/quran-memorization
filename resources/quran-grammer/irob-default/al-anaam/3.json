[{"row_id": 1, "segments": [{"text": "{ وَهُوَ اللَّهُ فِي السَّمَاوَاتِ وَفِي الْأَرْضِ يَعْلَمُ سِرَّكُمْ وَجَهْرَكُمْ وَيَعْلَمُ مَا تَكْسِبُونَ", "color": "brown"}, {"text": "(  الأنعام: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة خبر مرفوع بالضمّة الظاهرة، وجملة \"", "color": "black"}, {"text": "هو الله", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظاهرة والجارّ والمجرور متعلقان بمعني اسم \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَفِي﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\": حرف جر مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْأَرْضِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظاهرة، والجارّ والمجرور متعلقان بمعني اسم \"", "color": "black"}, {"text": "الله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}