[{"row_id": 1, "segments": [{"text": "{ لِكُلِّ نَبَإٍ مُسْتَقَرٌّ وَسَوْفَ تَعْلَمُونَ", "color": "brown"}, {"text": "(  الأنعام: 67  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِكُلِّ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الكسر، \"", "color": "black"}, {"text": "كل", "color": "blue"}, {"text": "\": اسم مجرور بالكسرة الظاهرة، والجارّ والمجرور متعلقان بمحذوف خبر مقدم، وهو مضاف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نَبَإٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُسْتَقَرٌّ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَسَوْفَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "سوف", "color": "blue"}, {"text": "\" حرف استقبال مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَعْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل، وجملة \"", "color": "black"}, {"text": "سوف تعلمون", "color": "blue"}, {"text": "\" معطوفة على الجملة السابقة.", "color": "black"}]}]