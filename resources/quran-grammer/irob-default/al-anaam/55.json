[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ نُفَصِّلُ الْآيَاتِ وَلِتَسْتَبِينَ سَبِيلُ الْمُجْرِمِينَ", "color": "brown"}, {"text": "(  الأنعام: 55  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على الفتح، \n\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السكون في محل جرّ بحرف الجرّ، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد مبنيّ على الكسر، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نُفَصِّلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والفاعل: ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْآيَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة عوضًا عن الفتحة لأنه جمع مؤنث سالم، وجملة \"", "color": "black"}, {"text": "نفصل الآيات", "color": "blue"}, {"text": "\" استئنافيّة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَلِتَسْتَبِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للتعليل، \"", "color": "black"}, {"text": "تستبين", "color": "blue"}, {"text": "\": فعل مضارع منصوب بأن المضمرة بعد لام التعليل وعلامة نصبه الفتحة الظاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿سَبِيلُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم، وجملة \"", "color": "black"}, {"text": "تستبين", "color": "blue"}, {"text": "\"