[{"row_id": 1, "segments": [{"text": "{ وَمَا عَلَى الَّذِينَ يَتَّقُونَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَلَكِنْ ذِكْرَى لَعَلَّهُمْ يَتَّقُونَ", "color": "brown"}, {"text": "(  الأنعام: 69  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محل جرّ بحرف الجرّ، والجارّ والمجرور متعلقان بمحذوف خبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَتَّقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل، وجملة \"", "color": "black"}, {"text": "يتقون", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حِسَابِهِمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "حساب", "color": "blue"}, {"text": "\": اسم مجرور بالكسرة الظاهرة، وهو مضاف، والجارّ والمجرور متعلقان بمحذوف حال، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا على أنه مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَكِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لكن", "color": "blue"}, {"text": "\": مهملة لأنها مخففة حرف مبنيّ على السكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ذِكْرَى﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف مبنيّ على الضمة المقدّرة على الألف للتعذّر أي: هي ذكري.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَعَلَّهُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "لعلّ", "color": "blue"}, {"text": "\": حرف توكيد مشبّه بالفعل مبنيّ على الفتح، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل نصب اسم \"", "color": "black"}, {"text": "لعلّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يَتَّقُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السكون في محل رفع فاعل، وجملة \"", "color": "black"}, {"text": "يتقون", "color": "blue"}, {"text": "\" في محل رفع خبر \"", "color": "black"}, {"text": "لعلّ", "color": "blue"}, {"text": "\"، وجملة \"", "color": "black"}, {"text": "لعلهم يتقون", "color": "blue"}, {"text": "\" في محل نصب حال.", "color": "black"}]}]