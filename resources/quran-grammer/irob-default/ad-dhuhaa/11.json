[{"row_id": 1, "segments": [{"text": "{ وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "color": "brown"}, {"text": "(  الضحى: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَمَّا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أما: حرف شرط وتفصيل لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِنِعْمَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "حدث", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَحَدِّثْ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب \"", "color": "black"}, {"text": "أما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "حدث: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة معطوفة على الجملة السابقة لا محلّ لها من الإعراب.", "color": "black"}]}]