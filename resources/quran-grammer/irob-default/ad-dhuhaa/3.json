[{"row_id": 1, "segments": [{"text": "{ مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَى", "color": "brown"}, {"text": "(  الضحى: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَدَّعَكَ﴾:", "color": "green"}, {"text": "ودع: فعل ماضٍ مبنيّ على الفتح، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ عل الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والضمير يعود إلى الرسول -صلى الله عليه وسلم-.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَمَا قَلَى﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما ودعك ربك", "color": "blue"}, {"text": "\"، وعلامة بناء الفعل الفتحة المقدّرة على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو يعود على الرب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ودعك", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قلي", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "ودعك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]