[{"row_id": 1, "segments": [{"text": "{ قُلْ إِنَّمَا أُنْذِرُكُمْ بِالْوَحْيِ وَلَا يَسْمَعُ الصُّمُّ الدُّعَاءَ إِذَا مَا يُنْذَرُونَ", "color": "brown"}, {"text": "(  الأنبياء: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون الظاهر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها ابتدائية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مبنيّ على الفتح بطل عملها لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافّة عليها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ما﴾:", "color": "green"}, {"text": "حرف زائد، وكانت مبنيّ على السكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أُنْذِرُكُمْ﴾:", "color": "green"}, {"text": "أنذر: فعل مضارع مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: \"", "color": "black"}, {"text": "أنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنذركم", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِالْوَحْيِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "الوحي: اسم مخفوض بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والخافض والمخفوض متعلّقان بـ\"", "color": "black"}, {"text": "أنذركم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حالية، أو حرف عطف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "لَا: حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿يَسْمَعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿الصُّمُّ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿الدُّعَاءَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يسمع الصم الدعاء", "color": "blue"}, {"text": "\" في محلّ نصب حال أو معطوفة.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان، مبنيّ على السكون متضمن معنى الشَّرط خافض لشرطه متَعَلِّقٌ بجوابه.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف زائد مبنيّ على السكون.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿يُنْذَرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النّون، لأنَّهُ من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "﴿\"", "color": "green"}, {"text": "الواو", "color": "green"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع نائب فاعل.", "color": "green"}]}, {"row_id": 25, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما ينذرون", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 26, "segments": []}]