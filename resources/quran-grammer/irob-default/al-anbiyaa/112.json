[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ احْكُمْ بِالْحَقِّ وَرَبُّنَا الرَّحْمَنُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ", "color": "brown"}, {"text": "(  الأنبياء: 112  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى مضاف منصوب بالفتحة المقدرة على ما قبل ياء المتكلم المحذوفة منع من ظهورها اشتغال المحلّ بحركة المناسبة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿احْكُمْ﴾:", "color": "green"}, {"text": "فعل دعاء بصيغة طلب مبنيّ على السكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِالْحَقِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "احكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَرَبُّنَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "\"", "color": "black"}, {"text": "رب", "color": "blue"}, {"text": "\": مبتدأ مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير المتكلم مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الرَّحْمَنُ الْمُسْتَعَانُ﴾:", "color": "green"}, {"text": "خبران بالتتابع للمبتدأ مرفوعان بالضمة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَلَى مَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان باسم المفعول \"", "color": "black"}, {"text": "المستعان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: اسم موصول مبنيّ على السكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".",