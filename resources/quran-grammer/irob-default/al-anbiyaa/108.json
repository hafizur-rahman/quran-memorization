[{"row_id": 1, "segments": [{"text": "{ قُلْ إِنَّمَا يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَهَلْ أَنْتُمْ مُسْلِمُونَ", "color": "brown"}, {"text": "(  الأنبياء: 108  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف نصب وتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يُوحَى﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَيَّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يوحي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنَّمَا﴾:", "color": "green"}, {"text": "كافّة ومكفوفة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَهُكُمْ﴾:", "color": "green"}, {"text": "إله: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَهٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَاحِدٌ﴾:", "color": "green"}, {"text": "توكيد لإله مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments