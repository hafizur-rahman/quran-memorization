[{"row_id": 1, "segments": [{"text": "{ قَالَ بَلْ رَبُّكُمْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ الَّذِي فَطَرَهُنَّ وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ", "color": "brown"}, {"text": "(  الأنبياء: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بَلْ﴾:", "color": "green"}, {"text": "حرف إضراب للاستئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبُّكُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبُّ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "رب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَطَرَهُنَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح والفاعل ضمير مستتر فيه جوازًا تقديره: هو، يعود على رب السموات والأرض.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "هن", "color": "blue"}, {"text": "\": ضمير الإناث مبنيّ على الفتح في محلّ نصب مفعول به.", "color"