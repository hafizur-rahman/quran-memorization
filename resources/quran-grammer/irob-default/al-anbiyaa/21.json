[{"row_id": 1, "segments": [{"text": "{ أَمِ اتَّخَذُوا آلِهَةً مِنَ الْأَرْضِ هُمْ يُنْشِرُونَ", "color": "brown"}, {"text": "(  الأنبياء: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمِ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اتَّخَذُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتخذوا", "color": "blue"}, {"text": "\" معطوفة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آلِهَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون وقد حرّك بالفتح منعًا من التقاء الساكنين.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْأَرْضِ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجارّ والمجرور متعلّقان بمحذوف نعت لـ\"", "color": "black"}, {"text": "آلهة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُنْشِرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع بثبوت النون، لأنه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، وجملة \"", "color": "black"}, {"text": "ينشرون", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text":