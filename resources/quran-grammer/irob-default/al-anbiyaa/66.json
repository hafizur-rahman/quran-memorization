[{"row_id": 1, "segments": [{"text": "{ قَالَ أَفَتَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُكُمْ شَيْئًا وَلَا يَضُرُّكُمْ", "color": "brown"}, {"text": "(  الأنبياء: 66  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَفَتَعْبُدُونَ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "الفاء", "color": "blue"}, {"text": "\": حرف عطف على محذوف مقدر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تعبدون﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والواو ضمير مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ دُونِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَنْفَعُكُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يعود على \"", "color": "green"}, {"text": "ما", "color": "green"}, {"text": "\".", "color": "green"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\" ضمير مبنيّ على الضم في محلّ نصب