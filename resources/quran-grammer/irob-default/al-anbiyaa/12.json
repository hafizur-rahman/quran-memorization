[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا أَحَسُّوا بَأْسَنَا إِذَا هُمْ مِنْهَا يَرْكُضُونَ", "color": "brown"}, {"text": "(  الأنبياء: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "\"", "color": "black"}, {"text": "لما", "color": "blue"}, {"text": "\": ظرف زمان متضمن معني الشرط مبنيّ على السكون في محلّ نصب مفعول فيه خافض لشرطه متعلِّق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَحَسُّوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَأْسَنَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "بأس", "color": "blue"}, {"text": "\": مفعول به منصوب بالفتحة الظاهرة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أحسوا بأسنا", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "فجائية حرف مبنيّ على السكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْهَا﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بحرف الجرّ والجارّ والمجرور متعلّقان بـ\