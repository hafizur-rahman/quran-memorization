[{"row_id": 1, "segments": [{"text": "{ لَا يَسْمَعُونَ حَسِيسَهَا وَهُمْ فِي مَا اشْتَهَتْ أَنْفُسُهُمْ خَالِدُونَ", "color": "brown"}, {"text": "(  الأنبياء: 102  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية لا عمل لها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَسْمَعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَسِيسَهَا﴾:", "color": "green"}, {"text": "حسيس: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير رفع منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ \"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اشْتَهَتْ﴾:", "color": "green"}, {"text": "اشتهي: فعل ماضٍ مبنيّ على الفتح المقدر للتعذر على الألف المحذوفة لالتقاء الساكنين ولاتصالها بتاء التأنيث الساكنة و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والعائد: ضمير منصوب محلا لأنه مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والتقدير: في ما اشتهت