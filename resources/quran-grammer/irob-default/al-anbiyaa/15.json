[{"row_id": 1, "segments": [{"text": "{ فَمَا زَالَتْ تِلْكَ دَعْوَاهُمْ حَتَّى جَعَلْنَاهُمْ حَصِيدًا خَامِدِينَ", "color": "brown"}, {"text": "(  الأنبياء: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف مبني على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على السكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿زَالَتْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "زال", "color": "blue"}, {"text": "\": فعل ماضٍ ناقص مبنيّ على الفتح الظاهر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السكون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تِلْكَ﴾:", "color": "green"}, {"text": "تي: اسم إشارة مبنيّ على السكون المقدّر على الياء المحذوفة لالتقاء الساكنين في محلّ رفع اسم \"", "color": "black"}, {"text": "زالت", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد مبنيّ على السكون، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب مبنيّ على السكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿دَعْوَاهُمْ﴾:", "color": "green"}, {"text": "دعوي: خبر \"", "color": "black"}, {"text": "زالت", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدّرة على الألف للتعذّر، وهو مضاف، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما زالت تلك دعواهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وجرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿جَعَلْنَاهُمْ﴾:", "color": "green"}, {"text": "جعل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ على السكون في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿حَصِيدًا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة الظاهرة في آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿خَامِدِينَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والمصدر المؤوّل من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المحذوفة والفعل \"", "color": "black"}, {"text": "جعلناهم", "color": "blue"}, {"text": "\" في محلّ جرّ بحرف الجر، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "دعواهم", "color": "blue"}, {"text": "\".", "color": "black"}]}]