[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَا هَذِهِ التَّمَاثِيلُ الَّتِي أَنْتُمْ لَهَا عَاكِفُونَ", "color": "brown"}, {"text": "(  الأنبياء: 52  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "اسم مبنيّ على السكون في محلّ نصب مفعول به بفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِأَبِيهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنَّهُ من الأسماء الخمسة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَقَوْمِهِ﴾:", "color": "green"}, {"text": "اسم معطوف مجرور بالواو على \"", "color": "black"}, {"text": "أبيه", "color": "blue"}, {"text": "\" وتعرب إعرابها، وعلامة جرّ الاسم الكسرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ على السكون في محلّ رفع خبر مقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هَذِهِ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف تنبيه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "ذا: اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿التَّمَاثِيلُ﴾:", "color": "green"}, {"text": "بدلٌ من اسم الإشارة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الَّتِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "التماثيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملة بعده صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿لَهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "عاكفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿عَاكِفُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنتم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنَّهُ جمع مذكر سالم.", "color": "black"}]}]