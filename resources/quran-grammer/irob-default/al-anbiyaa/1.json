[{"row_id": 1, "segments": [{"text": "سورة الأنبياء\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{  اقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ  فِي غَفْلَةٍ   مُعْرِضُونَ", "color": "brown"}, {"text": "(  الأنبياء:  1   )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اقْتَرَبَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح الظاهر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِلنَّاسِ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "الناس: اسم مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "اقترب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حِسَابُهُمْ﴾:", "color": "green"}, {"text": "حساب: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره, وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اقترب للناس حسابهم", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حالية حرف مبنيّ على الفتح، أو حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿غَفْلَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة الظاهرة في آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"tex