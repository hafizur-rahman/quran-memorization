[{"row_id": 1, "segments": [{"text": "{ وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِلْعَالَمِينَ", "color": "brown"}, {"text": "(  الأنبياء: 107  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَرْسَلْنَاكَ﴾:", "color": "green"}, {"text": "أرسل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَحْمَةً﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة من كاف المخاطب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِلْعَالَمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة محذوفة من \"", "color": "black"}, {"text": "رحمة", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وما أرسلناك", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]