[{"row_id": 1, "segments": [{"text": "{ وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ", "color": "brown"}, {"text": "(  الكافرون: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَابِدُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنتم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم،\nمَا أَعْبُدُ: تعرب إعراب \"", "color": "black"}, {"text": "ما تعبدون", "color": "blue"}, {"text": "\"  وهو « مَا: اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَعْبُدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وعلامة رفع الفعل الضمة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ولا أنتم عابدون", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "أعبد", "color": "blue"}, {"text": "\" في محلّ نصب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أعبد", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}]