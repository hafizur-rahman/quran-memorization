[{"row_id": 1, "segments": [{"text": "{ وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ", "color": "brown"}, {"text": "(  الكافرون: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية الثالثة من هذه الآية.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « وَلَا: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَابِدُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنتم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم، \nمَا أَعْبُدُ: تعرب إعراب \"", "color": "black"}, {"text": "ما تعبدون", "color": "blue"}, {"text": "\" وعلامة رفع الفعل الضمة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنا».", "color": "black"}]}]