[{"row_id": 1, "segments": [{"text": "{ إِنَّا بَلَوْنَاهُمْ كَمَا بَلَوْنَا أَصْحَابَ الْجَنَّةِ إِذْ أَقْسَمُوا لَيَصْرِمُنَّهَا مُصْبِحِينَ", "color": "brown"}, {"text": "(  القلم: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بَلَوْنَاهُمْ﴾:", "color": "green"}, {"text": "بلونا: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَمَا﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ما: حرف مصدري.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَلَوْنَا﴾:", "color": "green"}, {"text": "اعربت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ جرّ بحرف الجرّ  \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بمفعول مطلق محذوف، والتقدير: إنا بلوناهم بلاء كبلائنا أصحاب الجنة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَصْحَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْجَنَّةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه متعلق بـ \"", "color": "black"}, {"text": "بلونا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَقْسَمُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لَيَصْرِمُنَّهَا﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب القسم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "يصر من: فعل مضارع مبنيّ لاتصاله بنون التوكيد التي حذفت بسبب توالي النونات، وواو الجماعة المحذوفة لالتقائها ساكنة مع نون التوكيد الثقيلة هي في محلّ رفع فاعل، ونون التوكيد حرف لا محلّ له من الإعراب، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مُصْبِحِينَ﴾:", "color": "green"}, {"text": "حال منصوبة بالياء؛ لأنّها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنا بلوناهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بلوناهم", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بلونا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"