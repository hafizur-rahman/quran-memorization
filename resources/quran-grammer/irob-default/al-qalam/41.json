[{"row_id": 1, "segments": [{"text": "{ أَمْ لَهُمْ شُرَكَاءُ فَلْيَأْتُوا بِشُرَكَائِهِمْ إِنْ كَانُوا صَادِقِينَ", "color": "brown"}, {"text": "(  القلم: 41  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ لَهُمْ شُرَكَاءُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "أم لكم كتاب", "color": "blue"}, {"text": "\" الواردة في الآية السابعة والثلاثين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « أَمْ: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كِتَابٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَلْيَأْتُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف واقع في جواب شرط مقدم، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": لام الأمر، حرف جزم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "يأتوا: فعل مضارع مجزوم باللام، وعلامة جزمه حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِشُرَكَائِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يأتوا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿