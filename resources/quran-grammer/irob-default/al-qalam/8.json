[{"row_id": 1, "segments": [{"text": "{ فَلَا تُطِعِ الْمُكَذِّبِينَ", "color": "brown"}, {"text": "(  القلم: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُطِعِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره الذي حرك بالكسر الالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُكَذِّبِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تطع", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن ضل المكذبون فلا تطعهم.", "color": "black"}]}]