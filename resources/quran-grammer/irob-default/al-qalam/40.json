[{"row_id": 1, "segments": [{"text": "{ سَلْهُمْ أَيُّهُمْ بِذَلِكَ زَعِيمٌ", "color": "brown"}, {"text": "(  القلم: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سَلْهُمْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَيُّهُمْ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِذَلِكَ﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "زعيم", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿زَعِيمٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "سلهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أيهم بذلك زعيم", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به ثان لفعل السؤال المعلق بالاستفهام \"", "color": "black"}, {"text": "أيهم", "color": "blue"}, {"text": "\"، وذلك بتقدير حرف الجر.", "color": "black"}]}]