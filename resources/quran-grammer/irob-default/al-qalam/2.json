[{"row_id": 1, "segments": [{"text": "{ مَا أَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ", "color": "brown"}, {"text": "(  القلم: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز ولا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، ومبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِنِعْمَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "مجنون", "color": "blue"}, {"text": "\" في محلّ نصب حال بمعنى: ما أنت مجنون منعم عليك بالنبوة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِمَجْنُونٍ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "مجنون: اسم مجرور لفظًا منصوب محلًا على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" مرفوع محلًا على أنه خبر \"", "color": "black"}, {"text": "أنت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما أنت", "color": "blue"}, {"text": "\" بمجنون لا محلّ لها من الإعراب؛ لأنّها جواب القسم.", "color": "black"}]}]