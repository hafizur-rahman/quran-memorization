[{"row_id": 1, "segments": [{"text": "{ أَنْ كَانَ ذَا مَالٍ وَبَنِينَ", "color": "brown"}, {"text": "(  القلم: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح واسمها ضمير مستتر جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ نصب مفعول من أجله.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ذَا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالألف؛ لأنَّه من الأسماء الخمسة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَالٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَبَنِينَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "مال", "color": "blue"}, {"text": "\" مجرورة بالياء؛ لأنّها ملحقة بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان ذا مال وبنين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" ـ", "color": "black"}]}]