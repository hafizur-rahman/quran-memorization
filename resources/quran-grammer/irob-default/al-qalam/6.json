[{"row_id": 1, "segments": [{"text": "{ بِأَيِّكُمُ الْمَفْتُونُ", "color": "brown"}, {"text": "(  القلم: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بِأَيِّكُمُ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أي: اسم مجرور لفظًا مرفوع محلًا على أنه مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمَفْتُونُ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بأيكم المفتون", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به لفعل الإبصار المعلق بأي.", "color": "black"}]}]