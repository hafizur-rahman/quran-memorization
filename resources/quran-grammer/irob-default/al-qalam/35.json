[{"row_id": 1, "segments": [{"text": "{ أَفَنَجْعَلُ الْمُسْلِمِينَ كَالْمُجْرِمِينَ", "color": "brown"}, {"text": "(  القلم: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَفَنَجْعَلُ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "نجعل: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُسْلِمِينَ﴾:", "color": "green"}, {"text": "مفعول به أول منصوب بالياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَالْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب مفعول به ثانٍ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "المجرمين: مضاف إليه مجرور بالياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نجعل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على استئناف مقدر، أي: في الحكم، فنجعل المسلمين كالمجرمين.", "color": "black"}]}]