[{"row_id": 1, "segments": [{"text": "{  أَمْ تَسْأَلُهُمْ أَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَ", "color": "brown"}, {"text": "(  القلم: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الأربعين من سورة الطور.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو « أَمْ﴾: حرف عطف \nتَسْأَلُهُمْ: تسأل: فعل مضارع مرفوع بالضمة والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَجْرًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "هم: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ مَغْرَمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر المبتدأ \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُثْقَلُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نسألهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فهم من مغرم مثقلون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "تسألهم", "color": "blue"}, {"text": "\"».", "color": "black"}]}]