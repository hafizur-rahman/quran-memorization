[{"row_id": 1, "segments": [{"text": "سُورَةُ القَلَم\nترتيبها 68\nآياتها 52 مكية\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ ن وَالْقَلَمِ وَمَا يَسْطُرُونَ", "color": "brown"}, {"text": "(  القلم: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ن﴾:", "color": "green"}, {"text": "انظر ما قلناه في الآية الأولى من سورة البقرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "الم: ابتدأت بعض سور القرآن الكريم ببعض الحروف المقطّعة، وقد اختلف العلماء في تفسيرها وإعرابها اختلافًا كبيرًا.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "وهي تُعرب اسمًا مبنيًّا في محلّ رفع خبر مقدّم لمبتدأ محذوف، تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ويجوز إعراب \"", "color": "black"}, {"text": "الم", "color": "blue"}, {"text": "\" هنا، اسمًا مبنيًّا في محلّ رفع مبتدأ خبره \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالْقَلَمِ﴾:", "color": "green"}, {"text": "الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "القلم: مقسم به مجرور بالكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "ما: حرف مصدريّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَسْطُرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ جرّ معطوف على \"", "color": "black"}, {"text": "القلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم بالقلم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها ابتدائية.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يسطرون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}]