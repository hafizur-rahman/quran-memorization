[{"row_id": 1, "segments": [{"text": "{ فَذَرْنِي وَمَنْ يُكَذِّبُ بِهَذَا الْحَدِيثِ سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ", "color": "brown"}, {"text": "(  القلم: 44  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَذَرْنِي﴾:", "color": "green"}, {"text": "الفاء حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذرني: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ نصب اسم معطوف على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "ذرني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُكَذِّبُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِهَذَا﴾:", "color": "green"}, {"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "هذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "يكذب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْحَدِيثِ﴾:", "color": "green"}, {"text": "نعت لاسم الإشارة، أو بدل منه مجرور بالكسرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿سَنَسْتَدْرِجُهُمْ﴾:", "color": "green"}, {"text": "السين: حرف استقبال.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "نستدرج: فعل مض