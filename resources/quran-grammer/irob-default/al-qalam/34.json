[{"row_id": 1, "segments": [{"text": "{ إِنَّ لِلْمُتَّقِينَ عِنْدَ رَبِّهِمْ جَنَّاتِ النَّعِيمِ", "color": "brown"}, {"text": "(  القلم: 34  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "إِنَّ: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِلْمُتَّقِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" المقدم، وعلامة جرّ الاسم الياء\"؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلق بالمتقين\"", "color": "black"}, {"text": "أو بحال محذوفة من", "color": "blue"}, {"text": "\"جنات\"، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿جَنَّاتِ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالكسرة بدلا من الفتحة؛ لأنَّه جمع مؤنت سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿النَّعِيمِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن للمتقين جنات", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "black"}]}]