[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ", "color": "brown"}, {"text": "(  الأحقاف: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "{ إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا }", "color": "brown"}]}, {"row_id": 3, "segments": [{"text": ": الجزء الأول من الآية إلى \"", "color": "black"}, {"text": "ثم استقاموا", "color": "blue"}, {"text": "\" سبق إعرابه في الآية الثلاثين من سورة \"", "color": "black"}, {"text": "فصلت", "color": "blue"}, {"text": "\"،  وهو « إِنَّ: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبُّنَا﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة، أو خبر المبتدأ محذوف تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اسْتَقَامُوا﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\"، وتعرب إعرابها».", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "{ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ }", "color": "brown"}]}, {"row_id": 11, "segments": [{"text": ": \"", "color": "black"}, {"text": "وهذا الجزء الثاني سبق إعرابه في سور عديدة.", "color": "blue"}]}, {"row_id": 12, "segments": [{"text": "ومنها الخامسة والثلاثون من سورة الأعراف\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وهو « فَلَا: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿خَوْفٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جرّ و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محلّ جرّ بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجارّ والمجرور متعلقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿يَحْزَنُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يقصون", "color": "blue"}, {"text": "\": فعل مضارع مرفوع بثبوت النون، والواو ضمير متصل مبنيّ في محلّ رفع فاعل »", "color": "black"}]}]