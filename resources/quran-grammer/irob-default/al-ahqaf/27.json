[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ أَهْلَكْنَا مَا حَوْلَكُمْ مِنَ الْقُرَى وَصَرَّفْنَا الْآيَاتِ لَعَلَّهُمْ يَرْجِعُونَ", "color": "brown"}, {"text": "(  الأحقاف: 27  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ أَهْلَكْنَا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "ولقد مكنا", "color": "blue"}, {"text": "\" الواردة في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « وَلَقَدْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللام: للابتداء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَكَّنَّاهُمْ﴾:", "color": "green"}, {"text": "مكن: فعل ماض مبني على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبني على السكون في محلّ رفع فاعل، »", "color": "black"}, {"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حَوْلَكُمْ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بصلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنَ الْقُرَى﴾:", "color": "green"}, {"text": "من: حرف جر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "القرى: اسم مجرور.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجارّ والمجرور متعلّقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" تقديرها: حال كونهم من القرى