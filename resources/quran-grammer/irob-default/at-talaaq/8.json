[{"row_id": 1, "segments": [{"text": "{ وَكَأَيِّنْ مِنْ قَرْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِهِ فَحَاسَبْنَاهَا حِسَابًا شَدِيدًا وَعَذَّبْنَاهَا عَذَابًا نُكْرًا", "color": "brown"}, {"text": "(  الطلاق: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَأَيِّنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كأين: كناية عن عدد مبنية على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَرْيَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة، والجار والمجرور متعلق بحال محذوفة لـ \"", "color": "black"}, {"text": "كأين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والتقدير: عدد كبير حالة كونه من أهل قرية.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَتَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف المحذوفة  الساكنين، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَنْ أَمْرِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "عتت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَبِّهَا﴾:", "color": "green"}, {"text": "رب: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَرُسُلِهِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13