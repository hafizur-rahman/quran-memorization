[{"row_id": 1, "segments": [{"text": "{ يَلْبَسُونَ مِنْ سُنْدُسٍ وَإِسْتَبْرَقٍ مُتَقَابِلِينَ", "color": "brown"}, {"text": "(  الدخان: 53  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَلْبَسُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مِنْ سُنْدُسٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت للمفعول المقدّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَإِسْتَبْرَقٍ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "سندس", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُتَقَابِلِينَ﴾:", "color": "green"}, {"text": "حال من ضمير \"", "color": "black"}, {"text": "يلبسون", "color": "blue"}, {"text": "\" منصوب بالياء؛ لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة يلبسون\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]