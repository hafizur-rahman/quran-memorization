[{"row_id": 1, "segments": [{"text": "{ لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَى وَوَقَاهُمْ عَذَابَ الْجَحِيمِ", "color": "brown"}, {"text": "(  الدخان: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَذُوقُونَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يلبسون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "يَلْبَسُونَ: فعل مضارع مرفوع بثبوت النون، و\"", "color": "blue"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِيهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يذوقون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمَوْتَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمَوْتَةَ﴾:", "color": "green"}, {"text": "مستثنى منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْأُولَى﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "الموتة", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَوَقَاهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وقي: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعو