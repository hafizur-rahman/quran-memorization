[{"row_id": 1, "segments": [{"text": "{ رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِنْ كُنْتُمْ مُوقِنِينَ", "color": "brown"}, {"text": "(  الدخان: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبِّ السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "ربك", "color": "blue"}, {"text": "\" الواردة في الآية السابقة مجرور بالكسرة والسماوات: مضاف إليه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "{ مَا }", "color": "brown"}]}, {"row_id": 6, "segments": [{"text": ": اسم موصول مبنيّ في محلّ جرّ، لأنه معطوف على مجرور.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بَيْنَهُمَا﴾:", "color": "green"}, {"text": "ظرف مكان منصوب على الظرفية وعلامة نصبه الفتحة متعلّق بصلة الموصول المحذوفة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على السكون لاتصاله بضمير الرفع المتحرك فعل الشرط في محلّ جزم، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مُوقِنِينَ﴾:", "color": "green"}, {"text": "خبر \"", "