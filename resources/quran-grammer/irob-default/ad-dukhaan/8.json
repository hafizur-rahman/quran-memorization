[{"row_id": 1, "segments": [{"text": "{ لَا إِلَهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ", "color": "brown"}, {"text": "(  الدخان: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي للجنس يعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب، وخبرها محذوف وجوبًا بمعنى: لا إله موجود.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع بدل من محلّ \"", "color": "black"}, {"text": "لا إله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يُحْيِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَيُمِيتُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "يميت: مثل \"", "color": "black"}, {"text": "يحيي", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَبُّكُمْ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: هو ربكم مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَرَبُّ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "ربكم", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿آبَائِكُمُ﴾:", "color": "green"}, {"text": "آباء: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مضاف إليه.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْأَوَّلِينَ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "آبائكم", "color": "blue"}, {"text": "\" مجرور وعلامة جره الياء\"؛ لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا إله إلا هو", "color": "blue"}, {"text": "\"لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يحيي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يميت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يحيي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو ربكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]