[{"row_id": 1, "segments": [{"text": "{ خُذُوهُ فَاعْتِلُوهُ إِلَى سَوَاءِ الْجَحِيمِ", "color": "brown"}, {"text": "(  الدخان: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿خُذُوهُ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون؛ لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿فَاعْتِلُوهُ﴾:", "color": "green"}, {"text": "فعل معطوف بالفاء على \"", "color": "black"}, {"text": "خذوه", "color": "blue"}, {"text": "\" ويعرب مثله.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى سَوَاءِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "اعتلوه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْجَحِيمِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خذوه", "color": "blue"}, {"text": "\" في محلّ نصب مقول لا قول لقول مقدر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعتلوه", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]