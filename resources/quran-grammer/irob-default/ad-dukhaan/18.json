[{"row_id": 1, "segments": [{"text": "{ أَنْ أَدُّوا إِلَيَّ عِبَادَ اللَّهِ إِنِّي لَكُمْ رَسُولٌ أَمِينٌ", "color": "brown"}, {"text": "(  الدخان: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف تفسير.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَدُّوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَيَّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أدوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أدوا", "color": "blue"}, {"text": "\" تفسيرية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ نصب مفعول به \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" لفعل مضمر تقديره: قائلا لهم: أن أدوا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عِبَادَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "منادي منصوب، لأنه مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مخفوض بالكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبرها.", "color": "black"}]}, {"row_id": 12, "