[{"row_id": 1, "segments": [{"text": "{ فَأَسْرِ بِعِبَادِي لَيْلًا إِنَّكُمْ مُتَّبَعُونَ", "color": "brown"}, {"text": "(  الدخان: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَسْرِ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أسر: فعل أمر مبنيّ على حذف حرف العلة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِعِبَادِي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بأسر\"", "color": "black"}, {"text": "، و", "color": "blue"}, {"text": "\"الياء\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَيْلًا﴾:", "color": "green"}, {"text": "مفعول فيه ظرف زمان منصوب على الظرفية متعلّق بـ \"", "color": "black"}, {"text": "أسر", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِنَّكُمْ مُتَّبَعُونَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "أنكم عائدون", "color": "blue"}, {"text": "\" الواردة في الآية الخامسة عشرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وهو « إِنَّكُمْ: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَائِدُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع بالواو؛ لأنه جمع مذكر سالم».", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أسر", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي إن أردت النجاة فأسر وجملة الشرط في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" لقول مقدر أي قال الله تعالى لموسى.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنكم متبعون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]