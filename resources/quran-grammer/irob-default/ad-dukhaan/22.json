[{"row_id": 1, "segments": [{"text": "{ فَدَعَا رَبَّهُ أَنَّ هَؤُلَاءِ قَوْمٌ مُجْرِمُونَ", "color": "brown"}, {"text": "(  الدخان: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَدَعَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "دعا: فعل ماضٍ مبنيّ على الفتح المقدّر على \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبَّهُ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هَؤُلَاءِ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَوْمٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مُجْرِمُونَ﴾:", "color": "green"}, {"text": "نعت لقوم\"", "color": "black"}, {"text": "مرفوع بالواو، لأنّها جمع مذكر سالم.", "color": "blue"}]}, {"row_id": 9, "segments": [{"text": "جملة \"دعا\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها معطوفة على الجملة الاستئنافية المقدّرة، أي فلم يتركوه فدعا به.", "color": "blue"}]}, {"row_id": 10, "segments": [{"text": "والمصدر المؤول من \"أن هؤلاء قوم\"", "color": "black"}, {"text": "في محلّ جرّ بحرف جرّ محذوف.", "color": "blue"}]}, {"row_id": 11, "segments": [{"text": "والجار والمجرور متعلّقان بـ \"دعا\".", "color": "black"}]}]