[{"row_id": 1, "segments": [{"text": "{ وَإِنْ لَمْ تُؤْمِنُوا لِي فَاعْتَزِلُونِ", "color": "brown"}, {"text": "(  الدخان: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تُؤْمِنُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، فعل الشرط في محلّ جزم وعلامة جزمه حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تؤمنوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَاعْتَزِلُونِ﴾:", "color": "green"}, {"text": "الفاء: حرف ربط لجواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "اعتزلون: فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للوقاية، و\"", "color": "black"}, {"text": "ياء", "color": "blue"}, {"text": "\" المتكلم المحذوفة: ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن لم تؤمنوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "إني عذت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعتزلون", "color": "blue"