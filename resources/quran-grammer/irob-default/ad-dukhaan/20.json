[{"row_id": 1, "segments": [{"text": "{ وَإِنِّي عُذْتُ بِرَبِّي وَرَبِّكُمْ أَنْ تَرْجُمُونِ", "color": "brown"}, {"text": "(  الدخان: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنِّي﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إني: تقدم إعرابها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "في الآية السابقة وهو: «", "color": "black"}, {"text": "إِنِّي: حرف توكيد مشبه بالفعل، و\"", "color": "blue"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسمها", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "}", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عُذْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِرَبِّي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "عذت", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَرَبِّكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ربكم: اسم معطوف على \"", "color": "black"}, {"text": "ربي", "color": "blue"}, {"text": "\" مجرور وعلامة جره الكسرة، \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري ناصب.", "color": "black"}]},