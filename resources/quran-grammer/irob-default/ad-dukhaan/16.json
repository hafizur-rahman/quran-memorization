[{"row_id": 1, "segments": [{"text": "{ يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَى إِنَّا مُنْتَقِمُونَ", "color": "brown"}, {"text": "(  الدخان: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "يوم", "color": "blue"}, {"text": "\" في الآية العاشرة منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نَبْطِشُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْبَطْشَةَ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكُبْرَى﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "البطشة", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدّرة على \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِنَّا مُنْتَقِمُونَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "إنا مؤمنون", "color": "blue"}, {"text": "\" الواردة في الآية الثانية عشرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وهو: « إِنَّا: إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مُؤْمِنُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نبطش", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "blac