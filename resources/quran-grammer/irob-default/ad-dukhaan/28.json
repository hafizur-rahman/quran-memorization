[{"row_id": 1, "segments": [{"text": "{ كَذَلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ", "color": "brown"}, {"text": "(  الدخان: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ في محلّ نصب نعت لمصدر محذوف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إذا﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ في محلّ جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": للخطاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَأَوْرَثْنَاهَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "أورث: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَوْمًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آخَرِينَ﴾:", "color": "green"}, {"text": "نعت لـ", "color": "black"}, {"text": "( قوم )", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "منصوب بالياء، لأنه جمع مذكر سالم.", "color": "blue"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"أورثناها\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافية.", "color": "black"}]}]