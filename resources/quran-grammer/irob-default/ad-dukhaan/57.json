[{"row_id": 1, "segments": [{"text": "{ فَضْلًا مِنْ رَبِّكَ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ", "color": "brown"}, {"text": "(  الدخان: 57  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَضْلًا﴾:", "color": "green"}, {"text": "مفعول لأجله منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مِنْ رَبِّكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بنعت لـ \"", "color": "black"}, {"text": "فضة", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير فصل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْفَوْزُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْعَظِيمُ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "الفوز", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذلك هو الفوز", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]