[{"row_id": 1, "segments": [{"text": "{ قَالَ عَمَّا قَلِيلٍ لَيُصْبِحُنَّ نَادِمِينَ", "color": "brown"}, {"text": "(  المؤمنون: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَمَّا﴾:", "color": "green"}, {"text": "أصلها \"", "color": "black"}, {"text": "عن", "color": "blue"}, {"text": "\" حرف جر، و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": زائدة لتوكيد معنى القلة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَلِيلٍ اسم مجرور بـ \"", "color": "green"}, {"text": "عن", "color": "green"}, {"text": "\"، وعلامة جره الكسرة.", "color": "green"}]}, {"row_id": 5, "segments": [{"text": "﴿لَيُصْبِحُنَّ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب قسم مقدّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "يصبحن: فعل مضارع ناقص مبنيّ على حذف النون، لأنه من الأفعال الخمسة وسبب بنائه على حذف النون اتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "واو", "color": "blue"}, {"text": "\" الجماعة المحذوفة لالتقائها ساكنة مع نون التوكيد الثقيلة في محلّ رفع اسم \"", "color": "black"}, {"text": "يصبح", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نون", "color": "blue"}, {"text": "\" التوكيد لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَادِمِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "يصبح", "color": "blue"}, {"text": "\" منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور \"", "color": "black"}, {"text": "عما قليل", "color": "blue"}, {"text": "\" متعلّقان بـ \"", "color": "black"}, {"text": "يصبحن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_