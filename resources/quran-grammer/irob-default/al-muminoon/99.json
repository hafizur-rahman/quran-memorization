[{"row_id": 1, "segments": [{"text": "{ حَتَّى إِذَا جَاءَ أَحَدَهُمُ الْمَوْتُ قَالَ رَبِّ ارْجِعُونِ", "color": "brown"}, {"text": "(  المؤمنون: 99  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿حَتَّى إِذَا﴾:", "color": "green"}, {"text": "حتى: حرف غاية وابتداء متعلق بـ\"", "color": "black"}, {"text": "يصفون", "color": "blue"}, {"text": "\" التي وردت في الآية السادسة والتسعين.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إذا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه وهو حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَحَدَهُمُ﴾:", "color": "green"}, {"text": "أحد: مفعول به مقدم منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متصل مبني في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمَوْتُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿«", "color": "green"}, {"text": "رَبِّ﴾:", "color": "blue"}, {"text": "منادي بحرف نداء محذوف منصوب، وعلامة نصبه فتحة مقدرة على ما قبل ياء المتكلم منع من ظهورها حركة المناسبة.", "color": "green"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه».", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ارْجِعُونِ﴾:", "color": "green"}, {"text": "فعل دعاء وتوسل بصيغة طلب مبني على حذف النون، لأن مضارعه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون الوقاية والنون المحذوفة اكتفاء بالكسرة الدالة عليها ضمير متصل ضمير المتكلم في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاء أحدهم", "color": "blue"}, {"text": "\" في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" جواب شرط غير جازم لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ارجعون", "color": "blue"}, {"text": "\" في محل نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]