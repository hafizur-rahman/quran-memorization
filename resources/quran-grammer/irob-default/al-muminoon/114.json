[{"row_id": 1, "segments": [{"text": "{ قَالَ إِنْ لَبِثْتُمْ إِلَّا قَلِيلًا لَوْ أَنَّكُمْ كُنْتُمْ تَعْلَمُونَ", "color": "brown"}, {"text": "(  المؤمنون: 114  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "مخففة مهملة، حرف نفي بمعنى \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَبِثْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض مبني على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "نعت لمصدر محذوف أو نائبة عنه بتقدير إلا لبثًا قليلًا.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَنَّكُمْ﴾:", "color": "green"}, {"text": "إن: حرف نصب وتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ على الضم في محل نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبني على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل ر