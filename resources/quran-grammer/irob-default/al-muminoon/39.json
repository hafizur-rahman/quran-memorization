[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ انْصُرْنِي بِمَا كَذَّبُونِ", "color": "brown"}, {"text": "(  المؤمنون: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة مكررة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "أعربت في الآية الكريمة السادسة والعشرين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو﴾: « قَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى بحرف نداء محذوف بتقدير: يا رب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وهو منادى مضاف منصوب بالفتحة المقدّرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالكسرة التي هي الحركة الدالة على ياء المتكلم المحذوفة، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة: ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿انْصُرْنِي﴾:", "color": "green"}, {"text": "فعل دعاء وتضرع بصيغة طلب مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للوقاية، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "ما: مصدرية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَذَّبُونِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و\"", "color": "black"}, {"te