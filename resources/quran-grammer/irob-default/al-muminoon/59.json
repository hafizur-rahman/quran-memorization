[{"row_id": 1, "segments": [{"text": "{ وَالَّذِينَ هُمْ بِرَبِّهِمْ لَا يُشْرِكُونَ", "color": "brown"}, {"text": "(  المؤمنون: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة تعرب إعراب الآية الكريمة الآيةالسابعة والخمسين وهو﴾:", "color": "green"}, {"text": "« الَّذِينَ: اسم موصول مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة الاسمية بعده صلته لا محلّ لها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ خَشْيَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "رب: مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة،»", "color": "black"}, {"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له وجملة \"", "color": "black"}, {"text": "لا يشركون", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿«", "color": "green"}, {"text": "يُشْرِكُونَ ﴾:", "color": "blue"}, {"text": "يُؤْمِنُونَ: فعل مضارع مرفوع بثبوت النون، و \"", "color": "green"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل", "color": "green"}, {"text": "».", "color": "black"}]}]