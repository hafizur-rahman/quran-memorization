[{"row_id": 1, "segments": [{"text": "{ عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَتَعَالَى عَمَّا يُشْرِكُونَ", "color": "brown"}, {"text": "(  المؤمنون: 92  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عَالِمِ﴾:", "color": "green"}, {"text": "نعت للفظ الجلالة مخفوض، وعلامة خفضه الكسرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْغَيْبِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَالشَّهَادَةِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "الغيب", "color": "blue"}, {"text": "\" مجرورة مثلها وتعرب إعرابها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَتَعَالَى﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "تعالى: فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَمَّا يُشْرِكُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "عما يصفون", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة السابقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وهو: « عَمَّا: مركبة من \"", "color": "black"}, {"text": "عن", "color": "blue"}, {"text": "\" حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": المصدرية.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَصِفُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ جرّ بـ \"", "color": "black"}, {"text": "عن", "color": "blu