[{"row_id": 1, "segments": [{"text": "{ وَالَّذِينَ هُمْ عَنِ اللَّغْوِ مُعْرِضُونَ", "color": "brown"}, {"text": "(  المؤمنون: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة معطوفة بالواو على الآية التي قبلها وتعرب إعرابها.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: « الَّذِينَ: اسم موصول مبنيّ على الفتح في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "المؤمنين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي صَلَاتِهِمْ﴾:", "color": "green"}, {"text": "في صلاة: جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَاشِعُونَ﴾:", "color": "green"}, {"text": "خبر المبتدأ \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم».", "color": "black"}]}]