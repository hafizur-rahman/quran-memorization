[{"row_id": 1, "segments": [{"text": "{ فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ", "color": "brown"}, {"text": "(  المؤمنون: 116  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَتَعَالَى﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تعالى: فعل ماض مبني على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع للتعظيم بالضمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمَلِكُ الْحَقُّ﴾:", "color": "green"}, {"text": "نعتان للفظ الجلالة مرفوعان بالضمة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس تعمل عمل \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسمها مبني على الفتح في محل نصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر أو استثناء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبني في محل رفع بدلًا من محل \"", "color": "black"}, {"text": "لا إله", "color": "blue"}, {"text": "\" لأن محل \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" وما عملت فيه الرفع على الابتداء.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وخبر \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" النافية للجنس محذوف تقديره: كائن أو موجود.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَبُّ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْعَرْشِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿الْكَرِيمِ﴾:", "color": "green"}, {"text": "نعت للعرش مجرور مثله وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فتعالى", "color": "blue"}, {"text": "\" استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا إله إلا هو", "color": "blue"}, {"text": "\" في محل نصب حال.", "color": "black"}]}]