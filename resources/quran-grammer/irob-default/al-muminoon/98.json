[{"row_id": 1, "segments": [{"text": "{ وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ", "color": "brown"}, {"text": "(  المؤمنون: 98  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "{ وَأَعُوذُ بِكَ رَبِّ }", "color": "brown"}]}, {"row_id": 3, "segments": [{"text": ": أعربت في الآية الكريمة السابقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وهو﴾:", "color": "green"}, {"text": "« أَعُوذُ: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِكَ﴾:", "color": "green"}, {"text": "الباء: حرف جر زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير المخاطب للتعظيم مبني على الفتح في محل جر بالباء».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿«", "color": "green"}, {"text": "رَبِّ﴾:", "color": "blue"}, {"text": "منادي بحرف نداء محذوف منصوب، وعلامة نصبه فتحة مقدرة على ما قبل ياء المتكلم منع من ظهورها حركة المناسبة.", "color": "green"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري ونصب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَحْضُرُونِ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\"، وعلامة نصبه حذف النون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون الوقاية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والكسرة دالة على ياء المتكلم المحذوفة خطًا واختصارًا اكتفاء بالكسرة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متصل مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما تلاها بتأويل مصدر في محل جر بحرف جر محذوف تقديره: \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والجار والمجرور متعلقان بـ \"", "color": "black"}, {"text": "أعوذ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وأعوذ بك", "color": "blue"}, {"text": "\" معطوفة على الآية الكريمة السابقة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يحضرون", "color": "blue"}, {"text": "\" صلة \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية لا محل لها من الإعراب.", "color": "black"}]}]