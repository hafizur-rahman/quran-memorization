[{"row_id": 1, "segments": [{"text": "{ قَالُوا لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍ فَاسْأَلِ الْعَادِّينَ", "color": "brown"}, {"text": "(  المؤمنون: 113  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "{ قَالُوا لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍ }", "color": "brown"}]}, {"row_id": 3, "segments": [{"text": ": هذه الآية أعربت في الآية الكريمة التاسعة والخمسين بعد المائتين من سورة البقرة .", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو:\n « قَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَبِثْتُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، والتاء ضمير متّصل مبنيّ على الضمّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَوْمًا﴾:", "color": "green"}, {"text": "مفعول فيه منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَوْ﴾:", "color": "green"}, {"text": "حرف عطف مبنيّ على السكون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بَعْضَ﴾:", "color": "green"}, {"text": "اسم معطوف على \"", "color": "black"}, {"text": "يوم", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَوْمٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لبثتُ يومًا أو بعض يوم", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لبثتُ يومًا أو بعض يومٍ", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب».", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿فَاسْأَلِ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "اسأل: فعل أمر مبني على السكون الذي حرك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿الْعَادِّينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لبثنا يومًا", "color": "blue"}, {"text": "\" في محل نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فاسأل العادين", "color": "blue"}, {"text": "\" استئنافية لا محل لها من الإعراب.", "color": "black"}]}]