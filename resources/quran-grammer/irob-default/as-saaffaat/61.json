[{"row_id": 1, "segments": [{"text": "{ لِمِثْلِ هَذَا فَلْيَعْمَلِ الْعَامِلُونَ", "color": "brown"}, {"text": "(  الصافات: 61  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِمِثْلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يعمل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَلْيَعْمَلِ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "واللام: لام الأمر حرف جزم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "يعمل: فعل مضارع مجزوم باللام، وعلامة جزمه سكون آخره، وقد حُرِّك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْعَامِلُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ليعمل العاملون", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: من أراد الفوز في الآخرة، فليعمل له مثل ذلك في الدنيا.", "color": "black"}]}]