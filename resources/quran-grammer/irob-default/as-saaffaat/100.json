[{"row_id": 1, "segments": [{"text": "{ رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ", "color": "brown"}, {"text": "(  الصافات: 100  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي بحرف نداء محذوف منصوب بالفتحة المقدرة على آخره، منع من ظهورها اشتغال المحلّ بالكسرة المناسبة لـ \"", "color": "black"}, {"text": "ياء", "color": "blue"}, {"text": "\" المتكلم المحذوفة وهي ضمير مبنيّ في محلّ جرّ بالإضافة\nهَبْ: فعل طلب مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "هب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنَ الصَّالِحِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "هب", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}]