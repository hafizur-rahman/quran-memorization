[{"row_id": 1, "segments": [{"text": "{ فَلَوْلَا أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ", "color": "brown"}, {"text": "(  الصافات: 143  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَوْلَا﴾:", "color": "green"}, {"text": "الفاء حرف استئناف يقيد التعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لولا: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "( حرف امتناع لوجود )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنَّهُ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، واسمها ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ الْمُسَبِّحِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أنه كان من المسبحين", "color": "blue"}, {"text": "\" في محلّ رفع مبتدأ خبره محذوف تقديره: موجود.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة لولا \"", "color": "black"}, {"text": "تسبيحه", "color": "blue"}, {"text": "\" موجود لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان من المسبحين", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}]