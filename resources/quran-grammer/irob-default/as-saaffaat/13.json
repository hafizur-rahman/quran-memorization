[{"row_id": 1, "segments": [{"text": "{ وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ", "color": "brown"}, {"text": "(  الصافات: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن متضمن معنى الشرط مبنيّ على السكون خافض لشرطه متعلّق بجوابه في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ذُكِّرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَذْكُرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ذكروا", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يذكرون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}]