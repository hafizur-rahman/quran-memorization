[{"row_id": 1, "segments": [{"text": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ", "color": "black"}, {"text": "(  الصافات: 9  )", "color": "green"}, {"text": "}", "color": "black"}]}, {"row_id": 2, "segments": [{"text": "﴿دُحُورًا﴾:", "color": "green"}, {"text": "مفعول له أو مطلق لفعل محذوف منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَلَهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لهم: اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَذَابٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاصِبٌ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "عذاب", "color": "blue"}, {"text": "\" مرفوعة مثلها بالضمة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لهم عذاب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "لا يسمعون", "color": "blue"}, {"text": "\".", "color": "black"}]}]