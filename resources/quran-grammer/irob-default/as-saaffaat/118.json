[{"row_id": 1, "segments": [{"text": "{ وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ", "color": "brown"}, {"text": "(  الصافات: 118  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿تعرب إعراب الآية السابقة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « وَآتَيْنَاهُمَا: معطوفة بالواو على \"", "color": "black"}, {"text": "نصرناهم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو :  نصر: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمُسْتَبِينَ﴾:", "color": "green"}, {"text": "نعت للكتاب منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آتيناهما", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة جواب القسم».", "color": "black"}]}]