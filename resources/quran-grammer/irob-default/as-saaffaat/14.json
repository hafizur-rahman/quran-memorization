[{"row_id": 1, "segments": [{"text": "{ وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ", "color": "brown"}, {"text": "(  الصافات: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "وَإِذَا: الواو: حرف استئناف.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن متضمن معنى الشرط مبنيّ على السكون خافض لشرطه متعلّق بجوابه في محلّ نصب مفعول فيه».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَأَوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدّر على الألف المحذوفة للتعذّر لاتصالها بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آيَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَسْتَسْخِرُونَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يذكرون", "color": "blue"}, {"text": "\" في الآية السابقة، وهو: «", "color": "black"}, {"text": "يَذْكُرُونَ: فعل مضارع مرفوع بثبوت النون، و \"", "color": "blue"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وكذلك إعراب الجمل.", "color": "black"}]}]