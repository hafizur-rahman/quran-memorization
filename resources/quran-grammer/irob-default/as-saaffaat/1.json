[{"row_id": 1, "segments": [{"text": "سورة الصافات\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَالصَّافَّاتِ صَفًّا", "color": "brown"}, {"text": "(  الصافات: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالصَّافَّاتِ﴾:", "color": "green"}, {"text": "الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الصافات: مقسم به مجرور بالكسرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل القسم المحذوف، أي: أقسم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَفًّا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم بالصافات", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافيّة.", "color": "black"}]}]