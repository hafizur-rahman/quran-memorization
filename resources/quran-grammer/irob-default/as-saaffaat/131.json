[{"row_id": 1, "segments": [{"text": "{ إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ", "color": "brown"}, {"text": "(  الصافات: 131  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الخامسة بعد المائة من هذه السورة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « إِنَّا: إنّ: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب مفعول مطلق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَجْزِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء\" للثقل، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُحْسِنِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "صدقت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنا نجزي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نجزي", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"».", "color": "black"}]}]