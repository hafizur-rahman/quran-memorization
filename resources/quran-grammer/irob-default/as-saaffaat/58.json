[{"row_id": 1, "segments": [{"text": "{ أَفَمَا نَحْنُ بِمَيِّتِينَ", "color": "brown"}, {"text": "(  الصافات: 58  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَفَمَا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاء: حرف عطف على محذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ما: حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز، ونافية لا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، ومبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِمَيِّتِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ميتين: خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، أو خبر المبتدأ مجرور لفظًا منصوب محلًا على اللغة الأولى، ومرفوع محلًا على اللغة الثانية، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما نحن بميتين", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" لقول مقدر، أي: قال أهل الجنة: أنحن مخلدون فما نحن بميتين.", "color": "black"}]}]