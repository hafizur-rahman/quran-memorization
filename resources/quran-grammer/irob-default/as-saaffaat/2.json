[{"row_id": 1, "segments": [{"text": "{ فَالزَّاجِرَاتِ زَجْرًا", "color": "brown"}, {"text": "(  الصافات: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَالزَّاجِرَاتِ﴾:", "color": "green"}, {"text": "معطوفة بالفاء على \"", "color": "black"}, {"text": "الصافات صفًّا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": ": وهو : « وَالصَّافَّاتِ: الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "الصافات: مقسم به مجرور بالكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بفعل القسم المحذوف، أي: أقسم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿صَفًّا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره».", "color": "black"}]}]