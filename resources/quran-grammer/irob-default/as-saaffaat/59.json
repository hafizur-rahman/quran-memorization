[{"row_id": 1, "segments": [{"text": "{ إِلَّا مَوْتَتَنَا الْأُولَى وَمَا نَحْنُ بِمُعَذَّبِينَ", "color": "brown"}, {"text": "(  الصافات: 59  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء\nمَوْتَتَنَا: موته: مستثني بـ \"", "color": "black"}, {"text": "إلا", "color": "blue"}, {"text": "\" منصوب بالفتحة، وهو مضاف، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْأُولَى﴾:", "color": "green"}, {"text": "صفة للموتة منصوبة بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَمَا نَحْنُ بِمُعَذَّبِينَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما نحن بميتين", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو: « ما: حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز، ونافية لا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، ومبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِمَيِّتِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ميتين: خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، أو خبر المبتدأ مجرور لفظًا منصوب محلًا على اللغة الأولى، ومرفوع محلًا على اللغة الثانية، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما نحن بمعذبين", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "ما نحن بميتين", "color": "blue"}, {"text": "\".", "color": "black"}]}]