[{"row_id": 1, "segments": [{"text": "{ فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ", "color": "brown"}, {"text": "(  ص: 73  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الثلاثين من سورة الحجر.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: « فَسَجَدَ: الفاء: سببية.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "سجد: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمَلَائِكَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كُلُّهُمْ﴾:", "color": "green"}, {"text": "توكيد مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَجْمَعُونَ﴾:", "color": "green"}, {"text": "توكيد ثاني مرفوع بالواو، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فسجد", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب».", "color": "black"}]}]