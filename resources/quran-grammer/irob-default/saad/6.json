[{"row_id": 1, "segments": [{"text": "{ وَانْطَلَقَ الْمَلَأُ مِنْهُمْ أَنِ امْشُوا وَاصْبِرُوا عَلَى آلِهَتِكُمْ إِنَّ هَذَا لَشَيْءٌ يُرَادُ", "color": "brown"}, {"text": "(  ص: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَانطَلَقّ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "انطلق: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمَلَأُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة لـ \"", "color": "black"}, {"text": "الملأ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنِ﴾:", "color": "green"}, {"text": "حرف تفسير.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿امْشُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَاصْبِرُوا﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "امشوا", "color": "blue"}, {"text": "\" معطوفة عليه بالواو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿على ءَالِهَتِكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "اصبروا", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبني في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَشَئٌ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "شيء: خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يُرَادُ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول مرفوع وعلامة رفعه الضمة، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "يراد", "color": "blue"}, {"text": "\" في محلّ رفع نعت للموصوف \"", "color": "black"}, {"text": "شيء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "انطلق الملأ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "قال الكافرون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "امشوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اصبروا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "امشوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن هذا الشيء", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]