[{"row_id": 1, "segments": [{"text": "{ مَا سَمِعْنَا بِهَذَا فِي الْمِلَّةِ الْآخِرَةِ إِنْ هَذَا إِلَّا اخْتِلَاقٌ", "color": "brown"}, {"text": "(  ص: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿سَمِعْنَا﴾:", "color": "green"}, {"text": "سمع: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِهَذَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "هذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "سمعنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي الْمِلَّةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من اسم الإشارة \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الأَخِرَةِ﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "الملة", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿هَذَآ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اخْتِلَقٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع وعلامة رف