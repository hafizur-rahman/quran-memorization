[{"row_id": 1, "segments": [{"text": "{ قَالَ أَنَا خَيْرٌ مِنْهُ خَلَقْتَنِي مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طِينٍ", "color": "brown"}, {"text": "(  ص: 76  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنَا﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَيْرٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنا", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "خير", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَلَقْتَنِي﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ نَارٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة بتقدير خلقتني حالة كوني من نار.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَخَلَقْتَهُ مِنْ طِينٍ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "خلقتني من نار", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "colo