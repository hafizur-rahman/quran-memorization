[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ فَأَنْظِرْنِي إِلَى يَوْمِ يُبْعَثُونَ", "color": "brown"}, {"text": "(  ص: 79  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي بحرف نداء محذوف منصوب بالفتحة المقدّرة على آخره منع من ظهورها اشتغال المحلّ بالكسرة المناسبة لـ \"", "color": "black"}, {"text": "ياء", "color": "blue"}, {"text": "\" المتكلم المحذوفة، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة خطًا ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَأَنْظِرْنِي﴾:", "color": "green"}, {"text": "الفاء: حرف ربط لشرط مقدر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "انظرني: فعل دعاء بصيغة طلب مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": حرف للوقاية،\n و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَى يَوْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أنظرني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُبْعَثُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text"