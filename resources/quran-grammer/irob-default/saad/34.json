[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ فَتَنَّا سُلَيْمَانَ وَأَلْقَيْنَا عَلَى كُرْسِيِّهِ جَسَدًا ثُمَّ أَنَابَ", "color": "brown"}, {"text": "(  ص: 34  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف للابتداء والتوكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَتَنَّا﴾:", "color": "green"}, {"text": "فتن: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿سُلَيْمَانَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَأَلْقَيْنَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "فتنا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَي كُرْسِيِّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "ألقينا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿جَسَدًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَنَابَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 13, "s