[{"row_id": 1, "segments": [{"text": "{ قَالَ فَإِنَّكَ مِنَ الْمُنْظَرِينَ", "color": "brown"}, {"text": "(  ص: 80  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿فَإِنَّكَ﴾:", "color": "green"}, {"text": "الفاء: حرف ربط لشرط مقدّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ الْمُنْظَرِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنك من المنظرين", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن رغبت الإنظار فإنك من المنظرين.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والشرط وفعله وجوابه في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}]