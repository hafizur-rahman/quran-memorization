[{"row_id": 1, "segments": [{"text": "{ هَذَا عَطَاؤُنَا فَامْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ", "color": "brown"}, {"text": "(  ص: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَطَآؤُنَا﴾:", "color": "green"}, {"text": "عطاء: خبر \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَامْنُنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "امنن: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَوْ أَمْسِكْ﴾:", "color": "green"}, {"text": "معطوفة بـ \"", "color": "black"}, {"text": "أو", "color": "blue"}, {"text": "\" على \"", "color": "black"}, {"text": "أمنن", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِغَيْرِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من ضمير \"", "color": "black"}, {"text": "أمسك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿حِسَابٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هذا عطاؤنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية مقررة لمضمون ما سبق.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color