[{"row_id": 1, "segments": [{"text": "{ اصْبِرْ عَلَى مَا يَقُولُونَ وَاذْكُرْ عَبْدَنَا دَاوُودَ ذَا الْأَيْدِ إِنَّهُ أَوَّابٌ", "color": "brown"}, {"text": "(  ص: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اصْبِرْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ\nمَا: حرف مصدريّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَقُولُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَاذْكُرْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "اذكر: مثل \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَبْدَنَا﴾:", "color": "green"}, {"text": "عبد: مفعول به منصوب، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿دَاوُدَ﴾:", "color": "green"}, {"text": "عطف بيان لـ \"", "color": "black"}, {"text": "عبدنا", "color": "blue"}, {"text": "\" منصوب بالفتحة، ولم ينون؛ لأنّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿ذَا﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "داود", "color": "blue"}, {"text": "\" منصوب، وعلامة النصب الألف، لأنه من الأسماء الخمسة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْأَيْدِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِنَّهُ﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَوَّابٌ﴾:", "color": "green"}, {"text": "خبرها مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "ما يقولون", "color": "blue"}, {"text": "\" في محلّ جرّ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "جملة \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقولون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنه أواب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تعليل لقوله \"", "color": "black"}, {"text": "ذا الأيد", "color": "blue"}, {"text": "\".", "color": "black"}]}]