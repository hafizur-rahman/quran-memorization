[{"row_id": 1, "segments": [{"text": "{ أَمْ لَهُمْ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَلْيَرْتَقُوا فِي الْأَسْبَابِ", "color": "brown"}, {"text": "(  ص: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ لَهُم مُّلْكُ السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "أم عندهم خزائن الرَّحمة", "color": "blue"}, {"text": "\"، وهو: « أَمْ: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عِندَهُمْ﴾:", "color": "green"}, {"text": "عند: ظرف مكان متعلّق بخبر مقدم، وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَزَآئِنُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَحْمَةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "لهم", "color": "blue"}, {"text": "\": جارّ ومجرور متعلّقان بالخبر المقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "اسم معطوف بالواو على \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "اسم موصول مبنيّ في محلّ جرّ معطوف على \"", "color": "black"}, {"text": "السماوات والأرض", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بَيْنَهُمَا﴾:"