[{"row_id": 1, "segments": [{"text": "{ إِنَّ اللَّهَ اصْطَفَى آدَمَ وَنُوحًا وَآلَ إِبْرَاهِيمَ وَآلَ عِمْرَانَ عَلَى الْعَالَمِينَ", "color": "brown"}, {"text": "(  آل عمران: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ اللَّهَ﴾:", "color": "green"}, {"text": "مرّ إعرابهما في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو :« إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الله﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اصْطَفَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آدَمَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، وامتنع من التنوين للعلمية والعجمة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَنُوحًا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "نوحًا: اسم معطوف منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَآلَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "ونوحًا", "color": "blue"}, {"text": "\" في الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِبْرَاهِيمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة، لأنّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَآلَ عِمْرَانَ﴾:", "color": "green"}, {"text": "تعرب مثل \"", "color": "black"}, {"text": "وآل إبراهيم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿عَلَى الْعَالَمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بفعل \"", "color": "black"}, {"text": "اصطفى", "color": "blu