[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَتِ امْرَأَتُ عِمْرَانَ رَبِّ إِنِّي نَذَرْتُ لَكَ مَا فِي بَطْنِي مُحَرَّرًا فَتَقَبَّلْ مِنِّي إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ", "color": "brown"}, {"text": "(  آل عمران: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف مبنيّ في محلّ نصب مفعول به لفعل محذوف تقديره: \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿قَالَتِ﴾:", "color": "green"}, {"text": "قال: فعل ماض، والتاء: حرف للتأنيث.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿امْرَأَتُ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمّة، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عِمْرَانَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة عوضًا من الكسر، لأنّه ممنوع من الصرف للعلميّة وزيادة الألف والنون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى مضاف منصوب، حذف منه حرف النداء، وعلامة النصب الفتحة المقدرة على ما قبل ياء المتكلم منع من ظهورها اشتغال المحل بالحركة المناسبة للياء، وياء المتكلم المحذوفة ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "حرف للتوكيد مشبّه بالفعل، والياء: ضمير اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿نَذَرْتُ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون، والتاء: فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَكَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير في محلّ جرّ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلِّقان بـ \"", "color": "black"}, {"text": "نذرت", "color": "blue"}, {"text": "\"."