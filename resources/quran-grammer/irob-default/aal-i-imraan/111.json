[{"row_id": 1, "segments": [{"text": "{ لَنْ يَضُرُّوكُمْ إِلَّا أَذًى وَإِنْ يُقَاتِلُوكُمْ يُوَلُّوكُمُ الْأَدْبَارَ ثُمَّ لَا يُنْصَرُونَ", "color": "brown"}, {"text": "(  آل عمران: 111  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَنْ﴾:", "color": "green"}, {"text": "حرف نفي ونصب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَضُرُّوكُمْ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب، وعلامة النصب حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" فاعل وكم: ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَذًى﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب، وعلامة النصب الفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُقَتِلُوكُمْ﴾:", "color": "green"}, {"text": "يقاتلوا: فعل مضارع مجزوم، وعلامة الجزم حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يُوَلُّوكُمُ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يقاتلوكم", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( جواب الشرط )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْأَدْبَارَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "gre