[{"row_id": 1, "segments": [{"text": "{ إِنَّ اللَّهَ لَا يَخْفَى عَلَيْهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ", "color": "brown"}, {"text": "(  آل عمران: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَخْفَى﴾:", "color": "green"}, {"text": "مضارع مرفوع، وعلامة رفعه الضمة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "على: حرف جرّ، والهاء: ضمير متّصل مبنيّ في محلّ جرّ متعلّق بـ\"", "color": "black"}, {"text": "يخفى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَيْءٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بنعت \"", "color": "black"}, {"text": "شيء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِي السَّمَاءِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بنعت \"", "color": "black"}, {"text": "شيء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يخفى", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"te