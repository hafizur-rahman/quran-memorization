[{"row_id": 1, "segments": [{"text": "{ وَدَّتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يُضِلُّونَكُمْ وَمَا يُضِلُّونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ", "color": "brown"}, {"text": "(  آل عمران: 69  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَدَّتْ﴾:", "color": "green"}, {"text": "ودّ: فعل ماضٍ والتاء: تاء التأنيث الساكنة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "حرف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿طَائِفَةٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ أَهْلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف نعت لطائفة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وأهل مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يُضِلُّونَكُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" فاعل، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\" ضمير مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والمصدر المؤول في محلّ نصب مفعول به عامله \"", "color": "black"}, {"text": "فعل ودت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يُضِلُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، لأنه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿أنفسهم﴾:", "color": "green"}, {"text": "أنفس: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَمَا يَشْعُرُونَ﴾:", "color": "green"}, {"text": "الواو: حاليه.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "ما يشعرون: مثل \"", "color": "black"}, {"text": "ما يضلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ودت طائفة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يضلونكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما يضلون إلا أنفسهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما يشعرون", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}]