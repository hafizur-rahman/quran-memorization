[{"row_id": 1, "segments": [{"text": "{ قُلْ صَدَقَ اللَّهُ فَاتَّبِعُوا مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ", "color": "brown"}, {"text": "(  آل عمران: 95  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿صَدَقَ﴾:", "color": "green"}, {"text": "فعل ماضٍ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَاتَّبِعُوا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "اتبعوا: فعل أمر مبنيّ على حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِلَّةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِبْرَاهِيمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة عوضًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حَنِيفًا﴾:", "color": "green"}, {"text": "حال من \"", "color": "black"}, {"text": "إبراهيم", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص، واسمه ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنَ الْمُشْرِكِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان