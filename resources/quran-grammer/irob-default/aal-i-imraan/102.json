[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ", "color": "brown"}, {"text": "(  آل عمران: 102  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا الَّذِينَ آمَنُوا﴾:", "color": "green"}, {"text": "تقدم إعرابها في الآية المائة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : «يَاأَيُّهَا: يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أي: اسم مبنيّ على الضمّ في محلّ نصب مفعول به لفعل النداء المحذوف، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف للتنبيه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب بدل من \"", "color": "black"}, {"text": "أيّ", "color": "blue"}, {"text": "\"، أو نعت له.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، والواو: فاعل».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اتَّقُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حَقَّ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُقَاتِهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿تَمُوتُنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم وعلامة الجزم حذف النون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" المحذوفة لالتقاء الساكنين فاعل، والنون حرف للتوكيد لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَأَنْتُمْ﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "أنتم: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿مُسْلِمُونَ﴾:", "color": "green"}, {"text": "خبر مرفوع، وعلامة الرفع الواو لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة النداء: \"", "color": "black"}, {"text": "يا أيها الذين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتقوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تموتن", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة جواب النداء.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنتم مسلمون", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}]