[{"row_id": 1, "segments": [{"text": "{ وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ", "color": "brown"}, {"text": "(  آل عمران: 169  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَحْسَبَنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح في محلّ جزم، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، والنون حرف للتوكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قُتِلُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الضم، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل في محل رفع نائب فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي سَبِيلِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "قتلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَمْوَاتًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بَلْ﴾:", "color": "green"}, {"text": "حرف للإضراب الانتقالي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَحْيَاءٌ﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف تقديره: هم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مبنيّ متعلّق بمحذوف نعت لأحياء.", "color": "black"}]}, {"row_id": 13