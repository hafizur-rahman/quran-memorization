[{"row_id": 1, "segments": [{"text": "{ رَبَّنَا إِنَّكَ مَنْ تُدْخِلِ النَّارَ فَقَدْ أَخْزَيْتَهُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ", "color": "brown"}, {"text": "(  آل عمران: 192  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبَّنَا﴾:", "color": "green"}, {"text": "رب: منادى مضاف محذوف منه حرف النداء منصوب بالفتحة و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنَّكَ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ في محلّ نصب مفعول به أول مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تُدْخِلِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنه فعل الشرط، وعلامة الجزم السكون، وحرك بالكسر لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿النَّارَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَقَدْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَخْزَيْتَهُ﴾:", "color": "green"}, {"text": "أخزيت: فعل ماضٍ مبنيّ على السكون، والتاء: فاعل، والهاء: ضمير متصل في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لِلظَّالِمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف خبر مقدم، وعلامة الجرّ الياء.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَنْصَارٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًّا مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ربنا إنك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها اعتراضية أو استئنافيّة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنك من تدخل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب النداء.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ندخل النار", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قد أخزيته", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشرط.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما للظالمين من أنصار", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]