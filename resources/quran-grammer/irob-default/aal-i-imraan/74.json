[{"row_id": 1, "segments": [{"text": "{ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ", "color": "brown"}, {"text": "(  آل عمران: 74  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَخْتَصُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِرَحْمَتِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "يختص", "color": "blue"}, {"text": "\"، والهاء: ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَشَاءُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "الله: لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ذُو﴾:", "color": "green"}, {"text": "خبر مرفوع، وعلامة الرفع الواو، لأنه من الأسماء الستّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْفَضْلِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْعَظِيمِ﴾:", "color": "green"}, {"text": "نعت للفضل مجرور بالكسرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يشاء", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله ذو الفضل العظيم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "الله واسع", "color": "blue"}, {"text": "\" في الآية السابقة.", "color": "black"}]}]