[{"row_id": 1, "segments": [{"text": "{ إِنَّ أَوَّلَ بَيْتٍ وُضِعَ لِلنَّاسِ لَلَّذِي بِبَكَّةَ مُبَارَكًا وَهُدًى لِلْعَالَمِينَ", "color": "brown"}, {"text": "(  آل عمران: 96  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَوَّلَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَيْتٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وُضِعَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِلنَّاسِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "وضع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَلَّذِي﴾:", "color": "green"}, {"text": "اللام المزحلقة حرف يفيد التوكيد.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "الذي: اسم موصول مبنيّ في محلّ رفع خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِبَكَّةَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف صلة الموصول، وعلامة الجرّ الفتحة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُبَارَكًا﴾:", "color": "green"}, {"text": "حال من نائب الفاعل منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهُدًى﴾:", "color": "green"}, {"text": "معطوفة بالواو على الحال منصوب، وعلامة النصب الفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لِلْعَالَمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرو