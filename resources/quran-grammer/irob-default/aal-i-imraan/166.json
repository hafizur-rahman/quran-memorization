[{"row_id": 1, "segments": [{"text": "{ وَمَا أَصَابَكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ فَبِإِذْنِ اللَّهِ وَلِيَعْلَمَ الْمُؤْمِنِينَ", "color": "brown"}, {"text": "(  آل عمران: 166  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: اسم موصول مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَصَابَكُمْ﴾:", "color": "green"}, {"text": "أصاب: فعل ماضٍ، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مفعول به، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ \"", "color": "black"}, {"text": "أصاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْتَقَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْجَمْعَانِ﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الألف، لأنه مثنّى.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَبِإِذْنِ﴾:", "color": "green"}, {"text": "الفاء: حرف زائد.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "بإذن: جارّ ومجرور متعلّقان بمحذوف خبر لمبتدأ مقدر، تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلِيَعْلَمَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "اللام: لام التعليل حرف جرّ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "يعلم: فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة بعد اللام، وا