[{"row_id": 1, "segments": [{"text": "{ وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ الْمُؤْمِنِينَ مَقَاعِدَ لِلْقِتَالِ وَاللَّهُ سَمِيعٌ عَلِيمٌ", "color": "brown"}, {"text": "(  آل عمران: 121  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم ظرفي مبنيّ في محلّ نصب مفعول به لفعل محذوف تقديره: أذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿غَدَوْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، والتاء فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ أَهْلِكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "غدوت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تُبَوِّئُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "مفعول به أول منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَقَاعِدَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لِلْقِتَالِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "تبوئ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "الله: لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿سَمِيعٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿عَلِيمٌ﴾:", "color": "green"}, {"text": "خبر ثان مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "غدوت", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تبوئ", "color": "blue"}, {"text": "\" في محلّ نصب حال من فاعل \"", "color": "black"}, {"text": "غدوت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله سميع عليم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]