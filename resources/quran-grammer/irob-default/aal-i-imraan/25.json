[{"row_id": 1, "segments": [{"text": "{ فَكَيْفَ إِذَا جَمَعْنَاهُمْ لِيَوْمٍ لَا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ", "color": "brown"}, {"text": "(  آل عمران: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكَيْفَ﴾:", "color": "green"}, {"text": "الفاء: استئنافية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كيف: اسم استفهام مبنيّ على الفتح في محلّ رفع خبر مقدم لمبتدأ محذوف تقديره: صُنْعهم، أو حالهم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف مبنيّ في محلّ نصب مفعول به متعلِّق بالمبتدأ المقدَّر، لأنّه بتقدير مصدر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَمَعْنَاهُمْ﴾:", "color": "green"}, {"text": "جمعنا: فعل ماض مبنيّ على السكون، لاتصاله بضمير رفع متحرّك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": فاعل، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِيَوْمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "جمعناهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَيْبَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِيهِ﴾:", "color": "green"}, {"text": "في: حرف جرّ، والهاء: ضمير متصل مبنيّ في محلّ جرّ بحرف الجرّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجارّ والمجرور متعلِّقان بمحذوف خبر \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَوُفِّيَتْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وفيت: فعل ماض مبنيّ للمجهول، والتاء للتأنيث.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿كُلُّ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع بالضمّة، وهو مضاف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿نَفْسٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿كَسَبَتْ﴾:", "color": "green"}, {"text": "فعل ماض، والتاء للتأنيث، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿يُظْلَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول، مرفوع ثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل في محل رفع نائب فاعل.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كيف", "color": "blue"}, {"text": "\" حالهم لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جمعناهم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا ريب فيه", "color": "blue"}, {"text": "\" في محلّ جرّ نعت لـ\"", "color": "black"}, {"text": "يوم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 25, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وفيت كل نفس", "color": "blue"}, {"text": "\" في محلّ جرّ معطوفة على جملة \"", "color": "black"}, {"text": "لا ريب فيه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 26, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كسبت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول، والعائد محذوف، أي: كسبته.", "color": "black"}]}, {"row_id": 27, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هم لا يظلمون", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}, {"row_id": 28, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يظلمون", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}]