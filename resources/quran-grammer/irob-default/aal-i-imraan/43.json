[{"row_id": 1, "segments": [{"text": "{ يَامَرْيَمُ اقْنُتِي لِرَبِّكِ وَاسْجُدِي وَارْكَعِي مَعَ الرَّاكِعِينَ", "color": "brown"}, {"text": "(  آل عمران: 43  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَامَرْيَمُ﴾:", "color": "green"}, {"text": "مر إعرابهما في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو :«يَامَرْيَمُ: يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مريم﴾:", "color": "green"}, {"text": "منادى مبنيّ على الضمّ في محلّ نصب مفعول به لفعل النداء المحذوف».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اقْنُتِي﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأنّه مشتقّ من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والياء ضمير مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِرَبِّكِ﴾:", "color": "green"}, {"text": "لرب: جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "اقنتي", "color": "blue"}, {"text": "\" و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَاسْجُدِي وَارْكَعِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف في الموضعين.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "اسجدي واركعي: مثل \"", "color": "black"}, {"text": "اقنتي", "color": "blue"}, {"text": "\" في الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَعَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب متعلِّق بفعل \"", "color": "black"}, {"text": "اركعي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الرَّاكِعِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجر الياء، لأنّه جمع مذكّر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة النداء لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 13, "segments"