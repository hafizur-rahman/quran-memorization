[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا وَأُولَئِكَ هُمْ وَقُودُ النَّارِ", "color": "brown"}, {"text": "(  آل عمران: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد ونصب مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَنْ﴾:", "color": "green"}, {"text": "حرف نفي ونصب واستقبال.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُغْنِيَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَنْهُمْ﴾:", "color": "green"}, {"text": "عن: حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ، والجارّ والمجرور متعلِّقان بـ\"", "color": "black"}, {"text": "تغني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَمْوَالُهُمْ﴾:", "color": "green"}, {"text": "أموال: فاعل مرفوع بالضمّة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَوْلَادُهُمْ﴾:", "color": "green"}, {"text": "أولاد: معطوف على \"", "color": "black"}, {"text": "أموال", "color": "blue"}, {"text": "\"