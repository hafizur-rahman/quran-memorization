[{"row_id": 1, "segments": [{"text": "{ بَلَى مَنْ أَوْفَى بِعَهْدِهِ وَاتَّقَى فَإِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ", "color": "brown"}, {"text": "(  آل عمران: 76  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَلَى﴾:", "color": "green"}, {"text": "حرف جواب وهو إيجاب لما نفوا من قولهم \"", "color": "black"}, {"text": "ليس علينا في الأميين سبيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَوْفَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر في محلّ جزم فعل الشرط، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِعَهْدِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ\"", "color": "black"}, {"text": "أوفي", "color": "blue"}, {"text": "\"، والهاء: ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَاتَّقَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "اتقى: مثل أوفي ومعطوف عليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَإِنَّ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "إن: حرف للتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُحِبُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْمُتَّقِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color"