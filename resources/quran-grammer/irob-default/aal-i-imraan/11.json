[{"row_id": 1, "segments": [{"text": "{ كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَذَّبُوا بِآيَاتِنَا فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَاللَّهُ شَدِيدُ الْعِقَابِ", "color": "brown"}, {"text": "(  آل عمران: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَدَأْبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بخبر محذوف لمبتدأ مقدر تقديره: دأبهم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿آلِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِرْعَوْنَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الفتحة عوضًا من الكسرة، لأنّه ممنوع من الصرف للعلمية والعجمة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الذين: اسم موصول مبنيّ على السكون في محلّ جرّ معطوف على آل فرعون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ قَبْلِهِم﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف صلة الموصول، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَذَّبُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضمّ، والواو: فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِآيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "كذبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَأَخَذَهُمُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "أخذ: فعل ما