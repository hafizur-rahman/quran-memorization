[{"row_id": 1, "segments": [{"text": "{ بَلِ اللَّهُ مَوْلَاكُمْ وَهُوَ خَيْرُ النَّاصِرِينَ", "color": "brown"}, {"text": "(  آل عمران: 150  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَلِ﴾:", "color": "green"}, {"text": "حرف إضراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿اللهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَوْلَاكُمْ﴾:", "color": "green"}, {"text": "مولى: خبر مرفوع، وعلامة الرفع الضمة المقدرة على الألف للتعذّر و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "هو: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَيْرُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿النَّاصِرِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجر الياء.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله مولاكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو خير الناصرين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافيّة.", "color": "black"}]}]