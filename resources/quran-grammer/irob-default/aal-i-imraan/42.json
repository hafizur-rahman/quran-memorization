[{"row_id": 1, "segments": [{"text": "{ وَإِذْ قَالَتِ الْمَلَائِكَةُ يَامَرْيَمُ إِنَّ اللَّهَ اصْطَفَاكِ وَطَهَّرَكِ وَاصْطَفَاكِ عَلَى نِسَاءِ الْعَالَمِينَ", "color": "brown"}, {"text": "(  آل عمران: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: استئنافيّة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: ظرف مبنيّ في محلّ نصب مفعول به لفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَالَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ، والتاء: حرف للتأنيث.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمَلَائِكَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَامَرْيَمُ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "مريم: منادى مبنيّ على الضمّ في محلّ نصب مفعول به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف للتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اصْطَفَاكِ﴾:", "color": "green"}, {"text": "اصطفى: فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ نصب مفعول به، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَطَهَّرَكِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "طهَّر: فعل ماضٍ.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و\"", "color": "b