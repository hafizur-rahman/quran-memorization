[{"row_id": 1, "segments": [{"text": "{ رَبَّنَا إِنَّكَ جَامِعُ النَّاسِ لِيَوْمٍ لَا رَيْبَ فِيهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ", "color": "brown"}, {"text": "(  آل عمران: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبَّنَا﴾:", "color": "green"}, {"text": "مرّ إعرابها في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "رَبَّنَا: رب: منادى مضاف محذوف منه حرف النداء منصوب بالفتحة، و \"", "color": "blue"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّكَ﴾:", "color": "green"}, {"text": "مرّ إعرابها في الآية السابقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "إِنَّكَ: إنّ: حرف توكيد ونصب مشبّه بالفعل.", "color": "blue"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿جَامِعُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿النَّاسِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لِيَوْمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان باسم الفاعل \"", "color": "black"}, {"text": "جامع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "نافية للجنس.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَيْبَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"