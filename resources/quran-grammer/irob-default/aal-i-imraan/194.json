[{"row_id": 1, "segments": [{"text": "{ رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ", "color": "brown"}, {"text": "(  آل عمران: 194  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿رَبَّنَا﴾:", "color": "green"}, {"text": "تقدم إعرابها .", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "رَبَّنَا: رب: منادى مضاف محذوف منه حرف النداء منصوب بالفتحة و\"", "color": "blue"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مضاف إليه", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَآتِنَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "آتنا: مثل \"", "color": "black"}, {"text": "قنا", "color": "blue"}, {"text": "\" في الآية السابقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وهو «", "color": "black"}, {"text": "فعل أمر دعائي مبنيّ على حذف حرف العلة، و\"", "color": "blue"}, {"text": "نا", "color": "blue"}, {"text": "\": مفعول به والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَعَدْتَنَا﴾:", "color": "green"}, {"text": "وعد: فعل ماضٍ مبنيّ على السكون، والتاء: فاعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَى رُسُلِكَ﴾:", "color": "green"}, {"text": "على رسل: جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "وعدتنا", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": مضاف إليه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text":