[{"row_id": 1, "segments": [{"text": "{ الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُنْ مِنَ الْمُمْتَرِينَ", "color": "brown"}, {"text": "(  آل عمران: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مِنْ رَبِّكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف خبر، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم، واسم \"", "color": "black"}, {"text": "تكن", "color": "blue"}, {"text": "\" ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ الْمُمْتَرِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف خبر \"", "color": "black"}, {"text": "تكون", "color": "blue"}, {"text": "\"، وعلامة الجرّ الياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الحق من ربك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تكن", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب شرط مقدر غير جازم، أي: إذا كان الأمر كذلك، فلا تكن من الممترين.", "color": "black"}]}]