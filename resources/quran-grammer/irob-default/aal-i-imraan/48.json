[{"row_id": 1, "segments": [{"text": "{ وَيُعَلِّمُهُ الْكِتَابَ وَالْحِكْمَةَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ", "color": "brown"}, {"text": "(  آل عمران: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيُعَلِّمُهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يعلمه: فعل مضارع مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والهاء: ضمير مبنيّ على الضمّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابَ وَالْحِكْمَةَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ﴾:", "color": "green"}, {"text": "الكتاب: مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿والحكمة والتوراة والإنجيل﴾:", "color": "green"}, {"text": "أسماء معطوفة بواوات العطف على \"", "color": "black"}, {"text": "الكتاب", "color": "blue"}, {"text": "\" منصوبة مثله وعلامة نصبها الفتحة الظاهرة على آخرها.", "color": "black"}]}]