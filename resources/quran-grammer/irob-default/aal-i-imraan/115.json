[{"row_id": 1, "segments": [{"text": "{ وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ", "color": "brown"}, {"text": "(  آل عمران: 115  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: اسم شرط جازم مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَفْعَلُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنه فعل الشرط، وعلامة الجزم حذف النون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ خَيْرٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف حال من \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" أو هو تمييز له.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَلَنْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لن: حرف نفي ونصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُكْفَرُوهُ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول منصوب، وعلامة النصب حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير في محلّ رفع نائب فاعل والهاء: ضمير متصل في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "الله: لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿عَلَيمٌ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِالْمُتَّقِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بـ\"", "color": "black"}, {"text": "عليم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يفعلوا من خير", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الجملة الاستئنافية في الآية السابقة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لن يكفروه", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشرط.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله عليم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]