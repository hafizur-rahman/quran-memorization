[{"row_id": 1, "segments": [{"text": "{ وَلَا يَحْسَبَنَّ الَّذِينَ كَفَرُوا أَنَّمَا نُمْلِي لَهُمْ خَيْرٌ لِأَنْفُسِهِمْ إِنَّمَا نُمْلِي لَهُمْ لِيَزْدَادُوا إِثْمًا وَلَهُمْ عَذَابٌ مُهِينٌ", "color": "brown"}, {"text": "(  آل عمران: 178  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَحْسَبَنَّ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح في محلّ جزم، والنون نون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضمّ، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنَّمَا﴾:", "color": "green"}, {"text": "أن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ما: اسم موصول مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿نُمْلِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة الرفع الضمة المقدرة على الياء، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أنّما نملي", "color": "blue"}, {"text": "\" سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "يحسب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\