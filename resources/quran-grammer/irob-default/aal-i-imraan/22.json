[{"row_id": 1, "segments": [{"text": "{ أُولَئِكَ الَّذِينَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ", "color": "brown"}, {"text": "(  آل عمران: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أُولَئِكَ﴾:", "color": "green"}, {"text": "أولاء: اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" حرف للخطاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿حَبِطَتْ﴾:", "color": "green"}, {"text": "فعل ماض، والتاء تاء التأنيث الساكنة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَعْمَالُهُمْ﴾:", "color": "green"}, {"text": "أعمال: فاعل مرفوع، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي الدُّنْيَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بمحذوف حال من \"", "color": "black"}, {"text": "أعمال", "color": "blue"}, {"text": "\"، وعلامة الجرّ الكسرة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالْآخِرَةِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "الآخرة: معطوف على \"", "color": "black"}, {"text": "الدنيا", "color": "blue"}, {"text": "\" مجرور مثله بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا لَهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "اللام: حرف جرّ، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\":