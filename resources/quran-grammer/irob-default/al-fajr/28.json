[{"row_id": 1, "segments": [{"text": "{ ارْجِعِي إِلَى رَبِّكِ رَاضِيَةً مَرْضِيَّةً", "color": "brown"}, {"text": "(  الفجر: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ارْجِعِي﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأنه مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِلَى رَبِّكِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "ارجعي", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَاضِيَةً﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَرْضِيَّةً﴾:", "color": "green"}, {"text": "حال ثانية أو توكيد للحال الأولى \"", "color": "black"}, {"text": "راضية", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ارجعي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب النداء.", "color": "black"}]}]