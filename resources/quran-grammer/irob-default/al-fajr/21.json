[{"row_id": 1, "segments": [{"text": "{ كَلَّا إِذَا دُكَّتِ الْأَرْضُ دَكًّا دَكًّا", "color": "brown"}, {"text": "(  الفجر: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَلَّا﴾:", "color": "green"}, {"text": "حرف ردع وزجر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذًا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن خافض لشرطه متعلّق بجوابه، متضمن معني الشرط مبني على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿دُكَّتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السكون، وقد حُرِّك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْأَرْضُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿دَكًّا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿دَكًّا﴾:", "color": "green"}, {"text": "تأكيد منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "دكّت", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]