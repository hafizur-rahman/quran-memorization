[{"row_id": 1, "segments": [{"text": "{ وَجِيءَ يَوْمَئِذٍ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ الْإِنْسَانُ وَأَنَّى لَهُ الذِّكْرَى", "color": "brown"}, {"text": "(  الفجر: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَجِيءَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "جيء: فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "جيء", "color": "blue"}, {"text": "\"، وهو مضاف، و \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون وحرك بالكسر تخلصًا من التقاء الساكنين", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "في محلّ جرّ مضاف إليه، وهو مضاف أيضًا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والتقدير: ويومئذ يجاء بجهنم وتدك الأرض ويجيء أمر ربك والملك يتذكر الإنسان.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِجَهَنَّمَ﴾:", "color": "green"}, {"text": "جار ومجرور في محلّ رفع فاعل للفعل \"", "color": "black"}, {"text": "جيء", "color": "blue"}, {"text": "\" وعلامة جرّ الاسم الفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يومئذ﴾:", "color": "green"}, {"text": "أعربت في هذه الآية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَتَذَكَّرُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْإِنْسَانُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَأَنَّى﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "أني: اسم استفهام مبنيّ على السكون في محلّ نصب ظرف مكان متعلّق بخبر مقدم محذوف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالخبر المحذوف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الذِّكْرَى﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جيء", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "دكت", "color": "blue"}, {"text": "\" في محلّ جرّ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنّى له الذكري", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]