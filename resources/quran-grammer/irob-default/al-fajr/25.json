[{"row_id": 1, "segments": [{"text": "{ فَيَوْمَئِذٍ لَا يُعَذِّبُ عَذَابَهُ أَحَدٌ", "color": "brown"}, {"text": "(  الفجر: 25  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَيَوْمَئِذٍ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يومئذ: سبق إعرابها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وهو : \n«", "color": "black"}, {"text": "يَوْمَئِذٍ: يوم: ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "blue"}, {"text": "جيء", "color": "blue"}, {"text": "\"، وهو مضاف، و \"", "color": "blue"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون وحرك بالكسر تخلصًا من التقاء الساكنين", "color": "blue"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "في محلّ جرّ مضاف إليه، وهو مضاف أيضًا.", "color": "blue"}]}, {"row_id": 5, "segments": [{"text": "والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والتقدير: ويومئذ يجاء بجهنم وتدك الأرض ويجيء أمر ربك والملك يتذكر الإنسان».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُعَذِّبُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَذَابَهُ﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بالفتحة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "أو مفعول به منصوب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَحَدٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}]