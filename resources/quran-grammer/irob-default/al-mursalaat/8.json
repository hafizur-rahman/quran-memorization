[{"row_id": 1, "segments": [{"text": "{ فَإِذَا النُّجُومُ طُمِسَتْ", "color": "brown"}, {"text": "(  المرسلات: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن متضمن معنى الشّرط خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿النُّجُومُ﴾:", "color": "green"}, {"text": "نائب فاعل لفعل محذوف يفسره ما بعده، أي: فإذا طمست النجوم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿طُمِسَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "طمست النجوم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجواب إذا وما عطف عليه محذوف تقديره:: فصل بين الخلائق أو بان الأمر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "طمست", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}]