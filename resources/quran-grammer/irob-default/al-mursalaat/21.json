[{"row_id": 1, "segments": [{"text": "{ فَجَعَلْنَاهُ فِي قَرَارٍ مَكِينٍ", "color": "brown"}, {"text": "(  المرسلات: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَجَعَلْنَاهُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "جعل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي قَرَارٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "جعلناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَكِينٍ﴾:", "color": "green"}, {"text": "صفة مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جعلناه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافيّة.", "color": "black"}]}]