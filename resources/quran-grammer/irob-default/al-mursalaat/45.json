[{"row_id": 1, "segments": [{"text": "{ وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ", "color": "brown"}, {"text": "(  المرسلات: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الخامسة عشرة وهو ﴾:", "color": "green"}, {"text": "«وَيْلٌ: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بالفعل العامل في \"", "color": "black"}, {"text": "ويل", "color": "blue"}, {"text": "\" وهو مضاف و\"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" اسم مبنيّ على السكون الظاهر على آخره، وحرك بالكسر منعًا من التقاء الساكنين", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لِلْمُكَذِّبِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "ويل", "color": "blue"}, {"text": "\" المحذوف، وعلامة جره الياء\"", "color": "black"}, {"text": "، لأنه جمع مذكر سالم.", "color": "blue"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"ويل يومئذٍ للمكذبين\" لا محلّ لها من الإعراب، لأنّها استئنافيّة».", "color": "black"}]}]