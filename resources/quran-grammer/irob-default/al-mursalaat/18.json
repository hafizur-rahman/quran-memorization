[{"row_id": 1, "segments": [{"text": "{ كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ", "color": "brown"}, {"text": "(  المرسلات: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب صفة لمصدر محذوف، أي نفعل فعلًا مثل ذلك الفعل الشنيع.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَفْعَلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِالْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "نفعل", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نفعل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]