[{"row_id": 1, "segments": [{"text": "{ فَإِنْ كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ", "color": "brown"}, {"text": "(  المرسلات: 39  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص في محلّ جزم بـ \"", "color": "black"}, {"text": "إنْ", "color": "blue"}, {"text": "\" مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَيْدٌ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَكِيدُونِ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشّرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "كيدون: فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعل الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\" حرف للوقاية، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة خطًا واختصارًا ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان لكم كيد", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "هذا اليوم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كيدون", "color": "blue"}, {"text": "\" ف