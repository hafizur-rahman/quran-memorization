[{"row_id": 1, "segments": [{"text": "{ أَلَمْ نَخْلُقْكُمْ مِنْ مَاءٍ مَهِينٍ", "color": "brown"}, {"text": "(  المرسلات: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَمْ نَخْلُقْكُمْ﴾:", "color": "green"}, {"text": "أعربت في الآية السادسة عشرة، وهو « أَلَمْ: الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نُهْلِكِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون، وقد حرك بالكسر منعًا لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "\"", "color": "black"}, {"text": "والميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ مَاءٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "\"نخلق\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَهِينٍ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "ماء", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نخلقكم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]