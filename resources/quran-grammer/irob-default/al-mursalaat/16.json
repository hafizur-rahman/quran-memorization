[{"row_id": 1, "segments": [{"text": "{ أَلَمْ نُهْلِكِ الْأَوَّلِينَ", "color": "brown"}, {"text": "(  المرسلات: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نُهْلِكِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون، وقد حرك بالكسر منعًا لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْأَوَّلِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نهلك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]