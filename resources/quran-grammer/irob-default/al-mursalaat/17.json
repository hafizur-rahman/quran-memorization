[{"row_id": 1, "segments": [{"text": "{ ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ", "color": "brown"}, {"text": "(  المرسلات: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نُتْبِعُهُمُ﴾:", "color": "green"}, {"text": "نتبع: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أوّل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "\"", "color": "black"}, {"text": "والميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْآخِرِينَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نتبعهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافيّة.", "color": "black"}]}]