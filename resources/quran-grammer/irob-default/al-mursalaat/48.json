[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ", "color": "brown"}, {"text": "(  المرسلات: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان متضمن معنى الشّرط خافض لشرطه متعلّق بجوابه، مبنيّ على السكون في محلّ نصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قِيلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمُ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ارْكَعُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَرْكَعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قيل", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اركعوا", "color": "blue"}, {"text": "\" في م