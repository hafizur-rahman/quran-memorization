[{"row_id": 1, "segments": [{"text": "{ فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ", "color": "brown"}, {"text": "(  المرسلات: 50  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَبِأَيِّ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أي: اسم استفهام مجرور بالكسرة، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿حَدِيثٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الجارّ والمجرور", "color": "blue"}, {"text": "\"بأي\"", "color": "black"}, {"text": "متعلّقان بـ", "color": "blue"}, {"text": "\"يؤمنون\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَعْدَهُ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\"، وهو مضاف، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}]