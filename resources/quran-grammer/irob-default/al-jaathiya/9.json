[{"row_id": 1, "segments": [{"text": "{ وَإِذَا عَلِمَ مِنْ آيَاتِنَا شَيْئًا اتَّخَذَهَا هُزُوًا أُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ", "color": "brown"}, {"text": "(  الجاثية: 9  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلِمَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ آيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "علم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَيْئًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اتَّخَذَهَا﴾:", "color": "green"}, {"text": "اتخذ: تعرب إعراب \"", "color": "black"}, {"text": "علم", "color": "blue"}, {"text": "\" و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هُزُوًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أُولَئِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 12,