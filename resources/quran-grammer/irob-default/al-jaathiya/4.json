[{"row_id": 1, "segments": [{"text": "{ وَفِي خَلْقِكُمْ وَمَا يَبُثُّ مِنْ دَابَّةٍ آيَاتٌ لِقَوْمٍ يُوقِنُونَ", "color": "brown"}, {"text": "(  الجاثية: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَفِي خَلْقِكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "في خلقكم: في: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "خلقكم: اسم مجرور بالكسرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على البالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجار والمجرور \"", "color": "black"}, {"text": "في خلقكم", "color": "blue"}, {"text": "\" في محلّ رفع خبر مقدم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ معطوف على \"", "color": "black"}, {"text": "خلق", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَبُثُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ دَابَّةٍ﴾:", "color": "green"}, {"text": "من حرف جرّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجار والمجرور متعلّقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" تقديره: وما يبثه حالة كونها من الدواب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿آيَاتٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالضمة وخبره المقدم \"", "color": "black"}, {"text": "في خلقكم", "color": "blue"}, {"text": "\" أو تكون خبر مبتدأ محذوف تقديره: هي آيات.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لِقَوْمٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "صفة محذوفة من", "color": "blue"}, {"text": "\"آيات\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يُوقِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من خلقكم آيات", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافية.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يبث", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يوقنون", "color": "blue"}, {"text": "\" في محلّ جرّ نعت لـ \"", "color": "black"}, {"text": "قوم", "color": "blue"}, {"text": "\".", "color": "black"}]}]