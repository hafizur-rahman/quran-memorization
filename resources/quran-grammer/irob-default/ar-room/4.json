[{"row_id": 1, "segments": [{"text": "{ فِي بِضْعِ سِنِينَ لِلَّهِ الْأَمْرُ مِنْ قَبْلُ وَمِنْ بَعْدُ وَيَوْمَئِذٍ يَفْرَحُ الْمُؤْمِنُونَ", "color": "brown"}, {"text": "(  الروم: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فِي بِضْعِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "سيغلبون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿سِنِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جره \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْأَمْرُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَبْلُ﴾:", "color": "green"}, {"text": "اسم مبني على الضم لانقطاعه عن الإضافة في محل جر بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمِنْ بَعْدُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "من قبل", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلقان بالأمر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَيَوْمَئِذٍ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "يوم: ظرف زمان منصوب بالفتحة وهو مضاف متعلق بـ \"", "color": "black"}, {"text": "يفرح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "إذ: اسم مبني على السكون وقد حرك بالكسر