[{"row_id": 1, "segments": [{"text": "{ فَإِنَّكَ لَا تُسْمِعُ الْمَوْتَى وَلَا تُسْمِعُ الصُّمَّ الدُّعَاءَ إِذَا وَلَّوْا مُدْبِرِينَ", "color": "brown"}, {"text": "(  الروم: 52  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنَّكَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف على محذوف تابع للآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تُسْمِعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمَوْتَى﴾:", "color": "green"}, {"text": "مفعول به أول منصوب بالفتحة المقدرة على الألف للتعذر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلَا تُسْمِعُ الصُّمَّ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "لا تسمع الموتي", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الدُّعَاءَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَّوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدر على الألف المحذوفة للتخلص من التقاء الساكنين، ولا تصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مُدْبِرِينَ﴾:", "color": "green"}, {"text": "حال من ضمير \"", "color": "black"}, {"text": "ولوا", "color": "blue"}, {"text": "\" منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنك لا تسمع", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها تعليل لمقدر، أي: لا تحزن عليهم، فإنهم صم كالموتي.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تسمع الموتي", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تسمع الصم", "color": "blue"}, {"text": "\" في محلّ رفع معطوفة على جملة الخبر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ولوا", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجواب الشرط محذوف دل عليه ما قبله.", "color": "black"}]}]