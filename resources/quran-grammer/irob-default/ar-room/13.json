[{"row_id": 1, "segments": [{"text": "{ وَلَمْ يَكُنْ لَهُمْ مِنْ شُرَكَائِهِمْ شُفَعَاءُ وَكَانُوا بِشُرَكَائِهِمْ كَافِرِينَ", "color": "brown"}, {"text": "(  الروم: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام، والجار والمجرور متعلقان بخبر \"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ شُرَكَائِهِمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال من \"", "color": "black"}, {"text": "شفعاء", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شُفَعَاءُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "يكن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَكَانُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "كانوا: فعل ماضٍ ناقص مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": ف