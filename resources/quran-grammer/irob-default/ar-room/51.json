[{"row_id": 1, "segments": [{"text": "{ وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا لَظَلُّوا مِنْ بَعْدِهِ يَكْفُرُونَ", "color": "brown"}, {"text": "(  الروم: 51  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَئِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف موطئ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَرْسَلْنَا﴾:", "color": "green"}, {"text": "أرسل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رِيحًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَرَأَوْهُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "رأوه: فعل ماضٍ مبنيّ على الفتح المقدر للتعذر على الألف المحذوفة لاتصاله بواو الجماعة، وللتخلص من التقاء الساكنين، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُصْفَرًّا﴾:", "color": "green"}, {"text": "حال من السحاب منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَظَلُّوا﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب القسم المقدر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ظلوا: فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ ر