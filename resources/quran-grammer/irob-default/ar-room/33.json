[{"row_id": 1, "segments": [{"text": "{ وَإِذَا مَسَّ النَّاسَ ضُرٌّ دَعَوْا رَبَّهُمْ مُنِيبِينَ إِلَيْهِ ثُمَّ إِذَا أَذَاقَهُمْ مِنْهُ رَحْمَةً إِذَا فَرِيقٌ مِنْهُمْ بِرَبِّهِمْ يُشْرِكُونَ", "color": "brown"}, {"text": "(  الروم: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن متضمن معني الشرط خافض لشرطه متعلق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَسَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّاسَ﴾:", "color": "green"}, {"text": "مفعول به مقدم منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ضُرٌّ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿دَعَوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدر للتعذر على الألف المحذوفة لالتقاء الساكنين، ولاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَبَّهُمْ﴾:", "color": "green"}, {"text": "رب: مفعول به منصوب، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة\nمُنِيبِينَ: حال من الضمير في \"", "color": "black"}, {"text": "دعوا", "color": "blue"}, {"text": "\" منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "من