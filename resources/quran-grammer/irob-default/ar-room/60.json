[{"row_id": 1, "segments": [{"text": "{ فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ وَلَا يَسْتَخِفَّنَّكَ الَّذِينَ لَا يُوقِنُونَ", "color": "brown"}, {"text": "(  الروم: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَاصْبِرْ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب شرط محذوف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اصبر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَعْدَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حَقٌّ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَسْتَخِفَّنَّكَ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح، لاتصاله بنون التوكيد الثقيلة، ونون التوكيد الثقيلة لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿يُوقِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر، أي: إن قال الكافرون ذلك فاصبر.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن وعد الله حق", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها تعليلية.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يستخفنك الذين", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يوقنون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها صلة الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}]