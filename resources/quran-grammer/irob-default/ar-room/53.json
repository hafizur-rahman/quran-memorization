[{"row_id": 1, "segments": [{"text": "{ وَمَا أَنْتَ بِهَادِ الْعُمْيِ عَنْ ضَلَالَتِهِمْ إِنْ تُسْمِعُ إِلَّا مَنْ يُؤْمِنُ بِآيَاتِنَا فَهُمْ مُسْلِمُونَ", "color": "brown"}, {"text": "(  الروم: 53  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي يعمل عمل \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز ولا تعمل في لغة أهل نجد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى، أو مبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِهَادِ﴾:", "color": "green"}, {"text": "الباء: حرف جر زائد للتأكيد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "هادي: اسم مجرور لفظًا منصوب محلًا على اللغة الأولى، أو مرفوع محلًا على اللغة الثانية، لأنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" أو خبر المبتدأ، وعلامة نصبه أو رفعه فتحة أو ضمة مقدرة على آخره منع من ظهورها اشتغال المحل بحركة حرف الجر الزائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وحذف ياء الكلمة اختصارًا.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْعُمْيِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَنْ ضَلَالَتِهِمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "هادي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جر بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تُسْمِعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿يُؤْمِنُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿بِآيَاتِنَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلقام بـ \"", "color": "black"}, {"text": "يؤمن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿فَهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "هم: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿مُسْلِمُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما أنت بهادي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها معطوفة على جملة إنك لا تسمع.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن تسمع", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يؤمن", "color": "blue"}, {"text": "