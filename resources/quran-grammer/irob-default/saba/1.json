[{"row_id": 1, "segments": [{"text": "سورة سبأ\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ", "color": "brown"}, {"text": "(  سبأ: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الْحَمْدُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة للفظ الجلالة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا فِي السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "ما: اسم موصول مبنيّ على السكون في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "في السماوات: جار ومجرور متعلقان بصلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمَا فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما في السماوات", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "له: تقدم إعرابها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الحَمدُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فِي الآخِرَةِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بالحمد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}