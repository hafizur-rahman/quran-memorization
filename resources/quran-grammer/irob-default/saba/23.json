[{"row_id": 1, "segments": [{"text": "{ وَلَا تَنْفَعُ الشَّفَاعَةُ عِنْدَهُ إِلَّا لِمَنْ أَذِنَ لَهُ حَتَّى إِذَا فُزِّعَ عَنْ قُلُوبِهِمْ قَالُوا مَاذَا قَالَ رَبُّكُمْ قَالُوا الْحَقَّ وَهُوَ الْعَلِيُّ الْكَبِيرُ", "color": "brown"}, {"text": "(  سبأ: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَنْفَعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الشَّفَاعَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عِنْدَهُ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب متعلّق بـ\"", "color": "black"}, {"text": "لا تنفع", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِمَنْ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بحال محذوفة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَذِنَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، يعود على الضمير في \"", "color": "black"}, {"text": "عنده", "color": "blue"}, {"text": "\"، وهو الله تعالى.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أذن", "color": "blue"}, {"text": "\".", "color": "b