[{"row_id": 1, "segments": [{"text": "{ قُلْ مَا سَأَلْتُكُمْ مِنْ أَجْرٍ فَهُوَ لَكُمْ إِنْ أَجْرِيَ إِلَّا عَلَى اللَّهِ وَهُوَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ", "color": "brown"}, {"text": "(  سبأ: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": ": وهو : «", "color": "black"}, {"text": "قُلْ: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَأَلْتُكُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ أَجْرٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من اسم الشّرط \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" والتقدير: أي شيء سألتكم حوله كونه من أجر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَهُوَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشّرط.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "هو: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَجْرِيَ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع بالضمة المقدّرة على ما قبل ياء المتكلم منع من ظهورها اشتغال المحلّ بالحركة المناسبة، و\"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿عَلَى اللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "هو: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿عَلَى كُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالخبر.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿شَهِيدٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما سألتكم من أجر", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو لكم", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشّرط.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن أجري