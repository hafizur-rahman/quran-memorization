[{"row_id": 1, "segments": [{"text": "{ وَقَالَ الَّذِينَ كَفَرُوا لَنْ نُؤْمِنَ بِهَذَا الْقُرْآنِ وَلَا بِالَّذِي بَيْنَ يَدَيْهِ وَلَوْ تَرَى إِذِ الظَّالِمُونَ مَوْقُوفُونَ عِنْدَ رَبِّهِمْ يَرْجِعُ بَعْضُهُمْ إِلَى بَعْضٍ الْقَوْلَ يَقُولُ الَّذِينَ اسْتُضْعِفُوا لِلَّذِينَ اسْتَكْبَرُوا لَوْلَا أَنْتُمْ لَكُنَّا مُؤْمِنِينَ", "color": "brown"}, {"text": "(  سبأ: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "الواو حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قال: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَنْ﴾:", "color": "green"}, {"text": "حرف نفي ونصب واستقبال.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نُؤْمِنَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِهَذَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "هذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء، و\"", "color": "black"}, {"text": "الجار والمجرور متعلّقان بـ", "color": "blue"}, {"text": "\"نؤمن \".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْقُرْآنِ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مجرور بالكسرة.", "color": "black"}]}, {"row_id": 11, "s