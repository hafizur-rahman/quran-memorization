[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ جَزَيْنَاهُمْ بِمَا كَفَرُوا وَهَلْ نُجَازِي إِلَّا الْكَفُورَ", "color": "brown"}, {"text": "(  سبأ: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ نصب مفعول به بفعل يفسره \"", "color": "black"}, {"text": "جزيناهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَزَيْنَاهُمْ﴾:", "color": "green"}, {"text": "جزي: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ما: حرف مصدري.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" مع ما بعدها بتأويل مصدر في محلّ جرّ بالباء، أي: بكفرهم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "جزيناهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهَلْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "هل: حرف استفهام لا عمل له.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿نُجَازِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدرة على الياء\" للثقل، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْكَفُورَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جزيناهم", "color": "blue"}, {"text": "\" لا محلّ لها استئنافيّة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نجازي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "جزيناهم", "color": "blue"}, {"text": "\".", "color": "black"}]}]