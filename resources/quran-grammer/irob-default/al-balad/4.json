[{"row_id": 1, "segments": [{"text": "{ لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ", "color": "brown"}, {"text": "(  البلد: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَقَدْ﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب قسم محذوف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَلَقْنَا﴾:", "color": "green"}, {"text": "خلق: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْإِنْسَانَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي كَبَدٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة، أي مكابدًا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلقنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب القسم.", "color": "black"}]}]