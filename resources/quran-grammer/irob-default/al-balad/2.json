[{"row_id": 1, "segments": [{"text": "{ وَأَنْتَ حِلٌّ بِهَذَا الْبَلَدِ", "color": "brown"}, {"text": "(  البلد: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنْتَ﴾:", "color": "green"}, {"text": "الواو: اعتراضية أو حالية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنت: ضمير رفع منفصل مبني على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حِلٌّ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنت", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِهَذَا الْبَلَدِ﴾:", "color": "green"}, {"text": "أعربت في الآية الأولى،  وهو : \n« بِهَذَا: الباء: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "هذا: ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "لا أقسم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْبَلَدِ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مجرور وعلامة جره الكسرة ويجوز أن يكون صفة لاسم الإشارة، أي: أقسم سبحانه بالبلد الحرام أي مكة المكرمة».", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجارّ والمجرور \"", "color": "black"}, {"text": "بهذا", "color": "blue"}, {"text": "\" متعلّقان بـ\"", "color": "black"}, {"text": "حل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنت حلّ بهذا البلد", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب، أو في محلّ نصب حال.", "color": "black"}]}]