[{"row_id": 1, "segments": [{"text": "{ وَهَدَيْنَاهُ النَّجْدَيْنِ", "color": "brown"}, {"text": "(  البلد: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَهَدَيْنَاهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "هدى: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿النَّجْدَيْنِ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب بالياء، لأنه مثنى.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هديناه", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]