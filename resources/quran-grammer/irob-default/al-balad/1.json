[{"row_id": 1, "segments": [{"text": "سورة البلد\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ لَا أُقْسِمُ بِهَذَا الْبَلَدِ", "color": "brown"}, {"text": "(  البلد: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف زائد.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أُقْسِمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِهَذَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "هذا: ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "لا أقسم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْبَلَدِ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مجرور وعلامة جره الكسرة ويجوز أن يكون صفة لاسم الإشارة، أي: أقسم سبحانه بالبلد الحرام أي مكة المكرمة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أقسم", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]