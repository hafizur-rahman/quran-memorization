[{"row_id": 1, "segments": [{"text": "{ فَكُّ رَقَبَةٍ", "color": "brown"}, {"text": "(  البلد: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَكُّ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هي مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَقَبَةٍ﴾:", "color": "green"}, {"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، والجملة الاسمية \"", "color": "black"}, {"text": "هي فكّ رقبة", "color": "blue"}, {"text": "\" تفسيرية لا محلّ لها من الإعراب.", "color": "black"}]}]