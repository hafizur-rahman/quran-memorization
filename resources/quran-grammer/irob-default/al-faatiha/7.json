[{"row_id": 1, "segments": [{"text": "{ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ", "color": "brown"}, {"text": "(  الفاتحة: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿صِرَاطَ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "الصراط", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنْعَمْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، \nوالتاء: ضمير متّصل مبني على الفتح في محلّ رفع فاعل، وجملة \"", "color": "black"}, {"text": "أنعمت", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جرّ و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير الغائبين مبنيّ على السكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلّقان بأنعمت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿غَيْرِ﴾:", "color": "green"}, {"text": "نعت لِـ\"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمَغْضُوبِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة، وعلامة جرّه الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على حرف جرّ، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ جرّ بعلي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وشبه الجملة - الجارّ والمجرور - في محلّ رفع نائب