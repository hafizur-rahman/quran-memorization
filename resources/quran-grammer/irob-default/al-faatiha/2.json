[{"row_id": 1, "segments": [{"text": "{ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  الفاتحة: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الْحَمْدُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "اللام حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الله﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم مخفوض وعلامة خفضه: الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والخافض والمخفوض متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والتقدير: الحمد مختصّ لله.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "صفة لله أو بدل منه مخفوض مثله بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة وعلامة جرّه: الياء لأنّه ملحق بجمع المذكر السالم.", "color": "black"}]}]