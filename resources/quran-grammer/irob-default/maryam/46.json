[{"row_id": 1, "segments": [{"text": "{ قَالَ أَرَاغِبٌ أَنْتَ عَنْ آلِهَتِي يَاإِبْرَاهِيمُ لَئِنْ لَمْ تَنْتَهِ لأَرْجُمَنَّكَ وَاهْجُرْنِي مَلِيًّا", "color": "brown"}, {"text": "(  مريم: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: ضمير مستتر فيه جوازا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَرَاغِبٌ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "راغب: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع فاعل لاسم الفاعل سدّ مسدّ الخبر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَنْ آلِهَتِي﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "راغب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَاإِبْرَاهِيمُ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "إبراهيم: منادى مبنيّ على الضمّ في محلّ نصب مفعول به الفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَئِنْ﴾:", "color": "green"}, {"text": "اللام: موطئة للقسم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "إنْ: حرف شرط جازم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَنْتَهِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، وعلامة الجزم حذف حرف العلة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لأَرْجُمَنَّكَ﴾:", "color": "green"}, {"text": "اللام: لام القسم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "أرجمنك: فعل مضارع مبنيّ على الفتح في محلّ رفع، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون التوكيد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَاهْجُرْنِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "اهجرني: فعل أمر مبنيّ على السكون، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للوقاية، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿مَلِيًّا﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة، متعلّق بفعل \"", "color": "black"}, {"text": "اهجرني", "color": "blue"}, {"text": "\"، أو هو حال من فاعل \"", "color": "black"}, {"text": "اهجرني", "color": "blue"}, {"text": "\" إذا كان المعنى ممتعًا بعمرك، أي: سالمًا، أو مفعول", "color": "black"}]}]