[{"row_id": 1, "segments": [{"text": "{ يَازَكَرِيَّا إِنَّا نُبَشِّرُكَ بِغُلَامٍ اسْمُهُ يَحْيَى لَمْ نَجْعَلْ لَهُ مِنْ قَبْلُ سَمِيًّا", "color": "brown"}, {"text": "(  مريم: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَازَكَرِيَّا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "زكريا: منادى مبنيّ على الضم المقدر على الألف في محلّ نصب مفعول به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نُبَشِّرُكَ.", "color": "green"}]}, {"row_id": 6, "segments": [{"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل﴾: ضمير مستتر فيه وجوبًا تقديره: نحن للتعظيم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِغُلَامٍ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "نبشرك", "color": "blue"}, {"text": "\"\nاسْمُهُ: مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَحْيَى﴾:", "color": "green"}, {"text": "خبر مرفوع بالضمة المقدّرة على الألف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿نَجْعَلْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بالسكون، والفاعل: ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id