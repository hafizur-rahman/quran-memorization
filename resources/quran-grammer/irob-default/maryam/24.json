[{"row_id": 1, "segments": [{"text": "{ فَنَادَاهَا مِنْ تَحْتِهَا أَلَّا تَحْزَنِي قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّا", "color": "brown"}, {"text": "(  مريم: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَنَادَاهَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ناداها: فعل ماضٍ مبنيّ على الفتح المقدّر، والفاعل: ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ تَحْتِهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "نادي", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَلَّا﴾:", "color": "green"}, {"text": "أن: حرف تفسير.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "لا: حرف نفي وجزم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَحْزَنِي﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، وعلامة الجزم حذف النون، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿جَعَلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَبُّكِ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَحْتَكِ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلّق بمحذوف مفعول به ثان.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسرة في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿سَرِيًّا﴾:", "color": "green"}, {"text": "مفعول به أول منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ناداها", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "قالت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تحزني", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قد جعل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تعليل للنهي المتقدم.", "color": "black"}]}]