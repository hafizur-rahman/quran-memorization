[{"row_id": 1, "segments": [{"text": "{ قَالَ إِنَّمَا أَنَا رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَامًا زَكِيًّا", "color": "brown"}, {"text": "(  مريم: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل: ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل بطل عمله لدخول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" الكافّة عليه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَنَا﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَسُولُ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿رَبِّكِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِأَهَبَ﴾:", "color": "green"}, {"text": "اللام: للتعليل، حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "أهب: فعل مضارع منصوب بأن مضمرة بعد اللام، وعلامة النصب الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَكِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أهب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿غُلَامًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿زَكِيًّا﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "غلام", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن أهب", "color": "blue"}, {"text": "\" في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بالرسول\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"قال\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها استئناف بياني.", "color": "blue"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"أنا رسول\"", "color": "black"}, {"text": "في محل نصب", "color": "blue"}, {"text": "\"مقول القول\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"أهب\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي.", "color": "black"}]}]