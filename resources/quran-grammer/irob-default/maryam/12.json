[{"row_id": 1, "segments": [{"text": "{ يَايَحْيَى خُذِ الْكِتَابَ بِقُوَّةٍ وَآتَيْنَاهُ الْحُكْمَ صَبِيًّا", "color": "brown"}, {"text": "(  مريم: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَايَحْيَى﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "منادى مبني على الضم المقدر على الألف في محلّ نصب مفعول به لفعل النداء المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خُذِ﴾:", "color": "green"}, {"text": "فعل أمر مبني على السكون، وحرّك بالكسر منعًا لالتقاء الساكنين، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِقُوَّةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال من فاعل \"", "color": "black"}, {"text": "خذ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَآتَيْنَاهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "آتيناه: فعل ماضٍ مبنيّ على السكون، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْحُكْمَ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿صَبِيًّا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة من ضمير المفعول.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "جملة النداء \"", "color": "black"}, {"text": "يا يحيى", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" مقدر، أي: قال تعالى: \"", "color": "black"}, {"text": "يا