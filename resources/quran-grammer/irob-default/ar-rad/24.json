[{"row_id": 1, "segments": [{"text": "{ سَلَامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَى الدَّارِ", "color": "brown"}, {"text": "(  الرعد: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سَلَامٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع بالضمة الظّاهرة، وساغ الابتداء لما فيه من معنى الدّعاء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَيْكُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\": حرف جرّ مبنيّ على السكون، \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، والجار والمجرور متعلّقان بمحذوف خبر مرفوع، والجملة من المبتدأ وخبره في محلّ نصب مفعول به لأنّها", "color": "black"}, {"text": "( مقول قول )", "color": "green"}, {"text": "محذوف في موضع نُصِبَ على الحال؛ أي:", "color": "black"}, {"text": "( قائلين )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر، \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف مصدري مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿صَبَرْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتّصاله بضمير رفع متحرّك و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، والمصدر المؤوّل من \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" والفعل في محلّ جرّ بالباء، والتَّقديرُ", "color": "black"}, {"text": "( بصبركم )", "color": "green"}, {"text": "، والجارّ والمجرور متعلّقان بمحذوف تقديره:", "color": "black"}, {"text": "( هذا بما صبرتم )", "color": "green"}, {"text": "؛ أي:", "color": "black"}, {"text": "( هذا بسبب صبركم )", "color": "green"}, {"text": "فهما خبر لمبتدأ محذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَنِعْمَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "نعم", "color": "blue"}, {"text": "\": فعل ماض جامد لإنشاء المدح مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عُقْبَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدّرة على الألف للتعذّر، والجملة من الفعل والفاعل استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الدَّارِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}]