[{"row_id": 1, "segments": [{"text": "سورة الرعد\nبسم الله الرحمن الرحيم", "color": "black"}, {"text": "{ المر تِلْكَ آيَاتُ الْكِتَابِ وَالَّذِي أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ الْحَقُّ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ", "color": "brown"}, {"text": "(  الرعد: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿المر﴾:", "color": "green"}, {"text": "خبر لمبتدأ محذوف في محلّ رفع، والتقدير", "color": "black"}, {"text": "( هذه آلمر )", "color": "green"}, {"text": "، والجملة ابتدائية، لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تِلْكَ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد مبنيّ على السكون، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف خطاب مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آيَاتُ﴾:", "color": "green"}, {"text": "خبر مرفوع بالضمة الظّاهرة وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْكِتَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة من المبتدأ وخبره استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَالَّذِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على الكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أُنْزِلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة من الفعل ونائب الفاعل صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "\"", "color":