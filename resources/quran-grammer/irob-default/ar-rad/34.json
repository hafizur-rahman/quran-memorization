[{"row_id": 1, "segments": [{"text": "{ لَهُمْ عَذَابٌ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَشَقُّ وَمَا لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "لَهُمْ: اللام: حرف جرّ مبنيّ على الفتح، \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بمحذوف خبر مقدّم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَذَابٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخّر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْحَيَاةِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "في", "color": "blue"}, {"text": "\"وعلامة جرّه الكسرة الظاهرة، والجارّ والمجرور متعلّقان بمحذوف نعت \"", "color": "black"}, {"text": "عذاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الدُّنْيَا﴾:", "color": "green"}, {"text": "نعت \"", "color": "black"}, {"text": "الحياة", "color": "blue"}, {"text": "\" مجرور بالكسرة المقدّرة منع من ظهورها التعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَعَذَابُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف ابتداء مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "\"", "color": "black"}, {"text": "عذاب", "color": "blue"}, {"text": "\": مبتدأ مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْآخِرَةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَشَقُّ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره, والجملة من المبتدأ وخبره استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ مبنيّ على الفتح، و \"", "color": "black"}, {"text": "هُمْ", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ باللّام، والجارّ والمجرور متعلّقان بمحذوف خبر مقدّم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون وحرك بالفتح منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم مجرور بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جرّه الكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "واقٍ", "color": "blue"}, {"text": "\" الآتي.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَاقٍ﴾:", "color": "green"}, {"text": "مبتدأ مؤخّر مرفوع بضمة مقدرة على الياء المحذوفة، والجملة من المبتدأ وخبره معطوفة على الجملة \"", "color": "black"}, {"text": "لهم عذاب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]