[{"row_id": 1, "segments": [{"text": "{ مَثَلُ الْجَنَّةِ الَّتِي وُعِدَ الْمُتَّقُونَ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ أُكُلُهَا دَائِمٌ وَظِلُّهَا تِلْكَ عُقْبَى الَّذِينَ اتَّقَوْا وَعُقْبَى الْكَافِرِينَ النَّارُ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "مَثَلُ: مبتدأ مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والخبر محذوف، أي:", "color": "black"}, {"text": "(  الرعد: فيما يُتلى عليكم مَثَلُ الجَنَّةِ  )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْجَنَّةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّتِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ جرّ نعت لـ \"", "color": "black"}, {"text": "الجنة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وُعِد﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمُتَّقُونَ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع بالواو لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَجْرِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بضمة مقدّرة على الياء منع من ظهورها الثّقل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَحْتِهَا﴾:", "color": "green"}, {"text": "تحت: اسم مجرور بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظاهرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة، وال