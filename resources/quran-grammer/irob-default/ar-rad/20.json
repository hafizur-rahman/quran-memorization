[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ يُوفُونَ بِعَهْدِ اللَّهِ وَلَا يَنْقُضُونَ الْمِيثَاقَ", "color": "brown"}, {"text": "(  الرعد: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع نعت لِـ\"", "color": "black"}, {"text": "أولو", "color": "blue"}, {"text": "\" في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يُوفُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون لأنَّهُ من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة من الفعل والفاعل صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِعَهْدِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "\"", "color": "black"}, {"text": "عَهْدِ", "color": "blue"}, {"text": "\": اسم مجرور بالباء وعلامة جرّه الكسرة، والجار والمجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة، مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، و\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَنْقُضُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون لأنَّهُ من الأفعال الخمسة، والواو ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "ينقضون", "color": "blue"}, {"text": "\" معطوفة على الجملة \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمِيثَاقَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}]