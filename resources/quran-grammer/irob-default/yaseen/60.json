[{"row_id": 1, "segments": [{"text": "{ أَلَمْ أَعْهَدْ إِلَيْكُمْ يَابَنِى آدَمَ أَنْ لَا تَعْبُدُوا الشَّيْطَانَ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ", "color": "brown"}, {"text": "(  يس: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَعْهَدْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِلَيْكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أعهد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَابَنِى﴾:", "color": "green"}, {"text": "حرف نداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "بني: منادى منصوب بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ءَادَمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَن﴾:", "color": "green"}, {"text": "حرف تفسير لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نهي وجزم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَعْبُدُواْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اَلشَّيْطَان