[{"row_id": 1, "segments": [{"text": "{ وَلَوْ نَشَاءُ لَمَسَخْنَاهُمْ عَلَى مَكَانَتِهِمْ فَمَا اسْتَطَاعُوا مُضِيًّا وَلَا يَرْجِعُونَ", "color": "brown"}, {"text": "(  يس: 67  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَوْ نَشَآءُ لَمَسَخْنَهُمْ عَلَى مَكَانَتِهِمْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "ولو نشاء لطمسنا على أعينهم", "color": "blue"}, {"text": "\" الواردة في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": ": وهو : « وَلَوْ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَشَآءُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَطَمَسْنَا﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "طمس: فعل ماضٍ مبنيّ علي السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَى أَعْيُنِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "طمسنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "مسخناهم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ نصب مفعول به، والجارّ والمجرور \"", "color": "black"}, {"text": "على مكانتهم", "color": "blue"}, {"text": "\" متعلّق بحال محذوفة بمعنى: ولو نشاء لغيرنا صورهم كائنين في مكانتهم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿اسْتَطَعُواْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مُضِيًّا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿يَرْجِعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نشاء", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( الثانية )", "color": "green"}, {"text": "لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "نشاء", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( الأولى )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "مسخناهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإ