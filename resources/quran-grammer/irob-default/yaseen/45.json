[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قِيلَ لَهُمُ اتَّقُوا مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ", "color": "brown"}, {"text": "(  يس: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان متضمن معنى الشرط مبنيّ على السكون في محلّ نصب مفعول فيه خافض لشرطه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قِيلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ونائب الفاعل ضمير مستتر تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَهُمُ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قيل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿اتَّقُواْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بَيْنَ﴾:", "color": "green"}, {"text": "ظرف مكان متعلّق بصلة الموصول المحذوفة بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَيْدِيكُمْ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جر بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَمَا خَلْفَكُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "ما بين أيديكم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿لَعَلَّكُمْ﴾:", "color": "green"}, {"text": "لعل: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "لعل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿تُرْحَمُونَ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة الشرط وفعله وجوابه لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "إن نشأ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قيل", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه، وجواب الشرط محذوف دل عليه قوله تعالى في الآية التالية، كانوا عنها معرضين، أي: أعرضوا.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتقوا", "color": "blue"}, {"text": "\" في محلّ رفع نائب الفاعل.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لعلكم ترحمون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها حرف استئنافية.", "color": "black"}]}, {"row_id":