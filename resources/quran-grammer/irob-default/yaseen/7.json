[{"row_id": 1, "segments": [{"text": "{ لَقَدْ حَقَّ الْقَوْلُ عَلَى أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِنُونَ", "color": "brown"}, {"text": "(  يس: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَقَدْ﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب قسم مقدّر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَقَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقَوْلُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَى أَكْثَرِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "\"حق\"", "color": "black"}, {"text": "، و", "color": "blue"}, {"text": "\"الهاء\"", "color": "black"}, {"text": ": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "blue"}]}, {"row_id": 7, "segments": [{"text": "و\"الميم\": للجماعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قد حق القول", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم المقدّر.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة القسم المقدّ