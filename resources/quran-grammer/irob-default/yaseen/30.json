[{"row_id": 1, "segments": [{"text": "{ يَاحَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ", "color": "brown"}, {"text": "(  يس: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاحَسْرَةً﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "حسرة: منادى منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَى الْعِبَادِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بفعل المناداة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية الحادية عشرة من سورة الحجر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": ": وهو : « ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَأْتِيهِمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ رَسُولٍ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "مِنْ", "color": "blue"}, {"text": "\"حرف جرّ زائد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "رَسُولٍ: اسم مجرور لفظ مرفوع محلًا لأنه فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما يأتيهم", "color": "blue"}, {"text": "\" حكاية حال ماضية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجملة بعدها في محلّ نصب حال.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الضم، والواو ضمير