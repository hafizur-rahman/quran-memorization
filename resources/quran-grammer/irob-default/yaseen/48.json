[{"row_id": 1, "segments": [{"text": "{ وَيَقُولُونَ مَتَى هَذَا الْوَعْدُ إِنْ كُنْتُمْ صَادِقِينَ", "color": "brown"}, {"text": "(  يس: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية الثامنة  والاربعين من سورة يونس والآية الثامنة والثلاثين من سورة الأنبياء، وغيرها.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "﴾: وهو : « وَيَقُولُونَ: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "يقولون: فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَتَى﴾:", "color": "green"}, {"text": "اسم استفهام مبنيّ في محلّ نصب ظرف زمان متعلّق بخبر محذوف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ذا: اسم إشارة مبنيّ في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الوَعْدُ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\" أو عطف بيان - مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "كُنْتُمْ: فعل ماضٍ ناقص، مبنيّ على السكون، و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، والفعل في محلّ جزم فعل الشرط.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿صَادِقِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كنتم", "color": "blue"}, {"text": "\" منصوب، وعلامة النصب الياء».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقولون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافيّة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "متى هذا الوعد", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن كنتم صادقين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها استئنافيّة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجواب الشرط محذوف دل عليه ما قبله.", "color": "black"}]}]