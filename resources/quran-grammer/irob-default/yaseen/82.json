[{"row_id": 1, "segments": [{"text": "{ إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَنْ يَقُولَ لَهُ كُنْ فَيَكُونُ", "color": "brown"}, {"text": "(  يس: 82  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّمَآ﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد بطل عمله.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف زائد وكافّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَمْرُهُ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِذَآ﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون متضمن معنى الشرط خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَرَادَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَيْئًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَن﴾:", "color": "green"}, {"text": "حرف مصدري.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ونصب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَقُولَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بأنْ وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يقول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر", "color": "black"}, {"text": "(