[{"row_id": 1, "segments": [{"text": "{ لِتُنْذِرَ قَوْمًا مَا أُنْذِرَ آبَاؤُهُمْ فَهُمْ غَافِلُونَ", "color": "brown"}, {"text": "(  يس: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِتُنْذِرَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تنذر: فعل مضارع منصوب بأن مضمرة بعد اللام، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَوْمًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمرة وما بعدها بتأويل مصدر في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بفعل محذوف تقديره: أرسلناك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أُنْذِرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آبَاؤُهُمْ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿غَافِلُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تنذر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما أنذر آباؤهم", "color": "blue"}, {"text": "\" في محلّ نصب نعت لـ\"", "color": "black"}, {"text": "قومًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هم غافلون", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "ما أنذر", "color": "blue"}, {"text": "\".", "color": "black"}]}]