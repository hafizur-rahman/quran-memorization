[{"row_id": 1, "segments": [{"text": "{ قَالُوا رَبُّنَا يَعْلَمُ إِنَّا إِلَيْكُمْ لَمُرْسَلُونَ", "color": "brown"}, {"text": "(  يس: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": ": وهو : «", "color": "black"}, {"text": "قَالُوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "blue"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "blue"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللام﴾:", "color": "green"}, {"text": "في لـ \"", "color": "black"}, {"text": "مرسلون", "color": "blue"}, {"text": "\" وكأنها واقعة في جواب القسم الذي جاء في الجملة الاسمية \"", "color": "black"}, {"text": "ربنا يعلم", "color": "blue"}, {"text": "\" لأن هذا القول جارّ مجرى القسم في التوكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "مثل قولهم: شهد الله.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وعلم الله.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبُّنَا﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنَّا إِلَيْكُمْ لَمُرْسَلُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية 14.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": ": وهو : « إِنَّا: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "b