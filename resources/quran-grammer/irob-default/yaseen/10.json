[{"row_id": 1, "segments": [{"text": "{ وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ", "color": "brown"}, {"text": "(  يس: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أعربت في الآية السادسة من سورة البقرة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو ﴾: «و سَوَاءٌ:  \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\": عاطفة، سَوَاءٌ:خبر مقدم مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلِّقان بسواء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَأَنْذَرْتَهُمْ﴾:", "color": "green"}, {"text": "الهمزة: همزة التسوية، حرف مبنيّ على الفتح لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "أنذرتهم: فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، والتاء: ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والهاء: ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": علامة الجمع.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والمصدر المؤوّل من \"", "color": "black"}, {"text": "أأنذرتهم", "color": "blue"}, {"text": "\"، أي: إنذارُك في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف عطف للتسوية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف جزم ونفي وقلب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تُنْذِرْهُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت، و