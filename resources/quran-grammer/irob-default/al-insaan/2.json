[{"row_id": 1, "segments": [{"text": "{ إِنَّا خَلَقْنَا الْإِنْسَانَ مِنْ نُطْفَةٍ أَمْشَاجٍ نَبْتَلِيهِ فَجَعَلْنَاهُ سَمِيعًا بَصِيرًا", "color": "brown"}, {"text": "(  الإنسان: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿خَلَقْنَا﴾:", "color": "green"}, {"text": "خلق: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْإِنْسَانَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ نُطْفَةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من \"", "color": "black"}, {"text": "الإنسان", "color": "blue"}, {"text": "\"، والتقدير: حال كونه من نطفة، أي: من ماء قليل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَمْشَاجٍ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "نطفة", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَبْتَلِيهِ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستتر فيه وجوباً تقديره: نحن، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَجَعَلْنَاهُ﴾:", "color": "green"}, {"text": "معطوفة بالفاء على \"", "color": "black"}, {"text"