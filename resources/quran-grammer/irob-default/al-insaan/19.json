[{"row_id": 1, "segments": [{"text": "{ وَيَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُخَلَّدُونَ إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤًا مَنْثُورًا", "color": "brown"}, {"text": "(  الإنسان: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيَطُوفُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يطوف: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "يطوف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وِلْدَانٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُخَلَّدُونَ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "ولدان", "color": "blue"}, {"text": "\" مرفوعة بالواو لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان متضمن معنى الشّرط خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَأَيْتَهُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿حَسِبْتَهُمْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "رأيتهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لُؤْلُؤًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مَنْثُورًا﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "لؤلؤاً", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يطوف عليهم ولدان", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يسقون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة الشّرط وفعله وجوابه في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "ولدان", "color": "blue"}, {"text": "\" ثانٍ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "رأيتهم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "حسبتهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب شرط غير جازم.", "color": "black"}]}]