[{"row_id": 1, "segments": [{"text": "{ فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا", "color": "brown"}, {"text": "(  الإنسان: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَاصْبِرْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اصبر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لِحُكْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تُطِعْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "من: حرف جر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "لا تطع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿آثِمًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَوْ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿كَفُورًا﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "آثمًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اصبر", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدّر أي إن جاء قدر الله فاصبر.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تطع", "color": "blue"}, {"text": "\" في محلّ جزم معطوفة على جملة الجواب.", "color": "black"}]}]