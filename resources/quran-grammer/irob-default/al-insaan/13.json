[{"row_id": 1, "segments": [{"text": "{ مُتَّكِئِينَ فِيهَا عَلَى الْأَرَائِكِ لَا يَرَوْنَ فِيهَا شَمْسًا وَلَا زَمْهَرِيرًا", "color": "brown"}, {"text": "(  الإنسان: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مُتَّكِئِينَ﴾:", "color": "green"}, {"text": "حال من \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "جزاهم", "color": "blue"}, {"text": "\" منصوب بالياء؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿فِيهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَى الْأَرَائِكِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "متكئين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَرَوْنَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِيهَا شَمْسًا وَلَا زَمْهَرِيرًا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "منكم جزاء ولا شكوراً", "color": "blue"}, {"text": "\" الواردة في الآية التاسعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وهو \n« مِنْكُمْ: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نريد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ جَزَاءً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "col