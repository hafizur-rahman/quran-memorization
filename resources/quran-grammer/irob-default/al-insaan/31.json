[{"row_id": 1, "segments": [{"text": "{ يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًا", "color": "brown"}, {"text": "(  الإنسان: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يُدْخِلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَشَاءُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يدخل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي رَحْمَتِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يدخل", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالظَّالِمِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الظالمين: مفعول به منصوب بفعل مضمر تقديره: أَوْعِدْ، وعلامة نصبه \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَعَدَّ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "أعد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"t