[{"row_id": 1, "segments": [{"text": "{ يُوفُونَ بِالنَّذْرِ وَيَخَافُونَ يَوْمًا كَانَ شَرُّهُ مُسْتَطِيرًا", "color": "brown"}, {"text": "(  الإنسان: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يُوفُونَ بِالنَّذْرِ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يشربون من كأس", "color": "blue"}, {"text": "\" في الآية الخامسة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو \n« يَشْرَبُونَ: فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ كَأْسٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يشربون", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَيَخَافُونَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَوْمًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿شَرُّهُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُسْتَطِيرًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يخافون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان شره مستطيراً", "color": "blue"}, {"text": "\" في محلّ نصب نعت لـ\"", "color": "black"}, {"text": "يوماً", "color": "blue"}, {"text": "\".", "color": "black"}]}]