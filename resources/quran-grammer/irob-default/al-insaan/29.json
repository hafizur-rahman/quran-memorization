[{"row_id": 1, "segments": [{"text": "{ إِنَّ هَذِهِ تَذْكِرَةٌ فَمَنْ شَاءَ اتَّخَذَ إِلَى رَبِّهِ سَبِيلًا", "color": "brown"}, {"text": "(  الإنسان: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿هَذِهِ﴾:", "color": "green"}, {"text": "ها: حرف تنبيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ذه: اسم إشارة مبنيّ على الكسر في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَذْكِرَةٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَمَنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿شَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اتَّخَذَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "شاء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿إِلَى رَبِّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "اتخذ", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿سَبِيلًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن هذه تذكرة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من شاء", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافيّة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "شاء", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتخذ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط جازم غير مقترنة بالفاء أو \"", "color": "black"}, {"text": "إذا", "color": "blue"}, {"text": "\".", "color": "black"}]}]