[{"row_id": 1, "segments": [{"text": "{ نَحْنُ خَلَقْنَاهُمْ وَشَدَدْنَا أَسْرَهُمْ وَإِذَا شِئْنَا بَدَّلْنَا أَمْثَالَهُمْ تَبْدِيلًا", "color": "brown"}, {"text": "(  الإنسان: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿نَحْنُ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الضم في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿خَلَقْنَاهُمْ﴾:", "color": "green"}, {"text": "خلق: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَشَدَدْنَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "خلقنا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَسْرَهُمْ﴾:", "color": "green"}, {"text": "أسر: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه متضمن معنى الشّرط خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شِئْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بَدَّلْنَا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "شئنا", "colo