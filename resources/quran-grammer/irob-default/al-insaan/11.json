[{"row_id": 1, "segments": [{"text": "{ فَوَقَاهُمُ اللَّهُ شَرَّ ذَلِكَ الْيَوْمِ وَلَقَّاهُمْ نَضْرَةً وَسُرُورًا", "color": "brown"}, {"text": "(  الإنسان: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَوَقَاهُمُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وقى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أوّل مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿شَرَّ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة، و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْيَوْمِ﴾:", "color": "green"}, {"text": "بدل من اسم الإشارة مجرور بالكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَقَّاهُمْ نَضْرَةً﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لقاهم: تُعرب إعراب \"", "color": "black"}, {"text": "وقاهم", "color": "blue"}, {"text": "\"، والفاعل ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَسُرُورًا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "نضرة", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "وقاهم الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يوفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لقاهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "وقاهم الله", "color": "blue"}, {"text": "\".", "color": "black"}]}]