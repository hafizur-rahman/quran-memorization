[{"row_id": 1, "segments": [{"text": "{ وَمِنَ اللَّيْلِ فَاسْجُدْ لَهُ وَسَبِّحْهُ لَيْلًا طَوِيلًا", "color": "brown"}, {"text": "(  الإنسان: 26  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمِنَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من: حرف جرّ مبنيّ على السكون وقد حرّك بالكسر منعًا من التقاء الساكنين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّيْلِ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة، والجارّ والمجرور متعلّقان بفعل محذوف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَاسْجُدْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "اسجد: فعل أمر مبنيّ على السكون، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "اسجد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَسَبِّحْهُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "اسجد", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَيْلًا﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "سبحه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿طَوِيلًا﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "ليلًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اسجد", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدّر، أي: مهما حصل فاسجد والشرط المقدّر معطوف على الشّرط المقدّر السابق.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سبحه", "color": "blue"}, {"text": "\" في محلّ جزم معطوفة على جملة \"", "color": "black"}, {"text": "اسجد", "color": "blue"}, {"text": "\".", "color": "black"}]}]