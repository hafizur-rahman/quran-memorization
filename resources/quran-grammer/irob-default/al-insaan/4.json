[{"row_id": 1, "segments": [{"text": "{ إِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَلَاسِلَ وَأَغْلَالًا وَسَعِيرًا", "color": "brown"}, {"text": "(  الإنسان: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّا أَعْتَدْنَا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "إنا خلقنا", "color": "blue"}, {"text": "\" في الآية الثانية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو \n« إِنَّا: إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَلَقْنَا﴾:", "color": "green"}, {"text": "خلق: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلْكَافِرِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "أعتدنا", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"؛ لأنَّه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿سَلَاسِلَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَأَغْلَالًا وَسَعِيرًا﴾:", "color": "green"}, {"text": "معطوفتان بواوي العطف على \"", "color": "black"}, {"text": "سلاسل", "color": "blue"}, {"text": "\" منصوبتان بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنا أعتدنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أعتدنا", "color": "blue"}