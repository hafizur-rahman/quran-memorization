[{"row_id": 1, "segments": [{"text": "{ وَجَزَاهُمْ بِمَا صَبَرُوا جَنَّةً وَحَرِيرًا", "color": "brown"}, {"text": "(  الإنسان: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَجَزَاهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وما بعدها: يعرب إعراب \"", "color": "black"}, {"text": "لقاهم نضرة وسروراً .", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "\" الواردة في الآية السابقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو : «", "color": "black"}, {"text": "وَقَاهُمُ:  وقى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، و\"", "color": "blue"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أوّل مقدم.", "color": "blue"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازاً تقديره: هو».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ما: حرف مصدريّ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿صَبَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": وما بعدها بتأويل مصدر في محلّ جرّ بالباء، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "جزاهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿جَنَّةً﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفت