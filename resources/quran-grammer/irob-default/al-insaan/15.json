[{"row_id": 1, "segments": [{"text": "{ وَيُطَافُ عَلَيْهِمْ بِآنِيَةٍ مِنْ فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا", "color": "brown"}, {"text": "(  الإنسان: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيُطَافُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يطاف: فعل مضارع للمجهول مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، والجارّ والمجرور في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِآنِيَةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يطاف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ فِضَّةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة محذوفة لـ\"", "color": "black"}, {"text": "آنية", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَأَكْوَابٍ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "آنية", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَانَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "واسمها ضمير مستتر فيه جوازاً تقديره: هي.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿قَوَارِيرَا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "b