[{"row_id": 1, "segments": [{"text": "{ إِنَّا هَدَيْنَاهُ السَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا", "color": "brown"}, {"text": "(  الإنسان: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّا هَدَيْنَاهُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "إنا خلقنا", "color": "blue"}, {"text": "\" في الآية السابقة، وهو  : \n«  إِنَّا: إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿خَلَقْنَا﴾:", "color": "green"}, {"text": "خلق: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به أوّل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿السَّبِيلَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِمَّا﴾:", "color": "green"}, {"text": "حرف تفصيل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿شَاكِرًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَإِمَّا كَفُورًا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "إما شاكراً", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنا هديناه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "blac