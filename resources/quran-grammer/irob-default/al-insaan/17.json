[{"row_id": 1, "segments": [{"text": "{ وَيُسْقَوْنَ فِيهَا كَأْسًا كَانَ مِزَاجُهَا زَنْجَبِيلًا", "color": "brown"}, {"text": "(  الإنسان: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيُسْقَوْنَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يسقون: فعل مضارع للمجهول مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِيهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يسقون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَأْسًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَانَ مِزَاجُهَا زَنْجَبِيلًا﴾:", "color": "green"}, {"text": "أعربت في الآية الخامسة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وهو « كَانَ: فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِزَاجُهَا﴾:", "color": "green"}, {"text": "مزاج: اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَافُورًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة »  وجملة \"", "color": "black"}, {"text": "يسقون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "يطاف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان مزاجها زنجبيلاً", "color": "blue"}, {"text