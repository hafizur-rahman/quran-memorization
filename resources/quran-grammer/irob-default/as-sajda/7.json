[{"row_id": 1, "segments": [{"text": "{ الَّذِي أَحْسَنَ كُلَّ شَيْءٍ خَلَقَهُ وَبَدَأَ خَلْقَ الْإِنْسَانِ مِنْ طِينٍ", "color": "brown"}, {"text": "(  السجدة: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ رفع خبر رابع لـ\"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَحْسَنَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، وفاعله ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "&والجملة صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كُلَّ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَلَقَهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، وفاعله ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة الفعلية في محلّ نصب نعت لـ \"", "color": "black"}, {"text": "كل", "color": "blue"}, {"text": "\" أو جرّ نعت لـ\"", "color": "black"}, {"text": "شيء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَبَدَأَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "بدأ", "color": "blue"}, {"text": "\": فعل ماضٍ مبنيّ على الفتح، وفاعله ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجملة من الفعل والفاعل معطوفة على الجملة \"", "color": "black"}, {"text": "أحسن", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿خَلْقَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْإِنْسَانِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿طِينٍ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "بدأ", "color": "blue"}, {"text": "\".", "color": "black"}]}]