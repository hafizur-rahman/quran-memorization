[{"row_id": 1, "segments": [{"text": "{ أَمْ يَقُولُونَ افْتَرَاهُ بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ", "color": "brown"}, {"text": "(  السجدة: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "هي أم المنقطعة حرف إضراب بمعنى بل مبنيّ على السكون.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَقُولُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت التون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، والجملة من الفعل والفاعل استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿افْتَرَاهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على فتحة مقدرة منع من ظهورها التعذّر، وفاعله ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية في محلّ نصب مفعول به، لأنّها \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَلْ﴾:", "color": "green"}, {"text": "حرف ابتداء للإضراب مبنيّ على السكون لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السكون.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿