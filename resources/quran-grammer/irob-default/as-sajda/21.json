[{"row_id": 1, "segments": [{"text": "{ وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ الْأَدْنَى دُونَ الْعَذَابِ الْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ", "color": "brown"}, {"text": "(  السجدة: 21  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَنُذِيقَنَّهُم﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "واللام: واقعة في جواب القسم المقدّر حرف مبنيّ على الفتح، \"", "color": "black"}, {"text": "نذيق", "color": "blue"}, {"text": "\": فعل مضارع مبنيّ على الفتح الاتصاله بنون التّوكيد المباشرة والنّون هي نون التّوكيد الثّقيلة حرف لا محلّ له من الإعراب، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به، والجملة جواب القسم المقدّر لا محلّ لها من الإعراب، وجملة القسم وجوابه استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ مبنيّ على السّكون وحرّك بالكسر منعًا لالتقاء السّاكنين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْعَذَابِ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جره الكسرة الظّاهرة، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "نذيقنهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْأَدْنَى﴾:", "color": "green"}, {"text": "نعت لـ \"", "color": "black"}, {"text": "عذاب", "color": "blue"}, {"text": "\" مجرور بالكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿دُونَ﴾:", "color": "green"}, {"text": "ظرف زمان بمعنى \"", "color": "black"}, {"text": "قبل", "color": "blue"}, {"text": "\" متعلّق بمحذوف حال من \"", "color": "black"}, {"text": "العذاب", "color": "blue"}, {"text": "\".", "color":