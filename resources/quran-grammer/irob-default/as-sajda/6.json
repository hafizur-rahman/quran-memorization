[{"row_id": 1, "segments": [{"text": "{ ذَلِكَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الرَّحِيمُ", "color": "brown"}, {"text": "(  السجدة: 6  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ذَلِكَ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم إشارة مبنيّ على السّكون في محلّ رفع مبتدأ، واللام: حرف دالّ على البعد مبنيّ على الكسر، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف دال على توجيه الخطاب مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَالِمُ﴾:", "color": "green"}, {"text": "خبر مرفوع بالضّمة الظّاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة من المبتدأ والخبر استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْغَيْبِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالشَّهَادَةِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "الشهادة", "color": "blue"}, {"text": "\": اسم معطوف على \"", "color": "black"}, {"text": "الغيب", "color": "blue"}, {"text": "\" مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْعَزِيزُ﴾:", "color": "green"}, {"text": "خبر ثانٍ مرفوع بالضمة الظّاهرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الرَّحِيمُ﴾:", "color": "green"}, {"text": "خبر ثالث مرفوع بالضمة الظّاهرة.", "color": "black"}]}]