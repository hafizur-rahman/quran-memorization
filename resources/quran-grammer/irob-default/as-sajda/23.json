[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَلَا تَكُنْ فِي مِرْيَةٍ مِنْ لِقَائِهِ وَجَعَلْنَاهُ هُدًى لِبَنِي إِسْرَائِيلَ", "color": "brown"}, {"text": "(  السجدة: 23  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: واقعة في جواب القسم المقدّر مبنيّ على الفتح، \"", "color": "black"}, {"text": "قد", "color": "blue"}, {"text": "\": حرف تحقيق مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آتينا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السّكون لاتّصاله بضمير الرفع المتحرّك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة من الفعل والفاعل جواب القسم المقدّر لا محلّ لها من الإعراب وجملة القسم وجوابه استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مفعول به أوّل منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب شرط مقدّر، حرف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\": هي \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" الناهية حرف مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَكُنْ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بـ \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" وعلامة جزمه السّكون، واسمه ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 10, "segments"