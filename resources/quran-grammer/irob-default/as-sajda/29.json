[{"row_id": 1, "segments": [{"text": "{ قُلْ يَوْمَ الْفَتْحِ لَا يَنْفَعُ الَّذِينَ كَفَرُوا إِيمَانُهُمْ وَلَا هُمْ يُنْظَرُونَ", "color": "brown"}, {"text": "(  السجدة: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السّكون، وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "&والجملة من الفعل والفاعل استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "ظرف زمان متعلّق بـ \"", "color": "black"}, {"text": "ينفع", "color": "blue"}, {"text": "\" منصوب وعلامة نصبه الفتحة الظّاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْفَتْحِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة الظّاهرة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ينَفَعُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الذين﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب مفعول به مقدّم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتّصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة \"", "color": "black"}, {"text": "كفروا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِيمَانُهُمْ﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "إيمان", "color": "blue"}, {"text": "\": فاعل مرفوع بالضمّة الظّاهرة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة والجملة \"", "color": "black"}, {"text": "يَنْفعُ", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف مبنيّ على الفتح، \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\": حرف نفي مبنيّ على السّكون.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يُنَظرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، لأنّه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والجملة \"", "color": "black"}, {"text": "ينظرون", "color": "blue"}, {"text": "\" من الفعل والفاعل في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "والجملة من المبتدأ وخبره معطوفة على الجملة \"", "color": "black"}, {"text": "ينفع", "color": "blue"}, {"text": "\" في محلّ نصب.", "color": "black"}]}]