[{"row_id": 1, "segments": [{"text": "{ وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ", "color": "brown"}, {"text": "(  المسد: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَامْرَأَتُهُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الضمير في \"", "color": "black"}, {"text": "سيصلى", "color": "blue"}, {"text": "\" مرفوعة بالضمة، أو مبتدأ مرفوع.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَمَّالَةَ﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة أو مفعول به منصوب على الذم بفعل مضمر تقديره: أذم أو اشتم أو أعني.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْحَطَبِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}]