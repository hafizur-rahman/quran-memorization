[{"row_id": 1, "segments": [{"text": "{ الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ لَا يَمَسُّنَا فِيهَا نَصَبٌ وَلَا يَمَسُّنَا فِيهَا لُغُوبٌ", "color": "brown"}, {"text": "(  فاطر: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع خبر مبتدأ محذوف تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَحَلَّنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿دَار﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْمُقَامَةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ فَضْلِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أحلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَمَسُّنَا﴾:", "color": "green"}, {"text": "يمس: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فِيهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعل