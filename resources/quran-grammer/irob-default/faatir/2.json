[{"row_id": 1, "segments": [{"text": "{ مَا يَفْتَحِ اللَّهُ لِلنَّاسِ مِنْ رَحْمَةٍ فَلَا مُمْسِكَ لَهَا وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ مِنْ بَعْدِهِ وَهُوَ الْعَزِيزُ الْحَكِيمُ", "color": "brown"}, {"text": "(  فاطر: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السكون في محلّ نصب مفعول به مقدم للفعل \"", "color": "black"}, {"text": "يفتح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَفْتَحِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره، وقد حرِّك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لِلنَّاسِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلق بـ\"", "color": "black"}, {"text": "يفتح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَحْمَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور بالكسرة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجار والمجرور متعلّقان بحال محذوفة لاسم الشرط \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشرط.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا حرف نفي للجنس.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مُمْسِكَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب، وخبرها محذوف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ل