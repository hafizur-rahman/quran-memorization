[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا النَّاسُ إِنَّ وَعْدَ اللَّهِ حَقٌّ فَلَا تَغُرَّنَّكُمُ الْحَيَاةُ الدُّنْيَا وَلَا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ", "color": "brown"}, {"text": "(  فاطر: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة أعربت في الآية الثالثة والثلاثين من سورة لقمان.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "﴾: وهو : « يَاأَيُّهَا: يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أي: اسم منادي مبنيّ على الضم في محلّ نصب مفعول به لفعل النداء المحذوف، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف للتنبيه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّاسُ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" أو عطف بيان مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إِنَّ: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَعْدَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿حَقٌّ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف حرف دال على التعليل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَغُرَّنَّكُمُ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ على الفتح، لاتصاله بنون التوكيد الثقيلة التي هي حرف لا محلّ له م