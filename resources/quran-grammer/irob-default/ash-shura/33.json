[{"row_id": 1, "segments": [{"text": "{ إِنْ يَشَأْ يُسْكِنِ الرِّيحَ فَيَظْلَلْنَ رَوَاكِدَ عَلَى ظَهْرِهِ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ", "color": "brown"}, {"text": "(  الشورى: 33  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَشَأْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم فعل الشَّرط وعلامة جزمه السكون، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُسْكِنِ﴾:", "color": "green"}, {"text": "مثل \"", "color": "black"}, {"text": "يشأ", "color": "blue"}, {"text": "\"، وهو جواب الشَّرط.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وحرك بالكسرة منعا من التقاء الساكنين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الرِّيحَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَيَظْلَلْنَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطفٌ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "يظللن: وهي فعل مضارع ناقص معطوفٌ على يسكن\" مبنيّ على السكون لاتصاله بضمير الإناث في محلّ جزم، والنون: ضمير متصل مبنيّ في محلّ رفع اسم يظلّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رَوَاكِدَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "يظل", "color": "blue"}, {"text": "\" منصوب بالفتحة، ولم ينون؛ لأنَّهُ ممنوع من الصرف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَلَى ظَهْرِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "رواكد", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "{ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ }", "color": "brown