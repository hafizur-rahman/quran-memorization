[{"row_id": 1, "segments": [{"text": "{ وَيَعْلَمَ الَّذِينَ يُجَادِلُونَ فِي آيَاتِنَا مَا لَهُمْ مِنْ مَحِيصٍ", "color": "brown"}, {"text": "(  الشورى: 35  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَيَعْلَمَ﴾:", "color": "green"}, {"text": "الواو: حرف عطفٌ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يعلم: فعل مضارع معطوفٌ على فعل مقدر تقديره: لينتقم منهم ويعلم الذين يجادلون، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ نُصِبَ مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يُجَادِلُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي آيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يجادلون", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَحِيصٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلا على أنه مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعلم الذين يجادلون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة صلة الموصول الحرفي المقدرة أي: لـ\"", "color": "black"}, {"text": "أن", "color": "b