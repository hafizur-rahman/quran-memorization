[{"row_id": 1, "segments": [{"text": "سورة الشورى", "color": "black"}, {"text": "{ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "{ حم", "color": "brown"}, {"text": "(  الشورى: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 3, "segments": [{"text": "﴿حم﴾:", "color": "green"}, {"text": "انظر الآية الأولى من سورة البقرة وهو: «", "color": "black"}, {"text": "الم: ابتدأت بعض سور القرآن الكريم ببعض الحروف المقطّعة، وقد اختلف العلماء في تفسيرها وإعرابها اختلافًا كبيرًا.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "وهي تُعرب اسمًا مبنيًّا في محلّ رفع خبر مقدّم لمبتدأ محذوف، تقديره: هي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ويجوز إعراب \"", "color": "black"}, {"text": "الم", "color": "blue"}, {"text": "\" هنا، اسمًا مبنيًّا في محلّ رفع مبتدأ خبره \"", "color": "black"}, {"text": "ذلك", "color": "blue"}, {"text": "\"».", "color": "black"}]}]