[{"row_id": 1, "segments": [{"text": "{ كَذَلِكَ يُوحِي إِلَيْكَ وَإِلَى الَّذِينَ مِنْ قَبْلِكَ اللَّهُ الْعَزِيزُ الْحَكِيمُ", "color": "brown"}, {"text": "(  الشورى: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ في محلّ نصب نعت لمصدر محذوف، تقديره: مثل ذلك الوحي ذا: اسم مبنيّ في محلّ جرّ بالإضافة، و \"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يُوحِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَيْكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بيوحى\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَإِلَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إلى: حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ بـ \"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\"، والجار والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "يوحي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ قَبْلِكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف صلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل \"", "color": "black"}, {"text": "يوحي", "color": "blue"}, {"text": "\" مرفوع وعلامة رفع