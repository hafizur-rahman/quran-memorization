[{"row_id": 1, "segments": [{"text": "{ اللَّهُ الَّذِي أَنْزَلَ الْكِتَابَ بِالْحَقِّ وَالْمِيزَانَ وَمَا يُدْرِيكَ لَعَلَّ السَّاعَةَ قَرِيبٌ", "color": "brown"}, {"text": "(  الشورى: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبني في محلّ رفع خبر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "هو الذي", "color": "blue"}, {"text": "\" في محلّ رفع خبر لفظ الجلالة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْزَلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِالْحَقِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من \"", "color": "black"}, {"text": "الكتاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالْمِيزَانَ﴾:", "color": "green"}, {"text": "الواو: حرف عطفٌ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "الميزان: مثل \"", "color": "black"}, {"text": "الكتاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطفٌ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "ما: اسم استفهام مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يُدْرِيكَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع، وعلامة رفعه الضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستت