[{"row_id": 1, "segments": [{"text": "{ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَهُوَ الْعَلِيُّ الْعَظِيمُ", "color": "brown"}, {"text": "(  الشورى: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ في محلّ رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "{ وَمَا فِي الْأَرْضِ }", "color": "brown"}]}, {"row_id": 6, "segments": [{"text": ": مثل: \"", "color": "black"}, {"text": "له ما في السموات", "color": "blue"}, {"text": "\" ومعطوفة عليها بالواو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "هو: ضمير منفصل مبنيّ في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْعَلِيُّ﴾:", "color": "green"}, {"text": "خبر للمبتدأ \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْعَظِيمُ﴾:", "color": "green"}, {"text": "خبر ثانٍ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "له ما في السموات", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو العلي", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على الاستئنافية.", "color": "black"}]}]