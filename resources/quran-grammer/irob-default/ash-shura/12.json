[{"row_id": 1, "segments": [{"text": "{ لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ", "color": "brown"}, {"text": "(  الشورى: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَهُ مَقَالِيدُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "مقاليد: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الأرض: مثل \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "{ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ }", "color": "brown"}]}, {"row_id": 8, "segments": [{"text": ": تقدم إعرابها في الآية الثانية والستين من سورة العنكبوت\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وهو:«  يَبْسُطُ: فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: الله سبحانه.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الرِّزْقَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لِمَنْ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يَشَاءُ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يبسط", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿م