[{"row_id": 1, "segments": [{"text": "{ وَمَا أَنْتُمْ بِمُعْجِزِينَ فِي الْأَرْضِ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ", "color": "brown"}, {"text": "(  الشورى: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية الكريمة أعربت في الآية الكريمة الثانية والعشرين من سورة \"", "color": "green"}, {"text": "العنكبوت", "color": "green"}, {"text": "\".", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو : « وَمَا: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ما: تعمل عمل \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" عند الحجازيين وهي مهملة عند بني تميم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْتُمْ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على لغة الحجازيين، ومبتدأ على لغة بني تميم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِمُعْجِزِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "معجزين: اسم مجرور لفظًا منصوب محلًا على اللغة الأولى، ومرفوع محلًا على اللغة الثانية.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وعلامة نصبه أو رفعه \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" أو \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\"، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "معجزين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "&", "color": "black"}, {"text": "( ,,,  )", "color": "green"}, {"text": "}", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "