[{"row_id": 1, "segments": [{"text": "{ فَإِنْ أَعْرَضُوا فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا إِنْ عَلَيْكَ إِلَّا الْبَلَاغُ وَإِنَّا إِذَا أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً فَرِحَ بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ الْإِنْسَانَ كَفُورٌ", "color": "brown"}, {"text": "(  الشورى: 48  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَعْرَضُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم وهو فعل الشَّرط في محلّ جزم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشَّرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَرْسَلْنَاكَ﴾:", "color": "green"}, {"text": "أرسل: فعل ماض مبنيّ على السكون لاتصاله بـ\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصل للمخاطب مبنيّ على الفتح في محلّ نُصِبَ مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير الغائبين منبي في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "أرسلناك", "color": "blue"}, {"