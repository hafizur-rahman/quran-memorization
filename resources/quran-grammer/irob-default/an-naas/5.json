[{"row_id": 1, "segments": [{"text": "{ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ", "color": "brown"}, {"text": "(  الناس: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة ثانية لـ\"", "color": "black"}, {"text": "الوسواس", "color": "blue"}, {"text": "\" أو في محلّ رفع خبر مبتدأ محذوف تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أو في محلّ نصب مفعول به لفعل محذوف تقديره: أعني.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يُوَسْوِسُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي صُدُورِ النَّاسِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يوسوس", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الناس: مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}]