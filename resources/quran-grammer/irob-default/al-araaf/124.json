[{"row_id": 1, "segments": [{"text": "{ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُمْ مِنْ خِلَافٍ ثُمَّ لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ", "color": "brown"}, {"text": "(  الأعراف: 124  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَأُقَطِّعَنَّ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب قسم محذوف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أقطعنَّ: فعل مضارع مبنيّ على الفتح، لاتصاله بنون التوكيد الثقيلة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والتقدير: والله لأقطعنَّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة القسم استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "لأقطعنَّ", "color": "blue"}, {"text": "\" جواب القسم لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَيْدِيَكُمْ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَأَرْجُلَكُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "أيديكم", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ خِلَافٍ﴾:", "color": "green"}, {"text": "جار ومجرور في محل نصب حال من الأيدي والأرجل، أي: مختلفات.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَأُصَلِّبَنَّكُمْ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "لأقطعنَّ", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَج