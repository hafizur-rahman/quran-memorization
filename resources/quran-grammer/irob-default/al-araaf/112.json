[{"row_id": 1, "segments": [{"text": "{ يَأْتُوكَ بِكُلِّ سَاحِرٍ عَلِيمٍ", "color": "brown"}, {"text": "(  الأعراف: 112  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَأْتُوكَ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، لأنه جواب الطلب، وعلامة جزمه حذف النون، لأنه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة في محل نصب صفة ثانية للموصوف المقدر في الآية الكريمة السابقة أي \"", "color": "black"}, {"text": "رجالًا حاشرين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِكُلِّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "يأتوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَاحِرٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلِيمٍ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "ساحر", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}]