[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِنَ الْجِنِّ وَالْإِنْسِ لَهُمْ قُلُوبٌ لَا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَا يُبْصِرُونَ بِهَا وَلَهُمْ آذَانٌ لَا يَسْمَعُونَ بِهَا أُولَئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ أُولَئِكَ هُمُ الْغَافِلُونَ", "color": "brown"}, {"text": "(  الأعراف: 179  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اللام: حرف للابتداء والتوكيد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ذَرَأْنَا﴾:", "color": "green"}, {"text": "ذرأ: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِجَهَنَّمَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بذرأنا، وعلامة جر الاسم الفتحة بدلًا من الكسرة لأنّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "ذرأنا", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَثِيرًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنَ الْجِنِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة محذوفة من \"", "color": "black"}, {"text": "كثيرًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَالْإِنْسِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على من الجن\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text