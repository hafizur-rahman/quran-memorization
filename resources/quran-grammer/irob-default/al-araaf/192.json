[{"row_id": 1, "segments": [{"text": "{ وَلَا يَسْتَطِيعُونَ لَهُمْ نَصْرًا وَلَا أَنْفُسَهُمْ يَنْصُرُونَ", "color": "brown"}, {"text": "(  الأعراف: 192  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَسْتَطِيعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يستطيعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَصْرًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لَا: حرف نفي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَنْفُسَهُمْ﴾:", "color": "green"}, {"text": "أنفس: مفعول به مقدم منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَنْصُرُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يستطيعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملتان: \"", "color": "black"}, {"text": "لا يستطيعون", "color": "blue"}, {"text": "\" و \"", "color": "black"}, {"text": "لا أن