[{"row_id": 1, "segments": [{"text": "{ يَابَنِي آدَمَ خُذُوا زِينَتَكُمْ عِنْدَ كُلِّ مَسْجِدٍ وَكُلُوا وَاشْرَبُوا وَلَا تُسْرِفُوا إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ", "color": "brown"}, {"text": "(  الأعراف: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَابَنِي﴾:", "color": "green"}, {"text": "حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "بني: اسم منادي منصوب بالياء، لأنه ملحق بجمع المذكر السالم، وحذفت النون للإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿آدَمَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿خُذُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأنّ مضارعه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿والواو ضمير متّصل مبنيّ في محل رفع فاعل، و\"", "color": "green"}, {"text": "الألف", "color": "green"}, {"text": "\": فارقة.", "color": "green"}]}, {"row_id": 7, "segments": [{"text": "﴿زِينَتَكُمْ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محل جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان متعلق بـ\"", "color": "black"}, {"text": "خذوا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كُلِّ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَسْجِدٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خذوا", "color":