[{"row_id": 1, "segments": [{"text": "{ مَنْ يُضْلِلِ اللَّهُ فَلَا هَادِيَ لَهُ وَيَذَرُهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ", "color": "brown"}, {"text": "(  الأعراف: 186  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السّكون في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يُضْلِلِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه السّكون، وقد حرك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "لَا: حرف نفي للجنس يعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿هَادِيَ﴾:", "color": "green"}, {"text": "اسمها مبنيّ على الفتح في محلّ نصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بالخبر المحذوف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والتقدير: لا هادي كائن له.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فلا هادي له", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط جازم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة الشرط استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَيَذَرُهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "يذر: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، وفاعله ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"