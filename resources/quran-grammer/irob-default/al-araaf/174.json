[{"row_id": 1, "segments": [{"text": "{ وَكَذَلِكَ نُفَصِّلُ الْآيَاتِ وَلَعَلَّهُمْ يَرْجِعُونَ", "color": "brown"}, {"text": "(  الأعراف: 174  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكَذَلِكَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": اسم بمعني \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب مفعول مطلق، والتَّقديرُ: ومثل ذلك التفضيل البليغ نفصل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "الّلام: حرف للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نُفَصِّلُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْآيَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلًا من الفتحة، لأنّه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلَعَلَّهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "لعلّ: حرف توكيد مشبّه بالفعل من أخوات \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السّكون في محلّ نصب اسم \"", "color": "black"}, {"text": "لعلَّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَرْجِعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة في محلّ رفع خبر \"", "color