[{"row_id": 1, "segments": [{"text": "{ وَمِمَّنْ خَلَقْنَا أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ", "color": "brown"}, {"text": "(  الأعراف: 181  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمِمَّنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ممن: مكونة من \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" حرف الجر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السّكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَلَقْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السّكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلقنا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أُمَّةٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة المبتدأ والخبر استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَهْدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجملة في محلّ رفع صفة لأمة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿بِالْحَقّ