[{"row_id": 1, "segments": [{"text": "{ وَإِنْ تَدْعُوهُمْ إِلَى الْهُدَى لَا يَسْمَعُوا وَتَرَاهُمْ يَنْظُرُونَ إِلَيْكَ وَهُمْ لَا يُبْصِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 198  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَدْعُوهُمْ﴾:", "color": "green"}, {"text": "تدعوا: فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النّون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَى الْهُدَى﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تدعوهم", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الكسرة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وهذا القول الكريم مكرر وقد ورد في الآية الكريمة الثالثة والتسعين بعد المائة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَسْمَعُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النّون.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يسمعوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}, {"