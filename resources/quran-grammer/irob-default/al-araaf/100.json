[{"row_id": 1, "segments": [{"text": "{ أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ الْأَرْضَ مِنْ بَعْدِ أَهْلِهَا أَنْ لَوْ نَشَاءُ أَصَبْنَاهُمْ بِذُنُوبِهِمْ وَنَطْبَعُ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ", "color": "brown"}, {"text": "(  الأعراف: 100  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَوَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَهْدِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِلَّذِينَ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجار والمجرور متعلقان بـ\"", "color": "black"}, {"text": "يهد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَرِثُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو ضمير متّصل مبنيّ في محل رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَرْضَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "يرثون", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مِنْ بَعْدِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "يرثون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿أَهْلِهَا﴾:", "color": "green"}, {"text": "أهل: