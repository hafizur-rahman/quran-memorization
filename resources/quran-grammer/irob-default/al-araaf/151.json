[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ اغْفِرْ لِي وَلِأَخِي وَأَدْخِلْنَا فِي رَحْمَتِكَ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ", "color": "brown"}, {"text": "(  الأعراف: 151  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادى بحرف نداء محذوفة تقديرها: يا: منصوب وعلامة نصبه الفتحة المقدرة على آخره منع ظهورها اشتغال المحل بالكسرة التي هي الحركة الدالة على ياء المتكلم المحذوفة للتخفيف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والياء ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اغْفِرْ﴾:", "color": "green"}, {"text": "فعل طلب مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِي﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "اغفر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلِأَخِي﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "أخي: اسم مجرور باللام، وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والياء ضمير متّصل مبنيّ على السكون في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَأَدْخِلْنَا﴾:", "color": "green"}, {"text": "وأدخل: معطوفة بالواو على \"", "color": "black"}, {"text": "اغفر", "color": "blue"}, {"text": "\"، وتعرب إعرابها، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فِي رَحْمَتِكَ﴾:", "color": "green"}, {"text": "في رحمة: جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "أدخلنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الفتح في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَأَنْتَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "أنت: ضمير رفع منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿أَرْحَمُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أنت", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿الرَّاحِمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنت أرحم الراحمين", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]