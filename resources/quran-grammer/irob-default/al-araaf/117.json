[{"row_id": 1, "segments": [{"text": "{ وَأَوْحَيْنَا إِلَى مُوسَى أَنْ أَلْقِ عَصَاكَ فَإِذَا هِيَ تَلْقَفُ مَا يَأْفِكُونَ", "color": "brown"}, {"text": "(  الأعراف: 117  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَوْحَيْنَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أوحينا: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَى﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "اسم مجرور بـ\"", "color": "black"}, {"text": "إلى", "color": "blue"}, {"text": "\"، وعلامة جره الفتحة المقدرة على الألف للتعذّر، بدلًا من الكسرة لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجارّ والمجرور متعلقان بـ\"", "color": "black"}, {"text": "أوحى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أوحينا", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف تفسير لا عمل له.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَلْقِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف حرف العلة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿عَصَاكَ﴾:", "color": "green"}, {"text": "عصا: مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على الفتح في محل جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ألق", "color": "blue"}, {"text": "\"