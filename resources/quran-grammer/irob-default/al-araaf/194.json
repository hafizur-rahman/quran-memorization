[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ عِبَادٌ أَمْثَالُكُمْ فَادْعُوهُمْ فَلْيَسْتَجِيبُوا لَكُمْ إِنْ كُنْتُمْ صَادِقِينَ", "color": "brown"}, {"text": "(  الأعراف: 194  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَدْعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "تدعون", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب، وجملة \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" واسمها و خبرها استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ دُونِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عِبَادٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَمْثَالُكُمْ﴾:", "color": "green"}, {"text": "أمثال: صفة لعباد أو بدل منها مرفوعة بالضمّة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فَادْعُوهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ادعوا: فعل أمر مبنيّ على حذف النّون، لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿فَلْيَسْتَجِيبُوا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب شرط جازم متقدم عليه.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "الّلام: لام الأمر الجازمة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "يستجيبوا: فعل مضارع مجزوم بلام الأمر، وعلامة جزمه حذف النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ\"", "color": "black"}, {"text": "يستجيبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على السّكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "و\"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿صَادِقِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجواب الشرط محذوف لتقدم معناه، والتقدير: إن كنتم صادقين بأنهم آلهة، فليستجيبوا لكم.", "color": "black"}]}]