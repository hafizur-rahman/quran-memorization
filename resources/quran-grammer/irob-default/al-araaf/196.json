[{"row_id": 1, "segments": [{"text": "{ إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ", "color": "brown"}, {"text": "(  الأعراف: 196  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿وَلِيِّيَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" منصوب بالفتحة، والياء: ضمير مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وحرك بالفتح لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ رفع صفة للفظ الجلالة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نَزَّلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْكِتَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "نزل الكتاب", "color": "blue"}, {"text": "\" صلة الموصول.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" واسمها وخبرها استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "هُوَ: ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يَتَوَلَّى﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمّة المقدّرة على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الصَّالِحِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "يتولى الصالحين", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هو يتولى الصالحين", "color": "blue"}, {"text": "\" معطوفة على الجملة قبلها لا محلّ لها من الإعراب.", "color": "black"}]}]