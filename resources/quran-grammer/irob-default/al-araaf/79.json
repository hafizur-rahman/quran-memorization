[{"row_id": 1, "segments": [{"text": "{ فَتَوَلَّى عَنْهُمْ وَقَالَ يَاقَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَالَةَ رَبِّي وَنَصَحْتُ لَكُمْ وَلَكِنْ لَا تُحِبُّونَ النَّاصِحِينَ", "color": "brown"}, {"text": "(  الأعراف: 79  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَتَوَلَّى﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تولي: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَنْهُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تولي", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "عن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "وقال: معطوفة بالواو على \"", "color": "black"}, {"text": "تولي", "color": "blue"}, {"text": "\"، وتعرب إعرابها، والفعل مبنيّ على الفتح الظاهر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَاقَوْمِ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "قوم: منادي مضاف منصوب بالفتحة المقدرة على ما قبل ياء المتكلم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وياء المتكلم ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة النداء في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَقَدْ﴾:", "color": "green"}, {"text": "اللام: حرف للابتداء والتوكيد.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَبْلَغْتُكُمْ﴾:", "color": "green"}, {"text": "أبلغت: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، والتاء: ضمير متّصل مبنيّ على الضم في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿رِسَالَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿رَبِّي﴾:", "color": "green"}, {"text": "ربّ: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، والياء: ضمير متّصل مبنيّ في محلّ جرّ مضاف إليه ثانٍ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿وَنَصَحْتُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "أبلغت", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نصحت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿وَلَكِنْ﴾:", "color": "green"}, {"text": "الواو: زائدة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "لكن: حرف استدراك لا عمل له.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿تُحِبُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "﴿النَّاصِحِينَ ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء؛ لأنه جمع مذكر سالم.", "color": "black"}]}]