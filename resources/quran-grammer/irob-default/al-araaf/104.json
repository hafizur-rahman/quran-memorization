[{"row_id": 1, "segments": [{"text": "{ وَقَالَ مُوسَى يَافِرْعَوْنُ إِنِّي رَسُولٌ مِنْ رَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  الأعراف: 104  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قال: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَافِرْعَوْنُ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "فرعون: منادي مبنيّ على الضم في محل نصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة النداء في محل نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "إنّ: حرف نصب مشبّه بالفعل، والياء ضمير متّصل مبنيّ على السكون في محل نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿رَسُولٌ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنْ رَبِّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بصفة محذوفة من \"", "color": "black"}, {"text": "رسول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إني رسول من رب العالمين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب النداء.", "color": "black"}]}]