[{"row_id": 1, "segments": [{"text": "{ قَالَ أَنْظِرْنِي إِلَى يَوْمِ يُبْعَثُونَ", "color": "brown"}, {"text": "(  الأعراف: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنْظِرْنِي﴾:", "color": "green"}, {"text": "فعل طلب والتماس مبنيّ على السكون، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "النون: نون الوقاية، والياء: ضمير متّصل مبنيّ على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِلَى يَوْمِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أنظرني", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "يوم", "color": "blue"}, {"text": "\" مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُبْعَثُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول مرفوع بثبوت النون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محل رفع نائب فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنظرني", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يبعثون", "color": "blue"}, {"text": "\" في محل جر بالإضافة.", "color": "black"}]}]