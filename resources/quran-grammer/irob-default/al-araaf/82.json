[{"row_id": 1, "segments": [{"text": "{ وَمَا كَانَ جَوَابَ قَوْمِهِ إِلَّا أَنْ قَالُوا أَخْرِجُوهُمْ مِنْ قَرْيَتِكُمْ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ", "color": "brown"}, {"text": "(  الأعراف: 82  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَوَابَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَوْمِهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، والهاء: ضمير متّصل مبنيّ على الكسر في محلّ جرّ مضاف إليه ثانٍ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل لها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة، و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما تلاها بتأويل مصدر في محلّ نصب خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، والتقدير: إلا قولهم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَخْرِجُوهُمْ﴾:", "color": "green"}, {"text": "أخرجوا: فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السكون ف