[{"row_id": 1, "segments": [{"text": "{ وَالْوَزْنُ يَوْمَئِذٍ الْحَقُّ فَمَنْ ثَقُلَتْ مَوَازِينُهُ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ", "color": "brown"}, {"text": "(  الأعراف: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالْوَزْنُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الوزن: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة، وهو مضاف متعلق بخبر المبتدأ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "إذ: اسم مبنيّ على السكون وقد حرّك بالكسر تخلصًا من التقاء الساكنين في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْحَقُّ﴾:", "color": "green"}, {"text": "صفة للوزن مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَمَنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ثَقُلَتْ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح في محل جزم بمن والتاء: تاء التأنيث الساكنة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَوَازِينُهُ}", "color": "green"}]}, {"row_id": 11, "segments": [{"text": "﴾: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والهاء: ضمير متّصل مبنيّ في محل جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿فَأُولَئِكَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "أولاء: اسم إشارة مبنيّ على الكسر في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "blac