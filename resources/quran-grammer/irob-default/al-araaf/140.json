[{"row_id": 1, "segments": [{"text": "{ قَالَ أَغَيْرَ اللَّهِ أَبْغِيكُمْ إِلَهًا وَهُوَ فَضَّلَكُمْ عَلَى الْعَالَمِينَ", "color": "brown"}, {"text": "(  الأعراف: 140  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والجملة استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَغَيْرَ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "غير: مفعول به لفعل محذوف يفسره المذكور منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَبْغِيكُمْ﴾:", "color": "green"}, {"text": "أبغي: فعل مضارع مرفوع بالضمة المقدرة على الياء للثقل، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَهًا﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجملة من الفعل المحذوف في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أبغيكم", "color": "blue"}, {"text": "\" تفسيرية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَهُوَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "هو: ضمير رفع منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]