[{"row_id": 1, "segments": [{"text": "{ وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ", "color": "brown"}, {"text": "(  الأعراف: 154  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَمَّا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لمّا: اسم شرط غير جازم مبنيّ على السكون في محلّ نصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "متعلّق بالجواب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَكَتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَنْ مُوسَى﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "سكت", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الفتحة المقدّرة على الألف للتعذّر بدلًا من الكسرة، لأنّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْغَضَبُ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمّة، وجملة \"", "color": "black"}, {"text": "سكت الغضب", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَخَذَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْأَلْوَاحَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أخذ الألواح", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَفِي نُسْخَتِهَا﴾:", "color": "green"}, {"text": "الواو: حالية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "في نسخة: جارّ ومجرور متعلّقان بخبر مقدم، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿هُدًى﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع بالضمّة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَرَحْمَةٌ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "هدي", "color": "blue"}, {"text": "\" مرفوعة، وعلامة رفعها الضمة الظّاهرة في آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "في نسختها هدى ورحمة", "color": "blue"}, {"text": "\" في محلّ نُصِبَ حال.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿لِلَّذِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بهدي.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿لِرَبِّهِمْ﴾:", "color": "green"}, {"text": "الّلام: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "رب: اسم مجرور لفظًا منصوب محلًا على أنه مفعول به لفعل محذوف يفسره المذكور.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿يَرْهَبُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "يرهبون ربهم", "color": "blue"}, {"text": "\" في محلّ رفع خبر المبتدأ \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "والجملة الاسمية: \"", "color": "black"}, {"text": "هم لربهم يرهبون", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}]