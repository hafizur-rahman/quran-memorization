[{"row_id": 1, "segments": [{"text": "{ قَالَ فَبِمَا أَغْوَيْتَنِي لَأَقْعُدَنَّ لَهُمْ صِرَاطَكَ الْمُسْتَقِيمَ", "color": "brown"}, {"text": "(  الأعراف: 16  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح، والفاعل: ضمير مستتر فيه جوازًا تقديره:\nفَبِمَا: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ما: حرف مصدريّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَغْوَيْتَنِي﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، والتاء: ضمير متّصل مبنيّ على الفتح في محل رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والنون: حرف للوقاية.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والياء: ضمير متّصل مبنيّ على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَأَقْعُدَنَّ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب القسم المحذوف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "أقعدن: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة، والفاعل: ضمير مستتر فيه وجوبًا تقديره: \"", "color": "black"}, {"text": "أنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محل جرّ بالباء بتقدير فبإغوائك إياي، أو بسبب إغوائك إيايّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجار والمجرور متعلقان بفعل القسم المحذوف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أقعدن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿صِرَاطَكَ﴾:", "color": "green"}, {"text": "مفعول به للفعل \"", "color": "black"}, {"text": "أقعدن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "منصوب بالفتحة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْمُسْتَقِيمَ﴾:", "color": "green"}, {"text": "صفة للصراط منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة القسم في محل نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لأقعدنّ", "color": "blue"}, {"text": "\" لا محل لها من الإعراب لأنها جواب القسم.", "color": "black"}]}]