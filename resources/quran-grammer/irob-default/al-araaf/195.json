[{"row_id": 1, "segments": [{"text": "{ أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَا أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَا أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَا أَمْ لَهُمْ آذَانٌ يَسْمَعُونَ بِهَا قُلِ ادْعُوا شُرَكَاءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنْظِرُونِ", "color": "brown"}, {"text": "(  الأعراف: 195  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَلَهُمْ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لهم: الّلام: حرف جرّ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَرْجُلٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَمْشُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يمشون", "color": "blue"}, {"text": "\" وجملة \"", "color": "black"}, {"text": "يمشون بها في محلّ رفع نعت لـ", "color": "blue"}, {"text": "\"أرجل\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَا أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَا أَمْ لَهُمْ آذَانٌ يَسْمَعُونَ بِهَا﴾:", "color": "green"}, {"text": "الجمل معطوفة بحرف العطف \"", "color": "black"}, {"text": "أم", "color": "blue"}, {"text": "\" على جملة \"", "color": "black"}, {"text": "ألهم أرجل يمشون بها", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿قُلِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السّكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ادْعُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النّون، لأن مضارعه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿شُرَكَاءَكُمْ﴾:", "color": "green"}, {"text": "شركاء: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ادعوا", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿كِيدُونِ﴾:", "color": "green"}, {"text": "كيدوا: معطوفة على \"", "color": "black"}, {"text": "ادعوا", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "والنون: حرف للوقاية.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "والياء المحذوفة: ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "لَا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "﴿تُنْظِرُونِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم باللام، وعلامة جزمه حذف النّون، والنون الثانية حرف للوقاية، والياء المحذوفة ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 24, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]