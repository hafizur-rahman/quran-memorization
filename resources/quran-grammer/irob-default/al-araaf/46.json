[{"row_id": 1, "segments": [{"text": "{ وَبَيْنَهُمَا حِجَابٌ وَعَلَى الْأَعْرَافِ رِجَالٌ يَعْرِفُونَ كُلًّا بِسِيمَاهُمْ وَنَادَوْا أَصْحَابَ الْجَنَّةِ أَنْ سَلَامٌ عَلَيْكُمْ لَمْ يَدْخُلُوهَا وَهُمْ يَطْمَعُونَ", "color": "brown"}, {"text": "(  الأعراف: 46  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَبَيْنَهُمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "بين: ظرف مكان منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والهاء: ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وشبه الجملة بينهما متعلق بخبر مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿حِجَابٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَعَلَى الْأَعْرَافِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "على الأعراف: جار ومجرور متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رِجَالٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَعْرِفُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كُلًّا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِسِيمَاهُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "يعرفون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَنَادَوْا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 14, "segments": [{"tex