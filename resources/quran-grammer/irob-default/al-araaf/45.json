[{"row_id": 1, "segments": [{"text": "{ الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُمْ بِالْآخِرَةِ كَافِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة للموصوف \"", "color": "black"}, {"text": "الظالمين", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة السابقة أو بدل منه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَصُدُّونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون لأنه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، والجملة الفعلية \"", "color": "black"}, {"text": "يصدون", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَنْ سَبِيلِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "يصدون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور بالإضافة، وعلامة جرّه الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَيَبْغُونَهَا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "يصدون", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عِوَجًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير منفصل مبنيّ على السكون في م