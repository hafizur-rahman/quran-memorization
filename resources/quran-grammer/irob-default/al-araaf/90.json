[{"row_id": 1, "segments": [{"text": "{ وَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ لَئِنِ اتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَخَاسِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 90  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَقَالَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "قال: فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمَلَأُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محل رفع صفة للملأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ قَوْمِهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\"، والهاء: ضمير متّصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كفروا", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَئِنِ﴾:", "color": "green"}, {"text": "اللام: حرف موطئ للقسم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "إنْ: حرف شرط جازم مبنيّ على السكون، وقد حرّك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿اتَّبَعْتُمْ﴾:", "color": "green"}, {"text": "اتبع: فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك في محل جزم بـ\"", "color": "black"}, {"text": "إنْ", "color": "blue"}, {"text": "\" و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محل رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿شُعَيْبًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنْ اتبعتم", "color": "blue"}, {"text": "\" اعتراضية بين القسم المحذوف وجواب الشرط لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿إِنَّكُمْ﴾:", "color": "green"}, {"text": "إنّ حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محل نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿إِذًا﴾:", "color": "green"}, {"text": "حرف جواب لا عمل له.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿لَخَاسِرُونَ﴾:", "color": "green"}, {"text": "اللام: مزحلقة حرف توكيد.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "خاسرون: خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "و \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" مع اسمها و خبرها سدّت مسدّ جوابي القسم والشرط.", "color": "black"}]}]