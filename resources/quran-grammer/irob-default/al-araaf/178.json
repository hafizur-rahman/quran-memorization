[{"row_id": 1, "segments": [{"text": "{ مَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِي وَمَنْ يُضْلِلْ فَأُولَئِكَ هُمُ الْخَاسِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 178  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السّكون في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَهْدِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَهُوَ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "هُوَ: ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُهْتَدِي﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\": مرفوع بالضمّة المقدّرة على الياء للثقل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فهو المهتدي", "color": "blue"}, {"text": "\" جواب الشرط في محلّ جزم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة فعل الشرط وجوابه استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَنْ يُضْلِلْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "من يهد الله", "color": "blue"}, {"text": "\"، وتعرب إعرابها، وعلامة جزم الفعل السّكون، وفاعله ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَأُولَئِكَ﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشرط.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "أولاء: اسم إشارة مبنيّ على الكسر في محلّ رفع مبتدأ، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿هُمُ﴾:", "color": "green"}, {"text": "ضمير فصل لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْخَاسِرُونَ﴾:", "color": "green"}, {"text": "خبر مرفوع بالواو، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد رفع خبر المبتدأ \"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\" ويجوز إعراب \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير فصل أو حرف عماد لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "و\"", "color": "black"}, {"text": "الخاسرون", "color": "blue"}, {"text": "\" خبر \"", "color": "black"}, {"text": "أولئك", "color": "blue"}, {"text": "\" والجملة الاسمية \"", "color": "black"}, {"text": "فأولئك هم الخاسرون", "color": "blue"}, {"text": "\" في محلّ جزم جواب الشرط.", "color": "black"}]}]