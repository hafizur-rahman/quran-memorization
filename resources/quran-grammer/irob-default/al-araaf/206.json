[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ عِنْدَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ", "color": "brown"}, {"text": "(  الأعراف: 206  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف نصب وتوكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "رب: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وشبه الجملة \"", "color": "black"}, {"text": "عند ربك", "color": "blue"}, {"text": "\" متعلّق بصلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والتقدير: هم مستقرون.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة المقدّرة صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَسْتَكْبِرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿عَنْ عِبَادَتِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يستكبرون", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يستكبرون", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" واسمها وخبرها استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَيُسَبِّحُونَهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف، يسبحونه: فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، والهاء: ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿وَلَهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "له: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يسجدون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿يَسْجُدُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يسبحون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "يسجدون", "color": "blue"}, {"text": "\" معطوفة على الجملة الاستئنافية \"", "color": "black"}, {"text": "يسبحونه", "color": "blue"}, {"text": "\"، وكلاهما لا محلّ له من الإعراب.", "color": "black"}]}]