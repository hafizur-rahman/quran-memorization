[{"row_id": 1, "segments": [{"text": "{ أَوَلَمْ يَتَفَكَّرُوا مَا بِصَاحِبِهِمْ مِنْ جِنَّةٍ إِنْ هُوَ إِلَّا نَذِيرٌ مُبِينٌ", "color": "brown"}, {"text": "(  الأعراف: 184  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَوَلَمْ﴾:", "color": "green"}, {"text": "أو: الهمزة: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والواو: زائدة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لَمْ: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَتَفَكَّرُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ جرّ بحرف الجر محذوف، والتقدير: أولم يتأملوا في الذي.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِصَاحِبِهِمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السّكون في محلّ جرّ بالإضافة متعلّقان بصلة الموصول المحذوفة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ جِنَّةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف نفي لا عمل لها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text