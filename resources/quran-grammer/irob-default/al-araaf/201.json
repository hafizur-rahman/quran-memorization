[{"row_id": 1, "segments": [{"text": "{ إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 201  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اتَّقَوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم المقدّر للتعذّر على الألف المحذوفة لالتقاء الساكنين، ولاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة: والجملة من فعل الشرط وجوابه في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" واسمها و خبرها استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف زمان مبنيّ على السّكون في محلّ نصب خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَسَّهُمْ﴾:", "color": "green"}, {"text": "مس: فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿طَائِفٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمّة، وجملة \"", "color": "black"}, {"text": "مسهم طائف", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنَ الشَّيْطَانِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة من \"", "color": "black"}, {"text": "طائف", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تَذَكَّرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "تذكروا", "color": "blue"}, {"text": "\" جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿فَإِذَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "إذا: حرف فجاءة \"", "color": "black"}, {"text": "فجائية", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب لا عمل لها.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿مُبْصِرُونَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هم مبصرون", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}]