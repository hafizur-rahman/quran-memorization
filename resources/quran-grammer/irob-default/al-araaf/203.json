[{"row_id": 1, "segments": [{"text": "{ وَإِذَا لَمْ تَأْتِهِمْ بِآيَةٍ قَالُوا لَوْلَا اجْتَبَيْتَهَا قُلْ إِنَّمَا أَتَّبِعُ مَا يُوحَى إِلَيَّ مِنْ رَبِّي هَذَا بَصَائِرُ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ لِقَوْمٍ يُؤْمِنُونَ", "color": "brown"}, {"text": "(  الأعراف: 203  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف زمان مبنيّ على السّكون خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف جزم ونفي وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تَأْتِهِمْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لم تأتهم", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِآيَةٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ\"", "color": "black"}, {"text": "تأتهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والجملة جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَوْلَا﴾:", "col