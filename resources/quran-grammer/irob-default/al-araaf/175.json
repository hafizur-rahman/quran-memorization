[{"row_id": 1, "segments": [{"text": "{ وَاتْلُ عَلَيْهِمْ نَبَأَ الَّذِي آتَيْنَاهُ آيَاتِنَا فَانْسَلَخَ مِنْهَا فَأَتْبَعَهُ الشَّيْطَانُ فَكَانَ مِنَ الْغَاوِينَ", "color": "brown"}, {"text": "(  الأعراف: 175  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاتْلُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اتل: فعل أمر مبنيّ على حذف - حرف العلة - والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَلَيْهِمْ﴾:", "color": "green"}, {"text": "على: حرف جرّ، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بـ\"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "اتل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿نَبَأَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿آتَيْنَاهُ﴾:", "color": "green"}, {"text": "آتي: فعل ماضٍ مبنيّ على السّكون، لاتصاله بضمير رفع متحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل، والهاء: ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿آيَاتِنَا﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلًا من الفتحة لأنّه جمع مؤنث، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فَانْسَلَخَ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "انسلخ: فعل ماضٍ مبنيّ على الفتح والفاعل: ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مِنْهَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "انسلخ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملة استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿فَأَتْبَعَهُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطفٌ.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "أتبع: فعل ماضٍ مبنيّ على الفتح، والهاء: ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الشَّيْطَانُ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمّة وجملة \"", "color": "black"}, {"text": "اتبعه الشيطان", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "انسلخ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿فَكَانَ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "كان: فعل ماضٍ ناقص، واسمها ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿مِنَ الْغَاوِينَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم الياء، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فكان من الغاوين", "color": "blue"}, {"text": "\"معطوفة على جملة \"", "color": "black"}, {"text": "انسلخ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]