[{"row_id": 1, "segments": [{"text": "{ وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ", "color": "brown"}, {"text": "(  الأعراف: 204  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قُرِئَ﴾:", "color": "green"}, {"text": "فعل ماض للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقُرْآنُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قرئ القرآن", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَاسْتَمِعُوا﴾:", "color": "green"}, {"text": "الفاء: حرف واقع في جواب الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "استمعوا: فعل أمر مبنيّ على حذف النّون، لأن مضارعه من الأفعال الخمسة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "استمعوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجملة جواب شرط غير جازم لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَأَنْصِتُوا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "استمعوا", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "