[{"row_id": 1, "segments": [{"text": "{ فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ", "color": "brown"}, {"text": "(  الأعراف: 78  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَخَذَتْهُمُ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أخذت: فعل ماضٍ مبنيّ على الفتح، والتاء: حرف للتأنيث الساكنة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين مبنيّ على السكون في محلّ نصب مفعول به مقدم وحركت الميم بالضم للإشباع.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الرَّجْفَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أخذتهم", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فَأَصْبَحُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "أصبحوا: فعل ماضٍ ناقص مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "أصبح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿فِي دَارِهِمْ﴾:", "color": "green"}, {"text": "في دار: جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "جاثمين", "color": "blue"}, {"text": "\" و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿جَاثِمِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أصبح", "color": "blue"}, {"text": "\" منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_i