[{"row_id": 1, "segments": [{"text": "{ وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا وَادْعُوهُ خَوْفًا وَطَمَعًا إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ", "color": "brown"}, {"text": "(  الأعراف: 56  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُفْسِدُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "تفسدوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَعَدَ﴾:", "color": "green"}, {"text": "بعد ظرف مكان متعلق بـ \"", "color": "black"}, {"text": "لا تفسدوا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِصْلَاحِهَا﴾:", "color": "green"}, {"text": "إصلاح: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَادْعُوهُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ادعوا: فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محل رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والهاء: ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿خَوْفًا﴾:", "color": "green"}, {"t