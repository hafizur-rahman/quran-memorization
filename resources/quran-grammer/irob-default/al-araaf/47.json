[{"row_id": 1, "segments": [{"text": "{ وَإِذَا صُرِفَتْ أَبْصَارُهُمْ تِلْقَاءَ أَصْحَابِ النَّارِ قَالُوا رَبَّنَا لَا تَجْعَلْنَا مَعَ الْقَوْمِ الظَّالِمِينَ", "color": "brown"}, {"text": "(  الأعراف: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿صُرِفَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، والتاء: تاء التأنيث الساكنة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَبْصَارُهُمْ﴾:", "color": "green"}, {"text": "أبصار: نائب فاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تِلْقَاءَ﴾:", "color": "green"}, {"text": "اسم منصوب على الظرفية المكانية بالفتحة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "ويجوز أن تكون حالًا على المعنى، أي: تجاههم أو مستقبلين لهم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَصْحَابِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿النَّارِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماع، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَبَّنَا﴾:", "color": "green"}, {"text": "منادي بحرف نداء محذوفة تقديرها: يا.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "منصو