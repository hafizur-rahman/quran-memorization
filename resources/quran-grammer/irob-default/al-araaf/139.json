[{"row_id": 1, "segments": [{"text": "{ إِنَّ هَؤُلَاءِ مُتَبَّرٌ مَا هُمْ فِيهِ وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ", "color": "brown"}, {"text": "(  الأعراف: 139  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿هَؤُلَاءِ﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على الكسر في محل نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُتَبَّرٌ﴾:", "color": "green"}, {"text": "خبر مقدم مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محل رفع مبتدأ مؤخر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هُمْ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على السكون في محل رفع مبتدأ ثانٍ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِيهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة الاسمية \"", "color": "black"}, {"text": "هم فيه", "color": "blue"}, {"text": "\" صلة الموصول لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "متبر ما هم فيه", "color": "blue"}, {"text": "\" في محلّ رفع خبر \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\" واسمها وخبرها استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَبَاطِلٌ مَا﴾:", "color": "green"}, {"text": "بمعنى \"", "color": "black"}, {"text": "ومضمحل", "color": "blue"}, {"text": "\"، وهي معطوفة ب