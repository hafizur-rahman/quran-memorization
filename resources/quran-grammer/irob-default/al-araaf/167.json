[{"row_id": 1, "segments": [{"text": "{ وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَى يَوْمِ الْقِيَامَةِ مَنْ يَسُومُهُمْ سُوءَ الْعَذَابِ إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ", "color": "brown"}, {"text": "(  الأعراف: 167  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم مبنيّ على السّكون في محل نصب مفعول به لفعل مضمرٌ تقديره: اذكر، وهو مضافٌ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَأَذَّنَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "رب: فاعل مرفوع بالضمّة، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تأذن ربك", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَيَبْعَثَنَّ﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب القسم المقدّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "يبعثن: فعل مضارع مبنيّ على الفتح، لاتصاله بنون التوكيد الثقيلة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَيْهِمُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يبعث", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَى يَوْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يبعث", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْقِيَامَةِ﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور بالكسرة.", "color": "black"}]}, {"row_id": 12, "segmen