[{"row_id": 1, "segments": [{"text": "{ ثُمَّ لَآتِيَنَّهُمْ مِنْ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْمَانِهِمْ وَعَنْ شَمَائِلِهِمْ وَلَا تَجِدُ أَكْثَرَهُمْ شَاكِرِينَ", "color": "brown"}, {"text": "(  الأعراف: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿ثُمَّ لَآتِيَنَّهُمْ﴾:", "color": "green"}, {"text": "معطوفة بـ \"", "color": "black"}, {"text": "ثم", "color": "blue"}, {"text": "\" على \"", "color": "black"}, {"text": "لأقعدن", "color": "blue"}, {"text": "\" الواردة في الآية الكريمة السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "لَأَقْعُدَنَّ: اللام: واقعة في جواب القسم المحذوف.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "أقعدن: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة، والفاعل: ضمير مستتر فيه وجوبًا تقديره: \"", "color": "black"}, {"text": "أنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محل جرّ بالباء بتقدير فبإغوائك إياي، أو بسبب إغوائك إيايّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجار والمجرور متعلقان بفعل القسم المحذوف».", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ بَيْنِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "آتينهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَيْدِيهِمْ﴾:", "color": "green"}, {"text": "أيدي: مضاف إليه مجرور بالكسرة المقدرة على الياء للثقل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمِنْ خَلْفِهِمْ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "من بين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير مبنيّ على السكون في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَعَنْ أَيْمَانِهِمْ وَعَنْ شَمَائِلِهِمْ﴾:", "color": "green"}, {"text": "معطوفتان بواوي عطف وتعربان إعراب \"", "color": "black"}, {"text": "من خلفهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿تَجِدُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿أَكْثَرَهُمْ شَاكِرِينَ﴾:", "color": "green"}, {"text": "مفعولان للفعل \"", "color": "black"}, {"text": "تجد", "color": "blue"}, {"text": "\": الأول منصوب بالفتحة، والثاني منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "أكثرهم", "color": "blue"}, {"text": "\" ضمير الغائبين مبنيّ على السكون في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لآتينهم", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "أقعدنّ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تجد", "color": "blue"}, {"text": "\" استئنافية لا محل لها من الإعراب.", "color": "black"}]}]