[{"row_id": 1, "segments": [{"text": "{ أَفَأَمِنُوا مَكْرَ اللَّهِ فَلَا يَأْمَنُ مَكْرَ اللَّهِ إِلَّا الْقَوْمُ الْخَاسِرُونَ", "color": "brown"}, {"text": "(  الأعراف: 99  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَفَأَمِنُوا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أمنوا: فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَكْرَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَأْمَنُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مَكْرَ اللَّهِ﴾:", "color": "green"}, {"text": "تقدّم إعرابها.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْقَوْمُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْخَاسِرُونَ﴾:", "color": "green"}, {"text": "صفة للقوم مرفوعة مثله، وعلامة رفعها الواو، لأنها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يأمن مكر الله", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]