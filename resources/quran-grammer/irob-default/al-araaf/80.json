[{"row_id": 1, "segments": [{"text": "{ وَلُوطًا إِذْ قَالَ لِقَوْمِهِ أَتَأْتُونَ الْفَاحِشَةَ مَا سَبَقَكُمْ بِهَا مِنْ أَحَدٍ مِنَ الْعَالَمِينَ", "color": "brown"}, {"text": "(  الأعراف: 80  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "{ وَلُوطًا إ }", "color": "brown"}]}, {"row_id": 3, "segments": [{"text": ": الواو: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لوط: مفعول به لفعل \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\" أو \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\" لوطًا.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف زمان متعلق بـ \"", "color": "black"}, {"text": "أرسلنا", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال لقومه", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِقَوْمِهِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَتَأْتُونَ﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "تأتون: فعل مضارع مرفوع بثبوت النون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْفَاحِشَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿سَبَقَكُمْ﴾:", "color": "green"}, {"text": "سبق: فعل ماضٍ مبنيّ على الفتح، \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بِهَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "سبقكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف زائد لتوكيد النفي والاستغراق.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿أَحَدٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا على أنه فاعل.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جرّه الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما سبقكم", "color": "blue"}, {"text": "\" في محلّ نصب حال، أو استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]