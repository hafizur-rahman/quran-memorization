[{"row_id": 1, "segments": [{"text": "{ وَمِنْ قَوْمِ مُوسَى أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ", "color": "brown"}, {"text": "(  الأعراف: 159  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمِنْ قَوْمِ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من قوم: جارّ ومجرور متعلّقان بخبر مقدّم محذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مضافٌ إليه مجرور، وعلامة جره الفتحة المقدّرة على الألف للتعذّر بدلًا من الكسرة، لأنّه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أُمَّةٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَهْدُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النّون، والواو ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يهدون", "color": "blue"}, {"text": "\" في محلّ رفع صفة لأمة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِالْحَقِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة مصدر محذوف والتقدير: هداية ملتبسة\nبالحق.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة المبتدأ والخبر استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَبِهِ﴾:", "color": "green"}, {"text": "الواو: حرف عطفٌ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "به: جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يعدلون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَعْدِلُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يهدون", "color": "blue"}, {"text": "\"، ومعطوفة عليها.", "color": "black"}]}]