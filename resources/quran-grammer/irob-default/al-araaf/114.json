[{"row_id": 1, "segments": [{"text": "{ قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ الْمُقَرَّبِينَ", "color": "brown"}, {"text": "(  الأعراف: 114  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿نَعَمْ﴾:", "color": "green"}, {"text": "حرف جواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَإِنَّكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إنّ: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محل نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَمِنَ﴾:", "color": "green"}, {"text": "اللام: حرف توكيد و \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُقَرَّبِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بمن، وعلامة جرّه الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" وجملة \"", "color": "black"}, {"text": "وإنكم لمن المقربين", "color": "blue"}, {"text": "\" معطوفة على محذوف سدّ مسدّ حرف الإيجاب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والتقدير: نعم إن لكم أجرًا، وإنكم لمن المقربين.", "color": "black"}]}]