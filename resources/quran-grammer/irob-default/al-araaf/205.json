[{"row_id": 1, "segments": [{"text": "{ وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُنْ مِنَ الْغَافِلِينَ", "color": "brown"}, {"text": "(  الأعراف: 205  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَاذْكُرْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اذكر: فعل أمر مبنيّ على السّكون، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبَّكَ﴾:", "color": "green"}, {"text": "رب: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي نَفْسِكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اذكر", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَضَرُّعًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَخِيفَةً﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "تضرعًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَدُونَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "دون: ظرف مكان متعلّق بـ\"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\"، أو بحال مقدر منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ا