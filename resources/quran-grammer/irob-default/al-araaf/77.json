[{"row_id": 1, "segments": [{"text": "{ فَعَقَرُوا النَّاقَةَ وَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا يَاصَالِحُ ائْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الْمُرْسَلِينَ", "color": "brown"}, {"text": "(  الأعراف: 77  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَعَقَرُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "عقروا: فعل ماضٍ مبنيّ على الضم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّاقَةَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَعَتَوْا﴾:", "color": "green"}, {"text": "وعتوا وقالوا: معطوفتان بواوي العطف على \"", "color": "black"}, {"text": "عقروا", "color": "blue"}, {"text": "\"، وتعربان إعرابها، والفاعل \"", "color": "black"}, {"text": "عتا", "color": "blue"}, {"text": "\": مبنيّ على الضم المقدر على الألف المحذوفة لالتقاء الساكنين، ولاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَنْ أَمْرِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "عتوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "رب: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ على السكون في محلّ جرّ مضاف إليه ثانٍ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَقَالُوا﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "عقروا", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَاصَالِحُ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "صالح: منادي مبنيّ على الضم في محلّ نصب.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿ائْتِنَا﴾:", "color": "green"}, {"text": "ائتِ: فعل أمر مبنيّ على حذف حرف العلة وفاعله ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجملة في محلّ نصب مفعول به لـ \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "ائتنا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول مبنيّ على السكون في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿تَعِدُنَا﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به، وجملة \"", "color": "black"}, {"text": "تعدنا", "color": "blue"}, {"text": "\" صلة الموصول لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿كُنْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك في محلّ جزم لأنه فعل الشرط، والتاء: ضمير متّصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿مِنَ الْمُرْسَلِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، وعلامة جر الاسم الياء، لأنه