[{"row_id": 1, "segments": [{"text": "{ سَاءَ مَثَلًا الْقَوْمُ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَأَنْفُسَهُمْ كَانُوا يَظْلِمُونَ", "color": "brown"}, {"text": "(  الأعراف: 177  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، لإنشاء الذم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وفاعل \"", "color": "black"}, {"text": "ساء", "color": "blue"}, {"text": "\" محذوف تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَثَلًا﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقَوْمُ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمّة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الفعلية في محلّ رفع خبر مقدم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة المبتدأ والخبر استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "القوم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَذَّبُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِآيَاتِنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "كذبوا", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كذبوا بآيا