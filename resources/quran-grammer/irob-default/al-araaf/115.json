[{"row_id": 1, "segments": [{"text": "{ قَالُوا يَامُوسَى إِمَّا أَنْ تُلْقِيَ وَإِمَّا أَنْ نَكُونَ نَحْنُ الْمُلْقِينَ", "color": "brown"}, {"text": "(  الأعراف: 115  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والواو ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَامُوسَى﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "موسي: اسم منادي مبنيّ على الضم المقدّر على الألف للتعذّر في محل نصب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة النداء في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِمَّا﴾:", "color": "green"}, {"text": "حرف تفصيل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿تُلْقِيَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أنْ", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "أنْ وما تلاها", "color": "blue"}, {"text": "\" بتأويل مصدر في محل رفع مبتدأ والخبر محذوف تقديره: \"", "color": "black"}, {"text": "كائن", "color": "blue"}, {"text": "\" أو بتأويل مصدر في محل نصب مفعول به \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "bla