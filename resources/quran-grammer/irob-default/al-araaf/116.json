[{"row_id": 1, "segments": [{"text": "{ قَالَ أَلْقُوا فَلَمَّا أَلْقَوْا سَحَرُوا أَعْيُنَ النَّاسِ وَاسْتَرْهَبُوهُمْ وَجَاءُوا بِسِحْرٍ عَظِيمٍ", "color": "brown"}, {"text": "(  الأعراف: 116  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" استئنافية لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَلْقُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، والواو ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة في محل نصب مفعول به \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لمّا: اسم شرط غير جازم مبنيّ على السكون في محل نصب متعلق بالجواب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَلْقَوْا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضمّ المقدر للتعذّر على الألف المحذوفة لالتقاء الساكنين، ولاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ في محل رفع فاعل، والالف فارقة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿سَحَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، والواو ضمير متّصل مبنيّ في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\" فارقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَعْيُنَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿النَّاسِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "سحروا", "color": "blue"}, {"text": "\" جواب شرط غير جازم لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَاسْتَرْهَبُوهُمْ وَجَاءُوا﴾:", "color": "green"}, {"text": "الجملتان: معطوفتان بواوي العطف على \"", "color": "black"}, {"text": "سحروا", "color": "blue"}, {"text": "\"، وتعربان مثلها.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير الغائبين في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿بِسِحْرٍ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ\"", "color": "black"}, {"text": "جاؤوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿عَظِيمٍ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "سحر", "color": "blue"}, {"text": "\"مجرورة مثلها.", "color": "black"}]}]