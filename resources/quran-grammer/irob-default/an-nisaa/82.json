[{"row_id": 1, "segments": [{"text": "{ أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ وَلَوْ كَانَ مِنْ عِنْدِ غَيْرِ اللَّهِ لَوَجَدُوا فِيهِ اخْتِلَافًا كَثِيرًا", "color": "brown"}, {"text": "(  النساء: 82  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَفَلَا﴾:", "color": "green"}, {"text": "الهمزة: حرف استفهام.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لا: حرف نفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَتَدَبَّرُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْقُرْآنَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح، واسمه ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مِنْ عِنْدِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" المحذوف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿غَيْرِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الله﴾:", "color": "green"}, {"text": "لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿لَوَجَدُوا﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجدوا: فعل ماضٍ مبنيّ ع