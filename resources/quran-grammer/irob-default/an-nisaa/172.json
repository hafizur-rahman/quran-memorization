[{"row_id": 1, "segments": [{"text": "{ لَنْ يَسْتَنْكِفَ الْمَسِيحُ أَنْ يَكُونَ عَبْدًا لِلَّهِ وَلَا الْمَلَائِكَةُ الْمُقَرَّبُونَ وَمَنْ يَسْتَنْكِفْ عَنْ عِبَادَتِهِ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًا", "color": "brown"}, {"text": "(  النساء: 172  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لَنْ﴾:", "color": "green"}, {"text": "حرف نفي ونصب.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَسْتَنْكِفَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمَسِيحُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَكُونَ﴾:", "color": "green"}, {"text": "فعل مضارع ناقص منصوب بالفتحة واسمه ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَبْدًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "يكون", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بمحذوف نعت لـ \"", "color": "black"}, {"text": "عبدًا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يكون", "color": "blue"}, {"text": "\" في محلّ جرّ بحرف جرّ محذوف، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "يستنكف", "color": "blue"}, {"text": "\"، والتقدير: عن أن يكون.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "لا: حرف زائد لتأكيد النفي.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الْمَلَائِكَةُ﴾:", "color": "green