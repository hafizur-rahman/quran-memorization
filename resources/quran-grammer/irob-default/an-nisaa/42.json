[{"row_id": 1, "segments": [{"text": "{ يَوْمَئِذٍ يَوَدُّ الَّذِينَ كَفَرُوا وَعَصَوُا الرَّسُولَ لَوْ تُسَوَّى بِهِمُ الْأَرْضُ وَلَا يَكْتُمُونَ اللهٍ حَدِيثًا", "color": "brown"}, {"text": "(  النساء: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة متعلق بـ \"", "color": "black"}, {"text": "يود", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم ظرف مبنيّ في محلّ جرّ مضاف إليه، والتنوين عوض من جملة محذوفة، أي: يود إذ جئنا.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوَدُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَفَرُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، والواو: فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَعَصَوُا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "عصوا: فعل ماضٍ مبنيّ على الضم المقدر على الألف المحذوفة لالتقاء الساكنين، والواو ضمير متصل في محل رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الرَّسُولَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿تُسَوَّى﴾:", "color": "green"}, {"text": "فعل مضارع مبنيّ للمجهول مرفوع، وعلامة الرفع الضمة المقدرة على الألف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِهِمُ﴾:", "color": "green"}, {"text": "الباء: جارّ ومجرور متعلقان بـ\"", "color": "black"}, {"text": "تسوى", "color": "blue"}, {"text": "\".", "color": "blac