[{"row_id": 1, "segments": [{"text": "{ وَآتُوا الْيَتَامَى أَمْوَالَهُمْ وَلَا تَتَبَدَّلُوا الْخَبِيثَ بِالطَّيِّبِ وَلَا تَأْكُلُوا أَمْوَالَهُمْ إِلَى أَمْوَالِكُمْ إِنَّهُ كَانَ حُوبًا كَبِيرًا", "color": "brown"}, {"text": "(  النساء: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَآتُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "آتوا: فعل أمر مبنيّ على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْيَتَامَى﴾:", "color": "green"}, {"text": "مفعول به منصوب، وعلامة النصب الفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَمْوَالَهُمْ﴾:", "color": "green"}, {"text": "أموال: مفعول به ثان منصوب بالفتحة، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَتَبَدَّلُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم، وعلامة الجزم حذف النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْخَبِيثَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بِالطَّيِّبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تتبدلوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا تَأْكُلُوا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا تأكلوا: مثل \"", "color": "black"}, {"text": "لا تتبدلوا", "color": "blue"}, {"text": "\".", "color"