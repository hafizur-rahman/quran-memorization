[{"row_id": 1, "segments": [{"text": "{ وَإِذَا حَضَرَ الْقِسْمَةَ أُولُو الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينُ فَارْزُقُوهُمْ مِنْهُ وَقُولُوا لَهُمْ قَوْلًا مَعْرُوفًا", "color": "brown"}, {"text": "(  النساء: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف للزمن المستقبل متضمن معنى الشرط مبنيّ في محلّ نصب مفعول فيه متعلّق بمضمون الجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿حَضَر﴾:", "color": "green"}, {"text": "فعل ماضٍ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْقِسْمَةَ﴾:", "color": "green"}, {"text": "مفعول به مقدم منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أُولُو﴾:", "color": "green"}, {"text": "فاعل مرفوع، وعلامة الرفع الواو، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْقُرْبَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور، وعلامة الجرّ الكسرة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالْيَتَامَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "اليتامي: اسم معطوف على الفاعل مرفوع، وعلامة الرفع الضمة المقدرة على الألف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَالْمَسَاكِينُ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "المساكبن: اسم معطوف على الفاعل مرفوع، وعلامة الرفع الضمة الظاهرة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَارْزُقُوهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "ارزقوا: فعل أمر مبنيّ على حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير