[{"row_id": 1, "segments": [{"text": "{ اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَيَجْمَعَنَّكُمْ إِلَى يَوْمِ الْقِيَامَةِ لَا رَيْبَ فِيهِ وَمَنْ أَصْدَقُ مِنَ اللَّهِ حَدِيثًا", "color": "brown"}, {"text": "(  النساء: 87  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي للجنس، تعمل عمل \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَهَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "لا", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ في محلّ رفع بدل من الضمير المستكن في الخبر المحذوف، وتقديره: موجود.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَيَجْمَعَنَّكُمْ﴾:", "color": "green"}, {"text": "اللام: لام القسم لقسم مقدر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "يجمعن: فعل مضارع مبنيّ على الفتح في محلّ رفع، والنون: نون التوكيد، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير مفعول به، الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَى يَوْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يجمعنكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْقِيَامَةِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَا رَيْبَ﴾:", "color": "green"}, {"text": "مثل \"", "color": "bla