[{"row_id": 1, "segments": [{"text": "{ بَشِّرِ الْمُنَافِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا", "color": "brown"}, {"text": "(  النساء: 138  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿بَشِّرِ﴾:", "color": "green"}, {"text": "فعل أمر مبني على السكون، وحرك بالكسر منعًا لالتقاء الساكنين، والفاعل: ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْمُنَافِقِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم، والنون عوض عن تنوين المفرد.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بِأَنَّ﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "أن: حرف توكيد مشبَّه بالفعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة بعدها بتأويل مصدر في محل جر بالباء، والجار والمجرور متعلقان بـ \"", "color": "black"}, {"text": "بشر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بمحذوف رفع خبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿عَذَابًا﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مؤخر منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَلِيمًا﴾:", "color": "green"}, {"text": "نعت \"", "color": "black"}, {"text": "عذابًا", "color": "blue"}, {"text": "\" منصوب بالفتحة", "color": "black"}]}]