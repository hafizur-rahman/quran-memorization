[{"row_id": 1, "segments": [{"text": "{ أَمْ لَهُمْ نَصِيبٌ مِنَ الْمُلْكِ فَإِذًا لَا يُؤْتُونَ النَّاسَ نَقِيرًا", "color": "brown"}, {"text": "(  النساء: 53  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَمْ﴾:", "color": "green"}, {"text": "حرف منقطع بمعنى بل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بمحذوف رفع خبر مقدّم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَصِيبٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنَ الْمُلْكِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بنعت \"", "color": "black"}, {"text": "نصيب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَإِذًا﴾:", "color": "green"}, {"text": "حرف رابط لجواب شرط مقدر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "إذا: حرف جواب لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يُؤْتُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والواو: فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿النَّاسَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿نَقِيرًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لهم نصيب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يؤتون", "color": "blue"}, {"text": "\" في محلّ رفع خبر لمبتدأ محذوف تقديره: هم.", "color":