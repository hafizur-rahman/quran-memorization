[{"row_id": 1, "segments": [{"text": "{ فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُمَّ لَا يَجِدُوا فِي أَنْفُسِهِمْ حَرَجًا مِمَّا قَضَيْتَ وَيُسَلِّمُوا تَسْلِيمًا", "color": "brown"}, {"text": "(  النساء: 65  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لا: حرف زائد لتأكيد النفي في جواب القسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَرَبِّكَ﴾:", "color": "green"}, {"text": "الواو: واو القسم، حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "رب: اسم مجرور بالواو، والجارّ والمجرور متعلّقان بفعل محذوف تقديره: أقسم، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل جر مضاف إليه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿حَتَّى﴾:", "color": "green"}, {"text": "حرف غاية وجر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يُحَكِّمُوكَ﴾:", "color": "green"}, {"text": "يحكموا: فعل مضارع منصوب بأن مضمرة بعد حتى، وعلامة نصبه حذف النون، والواو: فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير مبني في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن يحكموك", "color": "blue"}, {"text": "\" في محلّ جر بحرف الجرّ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "يؤمنون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text