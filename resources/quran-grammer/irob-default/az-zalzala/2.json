[{"row_id": 1, "segments": [{"text": "{ وَأَخْرَجَتِ الْأَرْضُ أَثْقَالَهَا", "color": "brown"}, {"text": "(  الزلزلة: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَخْرَجَتِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أخرجت: فعل ماض مبنيّ على الفتح، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث مبنيّ على السكون، وحُرّك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْأَرْضُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "أخرجت", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "زلزلت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَثْقَالَهَا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}]