[{"row_id": 1, "segments": [{"text": "سورة الزلزلة\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ إِذَا زُلْزِلَتِ الْأَرْضُ زِلْزَالَهَا", "color": "brown"}, {"text": "(  الزلزلة: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان مبنيّ على السكون في محلّ نصب مفعول فيه متضمن معنى الشرط خافض لشرطه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿زُلْزِلَتِ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف التأنيث مبنيّ على السكون وحرّك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْأَرْضُ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿زِلْزَالَهَا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب بالفتحة، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جر بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "زلزلت", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]