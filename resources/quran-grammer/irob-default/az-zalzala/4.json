[{"row_id": 1, "segments": [{"text": "{ يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا", "color": "brown"}, {"text": "(  الزلزلة: 4  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "ظرف زمان منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" اسم مبنيّ على السكون وقد حرِّك بالكسر منعًا من التقاء الساكنين", "color": "black"}, {"text": "( سكونه سكون التنوين )", "color": "green"}, {"text": "وهو في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "والجملة المعوض عنها بالتنوين في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والتقدير: يومئذ تزلزل الأرض.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُحَدِّثُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَخْبَارَهَا﴾:", "color": "green"}, {"text": "أخبار: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تحدّث", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب شرط غير جازم.", "color": "black"}]}]