[{"row_id": 1, "segments": [{"text": "{ يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ", "color": "brown"}, {"text": "(  الهمزة: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَحْسَبُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَالَهُ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" منصوب بالفتحة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَخْلَدَهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والجملة الفعلية \"", "color": "black"}, {"text": "يحسب", "color": "blue"}, {"text": "\" وما بعدها لا محل لها من الإعراب، لأنها بدل من صلة \"", "color": "black"}, {"text": "الذي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" ومعموليها من اسمها وخبرها في محلّ نصب سدّت مسدّ مفعولي \"", "color": "black"}, {"text": "يحسب", "color": "blue"}, {"text": "\".", "color": "black"}]}]