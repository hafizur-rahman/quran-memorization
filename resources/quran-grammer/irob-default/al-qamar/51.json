[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ أَهْلَكْنَا أَشْيَاعَكُمْ فَهَلْ مِنْ مُدَّكِرٍ", "color": "brown"}, {"text": "(  القمر: 51  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَقَدْ أَهْلَكْنَا﴾:", "color": "green"}, {"text": "تعرب إعراب الآية الخامسة عشرة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « وَلَقَدْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللام: لام الابتداء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَرَكْنَاهَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "تَرَكْنَا", "color": "blue"}, {"text": "\": فعل ماض مبني على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": ",,,»", "color": "black"}, {"text": "﴿أَشْيَاعَكُمْ﴾:", "color": "green"}, {"text": "أشياع: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و\"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿«فَهَلْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "هل: حرف استفهام.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مُدَّكِرٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوعًا محلًا على أنه مبتدأ خبره محذوف ».", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أهلكنا", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها جواب القسم المقدرة وجملة القسم المقدرة استئ