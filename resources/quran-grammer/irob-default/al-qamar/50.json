[{"row_id": 1, "segments": [{"text": "{ وَمَا أَمْرُنَا إِلَّا وَاحِدَةٌ كَلَمْحٍ بِالْبَصَرِ", "color": "brown"}, {"text": "(  القمر: 50  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَمْرُنَا﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محل جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَاحِدَةٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَلَمْحٍ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبني على الفتح في محل رفع صفة ثانية للموصوف المحذوف \"", "color": "black"}, {"text": "كلمة", "color": "blue"}, {"text": "\"، أو يكون بدل من \"", "color": "black"}, {"text": "واحدة", "color": "blue"}, {"text": "\" لمح: مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بِالْبَصَرِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بصفة من \"", "color": "black"}, {"text": "لمح", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما أمرنا إلا واحدة", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها معطوفة على الاستئنافية.", "color": "black"}]}]