[{"row_id": 1, "segments": [{"text": "{ وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ", "color": "brown"}, {"text": "(  القمر: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿سبق إعرابها في ا تعرب إعراب االسابعة عشر والاية الخامسة عشرة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو «  وَلَقَدْ﴾: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "اللام: لام الابتداء.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قد: حرف تحقيق.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَرَكْنَاهَا﴾:", "color": "green"}, {"text": "\"", "color": "black"}, {"text": "تَرَكْنَا", "color": "blue"}, {"text": "\": فعل ماض مبني على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبني على السكون في محل رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": ",,,»", "color": "black"}, {"text": "﴿القرآن﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتح.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ للذكر﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "يسرنا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿« فَهَلْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "هل: حرف استفهام.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مُدَّكِرٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوعًا محلًا على أنه مبتدأ خبره محذوف».", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يسرنا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها جواب القسم المقدرة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة القسم المقدرة استئنافيّة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هل من مدكر", "color": "blue"}, {"text": "\" جواب شرط مقدر أي إذا كان القرآن ميسرا فهل من مدكر والاستفهام فيه معنى الأمر أي فاحفظوه واتعظوا به».", "color": "black"}]}]