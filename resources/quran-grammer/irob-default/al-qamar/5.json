[{"row_id": 1, "segments": [{"text": "{ حِكْمَةٌ بَالِغَةٌ فَمَا تُغْنِ النُّذُرُ", "color": "brown"}, {"text": "(  القمر: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿حِكْمَةٌ﴾:", "color": "green"}, {"text": "بدل من \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، أو خبر مبتدأ محذوف تقديره: هي حكمة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بَالِغَةٌ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "حكمة", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَمَا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُغْنِ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة الضمة بالمقدّرة على الياء المحذوفة للثقل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿النُّذُرُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هي حكمة", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما تغن النذر", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنّها معطوفة على الاستئنافية الأخيرة.", "color": "black"}]}]