[{"row_id": 1, "segments": [{"text": "{ وَكُلُّ شَيْءٍ فَعَلُوهُ فِي الزُّبُرِ", "color": "brown"}, {"text": "(  القمر: 52  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَكُلُّ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "كل: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فَعَلُوهُ﴾:", "color": "green"}, {"text": "فعل ماض مبني على الضم لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي الزُّبُرِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كل شيء في الزبر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنها معطوفة على الاستئناف المقدر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "فعلوه", "color": "blue"}, {"text": "\" في محل رفع نعت لـ \"", "color": "black"}, {"text": "كل", "color": "blue"}, {"text": "\"، أو في محلّ جر نعت لـ\"", "color": "black"}, {"text": "شيء", "color": "blue"}, {"text": "\".", "color": "black"}]}]