[{"row_id": 1, "segments": [{"text": "{ وَإِنْ يَرَوْا آيَةً يُعْرِضُوا وَيَقُولُوا سِحْرٌ مُسْتَمِرٌّ", "color": "brown"}, {"text": "(  القمر: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يروا﴾:", "color": "green"}, {"text": "فعل مضارع، فعل الشرط، مجزوم بحذف النون.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آيَةً﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُعْرِضُوا وَيَقُولُوا﴾:", "color": "green"}, {"text": "جواب الشرط يعرب إعراب \"", "color": "black"}, {"text": "يروا", "color": "blue"}, {"text": "\" ويقولوا: معطوفة بالواو على \"", "color": "black"}, {"text": "يعرضوا", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿سِحْرٌ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هذا سحر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُسْتَمِرٌّ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "سحر", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يروا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها معطوفة على الابتدائية.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعرضوا", "color": "blu