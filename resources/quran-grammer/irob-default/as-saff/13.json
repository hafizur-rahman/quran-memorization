[{"row_id": 1, "segments": [{"text": "{ وَأُخْرَى تُحِبُّونَهَا نَصْرٌ مِنَ اللَّهِ وَفَتْحٌ قَرِيبٌ وَبَشِّرِ الْمُؤْمِنِينَ", "color": "brown"}, {"text": "(  الصف: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأُخْرَى﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أخرى: مفعول به لفعل محذوف تقديره: \"", "color": "black"}, {"text": "يؤتكم", "color": "blue"}, {"text": "\" منصوب بالفتحة المقدرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تُحِبُّونَهَا﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل، و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متصل مبني على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نَصْرٌ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هي نصر، مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلقان بـ \"", "color": "black"}, {"text": "نصر", "color": "blue"}, {"text": "\" أو بصفة محذوفة له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَفَتْحٌ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "نصر", "color": "blue"}, {"text": "\" مرفوعة بالضمة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿قَرِيبٌ﴾:", "color": "green"}, {"text": "نعت مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَبَشِّرِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "بشر: فعل أمر مبني على السكون وحرك بالكسر منعًا لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوباً تقديره: أنت.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿ال