[{"row_id": 1, "segments": [{"text": "{ كَبُرَ مَقْتًا عِنْدَ اللَّهِ أَنْ تَقُولُوا مَا لَا تَفْعَلُونَ", "color": "brown"}, {"text": "(  الصف: 3  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَبُرَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَقْتًا﴾:", "color": "green"}, {"text": "تمييز منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عِنْدَ﴾:", "color": "green"}, {"text": "ظرف مكان منصوب بالفتحة متعلق بـ \"", "color": "black"}, {"text": "كبر", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري ونصب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَقُولُوا﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\"، وعلامة نصبه حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية وما بعدها: بتأويل مصدر في محل رفع فاعل \"", "color": "black"}, {"text": "كبر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَا لَا تَفْعَلُونَ﴾:", "color": "green"}, {"text": "أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو \n«مَا: اسم موصول مبني على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 12, "segments":