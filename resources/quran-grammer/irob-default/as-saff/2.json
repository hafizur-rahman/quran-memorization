[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا الَّذِينَ آمَنُوا لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ", "color": "brown"}, {"text": "(  الصف: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا الَّذِينَ آمَنُوا﴾:", "color": "green"}, {"text": "أعربت في الآية الأولى من سورة \"", "color": "black"}, {"text": "الممتحنة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو \n« يَاأَيُّهَا: يا: حرف نداء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "أي: منادى مبنيّ على الضم في محلّ نصب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": حرف للتنبيه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِينَ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على الفتح في محلّ رفع عطف بيان لـ\"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" أو بدل منه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿آمَنُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة».", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لِمَ﴾:", "color": "green"}, {"text": "اللام: حرف جر، و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم استفهام مبني على السكون في محل جر باللام، و \"", "color": "black"}, {"text": "الجار والمجرور متعلقان بـ", "color": "blue"}, {"text": "\"تقولون\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَقُولُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبني على السكون في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿تَفْعَلُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "تقولون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة النداء لا محل لها من الإعراب؛ لأنها استئنافية.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها صلة الموصول \"", "color": "black"}, {"text": "الذين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تقولون", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها جواب النداء.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا تفعلون", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها صلة الموصول \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}]