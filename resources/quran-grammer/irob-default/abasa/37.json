[{"row_id": 1, "segments": [{"text": "{ لِكُلِّ امْرِئٍ مِنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ", "color": "brown"}, {"text": "(  عبس: 37  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِكُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر مقدم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿امْرِئٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "من: حرف جرّ.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجار والمجرور متعلّقان بصفة محذوفة \"", "color": "black"}, {"text": "امرئ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَوْمَئِذٍ﴾:", "color": "green"}, {"text": "يوم: ظرف زمان منصوب بالفتحة متعلّق بـ\"", "color": "black"}, {"text": "يفر", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و\"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون وحرك بالكسر تخلصًا من التقاء الساكنين", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "في محلّ جرّ مضاف إليه، وهو مضاف، والجملة المحذوفة المعوض عنها بالتنوين في محلّ جرّ مضاف إليه، والتقدير: يومئذٍ تجيء الصاخة يفر المرء من أخيه ,,,.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿شَأْنٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُغْنِيهِ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لكل امرئ منهم شأنه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يغنيه", "color": "blue"}, {"text": "\" في محلّ رفع نعت لـ\"", "color": "black"}, {"text": "شأن", "color": "blue"}, {"text": "\".", "color": "black"}]}]