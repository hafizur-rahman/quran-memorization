[{"row_id": 1, "segments": [{"text": "{ أَنْ جَاءَهُ الْأَعْمَى", "color": "brown"}, {"text": "(  عبس: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿جَاءَهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية وما بعدها بتأويل مصدر في محلّ جرّ بحرف جرّ مقدر، أي: لأن جاءه، والجار والمجرور في محلّ نصب بـ\"", "color": "black"}, {"text": "تولي", "color": "blue"}, {"text": "\" أو بـ\"", "color": "black"}, {"text": "عبس", "color": "blue"}, {"text": "\" متعلّق بمفعول لأجله، أي: لأجل مجيء الأعمى.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْأَعْمَى﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة المقدّرة على الألف منع من ظهورها التعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "جاءه الأعمى", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}]