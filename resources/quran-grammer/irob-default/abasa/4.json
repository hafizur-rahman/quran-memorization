[{"row_id": 1, "segments": [{"text": "{ أَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرَى }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "أَوْ يَذَّكَّرُ: معطوفة بـ\"", "color": "black"}, {"text": "أو", "color": "blue"}, {"text": "\" على \"", "color": "black"}, {"text": "يزكي", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وعلامة رفع \"", "color": "black"}, {"text": "يذكر", "color": "blue"}, {"text": "\" الضمة الظاهرة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فَتَنْفَعَهُ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "تنفعه: فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة بعد الفاء، وعلامة نصبه الفتحة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الذِّكْرَى﴾:", "color": "green"}, {"text": "فاعل مرفوع بالضمة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والمصدر المؤول من \"", "color": "black"}, {"text": "أن تنفعه", "color": "blue"}, {"text": "\" في محلّ رفع معطوف على مصدر منتزع من الترجي المتقدم أي عسى لديك تزكية أو تذكير فتنتفع من ذكري.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يذكر", "color": "blue"}, {"text": "\" في محلّ رفع معطوفة على جملة \"", "color": "black"}, {"text": "يزكي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تنفعه الذكري", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}]