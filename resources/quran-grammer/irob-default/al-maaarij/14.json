[{"row_id": 1, "segments": [{"text": "{ وَمَنْ فِي الْأَرْضِ جَمِيعًا ثُمَّ يُنْجِيهِ", "color": "brown"}, {"text": "(  المعارج: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من: اسم موصول مبنيّ على السكون في محلّ جر، لأنَّه معطوف على مجرور.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿فِي الْأَرْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصلة الموصول المحذوفة التي لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَمِيعًا﴾:", "color": "green"}, {"text": "توكيد ل \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" أو حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يُنْجِيهِ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "يفتدي", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "يفْتَدِي: فعل مضارع مرفوع بالضمة المقدّرة على الياء\"", "color": "blue"}, {"text": "للثقل", "color": "blue"}, {"text": "».", "color": "blue"}]}, {"row_id": 9, "segments": [{"text": "وفاعل الفعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"الهاء\"", "color": "black"}, {"text": ": ضمير متصل مبنيّ في محلّ نصب مفعول به.", "color": "blue"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"ينجيه\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة صلة الموصول الحرفي.", "color": "black"}]}]