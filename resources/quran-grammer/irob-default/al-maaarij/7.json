[{"row_id": 1, "segments": [{"text": "{ وَنَرَاهُ قَرِيبًا", "color": "brown"}, {"text": "(  المعارج: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَنَرَاهُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الآية الكريمة السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو « \nيَرَوْنَهُ: فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بَعِيدًا﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالفتحة».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نراه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنها معطوفة على جملة \"", "color": "black"}, {"text": "إنهم يرونه", "color": "blue"}, {"text": "\".", "color": "black"}]}]