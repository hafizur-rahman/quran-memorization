[{"row_id": 1, "segments": [{"text": "{ عَلَى أَنْ نُبَدِّلَ خَيْرًا مِنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ", "color": "brown"}, {"text": "(  المعارج: 41  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عَلَى﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ ونصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نُبَدِّلَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المصدرية وما بعدها بتأويل مصدر في محلّ جرّ بـ \"", "color": "black"}, {"text": "على", "color": "blue"}, {"text": "\"، والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قادرون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿خَيْرًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "\"خير\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "ما: حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "ونافية لا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿نَحْنُ ضمير رفع منفصل مبنيّ على الضم في محلّ رفع اسم \"", "color": "green"}, {"text": "ما", "color": "green"}, {"text": "\" على اللغة الأولى ومبتدأ على اللغة الثانية.", "color": "green"}]}, {"row_id": 15, "segments": [{"text": "﴿بِمَسْبُوقِينَ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "مسبوقين: اسم مجرور لفظًا بالباء منصوب محلًا بالياء على أنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"؛ لأنَّه جمع مذكر سالم على اللغة الأولى، ومرفوع محلًا على أنه خبر \"", "color": "black"}, {"text": "نحن", "color": "blue"}, {"text": "\" على اللغة الثانية.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نبدل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما نحن بمسبوقين", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها معطوفة على جملة جواب القسم.", "color": "black"}]}, {"row_id": 19, "segments": []}]