[{"row_id": 1, "segments": [{"text": "{ يُبَصَّرُونَهُمْ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَدِي مِنْ عَذَابِ يَوْمِئِذٍ بِبَنِيهِ", "color": "brown"}, {"text": "(  المعارج: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يُبَصَّرُونَهُمْ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول، مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع نائب فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَوَدُّ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُجْرِمُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَوْ﴾:", "color": "green"}, {"text": "حرف مصدري لا عمل له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَفْتَدِي﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الياء\"", "color": "black"}, {"text": "للثقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "blue"}]}, {"row_id": 8, "segments": [{"text": "و \"لو\"", "color": "black"}, {"text": ": وما بعدها في تأويل مصدر في محلّ نصب مفعول به للفعل", "color": "blue"}, {"text": "\"يود\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ عَذَابِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يفتدي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَوْمِئِذٍ﴾:", "color": "green"}, {"text": "يوم: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "ذا", "color": "blue"}, {"text": "\": اسم مبنيّ على السكون، وقد حرك بالكسر تخلص من التقاء الساكنين", "color": "black"}, {"text": "( سكونه وسكون التنوين )", "color": "green"}, {"text": "في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِبَنِيهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بيفتدي\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 13, "segments": [{"text": "وعلامة جرّ الاسم \"الياء\"", "color": "black"}, {"text": "؛ لأنَّه ملحق بجمع المذكر السالم وحذفت النون للإضافة، و", "color": "blue"}, {"text": "\"الهاء\"", "color": "black"}, {"text": ": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "blue"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"يبصرونهم\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب؛ لأنّها استئنافية.", "color": "blue"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"يود المجرم\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "blue"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"يفتدي\"", "color": "black"}, {"text": "لا محل لها من الإعراب، لأنّها صلة الموصول الحرفي", "color": "blue"}, {"text": "\"لو\".", "color": "black"}]}]