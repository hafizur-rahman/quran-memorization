[{"row_id": 1, "segments": [{"text": "{ وَفَصِيلَتِهِ الَّتِي تُؤْوِيهِ", "color": "brown"}, {"text": "(  المعارج: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَفَصِيلَتِهِ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "وصاحبته", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "وَصَاحِبَتِهِ: معطوفة بواو العطف على \"", "color": "blue"}, {"text": "بنيه", "color": "blue"}, {"text": "\" مجرور بالكسرة متعلّق بيفتدي\"", "color": "blue"}, {"text": ".", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "و \"الهاء\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الَّتِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة لـ\"", "color": "black"}, {"text": "فصيلته", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تُؤْوِيهِ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستتر فيه جوازًا تقديره: هي، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تؤويه", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنّها صلة الموصول \"", "color": "black"}, {"text": "التي", "color": "blue"}, {"text": "\".", "color": "black"}]}]