[{"row_id": 1, "segments": [{"text": "{ إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ", "color": "brown"}, {"text": "(  المعارج: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "&إِنَّ حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَذَابَ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبِّهِمْ﴾:", "color": "green"}, {"text": "رب: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف، والهاء\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿غَيْرُ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَأْمُونٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن عذاب ربهم غير مأمون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها اعتراضية.", "color": "black"}]}]