[{"row_id": 1, "segments": [{"text": "{ إِذَا مَسَّهُ الشَّرُّ جَزُوعًا", "color": "brown"}, {"text": "(  المعارج: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمان خافض لشرطه متعلّق بجوابه متضمن معني الشرط، مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿ مَسَّهُ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الشَّرُّ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿جَزُوعًا﴾:", "color": "green"}, {"text": "حال منصوبة لفعل محذوف، والتقدير: ظهر جزوعًا أو صار جزوعًا.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "مسه الشر", "color": "blue"}, {"text": "\" في محلّ جر مضاف إليه.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان جزوعًا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب؛ لأنّها جواب شرط غير جازم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجملة الشرطية لا محلّ لها من الإعراب؛ لأنّها تفسيرية لقوله \"", "color": "black"}, {"text": "هلوعًا", "color": "blue"}, {"text": "\".", "color": "black"}]}]