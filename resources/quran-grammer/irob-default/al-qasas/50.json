[{"row_id": 1, "segments": [{"text": "{ فَإِنْ لَمْ يَسْتَجِيبُوا لَكَ فَاعْلَمْ أَنَّمَا يَتَّبِعُونَ أَهْوَاءَهُمْ وَمَنْ أَضَلُّ مِمَّنِ اتَّبَعَ هَوَاهُ بِغَيْرِ هُدًى مِنَ اللَّهِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ", "color": "brown"}, {"text": "(  القصص: 50  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إنّ: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿يَسْتَجِيبُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف النون وهو فعل الشرط.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يستجيبوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿فَاعْلَمْ﴾:", "color": "green"}, {"text": "الفاء: حرف رابط لجواب الشرط.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "واعلم: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَنَّمَا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل بطل عمله، وما: كافة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَتَّبِعُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 13, "s