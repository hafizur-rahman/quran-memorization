[{"row_id": 1, "segments": [{"text": "{ وَلَمَّا تَوَجَّهَ تِلْقَاءَ مَدْيَنَ قَالَ عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ", "color": "brown"}, {"text": "(  القصص: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَمَّا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: اسم شرط غير جازم مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بالجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَوَجَّهَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿تِلْقَاءَ﴾:", "color": "green"}, {"text": "ظرف مكان متعلّق بـ \"", "color": "black"}, {"text": "توجه", "color": "blue"}, {"text": "\" منصوب بالفتحة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مَدْيَنَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿ عَسَى رَبِّي أَنْ يَهْدِيَنِي﴾:", "color": "green"}, {"text": "سبق إعرابها في الآية الثانية بعد المئة من سورة التوبة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وهو: « \nعَسَى: فعل ماضٍ جامد ناقص مبنيّ على الفتح المقدّر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة اسم \"", "color": "black"}, {"text": "عسي", "color": "blue"}, {"text": "\" مرفوع بالضمّة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدريّ.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿يَتُوبَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text":