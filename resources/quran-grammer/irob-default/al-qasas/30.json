[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا أَتَاهَا نُودِيَ مِنْ شَاطِئِ الْوَادِ الْأَيْمَنِ فِي الْبُقْعَةِ الْمُبَارَكَةِ مِنَ الشَّجَرَةِ أَنْ يَامُوسَى إِنِّي أَنَا اللَّهُ رَبُّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  القصص: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا أَتَاهَا﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "فلما قضى", "color": "blue"}, {"text": "\" الواردة في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: « فَلَمَّا: الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لما: اسم شرط غير جازم مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بالجواب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَضَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و\"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نُودِيَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ للمجهول مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ شَاطِئِ﴾:", "color": "green"}, {"text": "جارّ ومجرور في محلّ رفع نائب فاعل للفعل \"", "color": "black"}, {"text": "نودي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْوَادِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالكسرة المقدّرة للثقل على الياء المحذوفة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿الْأَيْمَنِ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "الوادي", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿فِي الْبُقْعَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور م