[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ بِمَا أَنْعَمْتَ عَلَيَّ فَلَنْ أَكُونَ ظَهِيرًا لِلْمُجْرِمِينَ", "color": "brown"}, {"text": "(  القصص: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ رَبِّ﴾:", "color": "green"}, {"text": "سبق إعرابها في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «  قَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي منصوب، وعلامة نصبه الفتحة المقدرة على ما قبل الياء المحذوفة، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِمَا﴾:", "color": "green"}, {"text": "الباء: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف مصدريّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْعَمْتَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿عَلَيَّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أنعمت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" وما بعدها: بتأويل مصدر في محلّ جر بالباء.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "التقدير: بإنعامك علي والجارّ والمجرور يجوز أن يكون متعلقًا بفعل القسم المحذوف أو بفعل محذوف تقديره: اعصمني.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فَلَنْ﴾:", "color": "green"}, {"text": "الفاء: فاء السببية.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "لن: حرف نفي ونصب واستقبال.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿أَكُونَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ \"لن: وهو فعل ناقص بالفتحة واسمه ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿ظَهِيرًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "أكون", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿لِلْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أكون: أو بصفة محذوفة من", "color": "blue"}, {"text": "\"ظهيرًا\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿والمجرمين﴾:", "color": "green"}, {"text": "اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة النداء وجوابه في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنعمت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول الحرفي \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اعصمني بما أنعمت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لن أكون ظهيرًا", "color": "blue"}, {"text": "\" في محلّ جزم جواب شرط مقدر أي إن تعصمني فلن أكون.", "color": "black"}]}]