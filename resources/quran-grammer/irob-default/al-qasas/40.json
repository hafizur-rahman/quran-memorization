[{"row_id": 1, "segments": [{"text": "{ فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ", "color": "brown"}, {"text": "(  القصص: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَخَذْنَاهُ﴾:", "color": "green"}, {"text": "الفاء: فاء السببية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أخذ: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَجُنُودَهُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على الضمير.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "أخذناه", "color": "blue"}, {"text": "\" منصوبة بالفتحة، والهاء: ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَنَبَذْنَاهُمْ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "فأخذناه", "color": "blue"}, {"text": "\" وتعرب إعرابها، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِي الْيَمِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نبذناهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَانْظُرْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "انظر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبا تقديره: أنت.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كيف﴾:", "color": "green"},