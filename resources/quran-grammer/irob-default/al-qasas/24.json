[{"row_id": 1, "segments": [{"text": "{ فَسَقَى لَهُمَا ثُمَّ تَوَلَّى إِلَى الظِّلِّ فَقَالَ رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ", "color": "brown"}, {"text": "(  القصص: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَسَقَى﴾:", "color": "green"}, {"text": "الفاء: فاء السببية.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "سقى: فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَهُمَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "سقى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ثُمَّ﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَوَلَّى﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "سقى", "color": "blue"}, {"text": "\" وتعرب إعرابها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿إِلَى الظِّلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "تولى", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فَقَالَ رَبِّ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "قال رب: سبق إعرابها في الآية السادسة عشرة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وهو: «\nقَالَ: فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي منصوب، وعلامة نصبه الفتحة المقدرة على ما قبل الياء المحذوفة، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ بالإضافة».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "حرف توكيد