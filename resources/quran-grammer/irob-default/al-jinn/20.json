[{"row_id": 1, "segments": [{"text": "{ قُلْ إِنَّمَا أَدْعُو رَبِّي وَلَا أُشْرِكُ بِهِ أَحَدًا", "color": "brown"}, {"text": "(  الجن: 20  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قُلْ﴾:", "color": "green"}, {"text": "أعربت في الآية الأولى.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو «", "color": "black"}, {"text": "قُلْ: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد بطل عمله.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ما: حرف زائد كافّ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَدْعُو﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" للثقل، والفاعل ضمير مستتر فيه وجوباً تقديره: أنا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿رَبِّي﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة للياء.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أُشْرِك﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "أدعوا", "color": "blue"}, {"text": "\"، وعلامة رفعه الضمة الظاهرة في آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿بِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "لا أشرك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id