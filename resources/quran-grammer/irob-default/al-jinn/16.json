[{"row_id": 1, "segments": [{"text": "{ وَأَلَّوِ اسْتَقَامُوا عَلَى الطَّرِيقَةِ لَأَسْقَيْنَاهُمْ مَاءً غَدَقًا }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَأَلَّوِ: الواو: عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أن: مخففة من \"", "color": "black"}, {"text": "أنّ", "color": "blue"}, {"text": "\" الثقيلة، واسمها ضمير الشأن المحذوف.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وقد كسرت الواو منعاً لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿اسْتَقَامُوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَلَى الطَّرِيقَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "استقاموا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَأَسْقَيْنَاهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب \"", "color": "black"}, {"text": "لو", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "أسقي", "color": "blue"}, {"text": "\" فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مَاءً﴾:", "color": "green"}, {"text": "مفعو