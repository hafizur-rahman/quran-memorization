[{"row_id": 1, "segments": [{"text": "{ لِيَعْلَمَ أَنْ قَدْ أَبْلَغُوا رِسَالَاتِ رَبِّهِمْ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَى كُلَّ شَيْءٍ عَدَدًا", "color": "brown"}, {"text": "(  الجن: 28  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿لِيَعْلَمَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ للتعليل.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "يعلم: فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" مضمرة بعد اللام، وعلامة نصبه الفتحة، والفاعل ضمير مستتر فيه جوازاً تقديره: هو أي: الله سبحانه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\": المضمرة وما بعدها في تأويل مصدر في محلّ جرّ باللام، والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "يسلك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "مخففة من الثقيلة وهي حرف توكيد مشبّه بالفعل واسمه ضمير شأن مستتر تقديره: أنه.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَبْلَغُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" واسمها وخبرها بتأويل مصدر في محلّ نصب سدّ مسدّ مفعولي \"", "color": "black"}, {"text": "يعلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿رِسَالَاتِ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالكسرة بدلاً من الفتحة؛ لأنَّه جمع مؤنث سالم.", "color": "black"}]}, {"row_id": 10, "segments":