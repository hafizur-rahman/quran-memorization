[{"row_id": 1, "segments": [{"text": "{ وَأَنَّا ظَنَنَّا أَنْ لَنْ نُعْجِزَ اللَّهَ فِي الْأَرْضِ وَلَنْ نُعْجِزَهُ هَرَبًا", "color": "brown"}, {"text": "(  الجن: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنَّا ظَنَنَّا أَنْ لَنْ نُعْجِزَ﴾:", "color": "green"}, {"text": "أعربت في الآية الخامسة،  وهو « وَأَنَّا: الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ظَنَنَّا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "مخففة من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" الثقيلة، وهي حرف توكيد مشبه بالفعل، واسمه ضمير شأن مستتر تقديره: أنه و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المخففة واسمها وخبرها بتأويل مصدر في محلّ نصب سد مسد مفعولي \"", "color": "black"}, {"text": "ظن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَّنْ﴾:", "color": "green"}, {"text": "حرف نصب واستقبال.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿تَقُولَ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بـ\"", "color": "black"}, {"text": "لن", "color": "blue"}, {"text": "\"، وعلامة نصبه الفتحة».", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وفاعل \"", "color": "black"}, {"text": "نعجز", "color": "blue"}, {"text": "\" ضمير مستتر فيه وجوباً