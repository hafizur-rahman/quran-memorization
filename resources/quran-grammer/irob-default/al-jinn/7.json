[{"row_id": 1, "segments": [{"text": "{ وَأَنَّهُمْ ظَنُّوا كَمَا ظَنَنْتُمْ أَنْ لَنْ يَبْعَثَ اللَّهُ أَحَدًا", "color": "brown"}, {"text": "(  الجن: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنَّهُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنهم: أن: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسمها.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿ظَنُّوا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الضم، لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿كَمَا﴾:", "color": "green"}, {"text": "الكاف: حرف جرّ، و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": حرف مصدري.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ظَنَنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون، لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" المصدرية وما بعدها بتأويل مصدر في محلّ جرّ بالكاف، والجارّ والمجرور متعلّقان بمفعول مطلق محذوف والتقدير: أنهم ظنوا ظناً كظنكم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَنْ لَنْ يَبْعَثَ اللَّهُ أَحَدًا﴾:", "color": "green"}, {"text": "أعربت في الآية الخامسة  وهو « أَنْ: مخففة من \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" الثقيلة، و