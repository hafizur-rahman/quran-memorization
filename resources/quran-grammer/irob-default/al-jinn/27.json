[{"row_id": 1, "segments": [{"text": "{ إِلَّا مَنِ ارْتَضَى مِنْ رَسُولٍ فَإِنَّهُ يَسْلُكُ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ رَصَدًا", "color": "brown"}, {"text": "(  الجن: 27  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف استثناء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿مَنِ﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون، وقد حرك بالكسر لالتقاء الساكنين في محلّ نصب مستثني بدلًا من \"", "color": "black"}, {"text": "أحد", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿ارْتَضَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْ رَسُولٍ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَإِنَّهُ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "إنّ: حرف توكيد مشبّه بالفعل، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب اسم \"", "color": "black"}, {"text": "إنّ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يَسْلُكُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة، والفاعل ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مِنْ بَيْنِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "يسلك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يَدَيْهِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء؛ لأنَّه مثنى، وحذفت النون للإضافة، و \"", "color": "black"}, {"text": "اله