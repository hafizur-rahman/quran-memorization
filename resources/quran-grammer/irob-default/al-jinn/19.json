[{"row_id": 1, "segments": [{"text": "{ وَأَنَّهُ لَمَّا قَامَ عَبْدُ اللَّهِ يَدْعُوهُ كَادُوا يَكُونُونَ عَلَيْهِ لِبَدًا", "color": "brown"}, {"text": "(  الجن: 19  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنَّهُ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "أنه", "color": "blue"}, {"text": "\" في الآية الأولى، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "أَنَّهُ: أنّ: حرف توكيد مشبه بالفعل، و \"", "color": "blue"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير الشأن مبنيّ على الفتح في محلّ نصب اسم \"", "color": "blue"}, {"text": "إن", "color": "blue"}, {"text": "\"", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمَّا﴾:", "color": "green"}, {"text": "أعربت في الآية الثالثة عشرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وهو «", "color": "black"}, {"text": "لَمَّا: ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَامَ﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿عَبْدُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة، وهو مضاف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَدْعُوهُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بالضمة المقدّرة على الواو للثقل، والفاعل ضمير مستتر فيه جوازا تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿كَادُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الضم، لاتصاله بواو الجماعة، و \"