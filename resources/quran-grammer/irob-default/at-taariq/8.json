[{"row_id": 1, "segments": [{"text": "{ إِنَّهُ عَلَى رَجْعِهِ لَقَادِرٌ", "color": "brown"}, {"text": "(  الطارق: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّهُ﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، الضمير يعود على الخالق سبحانه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَلَى رَجْعِهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالخبر \"", "color": "black"}, {"text": "قادر", "color": "blue"}, {"text": "\" و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الكسر في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لقادر﴾:", "color": "green"}, {"text": "اللام: حرف توكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "قادر: خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنه على رجعه لقادر", "color": "blue"}, {"text": "\" استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]