[{"row_id": 1, "segments": [{"text": "{ وَمَا هُوَ بِالْهَزْلِ", "color": "brown"}, {"text": "(  الطارق: 14  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي بمنزلة \"", "color": "black"}, {"text": "ليس", "color": "blue"}, {"text": "\" في لغة أهل الحجاز ونافية لا عمل لها في لغة بني تميم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع اسم \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\" على اللغة الأولى وفي محلّ رفع مبتدأ على اللغة الثانية.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِالْهَزْلِ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الهزل: اسم مجرور بالباء لفظًا منصوب محلًا، لأنه خبر \"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\"، أو مرفوع محلًا، لأنه خبر \"", "color": "black"}, {"text": "هو", "color": "blue"}, {"text": "\"، وعلامة نصبه أو رفعه فتحة مقدّرة أو ضمة مقدرة على آخره منع من ظهورهما اشتغال المحلّ بحركة حرف الجرّ الزائد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجملة \"", "color": "black"}, {"text": "ما هو بالهزل", "color": "blue"}, {"text": "\" معطوفة على جملة \"", "color": "black"}, {"text": "إنه لقول فصل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب.", "color": "black"}]}]