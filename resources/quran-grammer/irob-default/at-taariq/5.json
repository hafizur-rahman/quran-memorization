[{"row_id": 1, "segments": [{"text": "{ فَلْيَنْظُرِ الْإِنْسَانُ مِمَّ خُلِقَ", "color": "brown"}, {"text": "(  الطارق: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلْيَنْظُرِ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف، واللام: لام الأمر، حرف جزم مبنيّ على الكسر.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وأسكنت تخفيفًا لاتصالها بالفاء.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "ينظر: فعل مضارع مجزوم باللام، وعلامة جزمه سكون آخره، وحرك بالكسر لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْإِنْسَانُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِمَّ﴾:", "color": "green"}, {"text": "مركبة من \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\": حرف جر.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم استفهام مبنيّ على السكون المقدّر على الألف في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، والجار والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "خلق", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿خُلِقَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ينظر", "color": "blue"}, {"text": "\" استئنافيّة لا محلّ لها من الإعراب.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلق", "color": "blue"}, {"text": "\" في محلّ نصب مفعول به.", "color": "black"}]}]