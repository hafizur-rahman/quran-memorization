[{"row_id": 1, "segments": [{"text": "سُورَةُ الطَّارِق\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ وَالسَّمَاءِ وَالطَّارِقِ", "color": "brown"}, {"text": "(  الطارق: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَالسَّمَاءِ﴾:", "color": "green"}, {"text": "الواو: حرف جرّ للقسم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "السماء: اسم مقسم به مجرور بواو القسم، وعلامة جره الكسرة، والجارّ والمجرور متعلّقان بفعل محذوف تقديره: أقسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَالطَّارِقِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "السماء", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة القسم ابتدائية لا محلّ لها من الإعراب.", "color": "black"}]}]