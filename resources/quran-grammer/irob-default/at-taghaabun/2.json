[{"row_id": 1, "segments": [{"text": "{ هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ", "color": "brown"}, {"text": "(  التغابن: 2  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هُوَ﴾:", "color": "green"}, {"text": "ضمير رفع منفصل مبنيّ على الفتح في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبني على السكون في محل رفع خبر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿خَلَقَكُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَمِنْكُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "منكم: جار ومجرور متعلقان بخبر مقدم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿كَافِرٌ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمِنْكُمْ مُؤْمِنٌ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "منكم كافر", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ﴾:", "color": "green"}, {"text": "تعرب إعراب الآية الحادية عشرة من سورة \"", "color": "black"}, {"text": "المنافقون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وهو \n« وَاللَّهُ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "الله: لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الض