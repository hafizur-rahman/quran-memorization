[{"row_id": 1, "segments": [{"text": "{ إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ شَكُورٌ حَلِيمٌ", "color": "brown"}, {"text": "(  التغابن: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تُقْرِضُوا﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهَ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مفعول به أول منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَرْضًا﴾:", "color": "green"}, {"text": "مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "أو مفعول مطلق مبين للنوع منصوب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿حَسَنًا﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "قرضًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة أيضًا.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُضَاعِفْهُ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\"، وعلامة جزمه السكون، والفاعل ضمير مستتر فيه جوازاً تقديره: هو، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبني على الضم في محل نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَكُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "يضاعفه لكم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَيَغْفِرْ لَكُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "يضاعفه لكم", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "الله: لفظ الجلالة: مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿شَكُورٌ حَلِيمٌ﴾:", "color": "green"}, {"text": "خبرآن للفظ الجلالة مرفوعان بالضمة، ويجوز أن يكون \"", "color": "black"}, {"text": "حليم", "color": "blue"}, {"text": "\" صفة لشكور.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تقرضوا", "color": "blue"}, {"text": "\" لا محل لها استئناف في حيز جواب النداء وجملة يضاعفه ..", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "لا محل لها من الإعراب؛ لأنها جواب الشرط غير مقترنة بالفاء.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يغفر", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها معطوفة على جملة جواب الشرط.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله شكور", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها استئنافية.", "color": "black"}]}]