[{"row_id": 1, "segments": [{"text": "{ مَا أَصَابَ مِنْ مُصِيبَةٍ إِلَّا بِإِذْنِ اللَّهِ وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ", "color": "brown"}, {"text": "(  التغابن: 11  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَصَابَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على الفتح وحذف مفعوله اختصارًا؛ لأنَّه معلوم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر زائد لتأكيد معنى النفي.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُصِيبَةٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلاً؛ لأنَّه فاعل أصاب وحذف المفعول به، أي ما أصابت الإنسان مصيبة وقد ذكر الفعل؛ لأنَّه فصل عن فاعله بفاصل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿بِإِذْنِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلقان بـ \"", "color": "black"}, {"text": "أصاب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مخفوض للتعظيم بالإضافة وعلامة الخفض الكسرة، أي إلا بتقدير منه سبحانه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ﴾:", "color": "green"}, {"text": "أعربت في الآية التاسعة  وهو \n« وَمَنْ: الواو حرف استئناف من: اسم شرط جازم مبني على السكون في محل رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿يُؤْمِنْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\" وعلامة جزمه السكون، و \"الفاعل ضمير مستتر فيه جوازاً تقديره: هو.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿بِاللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلقان بـ \"", "color": "black"}, {"text": "يؤمن", "color": "blue"}, {"text": "\"».", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿«يَهْدِ ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم جواب الشرط,وعلامة جزم \"", "color": "black"}, {"text": "يهد", "color": "blue"}, {"text": "\" حذف آخره - حرف العلة - \nقَلْبَهُ: مفعول به , قلب مضاف والهاء مضاف اليه»", "color": "black"}, {"text": "﴿وَاللَّهُ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "الله: مبتدأ مرفوع للتعظيم بالضمة.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بِكُلِّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بالخبر.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالإضافة وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿عَلِيمٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أصاب", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها استئنافية.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "من يؤمن", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها معطوفة على الاستئنافية.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يهد قلبه", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها جواب الشرط غير مقترنة بالفاء.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "الله بكل شيء عليم", "color": "blue"}, {"text": "\" لا محل لها من الإعراب؛ لأنها استئنافية.", "color": "black"}]}]