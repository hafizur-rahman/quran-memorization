[{"row_id": 1, "segments": [{"text": "{ فَآمِنُوا بِاللَّهِ وَرَسُولِهِ وَالنُّورِ الَّذِي أَنْزَلْنَا وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ", "color": "brown"}, {"text": "(  التغابن: 8  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَآمِنُوا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿آمنوا﴾:", "color": "green"}, {"text": "فعل أمر مبني على حذف النون؛ لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متصل مبني في محل رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿بِاللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلقان بـ \"", "color": "black"}, {"text": "آمنوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَرَسُولِهِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "رسوله: اسم معطوف بالكسرة، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متصل مبني في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَالنُّورِ﴾:", "color": "green"}, {"text": "معطوف بالواو على \"", "color": "black"}, {"text": "الرسول", "color": "blue"}, {"text": "\"، ويعرب إعرابه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبني على السكون في محل جر صفة لـ \"", "color": "black"}, {"text": "النور", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَنْزَلْنَا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبني على السكون، لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير م