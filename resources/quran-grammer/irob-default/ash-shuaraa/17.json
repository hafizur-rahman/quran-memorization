[{"row_id": 1, "segments": [{"text": "{ أَنْ أَرْسِلْ مَعَنَا بَنِي إِسْرَائِيلَ", "color": "brown"}, {"text": "(  الشعراء: 17  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف تفسير.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَرْسِلْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السّكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مَعَنَا﴾:", "color": "green"}, {"text": "ظرف مكان منصوب متعلّق بـ \"", "color": "black"}, {"text": "أرسل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة\nبَنِي: مفعول به منصوب، وعلامة نصبه الياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِسْرَائِيلَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أرسل", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}]