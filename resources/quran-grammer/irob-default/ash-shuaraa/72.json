[{"row_id": 1, "segments": [{"text": "{ قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ", "color": "brown"}, {"text": "(  الشعراء: 72  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿هَلْ﴾:", "color": "green"}, {"text": "حرف استفهام.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَسْمَعُونَكُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِذْ﴾:", "color": "green"}, {"text": "ظرف للزمن الماضي بمعنى \"", "color": "black"}, {"text": "حين", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بـ\"", "color": "black"}, {"text": "يسمعونكم", "color": "blue"}, {"text": "\"، وهو مضاف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَدْعُونَ﴾:", "color": "green"}, {"text": "تعرب إعراب \"", "color": "black"}, {"text": "يسمعون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يسمعونكم", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تدعون", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}]