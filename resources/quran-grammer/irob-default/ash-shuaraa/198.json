[{"row_id": 1, "segments": [{"text": "{ وَلَوْ نَزَّلْنَاهُ عَلَى بَعْضِ الْأَعْجَمِينَ", "color": "brown"}, {"text": "(  الشعراء: 198  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَوْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لو: حرف شرط غير جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَزَّلْنَاهُ﴾:", "color": "green"}, {"text": "نزل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿عَلَى بَعْضِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نزلناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْأَعْجَمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لو نزلناه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "لم يكن لهم آية", "color": "blue"}, {"text": "\".", "color": "black"}]}]