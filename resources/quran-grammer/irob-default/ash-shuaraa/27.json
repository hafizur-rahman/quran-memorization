[{"row_id": 1, "segments": [{"text": "{ قَالَ إِنَّ رَسُولَكُمُ الَّذِي أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ", "color": "brown"}, {"text": "(  الشعراء: 27  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّ﴾:", "color": "green"}, {"text": "حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَسُولَكُمُ﴾:", "color": "green"}, {"text": "رسول: اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السّكون في محلّ نصب صفة لـ \"", "color": "black"}, {"text": "الرسول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أُرْسِلَ﴾:", "color": "green"}, {"text": "فعل ماضٍ للمجهول مبنيّ على الفتح، ونائب الفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَيْكُمْ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أرسل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لَمَجْنُونٌ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "مجنون: خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعر