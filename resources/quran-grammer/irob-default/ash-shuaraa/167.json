[{"row_id": 1, "segments": [{"text": "{ قَالُوا لَئِنْ لَمْ تَنْتَهِ يَالُوطُ لَتَكُونَنَّ مِنَ الْمُخْرَجِينَ", "color": "brown"}, {"text": "(  الشعراء: 167  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية تعرب إعراب الآية الكريمة السادسة عشرة بعد المئة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: « قَالُوا: فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَئِنْ﴾:", "color": "green"}, {"text": "اللام: موطئة للقسم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿تَنْتَهِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف حرف العلة، وهو فعل الشرط.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَانُوحُ يا﴾:", "color": "green"}, {"text": "حرف نداء.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "نوح: منادى مبنيّ على الضم في محلّ نصب.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَتَكُونَنَّ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب القسم المقدر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "تكونن: فعل مضارع ناقص مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "\"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": للتوكيد.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "واسم \"", "color": "black"}, {"text": "تكون", "color": "blue"}, {"text": "\" ضمير مست