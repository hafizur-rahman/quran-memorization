[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا تَرَاءَى الْجَمْعَانِ قَالَ أَصْحَابُ مُوسَى إِنَّا لَمُدْرَكُونَ", "color": "brown"}, {"text": "(  الشعراء: 61  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: اسم شرط غير جازم بمعنى \"", "color": "black"}, {"text": "حين", "color": "blue"}, {"text": "\" مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بالجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿تَرَاءَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْجَمْعَانِ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالألف، لأنه مثنى.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَصْحَابُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسر، لأنه ممنوع من الصرف وقدرت الحركة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لَمُدْرَكُونَ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "مدركون: خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]},