[{"row_id": 1, "segments": [{"text": "{ إِنَّهُمْ عَنِ السَّمْعِ لَمَعْزُولُونَ", "color": "brown"}, {"text": "(  الشعراء: 212  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿إِنَّهُمْ﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿عَنِ السَّمْعِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿لَمَعْزُولُونَ﴾:", "color": "green"}, {"text": "اللام: لام التوكيد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "معزولون: خبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنهم عن السمع لمعزولون", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}]