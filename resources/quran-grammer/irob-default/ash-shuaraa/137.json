[{"row_id": 1, "segments": [{"text": "{ إِنْ هَذَا إِلَّا خُلُقُ الْأَوَّلِينَ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "إِنْ: مخففة مهملة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿خُلُقُ﴾:", "color": "green"}, {"text": "خبر المبتدأ \"", "color": "black"}, {"text": "هذا", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْأَوَّلِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن هذا إلا خلق", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}]