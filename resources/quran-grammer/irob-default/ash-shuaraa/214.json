[{"row_id": 1, "segments": [{"text": "{ وَأَنْذِرْ عَشِيرَتَكَ الْأَقْرَبِينَ", "color": "brown"}, {"text": "(  الشعراء: 214  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنْذِرْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنذر: فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَشِيرَتَكَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْأَقْرَبِينَ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "العشيرة", "color": "blue"}, {"text": "\" منصوبة بالياء، لأنها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنذر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "لا تدع", "color": "blue"}, {"text": "\".", "color": "black"}]}]