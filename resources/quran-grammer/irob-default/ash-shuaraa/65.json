[{"row_id": 1, "segments": [{"text": "{ وَأَنْجَيْنَا مُوسَى وَمَنْ مَعَهُ أَجْمَعِينَ", "color": "brown"}, {"text": "(  الشعراء: 65  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَأَنْجَيْنَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أنجي: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "من: اسم موصول مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مَعَهُ﴾:", "color": "green"}, {"text": "مع: ظرف مكان منصوب بالفتحة متعلّق بفعل محذوف تقديره: استقر، وهو مضاف، و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَجْمَعِينَ﴾:", "color": "green"}, {"text": "توكيد لـ \"", "color": "black"}, {"text": "موسى", "color": "blue"}, {"text": "\" وقومه منصوب بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنجينا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "أوحينا", "color": "blue"}, {"text": "\".", "color": "black"}]}]