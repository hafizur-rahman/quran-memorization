[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِنْ كُنْتُمْ مُوقِنِينَ", "color": "brown"}, {"text": "(  الشعراء: 24  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبُّ﴾:", "color": "green"}, {"text": "خبر مبتدأ محذوف تقديره: هو رب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿السَّمَاوَاتِ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالْأَرْضِ﴾:", "color": "green"}, {"text": "معطوفة على \"", "color": "black"}, {"text": "السماوات", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ما: اسم موصول مبنيّ على السّكون في محلّ جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿بَيْنَهُمَا﴾:", "color": "green"}, {"text": "بين: ظرف مكان منصوب بالفتحة متعلّق بمحذوف تقديره: كائن.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿و \"", "color": "green"}, {"text": "هما", "color": "green"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "green"}]}, {"row_id": 11, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "حرف شرط جازم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿كُنْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على السّكون لاتصاله بضمير الرفع المتحرك وهو فعل الشرط.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ رفع اسم \"", "co