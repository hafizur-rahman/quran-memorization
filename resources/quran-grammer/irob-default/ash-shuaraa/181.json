[{"row_id": 1, "segments": [{"text": "{ أَوْفُوا الْكَيْلَ وَلَا تَكُونُوا مِنَ الْمُخْسِرِينَ", "color": "brown"}, {"text": "(  الشعراء: 181  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿أَوْفُوا﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف النون، لأن مضارعه من الأفعال الخمسة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿الْكَيْلَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "لا: حرف نهي وجزم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿تَكُونُوا﴾:", "color": "green"}, {"text": "فعل مضارع ناقص مجزوم بحذف النون.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "تكون", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿الْمُخْسِرِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر تكون\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"أوفوا\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "blue"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"لا تكونوا\"", "color": "black"}, {"text": "لا محلّ له