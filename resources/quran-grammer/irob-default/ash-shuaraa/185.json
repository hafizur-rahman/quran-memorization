[{"row_id": 1, "segments": [{"text": "{ قَالُوا إِنَّمَا أَنْتَ مِنَ الْمُسَحَّرِينَ", "color": "brown"}, {"text": "(  الشعراء: 185  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية سبق إعرابها في الآية الثالثة والخمسين بعد المئة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: « قَالُوا: فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنَّمَا﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبه بالفعل بطل عمله.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وما: كافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَنْتَ﴾:", "color": "green"}, {"text": "ضمير منفصل مبنيّ على الفتح في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿الْمُسَحَّرِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجارّ والمجرور متعلّقان بخبر المبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أنت من المسحرين", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\"».", "color": "black"}]}]