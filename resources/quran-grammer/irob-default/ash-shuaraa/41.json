[{"row_id": 1, "segments": [{"text": "{ فَلَمَّا جَاءَ السَّحَرَةُ قَالُوا لِفِرْعَوْنَ أَئِنَّ لَنَا لأَجْرًا إِنْ كُنَّا نَحْنُ الْغَالِبِينَ", "color": "brown"}, {"text": "(  الشعراء: 41  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَلَمَّا﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: اسم شرط غير جازم مبنيّ على السكون في محلّ نصب مفعول به متعلّق بالجواب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿جَاءَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿السَّحَرَةُ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿لِفِرْعَوْنَ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "فرعون: اسم مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "قالوا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَئِنَّ﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "إن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿لَنَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "مقدم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿لأَجْرًا﴾:", "color": "green"},