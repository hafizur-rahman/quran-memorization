[{"row_id": 1, "segments": [{"text": "{ كَذَلِكَ سَلَكْنَاهُ فِي قُلُوبِ الْمُجْرِمِينَ", "color": "brown"}, {"text": "(  الشعراء: 200  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَذَلِكَ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب نائبة عن المفعول المطلق تقديره: مثل هذا المسلك سلكناه.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": للبعد، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿سَلَكْنَاهُ﴾:", "color": "green"}, {"text": "سلك فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فِي قُلُوبِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "سلكناه", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿الْمُجْرِمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "سلكناه", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استثنائية.", "color": "black"}]}]