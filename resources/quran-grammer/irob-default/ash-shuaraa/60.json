[{"row_id": 1, "segments": [{"text": "{ فَأَتْبَعُوهُمْ مُشْرِقِينَ", "color": "brown"}, {"text": "(  الشعراء: 60  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَأَتْبَعُوهُمْ﴾:", "color": "green"}, {"text": "الفاء: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "اتبعوا: فعل ماضٍ مبنيّ على الضم لاتصاله بواو الجماعة، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مُشْرِقِينَ﴾:", "color": "green"}, {"text": "حال منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اتبعوهم", "color": "blue"}, {"text": "\" لا محلّ لها معطوفة على جملة مستأنفة مقدرة أي فاجتمعوا فأتبعوهم.", "color": "black"}]}]