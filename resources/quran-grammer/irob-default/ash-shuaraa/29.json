[{"row_id": 1, "segments": [{"text": "{ قَالَ لَئِنِ اتَّخَذْتَ إِلَهًا غَيْرِي لأَجْعَلَنَّكَ مِنَ الْمَسْجُونِينَ", "color": "brown"}, {"text": "(  الشعراء: 29  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "تعرب كسابقتها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "قَالَ: فعل ماضٍ مبنيّ على الفتح.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: هو».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَئِنِ﴾:", "color": "green"}, {"text": "اللام: موطئة للقسم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إن: حرف شرط جازم مبنيّ على السّكون وحرك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿اتَّخَذْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السّكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿إِلَهًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿غَيْرِي﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "إلهًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة المقدّرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿لأَجْعَلَنَّكَ ﴾:", "color": "green"}, {"text": "اللام: واقعة في جواب القسم المقدّر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "اجعلنك: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الثقيلة لا محل لها من الإعراب.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿مِنَ﴾:", "color": "green"}, {"text": "حرف جرّ.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿الْمَسْجُونِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "والجار والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "أجعلنك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن اتخذت", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "أجعلنك", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب القسم المقدر وجواب الشرط محذوف دل عليه جواب القسم.", "color": "black"}]}]