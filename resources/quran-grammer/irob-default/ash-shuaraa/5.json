[{"row_id": 1, "segments": [{"text": "{ وَمَا يَأْتِيهِمْ مِنْ ذِكْرٍ مِنَ الرَّحْمَنِ مُحْدَثٍ إِلَّا كَانُوا عَنْهُ مُعْرِضِينَ", "color": "brown"}, {"text": "(  الشعراء: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَأْتِيهِمْ﴾:", "color": "green"}, {"text": "يأتي: فعل مضارع مرفوع بالضمة المقدرة على الياء للثقل.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جرّ زائد للتوكيد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ذِكْر﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا مرفوع محلًا على أنه فاعل \"", "color": "black"}, {"text": "يأتي", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ الرَّحْمَنِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بصفة محذوفة من \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مُحْدَثٍ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "ذكر", "color": "blue"}, {"text": "\" مجرورة بالكسرة على اللفظ لا المحل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كَانُوا﴾:", "color": "green"}, {"text": "فعل ماض ناقص مبنيّ على الضم لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\"، و \"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿عَنْهُ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿مُعْرِضِينَ﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما يأتيهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "إن نشأ", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كانوا عنه معرضين", "color": "blue"}, {"text": "\" في محلّ نصب حال من ضمير مبنيّ الغائب المفعول.", "color": "black"}]}]