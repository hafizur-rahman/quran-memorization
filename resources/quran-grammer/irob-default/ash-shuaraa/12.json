[{"row_id": 1, "segments": [{"text": "{ قَالَ رَبِّ إِنِّي أَخَافُ أَنْ يُكَذِّبُونِ", "color": "brown"}, {"text": "(  الشعراء: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿رَبِّ﴾:", "color": "green"}, {"text": "منادي منصوب بالفتحة المقدّرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة، و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبه بالفعل والياء\"", "color": "black"}, {"text": ": ضمير متّصل مبنيّ في محلّ نصب اسم", "color": "blue"}, {"text": "\"إن\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَخَافُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف مصدري ونصب.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿يُكَذِّبُونِ﴾:", "color": "green"}, {"text": "فعل مضارع منصوب بحذف النون.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "النون", "color": "blue"}, {"text": "\": نون الوقاية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\" المحذوفة: ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن