[{"row_id": 1, "segments": [{"text": "{ قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَمِنَ الْمُقَرَّبِينَ", "color": "brown"}, {"text": "(  الشعراء: 42  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَعَمْ﴾:", "color": "green"}, {"text": "حرف جواب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿وَإِنَّكُمْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "إن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِذًا﴾:", "color": "green"}, {"text": "حرف جواب.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿لَمِنَ﴾:", "color": "green"}, {"text": "اللام: للتوكيد.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "من: حرف جر.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْمُقَرَّبِينَ﴾:", "color": "green"}, {"text": "اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجار والمجرور متعلّقان بخبر \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إنكم لمن المقربين", "color": "blue"}, {"text": "\" في محلّ نصب معطوفة على جملة \"", "color": "black"}, {"text": "مقول القول", "color": "