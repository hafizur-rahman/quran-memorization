[{"row_id": 1, "segments": [{"text": "{ وَإِذْ نَادَى رَبُّكَ مُوسَى أَنِ ائْتِ الْقَوْمَ }", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "وَإِذْ: الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم مبنيّ على السكون في محلّ محلّ نصب مفعول به لفعل محذوف تقديره: اذكر إذ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿نَادَى﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح المقدّر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿رَبُّكَ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مُوسَى﴾:", "color": "green"}, {"text": "مفعول به منصوب بالفتحة المقدّرة على الألف للتعذّر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَنِ﴾:", "color": "green"}, {"text": "حرف تفسير مبنيّ على السكون وحرك بالكسر منعًا لالتقاء الساكنين.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿ائْتِ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على حذف حرف العلة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿الْقَوْمَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿الظَّالِمِينَ﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "القوم", "color": "blue"}, {"text": "\" منصوبة بالياء، لأنّها جمع مذكر سالم.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "نادي ربك", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ائت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها تفسيرية.", "color": "black"}]}]