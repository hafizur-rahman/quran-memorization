[{"row_id": 1, "segments": [{"text": "{ وَإِذَا بَطَشْتُمْ بَطَشْتُمْ جَبَّارِينَ", "color": "brown"}, {"text": "(  الشعراء: 130  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذا: ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بجوابه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿بَطَشْتُمْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "تم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بَطَشْتُمْ﴾:", "color": "green"}, {"text": "تعرب إعراب الأولى.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿جَبَّارِينَ﴾:", "color": "green"}, {"text": "حال منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بطشتم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بطشتم", "color": "blue"}, {"text": "\"", "color": "black"}, {"text": "( الثانية )", "color": "green"}, {"text": "لا محلّ لها من الإعراب، لأنّها جواب شرط غير جازم.", "color": "black"}]}]