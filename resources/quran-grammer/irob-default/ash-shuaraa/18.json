[{"row_id": 1, "segments": [{"text": "{ قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ", "color": "brown"}, {"text": "(  الشعراء: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿أَلَمْ﴾:", "color": "green"}, {"text": "الهمزة: همزة استفهام تفيد التوبيخ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "لم: حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿نُرَبِّكَ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بحذف حرف العلة والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿فِينَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نربك", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَلِيدًا﴾:", "color": "green"}, {"text": "حال منصوب بالفتحة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَبِثْتَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لبثت: فعل ماضٍ مبنيّ على السّكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿فِينَا﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "لبثت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنْ عُمُرِكَ﴾:", "color": "green"}, {"text": "جار ومجر