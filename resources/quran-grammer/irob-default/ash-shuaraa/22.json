[{"row_id": 1, "segments": [{"text": "{ وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَيَّ أَنْ عَبَّدْتَ بَنِي إِسْرَائِيلَ", "color": "brown"}, {"text": "(  الشعراء: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَتِلْكَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "تي: اسم إشارة مبنيّ على السّكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "\"", "color": "black"}, {"text": "اللام", "color": "blue"}, {"text": "\": حرف للبعد.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": حرف للخطاب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "( وقد تكون تلك\" كلمة واحدة مبنية على الفتح )", "color": "green"}, {"text": ".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿نِعْمَةٌ﴾:", "color": "green"}, {"text": "خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿تَمُنُّهَا﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "و \"", "color": "black"}, {"text": "ها", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿عَلَيَّ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "تمنها", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿أَنْ﴾:", "color": "green"}, {"text": "حرف تفسير.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿عَبَّدْتَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على السّكون لاتصاله بضمير الرفع المتحرك، و \"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿بَنِي﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "وهو مضاف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿إِسْرَائِيلَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من الكسرة، لأنه ممنوع من الصرف.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تمنها", "color": "blue"}, {"text": "\" في محلّ رفع نعت لـ \"", "color": "black"}, {"text": "نعمة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "عبدت", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها صلة الموصول \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\".", "color": "black"}]}]