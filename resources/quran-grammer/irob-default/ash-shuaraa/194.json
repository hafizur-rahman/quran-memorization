[{"row_id": 1, "segments": [{"text": "{ عَلَى قَلْبِكَ لِتَكُونَ مِنَ الْمُنْذِرِينَ", "color": "brown"}, {"text": "(  الشعراء: 194  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عَلَى قَلْبِكَ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بالفعل \"", "color": "black"}, {"text": "نزل", "color": "blue"}, {"text": "\"، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محل جر بالإضافة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لِتَكُونَ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "تكون: فعل مضارع ناقص منصوب بالفتحة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "واسمها ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و\"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" وما بعدها بتأويل مصدر في محلّ جرّ باللام والجارّ والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "نزل", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنَ الْمُنْذِرِينَ﴾:", "color": "green"}, {"text": "من: حرف جر.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "المنذرين: اسم مجرور بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والجار والمجرور متعلقان بخبر \"", "color": "black"}, {"text": "تكون", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "تكون", "color": "blue"}, {"text": "\" لا محل لها من الإعراب، لأنها صلة الموصول \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المضمر.", "color": "black"}]}]