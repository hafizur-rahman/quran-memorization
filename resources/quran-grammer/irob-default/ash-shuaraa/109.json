[{"row_id": 1, "segments": [{"text": "{ وَمَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِيَ إِلَّا عَلَى رَبِّ الْعَالَمِينَ", "color": "brown"}, {"text": "(  الشعراء: 109  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "ما: حرف نفي.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَسْأَلُكُمْ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنا.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿و \"", "color": "green"}, {"text": "كم", "color": "green"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "green"}]}, {"row_id": 7, "segments": [{"text": "﴿عَلَيْهِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أسألكم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنْ﴾:", "color": "green"}, {"text": "حرف جر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿أَجْرٍ﴾:", "color": "green"}, {"text": "اسم مجرور لفظًا منصوب محلًا على أنه مفعول به ثانٍ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِنْ﴾:", "color": "green"}, {"text": "مخففة مهملة نافية.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿أَجْرِيَ﴾:", "color": "green"}, {"text": "مبتدأ مرفوع بالضمة المقدرة على ما قبل الياء منع من ظهورها اشتغال المحلّ بالحركة المناسبة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿عَلَى رَبِّ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بخبر المبتدأ \"", "color": "black"}, {"text": "أجري", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿الْعَالَمِينَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالياء، لأنه ملحق بجمع المذكر السالم.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن أجري إلا على رب", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 17, "segments": []}]