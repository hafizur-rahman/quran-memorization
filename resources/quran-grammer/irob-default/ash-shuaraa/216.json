[{"row_id": 1, "segments": [{"text": "{ فَإِنْ عَصَوْكَ فَقُلْ إِنِّي بَرِيءٌ مِمَّا تَعْمَلُونَ", "color": "brown"}, {"text": "(  الشعراء: 216  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَإِنْ﴾:", "color": "green"}, {"text": "الفاء: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿عَصَوْكَ﴾:", "color": "green"}, {"text": "فعل ماض، فعل الشرط، مبنيّ على الفتح المقدر للتعذّر على الألف المحذوفة لاتصاله بواو الجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿فَقُلْ﴾:", "color": "green"}, {"text": "الفاء: واقعة في جواب الشرط.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "قال: فعل أمر مبنيّ على السكون والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿إِنِّي﴾:", "color": "green"}, {"text": "إن: حرف توكيد مشبّه بالفعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "والياء: ضمير متّصل مبنيّ في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بَرِيءٌ﴾:", "color": "green"}, {"text": "خبرها مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿مِمَّا﴾:", "color": "green"}, {"text": "أصلها: من: حرف جر.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "و\"", "color": "black"}, {"text": "ما", "color": "blue"}, {"text": "\": اسم موصول أو حرف مصدريّ.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "بريء", "color": "blue"}, {"