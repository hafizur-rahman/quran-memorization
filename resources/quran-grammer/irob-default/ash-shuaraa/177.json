[{"row_id": 1, "segments": [{"text": "{ إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ", "color": "brown"}, {"text": "(  الشعراء: 177  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿هذه الآية تعرب إعراب الآية السادسة بعد المئة.", "color": "green"}]}, {"row_id": 3, "segments": [{"text": "وهو﴾: « إِذْ: ظرف زمان مبنيّ على السكون في محلّ نصب مفعول فيه متعلّق بـ \"", "color": "black"}, {"text": "كذبت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿قَالَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جر.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "والجارّ والمجرور متعلّقان بـ\"", "color": "black"}, {"text": "قال", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿أَخُوهُمْ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو، لأنه من الأسماء الخمسة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿نُوحٌ﴾:", "color": "green"}, {"text": "عطف بيان أو بدل لـ \"", "color": "black"}, {"text": "أخوهم", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "قال لهم أخوهم", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ألا تتقون", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"t