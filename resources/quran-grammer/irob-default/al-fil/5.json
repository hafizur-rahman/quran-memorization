[{"row_id": 1, "segments": [{"text": "{ فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ", "color": "brown"}, {"text": "(  الفيل: 5  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿فَجَعَلَهُمْ﴾:", "color": "green"}, {"text": "معطوفة بالفاء على \"", "color": "black"}, {"text": "أرسل", "color": "blue"}, {"text": "\"، وتعرب إعرابها، وهو : «", "color": "black"}, {"text": "أرسل: فعل ماضٍ مبنيّ على الفتحة، وفاعله ضمير مستتر فيه جوازًا تقديره: هو", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "و \"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "و \"", "color": "black"}, {"text": "الميم", "color": "blue"}, {"text": "\": للجماعة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿كَعَصْفٍ﴾:", "color": "green"}, {"text": "الكاف: اسم بمعنى \"", "color": "black"}, {"text": "مثل", "color": "blue"}, {"text": "\" مبنيّ على الفتح في محلّ نصب مفعول به ثانٍ، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "عصف: مضاف إليه مجرور بالإضافة وعلامة جره الكسرة.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مَأْكُولٍ﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "عصف", "color": "blue"}, {"text": "\" مجرورة وعلامة جرها الكسرة الظاهرة على آخرها.", "color": "black"}]}]