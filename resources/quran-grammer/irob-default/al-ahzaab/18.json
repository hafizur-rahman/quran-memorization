[{"row_id": 1, "segments": [{"text": "{ * قَدْ يَعْلَمُ اللَّهُ الْمُعَوِّقِينَ مِنْكُمْ وَالْقَائِلِينَ لإِخْوَانِهِمْ هَلُمَّ إِلَيْنَا وَلَا يَأْتُونَ الْبَأْسَ إِلَّا قَلِيلًا", "color": "brown"}, {"text": "(  الأحزاب: 18  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿قَدْ﴾:", "color": "green"}, {"text": "حرف تحقيق.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿يَعْلَمُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُعَوِّقِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب بالياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنْكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة \"", "color": "black"}, {"text": "من المعوقين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَالْقَائِلِينَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "المعوقين", "color": "blue"}, {"text": "\"، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لإِخْوَانِهِمْ﴾:", "color": "green"}, {"text": "لإخوان: جارّ ومجرور متعلّقان بالقائلين، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿هَلُمَّ﴾:", "color": "green"}, {"text": "اسم فعل أمر مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿إِلَيْنَا﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "هلم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَلَا﴾:", "color": "green"}, {"text": "الواو: حالية أو عطف، أو استئنافيّة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "لا: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿يَأْتُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿الْبَأْسَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿قَلِيلًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يعلم الله", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "هلم", "color": "blue"}, {"text": "\" في محلّ نصب \"", "color": "black"}, {"text": "مقول القول", "color": "blue"}, {"text": "\" عامله القائلين.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لا يأتون", "color": "blue"}, {"text": "\" في محلّ نصب حال.", "color": "black"}]}]