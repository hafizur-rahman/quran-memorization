[{"row_id": 1, "segments": [{"text": "{ يَانِسَاءَ النَّبِيِّ مَنْ يَأْتِ مِنْكُنَّ بِفَاحِشَةٍ مُبَيِّنَةٍ يُضَاعَفْ لَهَا الْعَذَابُ ضِعْفَيْنِ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا", "color": "brown"}, {"text": "(  الأحزاب: 30  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَانِسَاءَ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "نساء: منادى منصوب، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿النَّبِيِّ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مَنْ﴾:", "color": "green"}, {"text": "اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَأْتِ﴾:", "color": "green"}, {"text": "فعل مضارع فعل الشّرط مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلّة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْكُنَّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من الاسم الموصول \"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿بِفَاحِشَةٍ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ زائد.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "فاحشة: اسم مجرور لفظًا منصوب محلًا، لأنه مفعول به.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مُبَيِّنَةٍ﴾:", "color": "green"}, {"text": "نعت لـ\"", "color": "black"}, {"text": "فاحشة", "color": "blue"}, {"text": "\" مجرور بالكسرة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يُضَاعَفْ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره.", "color": "black"}]}, {"row_id": 12, "segments": 