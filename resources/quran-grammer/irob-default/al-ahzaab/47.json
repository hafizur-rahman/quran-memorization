[{"row_id": 1, "segments": [{"text": "{ وَبَشِّرِ الْمُؤْمِنِينَ بِأَنَّ لَهُمْ مِنَ اللَّهِ فَضْلًا كَبِيرًا", "color": "brown"}, {"text": "(  الأحزاب: 47  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَبَشِّرِ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "بشر: فعل أمر مبنيّ على السكون وقد حرك بالكسر لالتقاء الساكنين، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿الْمُؤْمِنِينَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿بِأَنَّ﴾:", "color": "green"}, {"text": "الباء: حرف جرّ.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "أن: حرف توكيد مشبه بالفعل.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَهُمْ﴾:", "color": "green"}, {"text": "اللام: حرف جرّ.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ باللام.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "والجار والمجرور متعلّقان بخبر \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" المقدم.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "و \"", "color": "black"}, {"text": "أن", "color": "blue"}, {"text": "\" واسمها وخبرها بتأويل مصدر في محلّ جرّ بالباء.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "والجار والمجرور متعلّقان بـ \"", "color": "black"}, {"text": "بشِّر", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿مِنَ اللَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان باسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" أو بحال منه.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿فَضْلًا﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿كَبِيرًا﴾:", "color": "green"}, {"text": "صفة لـ\"", "color": "black"}, {"text": "فضلًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "بشر", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على استئناف مقدر، أي: راقب الناس وبشر.", "color": "black"}]}]