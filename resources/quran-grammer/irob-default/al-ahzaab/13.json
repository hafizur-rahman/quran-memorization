[{"row_id": 1, "segments": [{"text": "{ وَإِذْ قَالَتْ طَائِفَةٌ مِنْهُمْ يَاأَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَارْجِعُوا وَيَسْتَأْذِنُ فَرِيقٌ مِنْهُمُ النَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِيَ بِعَوْرَةٍ إِنْ يُرِيدُونَ إِلَّا فِرَارًا", "color": "brown"}, {"text": "(  الأحزاب: 13  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "إذ", "color": "blue"}, {"text": "\" في الآية السابقة، وتعرب إعرابها.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "وهو: «", "color": "black"}, {"text": "وَإِذْ: الواو: حرف عطف.", "color": "blue"}]}, {"row_id": 4, "segments": [{"text": "إذ: اسم مبنيّ على السكون في محلّ نصب مفعول به بفعل مضمر تقديره: اذكر».", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿قَالَتْ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "التاء", "color": "blue"}, {"text": "\": حرف للتأنيث لا محلّ له من الإعراب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿طَائِفَةٌ﴾:", "color": "green"}, {"text": "فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْهُمْ﴾:", "color": "green"}, {"text": "من: حرف جر، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "والجارّ والمجرور متعلّقان بصفة لـ\"", "color": "black"}, {"text": "طائفة", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿يَاأَهْلَ﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "أهل: منادى منصوب بالفتحة.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿يَثْرِبَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور بالفتحة بدلًا من