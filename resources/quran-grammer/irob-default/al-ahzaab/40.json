[{"row_id": 1, "segments": [{"text": "{ مَا كَانَ مُحَمَّدٌ أَبَا أَحَدٍ مِنْ رِجَالِكُمْ وَلَكِنْ رَسُولَ اللَّهِ وَخَاتَمَ النَّبِيِّينَ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا", "color": "brown"}, {"text": "(  الأحزاب: 40  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿كَانَ﴾:", "color": "green"}, {"text": "فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿مُحَمَّدٌ﴾:", "color": "green"}, {"text": "اسم \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿أَبَا﴾:", "color": "green"}, {"text": "خبرها منصوب بالألف، لأنه من الأسماء الخمسة، وهو مضاف.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿أَحَدٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِنْ رِجَالِكُمْ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بصفة لـ \"", "color": "black"}, {"text": "أبا", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "كم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الضم في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَلَكِنْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "لكن: حرف استدراك.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿رَسُولَ﴾:", "color": "green"}, {"text": "معطوف على \"", "color": "black"}, {"text": "أبا", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهِ﴾:", "color": "green"}, {"text": "لفظ الجلالة: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَخَاتَمَ النَّبِيِّينَ﴾:", "color": "green"}, {"text": "معطوفة بالواو على رسول الله\"", "color": "black"}, {"text": "، وتعرب إعرابها، وعلامة جرّ", "color": "blue"}, {"text": "\"النبيين\" الياء، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "﴿وَكَانَ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "كان: فعل ماضٍ ناقص مبنيّ على الفتح.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: اسمها مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿بِكُلِّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بخبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "﴿شَيْءٍ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور و علامة جره الكسرة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿عَلِيمًا﴾:", "color": "green"}, {"text": "خبر \"", "color": "black"}, {"text": "كان", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "ما كان محمد أبا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها استئنافية.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "كان الله بكل شيء عليمًا", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "ما كان محمد", "color": "blue"}, {"text": "\".", "color": "black"}]}]