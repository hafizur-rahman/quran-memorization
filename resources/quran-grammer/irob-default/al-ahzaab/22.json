[{"row_id": 1, "segments": [{"text": "{ وَلَمَّا رَأَى الْمُؤْمِنُونَ الْأَحْزَابَ قَالُوا هَذَا مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ وَصَدَقَ اللَّهُ وَرَسُولُهُ وَمَا زَادَهُمْ إِلَّا إِيمَانًا وَتَسْلِيمًا", "color": "brown"}, {"text": "(  الأحزاب: 22  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَلَمَّا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "لما: اسم شرط غير جازم مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَأَى﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح المقدّر على الألف للتعذّر.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُؤْمِنُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الْأَحْزَابَ﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿قَالُوا﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الضم، لاتصاله بواو الجماعة، و\"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل، و\"", "color": "black"}, {"text": "الألف", "color": "blue"}, {"text": "\": فارقة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿هَذَا﴾:", "color": "green"}, {"text": "ها: حرف للتنبيه.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "ذا: اسم إشارة مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ رفع خبر المبتدأ.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَعَدَنَا﴾:", "color": "green"}, {"text": "وعد: فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَرَسُولُهُ﴾:", "color": "green"}, {"text": "معطوف على لفظ الجلالة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "{ وَصَدَقَ اللَّهُ وَرَسُولُهُ }", "color": "brown"}]}, {"row_id": 15, "segments": [{"text": ": الواو: حرف عطف.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "صدق الله ورسوله: تعرب إعراب \"", "color": "black"}, {"text": "وعد الله ورسوله", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "﴿وَمَا﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "ما: حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 19, "segments": [{"text": "﴿زَادَهُمْ﴾:", "color": "green"}, {"text": "زاد: فعل ماضٍ مبنيّ على الفتح و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 20, "segments": [{"text": "والفاعل محذوف، لأنه معلوم من السياق أو لأن ما قبله يدل عليه وهو رؤية المؤمنين الأحزاب.", "color": "black"}]}, {"row_id": 21, "segments": [{"text": "بمعنى: وما زادهم هول الرؤية أو يكون \"", "color": "black"}, {"text": "الرؤية", "color": "blue"}, {"text": "\" نفسها.", "color": "black"}]}, {"row_id": 22, "segments": [{"text": "وقد ذكر الفعل \"", "color": "black"}, {"text": "زاد", "color": "blue"}, {"text": "\" مع الفاعل المقدّر \"", "color": "black"}, {"text": "الرؤية", "color": "blue"}, {"text": "\" لأنه فصل عنه بفاصل وهو\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\" في \"", "color": "black"}, {"text": "زادهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 23, "segments": [{"text": "والفاعل ضمير مستتر فيه جوازًا تقديره: هو، أي: هول الرؤية.", "color": "black"}]}, {"row_id": 24, "segme