[{"row_id": 1, "segments": [{"text": "{ رَبَّنَا آتِهِمْ ضِعْفَيْنِ مِنَ الْعَذَابِ وَالْعَنْهُمْ لَعْنًا كَبِيرًا", "color": "brown"}, {"text": "(  الأحزاب: 68  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "رَبَّنَا: أعربت في الآية السابقة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": ": وهو : «", "color": "black"}, {"text": "رَبَّنَا: منادي بحرف نداء محذوف، والتقدير: يا ربنا منصوب بالفتحة، و \"", "color": "blue"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ جرّ بالإضافة", "color": "blue"}, {"text": "».", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "آتِهِمْ: فعل تضرع وطلب مبنيّ على حذف حرف العلة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ نصب مفعول به أول.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿ضِعْفَيْنِ﴾:", "color": "green"}, {"text": "مفعول به ثان منصوب بالياء، لأنه مثنى.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿مِنَ الْعَذَابِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بنعت لـ \"", "color": "black"}, {"text": "ضعفين", "color": "blue"}, {"text": "\"، أو بـ \"", "color": "black"}, {"text": "آتهم", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَالْعَنْهُمْ﴾:", "color": "green"}, {"text": "معطوفة بالواو على \"", "color": "black"}, {"text": "آتهم", "color": "blue"}, {"text": "\"، وتعرب إعرابها، وعلامة بناء الفعل السكون الظاهر.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿لعنًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿كبيرا﴾:", "color": "green"}, {"text": "صفة لـ \"", "color": "black"}, {"text": "لعنًا", "color": "blue"}, {"text": "\" منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة النداء لا محلّ لها من الإعراب، لأنّها استئنافيّة.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "آتهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها جواب النداء.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "العنهم", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنّها معطوفة على جملة \"", "color": "black"}, {"text": "آتهم", "color": "blue"}, {"text": "\".", "color": "black"}]}]