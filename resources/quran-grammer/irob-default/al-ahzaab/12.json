[{"row_id": 1, "segments": [{"text": "{ وَإِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ إِلَّا غُرُورًا", "color": "brown"}, {"text": "(  الأحزاب: 12  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم مبنيّ على السكون في محلّ نصب مفعول به بفعل مضمر تقديره: اذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَقُولُ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿الْمُنَافِقُونَ﴾:", "color": "green"}, {"text": "فاعل مرفوع بالواو، لأنه جمع مذكر سالم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿وَالَّذِينَ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الذين: اسم موصول مبنيّ على الفتح في محلّ رفع، لأنه معطوف على \"", "color": "black"}, {"text": "المنافقون", "color": "blue"}, {"text": "\" المرفوعة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿فِي قُلُوبِهِمْ﴾:", "color": "green"}, {"text": "في قلوب: جارّ ومجرور متعلّقان بخبر مقدم، و\"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿مَرَضٌ﴾:", "color": "green"}, {"text": "مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿مَا﴾:", "color": "green"}, {"text": "حرف نفي لا عمل له.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿وَعَدَنَا﴾:", "color": "green"}, {"text": "وعد: فعل ماضٍ مبنيّ على الفتح، و\"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب مفعول به مقدم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "﴿اللَّهُ﴾:", "color": "green"}, {"text": "لفظ الجلالة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 13, "segments": [{"text": "﴿وَرَسُولُهُ﴾:", "color": "green"}, {"text": "معطوف بالواو على لفظ الجلالة مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 14, "segments": [{"text": "و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 15, "segments": [{"text": "﴿إِلَّا﴾:", "color": "green"}, {"text": "حرف حصر لا عمل له.", "color": "black"}]}, {"row_id": 16, "segments": [{"text": "﴿غُرُورًا﴾:", "color": "green"}, {"text": "مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 17, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "يقول المنافقون", "color": "blue"}, {"text": "\" في محلّ جرّ مضاف إليه.", "color": "black"}]}, {"row_id": 18, "segments": [{"text": "وجملة في قلوبهم مرض\"", "color": "black"}, {"text": "لا محلّ لها من الإعراب، لأنّها صلة الموصول", "color": "blue"}, {"text": "\"الذين\"", "color": "black"}, {"text": ".", "color": "blue"}]}, {"row_id": 19, "segments": [{"text": "وجملة \"ما وعدنا الله\"", "color": "black"}, {"text": "في محلّ نصب", "color": "blue"}, {"text": "\"مقول القول\".", "color": "black"}]}]