[{"row_id": 1, "segments": [{"text": "{ وَإِذْ أَخَذْنَا مِنَ النَّبِيِّينَ مِيثَاقَهُمْ وَمِنْكَ وَمِنْ نُوحٍ وَإِبْرَاهِيمَ وَمُوسَى وَعِيسَى ابْنِ مَرْيَمَ وَأَخَذْنَا مِنْهُمْ مِيثَاقًا غَلِيظًا", "color": "brown"}, {"text": "(  الأحزاب: 7  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَإِذْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "إذ: اسم مبنيّ على السّكون في محلّ نصب مفعول به لفعل محذوف تقديره: اذكر.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿أَخَذْنَا﴾:", "color": "green"}, {"text": "أخذ: فعل ماضٍ مبنيّ على السّكون، لاتصاله بضمير رفع متحرك.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السّكون في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿مِنَ النَّبِيِّينَ﴾:", "color": "green"}, {"text": "جار ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أخذنا", "color": "blue"}, {"text": "\"، وعلامة جرّ الاسم \"", "color": "black"}, {"text": "الياء", "color": "blue"}, {"text": "\"، لأنّه جمع مذكر سالم والنون عوض عن التنوين في الاسم المفرد.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿مِيثَاقَهُمْ﴾:", "color": "green"}, {"text": "ميثاق: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَمِنْكَ﴾:", "color": "green"}, {"text": "جار ومجرور معطوف على \"", "color": "black"}, {"text": "من النبيين", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿وَمِنْ نُوحٍ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "من نوح: جارّ ومجرور متعلّقان بـ \"", "color": "black"}, {"text": "أخذنا", "color": "blue"}, {"text":