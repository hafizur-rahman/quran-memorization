[{"row_id": 1, "segments": [{"text": "{ يَاأَيُّهَا النَّبِيُّ إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا", "color": "brown"}, {"text": "(  الأحزاب: 45  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَاأَيُّهَا﴾:", "color": "green"}, {"text": "يا: حرف نداء.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "أيها: أي: اسم منادى مبنيّ على الضم في محلّ نصب.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿و \"", "color": "green"}, {"text": "ها", "color": "green"}, {"text": "\": حرف للتنبيه.", "color": "green"}]}, {"row_id": 5, "segments": [{"text": "﴿النَّبِيُّ﴾:", "color": "green"}, {"text": "عطف بيان لـ \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" مرفوع بالضمة على لفظ \"", "color": "black"}, {"text": "أي", "color": "blue"}, {"text": "\" لا على محلها.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿إِنَّا﴾:", "color": "green"}, {"text": "إنّ: حرف توكيد مشبه بالفعل، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "إن", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿أَرْسَلْنَاكَ﴾:", "color": "green"}, {"text": "أرسل: فعل ماضٍ مبنيّ على السكون لاتصاله بضمير الرفع المتحرك.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل، و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ نصب مفعول به.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "﴿شَاهِدًا﴾:", "color": "green"}, {"text": "حال منصوبة بالفتحة.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿وَمُبَشِّرًا وَنَذِيرًا﴾:", "color": "green"}, {"text": "معطوفتان بواوي العطف على \"", "color": "black"}, {"text": "شاهدًا", "color": "blue"}, {"text": "\"، و