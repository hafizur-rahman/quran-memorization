[{"row_id": 1, "segments": [{"text": "{ يَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِي النَّارِ يَقُولُونَ يَالَيْتَنَا أَطَعْنَا اللَّهَ وَأَطَعْنَا الرَّسُولَا", "color": "brown"}, {"text": "(  الأحزاب: 66  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿يَوْمَ﴾:", "color": "green"}, {"text": "مفعول به بفعل مضمر تقديره: اذكر يوم، وعلامة نصبه الفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿تُقَلَّبُ﴾:", "color": "green"}, {"text": "فعل مضارع للمجهول مرفوع وعلامة رفعه الضمة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿وُجُوهُهُمْ﴾:", "color": "green"}, {"text": "نائب فاعل مرفوع وعلامة رفعه الضمة، و \"", "color": "black"}, {"text": "هم", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿فِي النَّارِ﴾:", "color": "green"}, {"text": "جار ومجرور متعلقان بـ \"", "color": "black"}, {"text": "تقلب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَقُولُونَ﴾:", "color": "green"}, {"text": "فعل مضارع مرفوع بثبوت النون، و \"", "color": "black"}, {"text": "الواو", "color": "blue"}, {"text": "\" ضمير متّصل مبنيّ في محلّ رفع فاعل.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿يَالَيْتَنَا﴾:", "color": "green"}, {"text": "يا: حرف تنبيه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "ليت: حرف تمنّ مشبّه بالفعل.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ نصب اسم \"", "color": "black"}, {"text": "ليت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿أَطَعْنَا﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على السكون لاتصاله بضمير رفع متحرك، و \"", "color": "black"}, {"text": "نا", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على السكون في محلّ رفع فاعل.", "color": "blac