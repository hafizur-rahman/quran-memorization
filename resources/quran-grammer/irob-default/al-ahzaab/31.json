[{"row_id": 1, "segments": [{"text": "{ * وَمَنْ يَقْنُتْ مِنْكُنَّ لِلَّهِ وَرَسُولِهِ وَتَعْمَلْ صَالِحًا نُؤْتِهَا أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًا كَرِيمًا", "color": "brown"}, {"text": "(  الأحزاب: 31  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿وَمَنْ﴾:", "color": "green"}, {"text": "الواو: حرف استئناف.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "من: اسم شرط جازم مبنيّ على السكون في محلّ رفع مبتدأ.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿يَقْنُتْ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة جزمه سكون آخره، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿مِنْكُنَّ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة من الاسم الموصول.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿لِلَّهِ﴾:", "color": "green"}, {"text": "خافض ومخفوض متعلّقان بـ\"", "color": "black"}, {"text": "يقنت", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿وَرَسُولِهِ﴾:", "color": "green"}, {"text": "معطوفة بالواو على لفظ الجلالة مخفوض بالكسرة، و\"", "color": "black"}, {"text": "الهاء", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿وَتَعْمَلْ﴾:", "color": "green"}, {"text": "الواو: حرف عطف.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "تعمل: فعل مضارع مجزوم، وعلامة جزمه سكون آخره، والفاعل ضمير مستتر فيه جوازًا تقديره: هي.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿صَالِحًا﴾:", "color": "green"}, {"text": "مفعول به منصوب وعلامة نصبه الفتحة الظاهرة على آخره.", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "﴿نُؤْتِهَا﴾:", "color": "green"}, {"text": "نؤت: فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "من", "color": "blue"}, {"text": "\"، وعلامة ج