[{"row_id": 1, "segments": [{"text": "{ عَبْدًا إِذَا صَلَّى", "color": "brown"}, {"text": "(  العلق: 10  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿عَبْدًا﴾:", "color": "green"}, {"text": "مفعول به للفعل \"", "color": "black"}, {"text": "ينهي", "color": "blue"}, {"text": "\" منصوب بالفتحة.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿إِذَا﴾:", "color": "green"}, {"text": "ظرف لما يستقبل من الزمن مبنيّ على السكون في محلّ نصب متضمن معنى الشرط خافض لشرطه متعلّق بجوابه مبنيّ على السكون في محلّ نصب مفعول فيه.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿صَلَّى﴾:", "color": "green"}, {"text": "فعل ماض مبنيّ على الفتح المقدّر على الألف للتعذّر، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "صلي", "color": "blue"}, {"text": "\" في محلّ جرّ بالإضافة.", "color": "black"}]}]