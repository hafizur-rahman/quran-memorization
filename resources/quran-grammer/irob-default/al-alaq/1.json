[{"row_id": 1, "segments": [{"text": "سورة العلق\nبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ", "color": "black"}, {"text": "{ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ", "color": "brown"}, {"text": "(  العلق: 1  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿اقْرَأْ﴾:", "color": "green"}, {"text": "فعل أمر مبنيّ على السكون، والفاعل ضمير مستتر فيه وجوبًا تقديره: أنت.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿بِاسْمِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بحال محذوفة، أي: مفتتحًا باسم ربك.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "﴿رَبِّكَ﴾:", "color": "green"}, {"text": "مضاف إليه مجرور وعلامة جره الكسرة الظاهرة على آخره، وهو مضاف.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "و \"", "color": "black"}, {"text": "الكاف", "color": "blue"}, {"text": "\": ضمير متّصل مبنيّ على الفتح في محلّ جرّ بالإضافة.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿الَّذِي﴾:", "color": "green"}, {"text": "اسم موصول مبنيّ على السكون في محلّ جرّ صفة لـ\"", "color": "black"}, {"text": "الرب", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "﴿خَلَقَ﴾:", "color": "green"}, {"text": "فعل ماضٍ مبنيّ على الفتح، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "خلق", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنه صلة الموصول.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "اقرأ", "color": "blue"}, {"text": "\" لا محلّ لها من الإعراب، لأنها ابتدائية.", "color": "black"}]}]