[{"row_id": 1, "segments": [{"text": "{  كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ", "color": "brown"}, {"text": "(  العلق: 15  )", "color": "green"}, {"text": "}", "color": "brown"}]}, {"row_id": 2, "segments": [{"text": "﴿كَلَّا﴾:", "color": "green"}, {"text": "حرف زجرّ وردع لا عمل له.", "color": "black"}]}, {"row_id": 3, "segments": [{"text": "﴿لَئِنْ﴾:", "color": "green"}, {"text": "اللام: حرف موطئ للقسم.", "color": "black"}]}, {"row_id": 4, "segments": [{"text": "إن: حرف شرط جازم.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "﴿لَمْ﴾:", "color": "green"}, {"text": "حرف نفي وجزم وقلب.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "﴿يَنْتَهِ﴾:", "color": "green"}, {"text": "فعل مضارع مجزوم بـ\"", "color": "black"}, {"text": "لم", "color": "blue"}, {"text": "\"، وعلامة جزمه حذف حرف العلّة، والفاعل ضمير مستتر فيه جوازًا تقديره: هو.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "إن لم ينته", "color": "blue"}, {"text": "\" اعتراضية بين القسم المحذوف وجوابه لا محلّ لها من الإعراب أي: لئن لم يرجع عما هو فيه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "﴿لَنَسْفَعًا﴾:", "color": "green"}, {"text": "اللام: حرف واقع في جواب القسم المقدّر.", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "نسفعًا: فعل مضارع مبنيّ على الفتح لاتصاله بنون التوكيد الخفيفة، ونون التوكيد الخفيفة المبدلة ألفًا لا محلّ لها من الإعراب، والفاعل ضمير مستتر فيه وجوبًا تقديره: نحن.", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "﴿بِالنَّاصِيَةِ﴾:", "color": "green"}, {"text": "جارّ ومجرور متعلّقان بـ\"", "color": "black"}, {"text": "نسفع", "color": "blue"}, {"text": "\".", "color": "black"}]}, {"row_id": 11, "segments": [{"text": "وجملة \"", "color": "black"}, {"text": "لنسفعًا", "color": "blue"}, {"text": "\" جواب القسم المقدر لا محلّ لها من الإعراب وجواب الشرط محذوف دل عليه جواب القسم.", "color": "black"}]}, {"row_id": 12, "segments": [{"text": "وجملة القسم استئنافية لا محلّ لها من الإعراب.", "color": "black"}]}]