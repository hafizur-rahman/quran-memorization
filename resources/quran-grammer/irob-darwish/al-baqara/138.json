[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": الآيات 138 الى 139]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "صِبْغَةَ اللَّهِ وَمَنْ أَحْسَنُ مِنَ اللَّهِ صِبْغَةً وَنَحْنُ لَهُ عابِدُونَ", "color": "black"}, {"text": "(138)", "color": "red"}, {"text": "قُلْ أَتُحَاجُّونَنا فِي اللَّهِ وَهُوَ رَبُّنا وَرَبُّكُمْ وَلَنا أَعْمالُنا وَلَكُمْ أَعْمالُكُمْ وَنَحْنُ لَهُ مُخْلِصُونَ", "color": "black"}, {"text": "(139)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(صِبْغَةَ)", "color": "red"}, {"text": ": بكسر الصاد مصدر هيئة من صبغ والمراد بها هنا الدين وسمّي صبغة لظهور أثره على معتنقه.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 6, "segments": [{"text": "(صِبْغَةَ اللَّهِ)", "color": "red"}, {"text": "مصدر مؤكد فهو مفعول مطلق لفعل محذوف، وفيها إشارة الى ما أوجده الله في الناس من بدائه العقول", "color": "black"}, {"text": "(وَمَنْ)", "color": "red"}, {"text": "الواو عاطفة ومن اسم استفهام وقد خرج الاستفهام هنا الى معنى النفي في محل رفع مبتدأ", "color": "black"}, {"text": "(أَحْسَنُ)", "color": "red"}, {"text": "خبر", "color": "black"}, {"text": "(مِنَ اللَّهِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بأحسن", "color": "black"}, {"text": "(صِبْغَةَ)", "color": "red"}, {"text": "تمييز", "color": "black"}, {"text": "(وَنَحْنُ)", "color": "red"}, {"text": "الواو عاطفة ونحن مبتدأ", "color": "black"}, {"text": "(لَهُ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بعابدون", "color": "black"}, {"text": "(عابِدُونَ)", "color": "red"}, {"text": "خبر نحن", "color": "black"}, {"text": "(قُلْ)", "color": "red"}, {"text": "فعل أمر وفاعله أنت", "color": "black"}, {"text": "(أَتُحَاجُّونَنا)", "color": "red"}, {"text": "الهمزة للاستفهام الانكاري وتحاجون فعل مضارع والواو فاعل والضمير المشترك في محل نصب مفعول", "color": "black"}, {"text": "(فِي اللَّهِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بتحاجوننا", "color": "black"}, {"text": "(وَهُوَ)", "color": "red"}, {"text": "الواو حالية وهو مبتدأ", "color": "black"}, {"text": "(رَبُّنا)", "color": "red"}, {"text": "خبر والجملة الاسمية في محل نصب على الحال", "color": "black"}, {"text": "(وَرَبُّكُمْ)", "color": "red"}, {"text": "عطف على ربنا", "color": "black"}, {"text": "(وَلَنا)", "color": "red"}, {"text": "الواو عاطفة ولنا الجار والمجرور خبر مقدم", "color": "black"}, {"text": "(أَعْمالُنا)", "color": "red"}, {"text": "مبتدأ مؤخر والجملة حالية", "color": "black"}, {"text": "(وَلَكُمْ أَعْمالُكُمْ)", "color": "red"}, {"text": "عطف على الجملة السابقة", "color": "black"}, {"text": "(وَنَحْنُ)", "color": "red"}, {"text": "الواو حالية ونحن مبتدأ", "color": "black"}, {"text": "(لَهُ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بمخلصون", "color": "black"}, {"text": "(مُخْلِصُونَ)", "color": "red"}, {"text": "خبر نحن والجملة حالية أيضا.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "البلاغة:", "color": "#8b0000"}]}, {"row_id": 8, "segments": [{"text": "في قوله: صبغة الله استعارة تصريحية شبّه الدين الاسلامي بالصبغة وحذف المشبه وأبقى المشبه به وقد تشبث بالمعنى واللفظ أعشى همدان حيث قال:", "color": "black"}]}, {"row_id": 9, "segments": [{"text": "وكل أناس لهم صبغة ... وصبغة همدان خير الصّبغ", "color": "black"}]}, {"row_id": 10, "segments": [{"text": "صبغنا على ذاك أولادنا ... فأكرم بصبغتنا في الصّبغ", "color": "black"}]}]