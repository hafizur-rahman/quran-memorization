[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": الآيات 120 الى 121]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَلَنْ تَرْضى عَنْكَ الْيَهُودُ وَلا النَّصارى حَتَّى تَتَّبِعَ مِلَّتَهُمْ قُلْ إِنَّ هُدَى اللَّهِ هُوَ الْهُدى وَلَئِنِ اتَّبَعْتَ أَهْواءَهُمْ بَعْدَ الَّذِي جاءَكَ مِنَ الْعِلْمِ ما لَكَ مِنَ اللَّهِ مِنْ وَلِيٍّ وَلا نَصِيرٍ", "color": "black"}, {"text": "(120)", "color": "red"}, {"text": "الَّذِينَ آتَيْناهُمُ الْكِتابَ يَتْلُونَهُ حَقَّ تِلاوَتِهِ أُولئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ فَأُولئِكَ هُمُ الْخاسِرُونَ", "color": "black"}, {"text": "(121)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(وَلَنْ)", "color": "red"}, {"text": "الواو استئنافية ولن حرف نفي ونصب واستقبال", "color": "black"}, {"text": "(تَرْضى)", "color": "red"}, {"text": "فعل مضارع منصوب بلن", "color": "black"}, {"text": "(عَنْكَ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بترضى", "color": "black"}, {"text": "(الْيَهُودُ)", "color": "red"}, {"text": "فاعل", "color": "black"}, {"text": "(وَلَا النَّصارى)", "color": "red"}, {"text": "عطف على اليهود", "color": "black"}, {"text": "(حَتَّى)", "color": "red"}, {"text": "حرف غاية وجر", "color": "black"}, {"text": "(تَتَّبِعَ)", "color": "red"}, {"text": "فعل مضارع منصوب بأن مضمرة وجوبا بعد حتى", "color": "black"}, {"text": "(مِلَّتَهُمْ)", "color": "red"}, {"text": "مفعول به والفاعل مستتر تقديره أنت", "color": "black"}, {"text": "(قُلْ)", "color": "red"}, {"text": "فعل أمر مبني على السكون والجملة مستأنفة", "color": "black"}, {"text": "(إِنَّ)", "color": "red"}, {"text": "حرف مشبه بالفعل", "color": "black"}, {"text": "(هُدَى اللَّهِ)", "color": "red"}, {"text": "اسمها والجملة في محل نصب مقول القول", "color": "black"}, {"text": "(هُوَ)", "color": "red"}, {"text": "مبتدأ", "color": "black"}, {"text": "(الْهُدى)", "color": "red"}, {"text": "خبره والجملة الاس