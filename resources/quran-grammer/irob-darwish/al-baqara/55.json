[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": الآيات 55 الى 56]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَإِذْ قُلْتُمْ يا مُوسى لَنْ نُؤْمِنَ لَكَ حَتَّى نَرَى اللَّهَ جَهْرَةً فَأَخَذَتْكُمُ الصَّاعِقَةُ وَأَنْتُمْ تَنْظُرُونَ", "color": "black"}, {"text": "(55)", "color": "red"}, {"text": "ثُمَّ بَعَثْناكُمْ مِنْ بَعْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُرُونَ", "color": "black"}, {"text": "(56)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(وَإِذْ)", "color": "red"}, {"text": "تقدم القول فيها", "color": "black"}, {"text": "(قُلْتُمْ)", "color": "red"}, {"text": "فعل وفاعل والجملة في محل جر بإضافة الظرف إليها", "color": "black"}, {"text": "(يا)", "color": "red"}, {"text": "حرف نداء للمتوسط", "color": "black"}, {"text": "(مُوسى)", "color": "red"}, {"text": "منادى مفرد علم", "color": "black"}, {"text": "(لَنْ)", "color": "red"}, {"text": "حرف نفي ونصب واستقبال", "color": "black"}, {"text": "(نُؤْمِنَ)", "color": "red"}, {"text": "فعل مضارع منصوب بلن، وفاعله ضمير مستتر تقديره نحن، والجملة مقول القول", "color": "black"}, {"text": "(لَكَ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بنؤمن", "color": "black"}, {"text": "(حَتَّى)", "color": "red"}, {"text": "حرف غاية وجر", "color": "black"}, {"text": "(نَرَى)", "color": "red"}, {"text": "فعل مضارع منصوب بأن مضمرة وجوبا بعد حتى", "color": "black"}, {"text": "(اللَّهَ)", "color": "red"}, {"text": "مفعول به", "color": "black"}, {"text": "(جَهْرَةً)", "color": "red"}, {"text": "مفعول مطلق لأنها مصدر جهر أي قرأ بصوت عال فهي بمثابة الذي يرى بالعين ويجوز أن تعرب نصبا على الحال أي جاهرين بالرؤية", "color": "black"}, {"text": "(فَأَخَذَتْكُمُ)", "color": "red"}, {"text": "الفاء عاطفة وأخذتكم فعل ماض والتاء تاء التأنيث الساكنة والكاف ضمير متصل في محل نصب مفعول به مقدم", "color": "black"}, {"text": "(الصَّاعِقَةُ)", "color": "red"}, {"text": "فاعل والجملة معط