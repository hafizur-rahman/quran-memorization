[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": آية 83]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَإِذْ أَخَذْنا مِيثاقَ بَنِي إِسْرائِيلَ لا تَعْبُدُونَ إِلاَّ اللَّهَ وَبِالْوالِدَيْنِ إِحْساناً وَذِي الْقُرْبى وَالْيَتامى وَالْمَساكِينِ وَقُولُوا لِلنَّاسِ حُسْناً وَأَقِيمُوا الصَّلاةَ وَآتُوا الزَّكاةَ ثُمَّ تَوَلَّيْتُمْ إِلاَّ قَلِيلاً مِنْكُمْ وَأَنْتُمْ مُعْرِضُونَ", "color": "black"}, {"text": "(83)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(وَإِذْ أَخَذْنا)", "color": "red"}, {"text": "تقدم إعرابه كثيرا", "color": "black"}, {"text": "(مِيثاقَ)", "color": "red"}, {"text": "مفعول به", "color": "black"}, {"text": "(بَنِي)", "color": "red"}, {"text": "مضاف إليه مجرور وعلامة جرّه الياء لأنه ملحق بجمع المذكر السالم", "color": "black"}, {"text": "(إِسْرائِيلَ)", "color": "red"}, {"text": "مضاف اليه وعلامة جره الفتحة نيابة عن الكسرة لأنه علم أعجمي", "color": "black"}, {"text": "(لا)", "color": "red"}, {"text": "نافية", "color": "black"}, {"text": "(تَعْبُدُونَ)", "color": "red"}, {"text": "فعل مضارع مرفوع والواو فاعل", "color": "black"}, {"text": "(إِلَّا)", "color": "red"}, {"text": "أداة حصر", "color": "black"}, {"text": "(اللَّهَ)", "color": "red"}, {"text": "مفعول به والجملة لا محل لها لأنها مفسرة والخبر بمعنى النهي أي", "color": "black"}, {"text": "(وَبِالْوالِدَيْنِ)", "color": "red"}, {"text": "الواو حرف عطف على موضع ان المحذوفة في لا تعبدون إلا الله فكان معنى الكلام وإذ أخذنا ميثاق بني إسرائيل بأن لا تعبدوا إلا الله وأحسنوا بالوالدين بالوالدين الجار والمجرور ومتعلقان بفعل المصدر أي وأحسنوا بالوالدين", "color": "black"}, {"text": "(إِحْساناً)", "color": "red"}, {"text": "مفعول مطلق لفعل محذوف", "color": "black"}, {"text": "(وَذِي الْقُرْبى وَالْيَتامى وَالْمَساكِينِ)", "color": "red"}, {"text": "عطف على الوالدين", "color": "black"}, {"text": "(وَقُولُوا)", "color": "red"}, {"text": "عطف ولكن لا بد من تقدير محذوف أي وقلنا قولوا", "color": "black"}, {"text": "(لِلنَّاسِ)", "color": "red"}, {"text": "متعلق بالفعل المحذوف", "color": "black"}, {"text": "(حُسْناً)", "color": "red"}, {"text": "صفة لمفعول مطلق محذوف أو قولا حسنا", "color": "black"}, {"text": "(وَأَقِيمُوا)", "color": "red"}, {"text": "عطف أيضا على ما تقدم", "color": "black"}, {"text": "(الصَّلاةَ)", "color": "red"}, {"text": "مفعول به", "color": "black"}, {"text": "(وَآتُوا الزَّكاةَ)", "color": "red"}, {"text": "عطف على أقيموا الصلاة", "color": "black"}, {"text": "(ثُمَّ)", "color": "red"}, {"text": "حرف عطف عطفت على محذوف أي فقبلتم الميثاق", "color": "black"}, {"text": "(تَوَلَّيْتُمْ)", "color": "red"}, {"text": "فعل وفاعل", "color": "black"}, {"text": "(إِلَّا)", "color": "red"}, {"text": "أداة استثناء لأن الكلام تام موجب", "color": "black"}, {"text": "(قَلِيلًا)", "color": "red"}, {"text": "مستثنى بإلا", "color": "black"}, {"text": "(مِنْكُمْ)", "color": "red"}, {"text": "الجار والمجرور صفة لقليلا", "color": "black"}, {"text": "(وَأَنْتُمْ)", "color": "red"}, {"text": "الواو حالية وأنتم مبتدأ", "color": "black"}, {"text": "(مُعْرِضُونَ)", "color": "red"}, {"text": "خبر والجملة الاسمية في محل نصب على الحال.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "البلاغة:", "color": "#8b0000"}]}, {"row_id": 6, "segments": [{"text": "1- جملة لا تعبدون خبر معناه النهي وهو أبلغ من التصريح به.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "2- الالتفات: من الغيبة الى الخطاب في قوله: «لا تعبدون» ومن خطاب بني إسرائيل القدامى الى خطاب الحاضرين منهم في زمن النبي صلى الله عليه وسلم.", "color": "black"}]}]