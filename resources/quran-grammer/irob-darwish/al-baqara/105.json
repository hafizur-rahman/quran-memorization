[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": آية 105]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "ما يَوَدُّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتابِ وَلا الْمُشْرِكِينَ أَنْ يُنَزَّلَ عَلَيْكُمْ مِنْ خَيْرٍ مِنْ رَبِّكُمْ وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ", "color": "black"}, {"text": "(105)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(اختص)", "color": "red"}, {"text": "فعل متعدّ يقال خصّه بكذا واختصّه وخصّصه وأخصّه فاختصّ به وجميع ما فاؤه خاء وعينه صاد يدل على الاجتماع والتكاثر والانضمام كخصب المكان وأخصب أي وقع فيه الخصب وهو اجتماع النبت وتكاثره وخاصر المرأة قبض على خاصرتها قال عبد الرحمن بن حسان بن ثابت:", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "ثم خاصرتها الى القبة الخضر ... اء تمشي في مرمر مسنون", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "وخصف الأوراق: اتبع بعضها ببعض وهم خصوم وخصاء ولا يكون ذلك إلا في اجتماع.", "color": "black"}]}, {"row_id": 7, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 8, "segments": [{"text": "(ما)", "color": "red"}, {"text": "نافية", "color": "black"}, {"text": "(يَوَدُّ)", "color": "red"}, {"text": "فعل مضارع مرفوع", "color": "black"}, {"text": "(الَّذِينَ كَفَرُوا)", "color": "red"}, {"text": "فاعل يود وجملة كفروا صلة", "color": "black"}, {"text": "(مِنْ)", "color": "red"}, {"text": "حرف جر", "color": "black"}, {"text": "(أَهْلِ الْكِتابِ)", "color": "red"}, {"text": "مجرور بمن والجار والمجرور في محل نصب على الحال", "color": "black"}, {"text": "(وَلَا الْمُشْرِكِينَ)", "color": "red"}, {"text": "عطف على أهل الكتاب ودخلت لا للتأكيد ولو كانت في غير القرآن لجاز حذفها", "color": "black"}, {"text": "(أَنْ يُنَزَّلَ)", "color": "red"}, {"text": "أن وما في حيزها في تأويل مصدر مفعول يود وينزل مبني للمجهول", "color": "black"}, {"text": "(عَلَيْكُمْ)", "color": "red"}, {"text