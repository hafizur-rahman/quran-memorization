[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": الآيات 207 الى 209]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغاءَ مَرْضاتِ اللَّهِ وَاللَّهُ رَؤُفٌ بِالْعِبادِ", "color": "black"}, {"text": "(207)", "color": "red"}, {"text": "يا أَيُّهَا الَّذِينَ آمَنُوا ادْخُلُوا فِي السِّلْمِ كَافَّةً وَلا تَتَّبِعُوا خُطُواتِ الشَّيْطانِ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ", "color": "black"}, {"text": "(208)", "color": "red"}, {"text": "فَإِنْ زَلَلْتُمْ مِنْ بَعْدِ ما جاءَتْكُمُ الْبَيِّناتُ فَاعْلَمُوا أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ", "color": "black"}, {"text": "(209)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(يَشْرِي)", "color": "red"}, {"text": ": يبيع.", "color": "black"}, {"text": "(السلم)", "color": "red"}, {"text": ": الاستسلام وهو بكسر السين وفتحها.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "(كَافَّةً)", "color": "red"}, {"text": ": من الكفّ كأنهم كفّوا عن أن يشذ واحد منهم.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 7, "segments": [{"text": "(وَمِنَ النَّاسِ)", "color": "red"}, {"text": "الواو عاطفة والجار والمجرور متعلقان بمحذوف خبر مقدم", "color": "black"}, {"text": "(مِنَ)", "color": "red"}, {"text": "مبتدأ مؤخر والجملة معطوفة على قوله: «فمن الناس» لاستيفاء أقسامهم", "color": "black"}, {"text": "(يَشْرِي نَفْسَهُ)", "color": "red"}, {"text": "فعل مضارع وفاعل مستتر ومفعول به والجملة صلة الموصول", "color": "black"}, {"text": "(ابْتِغاءَ مَرْضاتِ اللَّهِ)", "color": "red"}, {"text": "مفعول لأجله وما بعده مضاف اليه", "color": "black"}, {"text": "(وَاللَّهُ)", "color": "red"}, {"text": "الواو استئنافية والله مبتدأ", "color": "black"}, {"text": "(رَؤُفٌ)", "color": "red"}, {"text": "خبر", "color": "black"}, {"text": "(بِالْعِبادِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان برءوف", "color": "black"}, {"text": "(يا أَيُّهَا الَّذِينَ آمَنُوا)", "color": "red"}, {"text": "تقدم إعراب نظائرها", "color": "black"}, {"text": "(ادْخُلُوا)", "color": "red"}, {"text": "فعل أمر مبني على حذف النون والواو فاعل", "color": "black"}, {"text": "(فِي السِّلْمِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بادخلوا والجملة استئنافية", "color": "black"}, {"text": "(كَافَّةً)", "color": "red"}, {"text": "حال من الواو في ادخلوا ومن السلم لأنه يذكر ويؤنث", "color": "black"}, {"text": "(وَلا)", "color": "red"}, {"text": "الواو عاطفة ولا ناهية", "color": "black"}, {"text": "(تَتَّبِعُوا)", "color": "red"}, {"text": "فعل مضارع مجزوم بلا وعلامة جزمه حذف النون والواو فاعل", "color": "black"}, {"text": "(خُطُواتِ الشَّيْطانِ)", "color": "red"}, {"text": "مفعول به ومضاف إليه", "color": "black"}, {"text": "(إِنَّهُ)", "color": "red"}, {"text": "ان واسمها", "color": "black"}, {"text": "(لَكُمْ)", "color": "red"}, {"text": "جار ومجرور متعلقان بعدو", "color": "black"}, {"text": "(عَدُوٌّ)", "color": "red"}, {"text": "خبر", "color": "black"}, {"text": "(مُبِينٌ)", "color": "red"}, {"text": "صفة والجملة تعليلية لا محل لها.", "color": "black"}, {"text": "(فَإِنْ زَلَلْتُمْ)", "color": "red"}, {"text": "الفاء استئنافية، وإن شرطية، وزللتم فعل ماض وفاعله وهو في محل جزم فعل الشرط", "color": "black"}, {"text": "(مِنْ بَعْدِ ما جاءَتْكُمُ الْبَيِّناتُ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بزللتم وما مصدرية مؤولة مع الفعل بعدها بمصدر في محل جر بالإضافة وجاءتكم البينات فعل ومفعول به وفاعل", "color": "black"}, {"text": "(فَاعْلَمُوا)", "color": "red"}, {"text": "الفاء رابطة لجواب الشرط واعلموا فعل أمر مبني على حذف النون والواو\t\t\t\n\t\t\t\tفاعل والجملة في محل جزم جواب الشرط", "color": "black"}, {"text": "(أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ)", "color": "red"}, {"text": "أن واسمها وخبراها سدت مسد مفعولي اعلموا.", "color": "black"}]}]