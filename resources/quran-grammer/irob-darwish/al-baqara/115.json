[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": الآيات 114 الى 115]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَمَنْ أَظْلَمُ مِمَّنْ مَنَعَ مَساجِدَ اللَّهِ أَنْ يُذْكَرَ فِيهَا اسْمُهُ وَسَعى فِي خَرابِها أُولئِكَ ما كانَ لَهُمْ أَنْ يَدْخُلُوها إِلاَّ خائِفِينَ لَهُمْ فِي الدُّنْيا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذابٌ عَظِيمٌ", "color": "black"}, {"text": "(114)", "color": "red"}, {"text": "وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَما تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ إِنَّ اللَّهَ واسِعٌ عَلِيمٌ", "color": "black"}, {"text": "(115)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(المساجد)", "color": "red"}, {"text": ": جمع مسجد وهو اسم مكان للسجود وكان من حقّه أن يأتي على مفعل بفتح العين لأن عين مضارعه مضمومة ولكنه\t\t\t\n\t\t\t\tسمع بالكسر شذوذا كما شذّت ألفاظ جاءت بالكسر مع أنها مصوغة من مضموم العين في المضارع وهي المطلع والمغرب والمشرق والمسجد والمنسك والمجزر والمنبت والمسقط والمفرق والمسكن ويجوز فيها الفتح ولكن السماع أفصح.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 6, "segments": [{"text": "(وَمَنْ)", "color": "red"}, {"text": "الواو استئنافية ومن اسم استفهام في محل رفع مبتدأ ومعناه النفي", "color": "black"}, {"text": "(أَظْلَمُ)", "color": "red"}, {"text": "خبر من", "color": "black"}, {"text": "(مِمَّنْ)", "color": "red"}, {"text": "جار ومجرور متعلقان بأظلم", "color": "black"}, {"text": "(مَنَعَ مَساجِدَ اللَّهِ)", "color": "red"}, {"text": "فعل ماض وفاعل مستتر يعود على من ومساجد الله مفعول به والجملة لا محل لها لأنها صلة الموصول", "color": "black"}, {"text": "(أَنْ يُذْكَرَ)", "color": "red"}, {"text": "أن وما في حيّزها في تأويل مصدر مفعول ثان لمنع ولك أن تعرب المصدر مفعولا لأجله أي كراهة أن يذكر فيها اسمه", "color": "black"}, {"text": "(فِيهَا)", "color": "red"}, {"text": "جار ومجرور متعلقان بيذكر", "color": "black"}, {"text": "