[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": آية 87]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَلَقَدْ آتَيْنا مُوسَى الْكِتابَ وَقَفَّيْنا مِنْ بَعْدِهِ بِالرُّسُلِ وَآتَيْنا عِيسَى ابْنَ مَرْيَمَ الْبَيِّناتِ وَأَيَّدْناهُ بِرُوحِ الْقُدُسِ أَفَكُلَّما جاءَكُمْ رَسُولٌ بِما لا تَهْوى أَنْفُسُكُمُ اسْتَكْبَرْتُمْ فَفَرِيقاً كَذَّبْتُمْ وَفَرِيقاً تَقْتُلُونَ", "color": "black"}, {"text": "(87)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(قَفَّيْنا)", "color": "red"}, {"text": "اتبعنا والمادة كلها تدل على التبعية، والقفا كل تابع وهو مؤخر العنق ومنه قافية الشعر لأنها تتبع البيت", "color": "black"}, {"text": "(عِيسَى)", "color": "red"}, {"text": ": علم أعجمي وهو بالسريانية ايشوع وليس مشتقا من العيس وهو بياض يخالطه شقرة.", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "(مَرْيَمَ)", "color": "red"}, {"text": "علم أعجمي ولهذا منع من الصرف. والمريم في اللغة العربية من النساء كالزير من الرجال والزّير هو الذي يخالط النساء ويمازحهن بغير شر او به.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 7, "segments": [{"text": "(وَلَقَدْ)", "color": "red"}, {"text": "الواو حرف عطف واللام جواب قسم محذوف وقد:\t\t\t\n\t\t\t\tحرف تحقيق", "color": "black"}, {"text": "(آتَيْنا)", "color": "red"}, {"text": "فعل وفاعل", "color": "black"}, {"text": "(مُوسَى)", "color": "red"}, {"text": "مفعول به أول", "color": "black"}, {"text": "(الْكِتابَ)", "color": "red"}, {"text": "مفعول به ثان", "color": "black"}, {"text": "(وَقَفَّيْنا)", "color": "red"}, {"text": "عطف على آتينا", "color": "black"}, {"text": "(مِنْ بَعْدِهِ)", "color": "red"}, {"text": "جار ومجرور متعلقان بمحذوف حال", "color": "black"}, {"text": "(بِالرُّسُلِ)", "color": "red"}, {"text": "جار ومجرور متعلقان بقفينا", "color": "black"}, {"text": "(وَآتَيْنا)", "color": "red"}, {"text": "عطف على ما تقدم", "color": "black"}, {"text": "(عِيسَى)", "color": "red"}, {"text": "مفعول به أول", "color": "black"}, {"text": "(ابْنَ)", "color": "red"}, {"text": "بدل أو صفة", "color": "black"}, {"text": "(مَرْيَمَ)", "color": "red"}, {"text": "مضاف اليه", "color": "black"}, {"text": "(الْبَيِّناتِ)", "color": "red"}, {"text": "مفعول به ثان وعلامة نصبه الكسرة لأنه جمع مؤنث سالم", "color": "black"}, {"text": "(وَأَيَّدْناهُ)", "color": "red"}, {"text": "عطف على ما تقدم", "color": "black"}, {"text": "(بِرُوحِ الْقُدُسِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بأيدناه", "color": "black"}, {"text": "(أَفَكُلَّما)", "color": "red"}, {"text": "الهمزة للاستفهام والفاء عاطفة وكلما ظرف زمان متضمن معنى الشرط", "color": "black"}, {"text": "(جاءَكُمْ)", "color": "red"}, {"text": "فعل ماض ومفعول به مقدّم", "color": "black"}, {"text": "(رَسُولٌ)", "color": "red"}, {"text": "فاعل جاء والجملة في محل جر بإضافة الظرف إليها", "color": "black"}, {"text": "(بِما)", "color": "red"}, {"text": "الباء حرف جر وما اسم موصول مجرور بالباء محلا والجار والمجرور متعلقان بجاءكم", "color": "black"}, {"text": "(لا)", "color": "red"}, {"text": "نافية", "color": "black"}, {"text": "(تَهْوى)", "color": "red"}, {"text": "فعل مضارع", "color": "black"}, {"text": "(أَنْفُسُكُمُ)", "color": "red"}, {"text": "فاعل والجملة لا محل لها لانها صلة", "color": "black"}, {"text": "(اسْتَكْبَرْتُمْ)", "color": "red"}, {"text": "فعل ماض وفاعل والجملة لا محل لها لأنها جواب شرط غير جازم", "color": "black"}, {"text": "(فَفَرِيقاً)", "color": "red"}, {"text": "الفاء عاطفة وفريقا مفعول به مقدّم", "color": "black"}, {"text": "(كَذَّبْتُمْ)", "color": "red"}, {"text": "فعل", "color": "black"}, {"text": "(وَفَرِيقاً)", "color": "red"}, {"text": "الواو عاطفة وفريقا مفعول مقدم لتقتلون", "color": "black"}, {"text": "(تَقْتُلُونَ)", "color": "red"}, {"text": "فعل مضارع مرفوع وعلامة رفعه ثبوت النون والواو فاعل.", "color": "black"}]}]