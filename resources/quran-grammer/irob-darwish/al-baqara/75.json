[{"row_id": 1, "segments": [{"text": "[سورة البقرة", "color": "green"}, {"text": "(2)", "color": "red"}, {"text": ": آية 75]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "أَفَتَطْمَعُونَ أَنْ يُؤْمِنُوا لَكُمْ وَقَدْ كانَ فَرِيقٌ مِنْهُمْ يَسْمَعُونَ كَلامَ اللَّهِ ثُمَّ يُحَرِّفُونَهُ مِنْ بَعْدِ ما عَقَلُوهُ وَهُمْ يَعْلَمُونَ", "color": "black"}, {"text": "(75)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "اللغة:", "color": "#8b0000"}]}, {"row_id": 4, "segments": [{"text": "(الطمع)", "color": "red"}, {"text": "تعلق النفس بإدراك أمر تعلقا قويا فهو أشد من الرجاء يقال: طمع يطمع طمعا وطماعية وطماعية. قال المتنبي:", "color": "black"}]}, {"row_id": 5, "segments": [{"text": "إلام طماعية العاذل ... ولا رأي في الحبّ للعاقل", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 7, "segments": [{"text": "(أَفَتَطْمَعُونَ)", "color": "red"}, {"text": "الهمزة للاستفهام والمراد به النهي أو الاستنكار وقد تقدم بحث دخول الهمزة على حروف العطف والمعنى: لا تطمعوا في إقناع هؤلاء العتاة الجفاة القاسية قلوبهم", "color": "black"}, {"text": "(أَنْ يُؤْمِنُوا)", "color": "red"}, {"text": "أن وما بعدها\t\t\t\n\t\t\t\tفي تأويل مصدر منصوب بنزع الخافض", "color": "black"}, {"text": "(لَكُمْ)", "color": "red"}, {"text": "جار ومجرور متعلق بيؤمنوا على تضمين يؤمنوا معنى الانقياد", "color": "black"}, {"text": "(وَقَدْ)", "color": "red"}, {"text": "الواو حالية وقد حرف تحقيق", "color": "black"}, {"text": "(كانَ)", "color": "red"}, {"text": "فعل ماض ناقص", "color": "black"}, {"text": "(فَرِيقٌ)", "color": "red"}, {"text": "اسمها", "color": "black"}, {"text": "(مِنْهُمْ)", "color": "red"}, {"text": "جار ومجرور صفة لفريق", "color": "black"}, {"text": "(يَسْمَعُونَ)", "color": "red"}, {"text": "فعل مضارع مرفوع والواو فاعل وجملة يسمعون خبر كان", "color": "black"}, {"text": "(كَلامَ اللَّهِ)", "color": "red"}, {"text": "مفعول به", "color": "black"}, {"text": "(ثُمَّ)", "color": "red"}, {"text": "حرف عطف للتراخي", "color": "black"}, {"text": "(يُحَرِّفُونَهُ)", "color": "red"}, {"text": "عطف على يسمعون", "color": "black"}, {"text": "(مِنْ بَعْدِ)", "color": "red"}, {"text": "الجار والمجرور متعلقان بيحرفونه", "color": "black"}, {"text": "(ما)", "color": "red"}, {"text": "مصدرية مؤولة مع ما بعدها بمصدر في محل جر بالاضافة", "color": "black"}, {"text": "(عَقَلُوهُ)", "color": "red"}, {"text": "فعل وفاعل ومفعول به", "color": "black"}, {"text": "(وَهُمْ)", "color": "red"}, {"text": "الواو حالية وهم مبتدأ", "color": "black"}, {"text": "(يَعْلَمُونَ)", "color": "red"}, {"text": "الجملة في موضع رفع خبرهم والجملة الاسمية في موضع نصب على الحال أي والحال أنهم عالمون بكفرهم وعنادهم وافترائهم.", "color": "black"}]}]