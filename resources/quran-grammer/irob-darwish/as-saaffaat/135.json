[{"row_id": 1, "segments": [{"text": "[سورة الصافات", "color": "green"}, {"text": "(37)", "color": "red"}, {"text": ": الآيات 133 الى 138]", "color": "green"}]}, {"row_id": 2, "segments": [{"text": "وَإِنَّ لُوطاً لَمِنَ الْمُرْسَلِينَ", "color": "black"}, {"text": "(133)", "color": "red"}, {"text": "إِذْ نَجَّيْناهُ وَأَهْلَهُ أَجْمَعِينَ", "color": "black"}, {"text": "(134)", "color": "red"}, {"text": "إِلاَّ عَجُوزاً فِي الْغابِرِينَ", "color": "black"}, {"text": "(135)", "color": "red"}, {"text": "ثُمَّ دَمَّرْنَا الْآخَرِينَ", "color": "black"}, {"text": "(136)", "color": "red"}, {"text": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِحِينَ", "color": "black"}, {"text": "(137)", "color": "red"}]}, {"row_id": 3, "segments": [{"text": "وَبِاللَّيْلِ أَفَلا تَعْقِلُونَ", "color": "black"}, {"text": "(138)", "color": "red"}]}, {"row_id": 4, "segments": [{"text": "الإعراب:", "color": "#8b0000"}]}, {"row_id": 5, "segments": [{"text": "(وَإِنَّ لُوطاً لَمِنَ الْمُرْسَلِينَ)", "color": "red"}, {"text": "وهذه هي القصة الخامسة، والواو استئنافية أو عاطفة وإن واسمها واللام المزحلقة ومن المرسلين خبرها.", "color": "black"}, {"text": "(إِذْ نَجَّيْناهُ وَأَهْلَهُ أَجْمَعِينَ)", "color": "red"}, {"text": "الظرف متعلق بمحذوف تقديره اذكر وجملة نجيناه من الفعل والفاعل والمفعول في محل جر بإضافة الظرف إليها وأهله مفعول معه أو عطف على الهاء وأجمعين تأكيد.", "color": "black"}]}, {"row_id": 6, "segments": [{"text": "(إِلَّا عَجُوزاً فِي الْغابِرِينَ)", "color": "red"}, {"text": "إلا أداة استثناء وعجوزا مستثنى وفي الغابرين صفة.", "color": "black"}, {"text": "(ثُمَّ دَمَّرْنَا الْآخَرِينَ)", "color": "red"}]}, {"row_id": 7, "segments": [{"text": "ثم حرف عطف للترتيب مع التراخي ودمرنا الآخرين فعل ماض وفاعل ومفعول به وهم كفار قومه.", "color": "black"}]}, {"row_id": 8, "segments": [{"text": "(وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِحِينَ)", "color": "red"}]}, {"row_id": 9, "segments": [{"text": "الواو عاطفة أو حالية وان واسمها واللام المزحلقة وتمرون فعل مضارع وفاعل وعليهم متعلقان بتمرون ومصبحين حال وهي تامة.", "color": "black"}, {"text": "(وَبِاللَّيْلِ أَفَلا تَعْقِلُونَ)", "color": "red"}]}, {"row_id": 10, "segments": [{"text": "الواو عاطفة وبالليل عطف على مصبحين فهو حال أخرى والحال هنا محمول على المكان والباء للملابسة والهمزة داخلة على مقدر عطف عليه قوله فلا تعقلون والتقدير تشاهدون ذلك فلا تعقلون أي تعتبرون به.", "color": "black"}]}]