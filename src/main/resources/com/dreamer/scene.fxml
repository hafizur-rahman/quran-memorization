<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dreamer.Controller">
    <!--    <right>-->
    <!--        <TreeView fx:id="chaptersTree" visible="false" />-->
    <!--    </right>-->
    <top>
        <BorderPane>
            <center>
                <HBox>
                    <Separator prefWidth="20"/>

                    <Label fx:id="chapterLabel" text="Sura ...">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>
                    <Separator/>
                    <Label fx:id="verseLabel" text="Verse: ">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>
                    <Separator/>
                    <Button fx:id="prevVerse" text="&lt; Prev">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                    <Separator/>
                    <Button fx:id="nextVerse" text="Next &gt;">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                    <Separator/>
                    <CheckBox fx:id="playContinuous" text="Continuous">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </CheckBox>
                    <Separator/>
                    <ToggleButton fx:id="playButton" text="&gt;">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </ToggleButton>
                    <Label text="  "/>
                    <Button fx:id="randomVerse" text="Pick Random">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                </HBox>
            </center>
            <right>
                <HBox>
                    <Button fx:id="prevPage" text="&lt; Prev">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                    <Separator/>
                    <Button fx:id="nextPage" text="Next &gt;">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                    <Label text="  Page: ">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="pageIdInput" text="" prefWidth="50">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </TextField>
                    <Separator/>
                    <Label text="Repeat: ">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="repeatCountInput" text="1" prefWidth="50">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </TextField>
                    <Separator/>
                </HBox>
            </right>
        </BorderPane>
    </top>
    <right>
        <BorderPane>
            <left>
                <ImageView fx:id="pageImage" fitWidth="600" fitHeight="780" preserveRatio="true"/>
            </left>
        </BorderPane>
    </right>
    <left>
        <BorderPane prefWidth="1000.0">
            <center>
                <TabPane side="LEFT">
                    <Tab fx:id="currentPage" text="Current Page" closable="false">
                        <ScrollPane fitToWidth="true" style="-fx-border-color: lightgray; -fx-border-width: 10;">
                            <VBox spacing="20">
                                <Separator/>

                                <BorderPane>
                                    <center>
                                        <Text fx:id="pageBengaliTranslation" text="" wrappingWidth="570" lineSpacing="6"
                                              textAlignment="JUSTIFY">
                                            <font>
                                                <Font name="Arial" size="18.0"/>
                                            </font>
                                        </Text>
                                    </center>
                                </BorderPane>
                            </VBox>
                        </ScrollPane>

                    </Tab>
                    <Tab fx:id="currentVerse" text="Current Verse" closable="false">
                        <ScrollPane fitToWidth="true" style="-fx-border-color: lightgray; -fx-border-width: 10;">
                            <VBox spacing="10">
                                <ImageView fx:id="verseImage" fitWidth="930" preserveRatio="true" visible="true">
                                </ImageView>

                                <Separator/>

                                <Text fx:id="verseSyntax" wrappingWidth="930" fill="dimgray" lineSpacing="6"
                                      style="-fx-text-alignment: right;">
                                    <font>
                                        <Font name="Arial" size="25.0"/>
                                    </font>
                                </Text>

                                <Separator/>

                                <BorderPane>
                                    <center>
                                        <Text fx:id="verseBengaliTranslation" wrappingWidth="930" fill="slategrey"
                                              lineSpacing="6" textAlignment="JUSTIFY">
                                            <font>
                                                <Font name="Arial" size="20.0"/>
                                            </font>
                                        </Text>
                                    </center>
                                </BorderPane>

                                <Separator/>

                                <BorderPane>
                                    <center>
                                        <Text fx:id="verseTafsir" wrappingWidth="930" fill="dimgray" lineSpacing="6"
                                              textAlignment="JUSTIFY">
                                            <font>
                                                <Font name="Arial" size="15.0"/>
                                            </font>
                                        </Text>
                                    </center>
                                </BorderPane>
                            </VBox>
                        </ScrollPane>
                    </Tab>
                </TabPane>
            </center>
        </BorderPane>
    </left>
</BorderPane>
