<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dreamer.Controller">
<!--    <right>-->
<!--        <TreeView fx:id="chaptersTree" visible="false" />-->
<!--    </right>-->
    <top>
        <BorderPane>
            <center>
                <HBox>
                    <Label text="   " visible="false">
                        <font><Font size="15.0" /></font>
                    </Label>

                    <Label fx:id="chapterLabel" text="Sura ...">
                        <font><Font size="15.0" /></font>
                    </Label>
                    <Label text="    " />
                    <Label fx:id="verseLabel" text="Verse: ">
                        <font><Font size="15.0" /></font>
                    </Label>
                    <Label text="  " />
                    <Button fx:id="prevVerse" text="&lt; Prev">
                        <font><Font size="12.0" /></font>
                    </Button>
                    <Label text="  " />
                    <Button fx:id="nextVerse" text="Next &gt;">
                        <font><Font size="12.0" /></font>
                    </Button>
                    <Label text="    " />
                    <CheckBox fx:id="playContinuous" text="Continuous">
                        <font><Font size="15.0" /></font>
                    </CheckBox>
                    <Label text="    " />
                    <ToggleButton fx:id="playButton" text="&gt;">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </ToggleButton>
                    <Label text="  " />
                    <Button fx:id="randomVerse" text="Pick Random">
                        <font><Font size="12.0" /></font>
                    </Button>
                </HBox>
            </center>
            <right>
                <HBox>
                    <Button fx:id="prevPage" text="&lt; Prev">
                        <font><Font size="12.0" /></font>
                    </Button>
                    <Label text="  " />
                    <Button fx:id="nextPage" text="Next &gt;">
                        <font><Font size="12.0" /></font>
                    </Button>
                    <Label text="  Page: ">
                        <font><Font size="15.0" /></font>
                    </Label>
                    <TextField fx:id="pageIdInput" text="">
                        <font><Font size="12.0" /></font>
                    </TextField>
                    <Label text="  Repeat: ">
                        <font><Font size="15.0" /></font>
                    </Label>
                    <TextField fx:id="repeatCountInput" text="1">
                        <font><Font size="12.0" /></font>
                    </TextField>
                </HBox>
            </right>
        </BorderPane>
    </top>
    <right>
        <BorderPane>
            <left>
                <ImageView fx:id="pageImage" fitWidth="600" fitHeight="780" preserveRatio="true"/>
            </left>
        </BorderPane>
    </right>
    <left>
        <BorderPane prefWidth="1000.0">
            <center>
                <TabPane side="LEFT">
                    <Tab fx:id="currentPage" text="Current Page" closable="false">
                        <BorderPane>
                            <center>
                                <Text fx:id="pageBengaliTranslation" text="" wrappingWidth="550" lineSpacing="6" textAlignment="JUSTIFY">
                                    <font>
                                        <Font name="Arial" size="18.0" />
                                    </font>
                                </Text>
                            </center>
                        </BorderPane>
                    </Tab>
                    <Tab fx:id="currentVerse" text="Current Verse" closable="false">
                        <ScrollPane fitToWidth="true">
                            <VBox spacing="10" style="-fx-border-color: lightgray; -fx-border-width: 10;">
                                <ImageView fx:id="verseImage" fitWidth="930" preserveRatio="true" visible="true">
                                </ImageView>

                                <Separator/>

                                <Text fx:id="verseSyntax" wrappingWidth="930" style="-fx-text-alignment: right;">
                                    <font>
                                        <Font name="Arial" size="25.0" />
                                    </font>
                                </Text>

                                <Separator/>

                                <Text fx:id="verseBengaliTranslation" wrappingWidth="930" style="-fx-text-alignment: justify;">
                                    <font>
                                        <Font name="Arial" size="23.0" />
                                    </font>
                                </Text>

                                <Separator/>

                                <Text fx:id="verseTafsir" wrappingWidth="930" style="-fx-text-alignment: justify;">
                                    <font>
                                        <Font name="Arial" size="15.0" />
                                    </font>
                                </Text>
                            </VBox>
                        </ScrollPane>
                    </Tab>
                </TabPane>
            </center>
        </BorderPane>
    </left>
</BorderPane>
